  document_type           = {Article},
  doi                     = {10.1088/1402-4896/acfe48},
  groups                  = {Journals},
  keywords                = {Bioinformatics; Cryptography; Efficiency; Geometry; Image coding; Image enhancement; Pixels, Bit planes; Chaotic sequence; DNA encryption; External disturbances; Image encryption scheme; Images encryptions; Pixel level; Rubik’s cube scrambling; Sub-block scrambling; Sub-blocks, DNA},
