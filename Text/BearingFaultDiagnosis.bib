  author_keywords         = {Fixed Point; Forbidden Patterns; Noise Characterization; Phase Space; Tied Data},
  correspondence_address1 = {Amadio, A.; Vehicle Research, Av. Hipólito Yrigoyen 288, Argentina; email: aamadio@docentes.frgp.utn.edu.ar},
  document_type           = {Article},
