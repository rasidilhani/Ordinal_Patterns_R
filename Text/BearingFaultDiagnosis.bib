  groups                  = {Journals},
  keywords                = {Complex networks; Feature extraction; Flow patterns; Harmonic analysis; Network layers; Time series analysis; Topology; Two phase flow, Behaviour characterization; Features extraction; Gas liquid flows; Multi-layer network; Multi-layers; Nonlinear behavior characterization; Nonlinear behaviours; Ordinal network; Time-series analysis; Visibility graphs, Entropy},
