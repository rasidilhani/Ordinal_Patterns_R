}

@Article{Qiao2024,
  author                  = {Qiao, L. and Wang, X. and Hao, Y. and Zhang, M.},
  journal                 = {Laser and Optoelectronics Progress},
  title = {Progress of Chaotic Semiconductor Lasers and Their Applications [混 沌 半 导 体 激 光 器 及 其 应 用 研 究 进 展]},
  year                    = {2024},
