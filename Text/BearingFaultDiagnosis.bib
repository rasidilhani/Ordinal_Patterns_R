  groups                  = {Journals},
  keywords                = {Failure (mechanical); Failure analysis; Fault detection; Feature extraction; Iterative methods; Rotating machinery, Fault diagnosis of rotating machineries; Faults diagnosis; Faults information; Features extraction; Multi-fault diagnosis; Multichannel data; Multivariate variational mode decomposition; Optimal modes; Parameter selection; Signal-processing, Variational mode decomposition},
