@InProceedings{sanchez2009discrete,
  author    = {S{\'a}nchez-Moreno, Pablo and Y{\'a}nez, RJ and Dehesa, JS},
  booktitle = {Proceedings of the 14th International Conference on Difference Equations and Applications. Difference Equations and Applications. Istanbul, Turkey: Bah{\c{c}}esehir University Press},
  title     = {Discrete densities and Fisher information},
  year      = {2009},
  pages     = {291--298},
  abstract  = {The spreading of a discrete distribution can be complementarily investigated by means of the Renyi and Shannon entropies in a much better way than the renowned variance. These three global notions are mere discretizations of the corresponding quantities for continuous distributions. In this work we introduce the concept of Fisher information of discrete distributions by a discretization and convergence process of three different, but equivalent, notions of the Fisher information of a continuous distribution. The Poisson and binomial distributions are shown to play a relevant role in setting up the new spreading information-theoretic quantifier.},
  file      = {:C\:/Users/UserA1/Documents/PhD/BP cited papers/Discrete densities and Fisher information.pdf:PDF},
  groups    = {in Proceedings},
  keywords  = {Information measures,Fisher Infromation,discrete densities,Poisson distribution,binomial distribution},
}

@Article{Rey2025,
  author   = {A. A. Rey and A. C. Frery and J. Gambini},
  journal  = {Chaos, Solitons \& Fractals},
  title = {Asymptotic distribution of the statistical complexity under the multinomial law},
  year     = {2025},
  issn     = {0960-0779},
  pages    = {116085},
  volume   = {193},
  abstract = {The Statistical Complexity is a feature computed from a probability function that aims to quantify the structure of the system that produced the observations. It is the product between the normalized Shannon Entropy and the normalized Jensen–Shannon distance between the probability function and the uniform law. We obtain the Statistical Complexity asymptotic distribution under the Multinomial model, and we validate this result with numerical experiments. We present examples where this asymptotic result provides a good approximation, even in scenarios where the Multinomial model is not strictly valid, such as in applications to Bandt and Pompe ordinal patterns. We provide the R code that implements these functions.},
  doi      = {https://doi.org/10.1016/j.chaos.2025.116085},
  groups   = {Journals},
  keywords = {Statistical complexity, Asymptotic distribution, Multinomial distribution},
  url      = {https://www.sciencedirect.com/science/article/pii/S0960077925000980},
}









@Article{Graben2015,
  author   = {beim Graben, Peter and Hutt, Axel},
  journal  = {Philosophical Transactions of the Royal Society A: Mathematical, Physical and Engineering Sciences},
  title = {Detecting event-related recurrences by symbolic analysis: applications to human language processing},
  year     = {2015},
  number   = {2034},
  pages    = {20140089},
  volume   = {373},
  abstract = {Quasi-stationarity is ubiquitous in complex dynamical systems. In brain dynamics, there is ample evidence that event-related potentials (ERPs) reflect such quasi-stationary states. In order to detect them from time series, several segmentation techniques have been proposed. In this study, we elaborate a recent approach for detecting quasi-stationary states as recurrence domains by means of recurrence analysis and subsequent symbolization methods. We address two pertinent problems of contemporary recurrence analysis: optimizing the size of recurrence neighbourhoods and identifying symbols from different realizations for sequence alignment. As possible solutions for these problems, we suggest a maximum entropy criterion and a Hausdorff clustering algorithm. The resulting recurrence domains for single-subject ERPs are obtained as partition cells reflecting quasi-stationary brain states.},
  doi      = {10.1098/rsta.2014.0089},
  eprint   = {https://royalsocietypublishing.org/doi/pdf/10.1098/rsta.2014.0089},
  groups   = {Journals},
  url      = {https://royalsocietypublishing.org/doi/abs/10.1098/rsta.2014.0089},
}

