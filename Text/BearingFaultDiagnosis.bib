  groups                  = {Journals},
  keywords                = {Entropy; Epicyclic gears; Failure analysis; Frequency estimation; Gear teeth; Modulation; Vibration analysis, Experimental investigations; Fault diagnosis method; Frequency demodulation; Instantaneous frequency; Instantaneous frequency estimation; Oscillatory components; Signal processing technique; Varying speed conditions, Fault detection, decomposition analysis; detection method; estimation method; Lotka-Volterra model; model; model validation; signal processing; vibration; wavelength; wind turbine},
