}

@Article{Kowalski2010a,
  author            = {Kowalski, Andres M. and Martin, Maria T. and Zunino, Luciano and Plastino, Angelo and Casas, Montserrat},
  journal           = {Entropy},
  title = {The quantum-classical transition as an information flow},
