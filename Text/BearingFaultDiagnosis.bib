  groups                  = {Journals},
  keywords                = {Bitcoin; Entropy; Maximum likelihood estimation, Akaike's information criterions; Bayesian information criterion; Entropy analysis; FIGARCH; Forbidden pattern; Garch modelling; Maximum-likelihood estimation; Model fit; Model-based OPC; Permutation entropy, Dynamics},
