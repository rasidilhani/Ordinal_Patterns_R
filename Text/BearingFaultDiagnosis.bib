}

@Article{Wu2021,
  author                  = {Wu, Q.},
  journal                 = {Nonlinear Dynamics},
  title = {Cascade-sine chaotification model for producing chaos},
  year                    = {2021},
  issn                    = {0924090X},
  note                    = {cited By 11},
  number                  = {3},
  pages = {2607--2620},
  volume                  = {106},
  abbrev_source_title = {Nonlinear Dyn},
  abstract                = {Motivated by the concept of cascade operator and sine enhanced model, this paper proposes a universal framework termed cascade-sine chaotification model (CSCM) for producing chaotic maps. The principle of the proposed method is to perform sine transformation on the outputs of the seed maps, and then cascade the results to construct new systems. Compared with one-dimensional (1D) nonlinear models, the CSCM can produce diverse chaotic maps with arbitrary dimensionality by combining existing seed maps. Moreover, the chaotic maps generated by CSCM possess extremely higher complexity and larger chaotic ranges than the seed maps. To verify the effectiveness of CSCM, four chaotic maps generated by CSCM are presented as examples, of which the dynamical properties are systematically analyzed. Simulation results indicate the generated systems perform robust hyperchaotic properties in a large parameter range. Finally, a pseudo-random number generator (PRNG) is introduced to investigate the practicability of CSCM and the test results demonstrate the randomness of the obtained chaotic sequences. © 2021, The Author(s), under exclusive licence to Springer Nature B.V.},
  affiliation             = {School of Internet, Anhui University, Hefei, 230601, China; National Engineering Research Center for Agro-Ecological Big Data Analysis and Application, Anhui University, Hefei, 230601, China},
  author_keywords         = {Cascade-sine chaotification model (CSCM); Chaotification; Pseudo-random number generator (PRNG); Sine map},
  coden                   = {NODYE},
  correspondence_address1 = {Wu, Q.; National Engineering Research Center for Agro-Ecological Big Data Analysis and Application, China; email: qiujiewu@ahu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1007/s11071-021-06885-3},
  groups                  = {Journals},
  keywords                = {Lyapunov methods; Number theory; Random number generation, Cascade-sine chaotification model; Chaotic map; Chaotification; Non-linear modelling; One-dimensional; Pseudo-random number generator; Pseudorandom number generators; Sine map; Sine transformation, Chaotic systems},
  language                = {English},
  publisher               = {Springer Science and Business Media B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85117326370&doi=10.1007%2fs11071-021-06885-3&partnerID=40&md5=1f97a9b06cf9c8ca4015f3fe77b3ef61},
}

