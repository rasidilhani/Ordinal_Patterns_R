@Article{Zhou2024g,
  author                  = {Zhou, X. and Yuan, R. and Lv, Y. and Li, B. and Fu, S. and Li, H.},
  journal                 = {IEEE Sensors Journal},
  title = {Hierarchical multiscale fluctuation-based symbolic fuzzy entropy: A novel tensor health indicator for mechanical fault diagnosis},
  year                    = {2024},
  issn                    = {1530437X},
  note                    = {cited By 0},
  abbrev_source_title = {IEEE Sensors J.},
  abstract                = {Fuzzy entropy (FE), a powerful tool for measuring the complexity of nonlinear time series, has been widely used in bearing fault diagnosis and health monitoring. However, FE measures complexity only at a single scale, failing to consider valuable information in large-scale features of time series and failing to consider both high and low frequency information. To address these limitations, a new tensor-based entropy method called Hierarchical multiscale fluctuation-based symbolic fuzzy entropy (HMFSFE) is proposed in this paper. The proposed HMFSFE uses wave symbols to quantify the complexity of time series and extract tensor features, enhancing anti-noise performance and computational efficiency. Additionally, the HMFSFE assesses the dynamic properties of vibration data across various hierarchical layers and scales to further enhance fault extraction from signals. Based on the superiorities of the HMFSFE in nonlinear feature extraction and unique feature representation, a bearing fault diagnosis method approach based on the HMFSFE and the convolutional neural network (CNN) was proposed. Through analysis of experimental bearing data and comparison with existing fault diagnosis methods, the experimental results demonstrate that the proposed diagnosis scheme excels in health status recognition and offers significant advantages in terms of diagnostic accuracy and stability. © 2001-2012 IEEE.},
  affiliation             = {Ministry Education, Wuhan University of Science and Technology, Key Laboratory of Metallurgical Equipment and Control Technology, China; Wuhan University of Science and Technology, Hubei Key Laboratory of Mechanical Transmission and Manufacturing Engineering, Wuhan, 430081, China; Cornell University, Laboratory for Intelligent Systems and Controls, Ithaca, NY 14850, United States},
  author_keywords         = {convolutional neural networks; Fault diagnosis; feature extraction; hierarchical multiscale fluctuation-based symbolic fuzzy entropy; tensor features},
  correspondence_address1 = {Yuan, R.; Ministry Education, China},
  document_type           = {Article},
  doi                     = {10.1109/JSEN.2024.3512654},
  groups                  = {Journals},
  keywords                = {Endocrinology; Image coding; Multilayer neural networks; Time series, Bearing fault diagnosis; Convolutional neural network; Fault diagnosis method; Faults diagnosis; Features extraction; Fuzzy entropy; Health indicators; Hierarchical multiscale fluctuation-based symbolic fuzzy entropy; Tensor feature; Times series, Tensors},
  language                = {English},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85212543983&doi=10.1109%2fJSEN.2024.3512654&partnerID=40&md5=7d114b5aea3d930fc88a2b211626fec7},
}

