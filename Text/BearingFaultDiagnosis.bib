  groups                  = {Journals},
  keywords                = {Chaotic systems; Lyapunov methods, Attractor periodic switching; Discrete maps; DSP implementation; Hyperchaotic; Hyperchaotic maps; Infinitely wide parameter range; Non-degenerate hyperchaotic; Parameter range; Periodic switching; Ultra-wide, Digital signal processing},
