@InProceedings{WOS:000345844100102,
  author                     = {del Campo, Sergio Martin and Albertsson, Kim and Nilsson, Joakim and Eliasson, Jens and Sandin, Fredrik},
  booktitle = {2013 IEEE INTERNATIONAL WORKSHOP ON MACHINE LEARNING FOR SIGNAL PROCESSING (MLSP)},
  title = {FPGA PROTOTYPE OF MACHINE LEARNING ANALOG-TO-FEATURE CONVERTER FOR EVENT-BASED SUCCINCT REPRESENTATION OF SIGNALS},
  year                       = {2013},
  address                    = {345 E 47TH ST, NEW YORK, NY 10017 USA},
  editor                     = {Sanei, S and Smaragdis, P and Nandi, A and Ho, ATS and Larsen, J},
  note                       = {23rd IEEE International Workshop on Machine Learning for Signal Processing (MLSP), Southampton, ENGLAND, SEP 22-25, 2013},
  organization               = {IEEE; IEEE Signal Proc Soc; Machine Learning Signal Proc Tech Comm},
  publisher                  = {IEEE},
  series                     = {IEEE International Workshop on Machine Learning for Signal Processing},
  abstract                   = {Sparse signal models with learned dictionaries of morphological features
   provide efficient codes in a variety of applications. Such models can be
   useful to reduce sensor data rates and simplify the communication,
   processing and analysis of information, provided that the algorithm can
   be realized in an efficient way and that the signal allows for sparse
   coding. In this paper we outline an FPGA prototype of a general purpose
   ``analog-to-feature converter{''}, which learns an overcomplete
   dictionary of features from the input signal using matching pursuit and
   a form of Hebbian learning. The resulting code is sparse, event-based
   and suitable for analysis with parallel and neuromorphic processors. We
   present results of two case studies. The first case is a blind source
   separation problem where features are learned from an artificial signal
   with known features. We demonstrate that the learned features are
   qualitatively consistent with the true features. In the second case,
   features are learned from ball-bearing vibration data. We find that
   vibration signals from bearings with faults have characteristic features
   and codes, and that the event-based code enable a reduction of the data
   rate by at least one order of magnitude.},
  affiliation                = {del Campo, SM (Corresponding Author), Lulea Univ Technol, SKF Univ Technol Ctr, S-97187 Lulea, Sweden. del Campo, Sergio Martin, Lulea Univ Technol, SKF Univ Technol Ctr, S-97187 Lulea, Sweden. Lulea Univ Technol, EISLAB, S-97187 Lulea, Sweden.},
