  publisher               = {MDPI},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85137826740&doi=10.3390%2fmath10173033&partnerID=40&md5=9e963d66e2e8cfa446e753ce97977da5},
}

@Article{Minati2022a,
  author                  = {Minati, L. and Bartels, J. and Li, C. and Frasca, M. and Ito, H.},
  journal                 = {Chaos, Solitons and Fractals},
  title = {Synchronization phenomena in dual-transistor spiking oscillators realized experimentally towards physical reservoirs},
  year                    = {2022},
  issn                    = {09600779},
  note                    = {cited By 11},
  volume                  = {162},
  abbrev_source_title = {Chaos Solitons Fractals},
  abstract                = {Transistor-based chaotic oscillators are known to realize highly diverse dynamics despite having elementary circuit topologies. This work investigates, numerically and experimentally using a ring network, a recently-introduced dual-transistor circuit that generates neural-like spike trains. A multitude of non-trivial effects are observed as a function of the supply voltage and coupling strength, including pattern formation under incomplete synchronization and sensitivity to additional long-distance links. Globally-applied noise exerts a synchronizing effect that interacts with the other control parameters. When the network is partitioned in halves at different levels of granularity, their interplay gives rise to adversarial route-to-synchronization phenomena. These results highlight the generative ability of this circuit and motivate its consideration towards the future realization of physical reservoirs. © 2022 Elsevier Ltd},
  affiliation             = {Nano Sensing Unit, Institute of Innovative Research, Tokyo Institute of Technology, Yokohama, 226-8503, Japan; Center for Mind/Brain Science (CIMeC), University of Trento, Trento, 38123, Italy; Department of Electrical Electronic and Computer Engineering, University of Catania, Catania, 95131, Italy; “A. Ruberti” Institute for Systems Analysis and Computer Science, National Research Council (IASI-CNR), Rome, 00185, Italy},
