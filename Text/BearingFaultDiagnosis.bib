@Article{Mastroeni2024,
  author                  = {Mastroeni, L. and Mazzoccoli, A. and Vellucci, P.},
  journal                 = {Chaos, Solitons and Fractals},
  title = {Wavelet entropy and complexity–entropy curves approach for energy commodity price predictability amid the transition to alternative energy sources},
  year                    = {2024},
  issn                    = {09600779},
  note                    = {cited By 2},
  volume                  = {184},
  abbrev_source_title = {Chaos Solitons Fractals},
  abstract                = {In recent years, energy commodities have emerged as pivotal and widely debated subjects, driven by their profound influence on the global economy and their intricate interconnections. Moreover, the challenges stemming from the predictability of energy commodity prices have become a prominent and intensifying focus of discussion. To this aim, in this paper, we employ wavelet analysis with an entropy approach to investigate and evaluate fluctuations, low-frequency events, and rare events in energy commodity prices and the consequent predictability of such time series. In particular, wavelet analysis can differentiate high-frequency from low-frequency movements in a time series, and entropy is a valuable mathematical tool used to evaluate the state of disorder, randomness, or uncertainty in a time series. Specifically, we employ Rényi Entropy instead of the Shannon entropy because it allows for enhanced consideration of low-frequency events and spikes in a time series. Therefore, to analyze the predictability of a series, we use Wavelet Rényi Entropy (WRE) and the Rényi complexity–entropy curves by combining the wavelet transform with Rényi entropy. Finally, we apply our analysis to real financial data, including energy commodities and indices that can describe the transition to alternative energy resources. © 2024 The Author(s)},
  affiliation             = {Department of Economics, Roma Tre University, Via Silvio d'Amico 7700145, Italy},
  art_number              = {115005},
  author_keywords         = {Greedy algorithm; Heisenberg uncertainty principle; Step functions; Waveform dictionary},
  coden                   = {CSFOE},
  correspondence_address1 = {Vellucci, P.; Department of Economics, Via Silvio d'Amico 77, Italy; email: pierluigi.vellucci@uniroma3.it},
  document_type           = {Article},
  doi                     = {10.1016/j.chaos.2024.115005},
  groups                  = {Journals},
  keywords                = {Costs; Economics; Energy resources; Time series analysis; Uncertainty analysis; Wavelet analysis; Wavelet transforms, Commodity prices; Energy commodity; Greedy algorithms; Heisenberg's Uncertainty principle; Lower frequencies; Renyi's entropy; Step-function; Times series; Waveform dictionary; Waveforms, Time series},
  language                = {English},
  publisher               = {Elsevier Ltd},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85193848535&doi=10.1016%2fj.chaos.2024.115005&partnerID=40&md5=372990af84cca27ebca2281926892937},
}

@Article{Kim2024,
  author                  = {Kim, J. and Lee, J. and Seo, J. and Ghim, Y.-C. and Lee, Y. and Na, Y.-S.},
  journal                 = {Plasma Physics and Controlled Fusion},
  title = {Enhancing disruption prediction through Bayesian neural network in KSTAR},
