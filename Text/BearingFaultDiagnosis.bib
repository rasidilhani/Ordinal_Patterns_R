}

@Article{Natiq2019,
  author                  = {Natiq, H. and Ariffin, M.R.K. and Said, M.R.M. and Banerjee, S.},
  journal                 = {Internet of Things (Netherlands)},
  title = {Enhancing the sensitivity of a chaos sensor for Internet of things},
  year                    = {2019},
  issn                    = {25426605},
  note                    = {cited By 15},
  volume                  = {7},
  abbrev_source_title = {Internet. Thing.},
  abstract                = {Implementing chaotic systems in various applications such as sensors and cryptography shows that the sensitivity and complexity of these systems are highly required. Beside that, many existing chaotic systems exhibit low sensitivity, limited chaotic or hyperchaotic behavior, and low complexity, and this can give a negative effect on the chaos-based sensors applications. To address this problems, we present a cosine chaotification technique to enhance the chaotic characteristics of discrete systems. The proposed technique applies the cosine function as nonlinear transform to the output of a discrete system. As a typical example, we apply it on the classical 2D Hénon map. Performance evaluations show that the proposed technique can change the chaotic and non-chaotic states of the 2D Hénon map to the hyperchaotic state with extremely high complexity performance. Additionally, sensitivity dependence results, such as cross-correlation coefficient, number of non-divergent trajectories, and the change of complexity demonstrate that the enhanced Hénon map has higher sensitivity than the classical map. That means, the proposed technique would be very useful to enhance the employed systems in chaos-based sensors applications. © 2019 Elsevier B.V.},
  affiliation             = {Institute for Mathematical Research, Universiti Putra Malaysia, Serdang, Malaysia; Malaysia-Italy Centre of Excellence for Mathematical Science, Universiti Putra Malaysia, Serdang, Malaysia; Department of Mathematics, Universiti Putra Malaysia, Serdang, Malaysia},
  art_number              = {100083},
  author_keywords         = {Chaotic attractor; Chaoticfication; Complexity; Hyperchaotic behavior},
  correspondence_address1 = {Banerjee, S.; Institute for Mathematical Research, Malaysia; email: santoban@gmail.com},
  document_type           = {Article},
  doi                     = {10.1016/j.iot.2019.100083},
  groups                  = {Journals},
  language                = {English},
  publisher               = {Elsevier B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85078473339&doi=10.1016%2fj.iot.2019.100083&partnerID=40&md5=bf11006df3731c236d06205edcac6871},
}

@Conference{Ivakhiv2019,
  author              = {Ivakhiv, O. and Nakonechnyi, M. and Viter, O. and Hladiy, G. and Shylinska, I. and Lendyuk, T.},
