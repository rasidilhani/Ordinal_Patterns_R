}

@Article{Scarpino2019,
  author                  = {Scarpino, S.V. and Petri, G.},
  journal                 = {Nature Communications},
  title = {On the predictability of infectious disease outbreaks},
  year                    = {2019},
  issn                    = {20411723},
  note                    = {cited By 151},
  number                  = {1},
  volume                  = {10},
  abbrev_source_title = {Nat. Commun.},
  abstract                = {Infectious disease outbreaks recapitulate biology: they emerge from the multi-level interaction of hosts, pathogens, and environment. Therefore, outbreak forecasting requires an integrative approach to modeling. While specific components of outbreaks are predictable, it remains unclear whether fundamental limits to outbreak prediction exist. Here, adopting permutation entropy as a model independent measure of predictability, we study the predictability of a diverse collection of outbreaks and identify a fundamental entropy barrier for disease time series forecasting. However, this barrier is often beyond the time scale of single outbreaks, implying prediction is likely to succeed. We show that forecast horizons vary by disease and that both shifting model structures and social network heterogeneity are likely mechanisms for differences in predictability. Our results highlight the importance of embracing dynamic modeling approaches, suggest challenges for performing model selection across long time series, and may relate more broadly to the predictability of complex adaptive systems. © 2019, The Author(s).},
  affiliation             = {Network Science Institute, Northeastern University, Boston, MA 02115, United States; Marine & Environmental Sciences, Northeastern University, Boston, MA 02115, United States; Physics, Northeastern University, Boston, MA 02115, United States; Health Sciences, Northeastern University, Boston, MA 02115, United States; Dharma Platform, Washington, DC 20005, United States; ISI Foundation, Turin, 10126, Italy; ISI Global Science Foundation, New York, NY 10018, United States},
  art_number              = {898},
  correspondence_address1 = {Scarpino, S.V.; ISI FoundationItaly; email: s.scarpino@northeastern.edu},
  document_type           = {Article},
  doi                     = {10.1038/s41467-019-08616-0},
  groups                  = {Journals},
  keywords                = {disease prevalence; entropy; infectious disease; infectivity; prediction; social network; time series, Article; Chlamydia; dengue; entropy; epidemic; forecasting; gonorrhea; hepatitis A; human; infection; influenza; measles; mumps; pertussis; poliomyelitis; prediction; secondary infection; social network; white noise; biological model; disease transmission; epidemic; procedures; statistical model; statistics and numerical data, Disease Outbreaks; Disease Transmission, Infectious; Forecasting; Humans; Models, Biological; Models, Statistical},
  language                = {English},
  publisher               = {Nature Publishing Group},
  pubmed_id               = {30796206},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85061869352&doi=10.1038%2fs41467-019-08616-0&partnerID=40&md5=ea7c55ac053cc227df46af6061062459},
}

@Article{Sigaki2019,
  author                  = {Sigaki, H.Y.D. and Perc, M. and Ribeiro, H.V.},
  journal                 = {Scientific Reports},
  title = {Clustering patterns in efficiency and the coming-of-age of the cryptocurrency market},
  year                    = {2019},
  issn                    = {20452322},
  note                    = {cited By 67},
  number                  = {1},
  volume                  = {9},
  abbrev_source_title = {Sci. Rep.},
  abstract                = {The efficient market hypothesis has far-reaching implications for financial trading and market stability. Whether or not cryptocurrencies are informationally efficient has therefore been the subject of intense recent investigation. Here, we use permutation entropy and statistical complexity over sliding time-windows of price log returns to quantify the dynamic efficiency of more than four hundred cryptocurrencies. We consider that a cryptocurrency is efficient within a time-window when these two complexity measures are statistically indistinguishable from their values obtained on randomly shuffled data. We find that 37% of the cryptocurrencies in our study stay efficient over 80% of the time, whereas 20% are informationally efficient in less than 20% of the time. Our results also show that the efficiency is not correlated with the market capitalization of the cryptocurrencies. A dynamic analysis of informational efficiency over time reveals clustering patterns in which different cryptocurrencies with similar temporal patterns form four clusters, and moreover, younger currencies in each group appear poised to follow the trend of their ‘elders’. The cryptocurrency market thus already shows notable adherence to the efficient market hypothesis, although data also reveals that the coming-of-age of digital currencies is in this regard still very much underway. © 2019, The Author(s).},
  affiliation             = {Departamento de Física, Universidade Estadual de Maringá, Maringá, PR 87020-900, Brazil; Faculty of Natural Sciences and Mathematics, University of Maribor, Koroška cesta 160, Maribor, SI-2000, Slovenia; Complexity Science Hub Vienna, Josefstädterstraße 39, Vienna, A-1080, Austria},
  art_number              = {1440},
  correspondence_address1 = {Perc, M.; Faculty of Natural Sciences and Mathematics, Koroška cesta 160, Slovenia; email: matjaz.perc@uni-mb.si},
  document_type           = {Article},
  doi                     = {10.1038/s41598-018-37773-3},
  groups                  = {Journals},
  keywords                = {aged; article; entropy; human; market},
  language                = {English},
  publisher               = {Nature Publishing Group},
  pubmed_id               = {30723248},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85061133533&doi=10.1038%2fs41598-018-37773-3&partnerID=40&md5=502f9b07c81becf262ae69d691e8ebe4},
}

@Article{Borovsky2019,
  author                  = {Borovsky, J.E. and Osmane, A.},
  journal                 = {Nonlinear Processes in Geophysics},
  title = {Compacting the description of a time-dependent multivariable system and its multivariable driver by reducing the state vectors to aggregate scalars: The Earth's solar-wind-driven magnetosphere},
  year                    = {2019},
  issn                    = {10235809},
  note                    = {cited By 13},
  number                  = {4},
  pages = {429--443},
  volume                  = {26},
  abbrev_source_title = {Nonlinear Processes Geophys.},
  abstract                = {Using the solar-wind-driven magnetosphere-ionosphere-thermosphere system, a methodology is developed to reduce a state-vector description of a time-dependent driven system to a composite scalar picture of the activity in the system. The technique uses canonical correlation analysis to reduce the time-dependent system and driver state vectors to time-dependent system and driver scalars, with the scalars describing the response in the system that is most-closely related to the driver. This reduced description has advantages: low noise, high prediction efficiency, linearity in the described system response to the driver, and compactness. The methodology identifies independent modes of reaction of a system to its driver. The analysis of the magnetospheric system is demonstrated. Using autocorrelation analysis, Jensen-Shannon complexity analysis, and permutation-entropy analysis the properties of the derived aggregate scalars are assessed and a new mode of reaction of the magnetosphere to the solar wind is found. This state-vector-reduction technique may be useful for other multivariable systems driven by multiple inputs. © 2019 Author(s).},
  affiliation             = {Center for Space Plasma Physics, Space Science Institute, Boulder, CO, United States; Department of Physics, University of Helsinki, Helsinki, Finland},
  correspondence_address1 = {Borovsky, J.E.; Center for Space Plasma Physics, United States; email: jborovsky@spacescience.org},
  document_type           = {Article},
  doi                     = {10.5194/npg-26-429-2019},
  groups                  = {Journals},
  keywords                = {correlation; ionosphere; linearity; magnetosphere; multivariate analysis; solar wind; thermosphere; vector},
  language                = {English},
  publisher               = {Copernicus GmbH},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85075615940&doi=10.5194%2fnpg-26-429-2019&partnerID=40&md5=e3ae57fd0800f8e332e236eca6216712},
}

@Article{Ji2019,
  author                  = {Ji, A. and Shang, P.},
  journal                 = {Physica A: Statistical Mechanics and its Applications},
  title = {Analysis of financial time series through forbidden patterns},
  year                    = {2019},
  issn                    = {03784371},
  note                    = {cited By 6},
  volume                  = {534},
  abbrev_source_title = {Phys A Stat Mech Appl},
  abstract                = {The forbidden pattern is consistently considered to be an instrument of discriminating the potentially deterministic time series from random one. As a complexity parameter, the forbidden pattern is valuable for the real-world time series since noise eliminations are not needed—it focuses on the comparison of adjacent values. In some cases, based on the permutation entropy and the Bandt–Pompe (BP) methodology, it turns to analogous results with the Lyapunov exponent, with faster calculation and better robustness, however. In this work, we use the approach of the number of forbidden patterns to distinguish completely random behavior and potentially deterministic dynamic system in the real world. In particular, we pay attention to the performance of the method in the financial time series. In addition, we are concerned about the effect of time delays on determinism of stock indices and make a discussion of the sensitivity of different stock indices to time delays. Moreover, in this paper we focus on the evolution of deterministic behavior, pointing out that it is effective to use this method to quantify the degree of determinism in different time states. We can see that the approach of the number of forbidden patterns has excellent characteristics in terms of capturing potential properties of financial systems. © 2019 Elsevier B.V.},
  affiliation             = {Department of Mathematics, School of Science, Beijing Jiaotong University, Beijing, 100044, China},
  art_number              = {122038},
  author_keywords         = {Forbidden patterns; Time delay; Time series analysis; Underlying determinism},
  coden                   = {PHYAD},
  correspondence_address1 = {Ji, A.; Department of Mathematics, China; email: 15271132@bjtu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.physa.2019.122038},
  groups                  = {Journals},
  keywords                = {Finance; Financial data processing; Lyapunov methods; Time delay, Deterministic behavior; Financial time series; Forbidden pattern; Lyapunov exponent; Permutation entropy; Potential property; Real-world time series; Underlying determinism, Time series analysis},
  language                = {English},
  publisher               = {Elsevier B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85069817770&doi=10.1016%2fj.physa.2019.122038&partnerID=40&md5=aadfcb9f8878e46b07e1f5da3ca94233},
}

@Article{Ravan2019b,
  author                  = {Ravan, M.},
  journal                 = {AIMS Electronics and Electrical Engineering},
  title = {A machine learning approach using {Eeg} signals to measure sleep quality},
  year                    = {2019},
  issn                    = {25781588},
  note                    = {cited By 9},
  number                  = {4},
  pages = {347--358},
  volume                  = {3},
  abbrev_source_title = {AIMS Electron. Electr.Eng.},
  abstract                = {Sleep quality has a vital effect on good health and well-being throughout a life. Getting enough sleep at the right times can help protect mental health, physical health, quality of life, and safety. In this study, an electroencephalography (EEG)-based machine-learning approach is proposed to measure sleep quality. The advantages of this approach over standard Polysomnography (PSG) method are: 1) it measures sleep quality by recognizing three sleep categories rather than five sleep stages, thus higher accuracy can be expected; 2) three sleep categories are recognized by analyzing EEG signals only, so the user experience is improved because fewer sensors are attached to the body during sleep. Using quantitative features obtained from EEG signals, we developed a new automatic sleep-staging framework that consists of a multi-class support vector machine (SVM) classification based on a decision tree approach. We used polysomnographic data from PhysioBank database to train and evaluate and test the performance of the framework, where the sleep stages have been visually annotated. The results demonstrated that the proposed approach achieves high classification performance, which helps to measure sleep quality accurately. This framework can provide a robust and accurate sleep quality assessment that helps clinicians to determine the presence and severity of sleep disorders, and also evaluate the efficacy of treatments. © 2019 the Author(s), licensee AIMS Press.},
  affiliation             = {Department of Electrical & Computer Engineering, New York Institute of Technology (NYIT), 1855 Broadway, New York, NY 10023, United States},
  author_keywords         = {Automatic sleep quality measurement; Dendrogram-support vector machine classifier; Electroencephalography (EEG); Machine learning; Time-frequency features},
  correspondence_address1 = {Ravan, M.; Department of Electrical & Computer Engineering, 1855 Broadway, United States; email: mravan@nyit.edu},
  document_type           = {Article},
  doi                     = {10.3934/ElectrEng.2019.4.347},
  groups                  = {Journals},
  keywords                = {Biomedical signal processing; Data visualization; Decision trees; Electrophysiology; Quality control; Sleep research; Support vector machines, Automatic sleep quality measurement; Dendrogram-support vector machine classifier; Dendrograms; Electroencephalography; Machine learning approaches; Machine-learning; Quality measurements; Sleep quality; Support vector machine classifiers; Time frequency features, Electroencephalography},
  language                = {English},
  publisher               = {American Institute of Mathematical Sciences},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85091198678&doi=10.3934%2fElectrEng.2019.4.347&partnerID=40&md5=c6eb1d0b52f4b68c9f1342e7f165f91d},
}

@Conference{Lu2019,
  author              = {Lu, P. and Liu, H.},
  title = {A transient power quality signal denoising method based on CEEMDAN and UWT},
  year                = {2019},
  editor              = {Wu W., Wang L., Ji C., Chen N., Qiang S., Song X., Wang X.},
  note                = {cited By 2},
  pages = {1095--1099},
  publisher           = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {Int. Conf. Syst. Inf., ICSAI},
  abstract            = {Aiming at power quality detection and noise pollution, in combination with complete ensemble empirical mode decomposition with adaptive noise (CEEMDAN), permutation entropy (PE) and wavelet threshold denoising based on undecimated wavelet transform (UWT), a transient power quality denoising method based on CEEMDAN and UWT is proposed. CEEMDAN decomposes the disturbance signal into a series of intrinsic mode function with single-component characteristics, UWT denoising is used to deal with the noise components screened out by PE and reconstruction to obtain the original signal after denoising. The method is implemented in LabVIEW and simulated independently, the results verify the effectiveness of the method. Finally, on the basis of PXI equipment, a detection device based on LabView is built, which provides a new idea for the development of power quality detection system. © 2019 IEEE.},
  affiliation         = {State Key Laboratory of Reliability and Intelligence of Electrical Equipment, School of Electrical Engineering, China; Key Laboratory of Electromagnetic Field and Electrical, Apparatus Reliability of Hebei Province (School of Electrical Engineering), Hebei University of Technology, Tianjin, China},
