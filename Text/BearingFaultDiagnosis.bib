@Article{Kim2023a,
  author                  = {Kim, S.-E. and Shin, C. and Yim, J. and Seo, K. and Ryu, H. and Choi, H. and Park, J. and Min, B.-K.},
  journal                 = {Frontiers in Psychiatry},
  title = {Resting-state electroencephalographic characteristics related to mild cognitive impairments},
  year                    = {2023},
  issn                    = {16640640},
  note                    = {cited By 6},
  volume                  = {14},
  abbrev_source_title = {Front. Psychiatry},
  abstract                = {Alzheimer's disease (AD) causes a rapid deterioration in cognitive and physical functions, including problem-solving, memory, language, and daily activities. Mild cognitive impairment (MCI) is considered a risk factor for AD, and early diagnosis and treatment of MCI may help slow the progression of AD. Electroencephalography (EEG) analysis has become an increasingly popular tool for developing biomarkers for MCI and AD diagnosis. Compared with healthy elderly, patients with AD showed very clear differences in EEG patterns, but it is inconclusive for MCI. This study aimed to investigate the resting-state EEG features of individuals with MCI (n = 12) and cognitively healthy controls (HC) (n = 13) with their eyes closed. EEG data were analyzed using spectral power, complexity, functional connectivity, and graph analysis. The results revealed no significant difference in EEG spectral power between the HC and MCI groups. However, we observed significant changes in brain complexity and networks in individuals with MCI compared with HC. Patients with MCI exhibited lower complexity in the middle temporal lobe, lower global efficiency in theta and alpha bands, higher local efficiency in the beta band, lower nodal efficiency in the frontal theta band, and less small-world network topology compared to the HC group. These observed differences may be related to underlying neuropathological alterations associated with MCI progression. The findings highlight the potential of network analysis as a promising tool for the diagnosis of MCI. Copyright © 2023 Kim, Shin, Yim, Seo, Ryu, Choi, Park and Min.},
  affiliation             = {Department of Applied Artificial Intelligence, Seoul National University of Science and Technology, Seoul, South Korea; Department of Applied Mathematics, Kongju National University, Gongju-si, South Korea; Graduate School of Technology and Innovation Management, Hanyang University, Seoul, South Korea; Department of Neurology, College of Medicine, Hanyang University, Seoul, South Korea; Department of Brain and Cognitive Engineering, Korea University, Seoul, South Korea},
  art_number              = {1231861},
  author_keywords         = {complexity; EEG; functional connectivity; graph analysis; mild cognitive impairment; spectral power},
  correspondence_address1 = {Park, J.; Department of Neurology, South Korea; email: jinspark@hanyang.ac.kr; Min, B.-K.; Department of Brain and Cognitive Engineering, South Korea; email: min_bk@korea.ac.kr},
  document_type           = {Article},
  doi                     = {10.3389/fpsyt.2023.1231861},
  groups                  = {Journals},
  keywords                = {aged; Alzheimer disease; Article; clinical dementia rating scale; cognition; controlled study; electroencephalography; entropy; female; functional connectivity; head injury; human; human experiment; major depression; male; medial temporal lobe; mild cognitive impairment; Mini Mental State Examination; nerve cell network; neuropathology; problem solving; resting state network; signal processing; substance abuse; time series analysis},
  language                = {English},
  publisher               = {Frontiers Media SA},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85172462247&doi=10.3389%2ffpsyt.2023.1231861&partnerID=40&md5=493ba6df7c5676a0eee68b14a7dec633},
}

@Article{Song2023b,
  author                  = {Song, E.Z. and Ren, C. and Ke, Y. and Yao, C.},
  journal                 = {Lecture Notes in Civil Engineering},
  title = {Study on Health Status Assessment Method of Injector Based on Hierarchical Weighted Permutation Entropy and Hidden Markov Model},
  year                    = {2023},
  issn                    = {23662557},
  note                    = {cited By 0},
  pages = {698--713},
  volume                  = {375 LNCE},
  abbrev_source_title = {Lect. Notes Civ. Eng.},
  abstract                = {For the features information of common rail injectors degradation process always weak or submerged by strong noise, which leads to the problem of low accuracy of health status evaluation, this paper combines the hierarchical weighted permutation entropy and hidden Markov models and builds the model to evaluate status of injector health. The model gives full consideration to the time sequence of signal characteristics and extracts the fault characteristic through hierarchical weighted permutation entropy. Then the hidden Markov model is established to judge the degradation state. Aiming at the question that it is hard to obtain the life cycle signal of common-rail injectors, the Mahalanobis distance is used to quantify the degradation degree of injectors. In addition, a health index suitable for common-rail injectors is proposed, and the health state space of injectors can be established without the life cycle data. In the health status evaluation of the fuel injector test stand, the model can reliably identify the state of the fuel injector degradation process, and improve the accuracy of state evaluation compared with other common methods. © 2023, Harbin Engineering University.},
  affiliation             = {Yantai Research Institute, Harbin Engineering University, Harbin, China},
  author_keywords         = {Health status assessment; Hidden Markov Model (HMM); Hierarchical Weighted Permutation Entropy (HWPE)},
  correspondence_address1 = {Ren, C.; Yantai Research Institute, China; email: rc980606@hrbeu.edu.cn},
  document_type           = {Conference Paper},
  doi                     = {10.1007/978-981-99-4291-6_49},
  editor                  = {Yang D.},
  groups                  = {Journals},
  isbn                    = {9789819942909},
  keywords                = {Entropy; Fuel injection; Hidden Markov models, Common rail injector; Degradation process; Fuel-injectors; Health status; Health status assessment; Hidden markov model; Hidden-Markov models; Hierarchical weighted permutation entropy; Permutation entropy; Status evaluations, Life cycle},
  language                = {English},
  publisher               = {Springer Science and Business Media Deutschland GmbH},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85172313096&doi=10.1007%2f978-981-99-4291-6_49&partnerID=40&md5=85724c4ad2cd7a48f30d1eb550128d27},
}

@Article{Xie2023a,
  author                  = {Xie, G. and Liu, S. and Li, X.},
  journal                 = {Journal of Hospitality and Tourism Research},
  title = {An Interval Decomposition-Ensemble Model for Tourism Forecasting},
  year                    = {2023},
  issn                    = {10963480},
  note                    = {cited By 3},
  abbrev_source_title = {J. Hosp. Tour. Res.},
  abstract                = {In order to accurately capture the variability of tourism demand, this paper proposed a new decomposition-ensemble framework for forecasting interval-valued time series (ITS) of tourism arrivals. The procedure consists of four main steps: ITS decomposition, determination of the optimal decomposition technique, component ITS forecasting, and ensemble. The investigation revealed the optimal theoretical approach for choosing the decomposition technique in terms of multi-scale complexity. In addition, a comparison was made between the performance of two types of models that predict the upper and lower limits of ITS separately versus simultaneously. Using the weekly ITSs of tourist arrivals to Mount Siguniang, in western China, and Hawaii, USA, during both COVID and non-COVID periods, an empirical study was conducted to illustrate the framework. The results demonstrated that the proposed model exhibits higher predictive accuracy and greater robustness, compared to other models. This indicates the model’s effectiveness in forecasting the ITS of tourism demand. © The Author(s) 2023.},
  affiliation             = {School of E-Business and Logistics, Beijing Technology and Business University, Beijing, China; Research Center for Consumption Big Data and Intelligent Decision-Making, Beijing Technology and Business University, China; Academy of Mathematics and Systems Science, Chinese Academy of Sciences, Beijing, China; School of Economics and Management, University of Science and Technology Beijing, China},
  author_keywords         = {decomposition-ensemble methodology; interval-valued time series; multi-scale complexity; multivariate decomposition; tourism demand forecasting},
  correspondence_address1 = {Xie, G.; School of E-Business and Logistics, China; email: gxie@amss.ac.cn},
  document_type           = {Article},
  doi                     = {10.1177/10963480231198539},
  groups                  = {Journals},
  language                = {English},
  publisher               = {SAGE Publications Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85171593051&doi=10.1177%2f10963480231198539&partnerID=40&md5=95ecf2059dd0dca9ec3292d08c998409},
}

@Article{Ding2023b,
  author                  = {Ding, L. and Ji, J. and Li, Y. and Wang, S. and Noman, K. and Feng, K.},
  journal                 = {IEEE Transactions on Instrumentation and Measurement},
  title = {A Novel Weak Feature Extraction Method for Rotating Machinery: Link Dispersion Entropy},
  year                    = {2023},
  issn                    = {00189456},
  note                    = {cited By 13},
  volume                  = {72},
  abbrev_source_title = {IEEE Trans. Instrum. Meas.},
  abstract                = {The entropy-based feature extraction is a promising tool for extracting weak features from rotating machinery. However, the existing research has paid little attention to the state transition process, which brings the problem of accuracy and comprehensiveness in complexity estimation. To address this issue, this article proposes link dispersion entropy (LDE) based on the theory of the Markov chain for weak feature extraction. By calculating the transition probability of symbol patterns, the LDE can extract the fault information contained in the transition, enabling it to capture the early weak fault. Furthermore, LDE is extended to a multiscale analysis by combining it with the coarse-gaining process for comprehensive feature extraction, termed multiscale LDE (MLDE). Finally, three simulated signals and two different experimental data are utilized to verify the advantage of MLDE in extracting the weak fault features. Results demonstrate that MLDE has the best performance in fault diagnosis of rotating machinery compared with the existing five methods, namely sample entropy (SE), fuzzy entropy (FE), permutation entropy (PE), dispersion entropy (DE), and symbolic dynamic entropy (SDE). © 1963-2012 IEEE.},
  affiliation             = {Northwestern Polytechnical University, School of Mechanics and Engineering, Xi'an, 710072, China; University of Technology Sydney, School of Mechanical and Mechatronic Engineering, Sydney, NSW 2007, Australia; Northwestern Polytechnical University, School of Aeronautics, Xi'an, 710072, China; Northwestern Polytechnical University, School of Civil Aviation, Xi'an, 710072, China; National University of Singapore, Department of Industrial Systems Engineering and Management, Cluny Road11576, Singapore},
  art_number              = {3532012},
  author_keywords         = {Complexity evaluation; fault diagnosis; feature extraction; link dispersion entropy (LDE); rotating machinery},
  coden                   = {IEIMA},
  correspondence_address1 = {Li, Y.; Northwestern Polytechnical University, China; email: yongbo@nwpu.edu.cn; Feng, K.; National University of Singapore, Cluny Road, Singapore; email: ke.feng@outlook.com.au},
  document_type           = {Article},
  doi                     = {10.1109/TIM.2023.3312483},
  groups                  = {Journals},
  keywords                = {Dispersions; Extraction; Failure analysis; Fault detection; Feature extraction; Markov processes; Rotating machinery; Time series analysis, Complexity evaluation; Complexity theory; Entropy-based; Faults diagnosis; Features extraction; Link dispersion entropy; Symbol; Time-series analysis; Weak faults, Entropy},
  language                = {English},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85171547357&doi=10.1109%2fTIM.2023.3312483&partnerID=40&md5=7a30ff063ba34d75ffd3bce9e902add0},
}

@Conference{Hua2023,
  author              = {Hua, J. and Zhang, Q. and Fang, Z.},
  title = {Fault Diagnosis Method of Rolling Bearing Based on Adaptive Cyclostationarity Blind Deconvolution},
  year                = {2023},
  note                = {cited By 0},
  pages = {697--704},
  publisher           = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {Int. Symp. Comput. Technol. Inf. Sci., ISCTIS},
  abstract            = {The vibration signals collected by sensors can be regarded as the convolution result of multiple interference factors and fault source signals, so the deconvolution method has certain advantages in signal processing. A fault diagnosis method for rolling bearings based on adaptive maximum second-order cyclostationary blind deconvolution (ACYCBD), improved arithmetic optimization algorithm (IAOA) and optimized support vector machine (SVM) is proposed. Firstly, the optimization criterion based on the least square envelope spectral dispersion entropy is constructed, and the optimal inverse filter parameters are solved by improved arithmetic optimization algorithm. Then, the optimal inverse filter is used for blind deconvolution of the fault signal, and the fault features of the filtered signal are extracted by multi-scale dispersion entropy to form feature vectors. Finally, the feature vector is input into the classification model. The hyperparameters of SVM are optimized by IAOA and train the best classification model and test it. The test results show that the proposed method can accurately and effectively identify the faulty kinds of bearings, and can maintain more than 90% accuracy even under noise pollution. © 2023 IEEE.},
  affiliation         = {School of Mechanical Engineering, Zhejiang University of Technology, Hangzhou, China; Ningbo Institute of Materials Technology and Engineering, Chinese Academy of Sciences, Ningbo, China},
  author_keywords     = {arithmetic optimization algorithm; maximum second-cyclostationarity blind deconvolution; rolling bearing; square envelope spectral dispersion entropy},
  document_type       = {Conference Paper},
  doi                 = {10.1109/ISCTIS58954.2023.10213113},
  groups              = {Conference},
  isbn                = {9798350325386},
  journal             = {2023 3rd International Symposium on Computer Technology and Information Science, ISCTIS 2023},
  keywords            = {Convolution; Dispersions; Failure analysis; Fault detection; Inverse problems; Optimization; Roller bearings; Signal processing; Support vector machines, Arithmetic optimization algorithm; Blind deconvolution; Cyclostationarity; Fault diagnosis method; Maximum second-cyclostationarity blind deconvolution; Optimization algorithms; Rolling bearings; Spectral dispersions; Square envelope spectral dispersion entropy; Support vectors machine, Entropy},
  language            = {English},
  source              = {Scopus},
  url                 = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85170291553&doi=10.1109%2fISCTIS58954.2023.10213113&partnerID=40&md5=5c0090707eb877018b47a15f7795a18e},
}

@Article{Liu2023k,
