  journal                 = {IEEE Advanced Information Technology, Electronic and Automation Control Conference (IAEAC)},
  keywords                = {Acoustic noise; Acoustic noise measurement; Entropy; Extraction; Frequency response; Ships; Variational mode decomposition, Amplitude-aware permutation entropy; Band-limited signal; Features extraction; Mel frequency cepstral co-efficient; Mel-frequency cepstral coefficients; Multi-scales; Multiscale entropy; Permutation entropy; Ship radiated noise; Ship's radiated noise, Feature extraction},
