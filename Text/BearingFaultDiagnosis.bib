  art_number              = {125997},
  author_keywords         = {Dissimilarity; Epilepsy; Heart rate; Ordinal pattern; Sleep stage classification},
  coden                   = {PHYAD},
  correspondence_address1 = {Wang, J.; School of Computer and Information Technology, China; email: wj@bjtu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.physa.2021.125997},
  groups                  = {Journals},
  keywords                = {Biomedical signal processing; Large scale systems; Neurology; Signal analysis, Dissimilarity; Dissimilarity measures; Healthy subjects; Heart-rate; Linear methods; Non-linear methods; Ordinal pattern; Physiological signals; Sleep stages classifications; Underlying dynamics, Heart},
  language                = {English},
