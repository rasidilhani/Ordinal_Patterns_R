  journal             = {2020 Asia-Pacific Signal and Information Processing Association Annual Summit and Conference, APSIPA ASC 2020 - Proceedings},
  keywords            = {Entropy; Time series, Different time scale; Fractional brownian motion; Multivariate time series; Permutation entropy; Real-world; Real-world problem; Univariate, Brownian movement},
  language            = {English},
  source              = {Scopus},
  url                 = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85100936038&partnerID=40&md5=981465cbbec2df757b3aef96e3bb3caf},
}

@Article{Kratzer2020,
  author                  = {Kratzer, S. and Schneider, M. and Obert, D.P. and Schneider, G. and García, P.S. and Kreuzer, M.},
  journal                 = {Frontiers in Systems Neuroscience},
  title = {Age-Related {Eeg} Features of Bursting Activity During Anesthetic-Induced Burst Suppression},
  year                    = {2020},
  issn                    = {16625137},
  note                    = {cited By 14},
  volume                  = {14},
  abbrev_source_title = {Front. Syst. Neurosci.},
  abstract                = {Electroencephalographic (EEG) Burst Suppression (BSUPP) is a discontinuous pattern characterized by episodes of low voltage disrupted by bursts of cortical synaptic activity. It can occur while delivering high-dose anesthesia. Current research suggests an association between BSUPP and the occurrence of postoperative delirium in the post-anesthesia care unit (PACU) and beyond. We investigated burst micro-architecture to further understand how age influences the neurophysiology of this pharmacologically-induced state. We analyzed a subset of EEG recordings (n = 102) taken from a larger data set previously published. We selected the initial burst that followed a visually identified “silent second,” i.e., at least 1 s of iso-electricity of the EEG during propofol induction. We derived the (normalized) power spectral density [(n)PSD], the alpha band power, the maximum amplitude, the maximum slope of the EEG as well as the permutation entropy (PeEn) for the first 1.5 s of the initial burst of each patient. In the old patients >65 years, we observed significantly lower (p < 0.001) EEG power in the 1–15 Hz range. In general, their EEG contained a significantly higher amount of faster oscillations (>15 Hz). Alpha band power (p < 0.001), EEG amplitude (p = 0.001), and maximum EEG slope (p = 0.045) all significantly decreased with age, whereas PeEn increased (p = 0.008). Hence, we can describe an age-related change in features during EEG burst suppression. Sub-group analysis revealed no change in results based on pre-medication. These EEG changes add knowledge to the impact of age on cortical synaptic activity. In addition to a reduction in EEG amplitude, age-associated burst features can complicate the identification of excessive anesthetic administration in patients under general anesthesia. Knowledge of these neurophysiologic changes may not only improve anesthesia care through improved detection of burst suppression but might also provide insight into changes in neuronal network organization in patients at risk for age-related neurocognitive problems. © Copyright © 2020 Kratzer, Schneider, Obert, Schneider, García and Kreuzer.},
  affiliation             = {Department of Anesthesiology and Intensive Care Medicine, School of Medicine, Technical University Munich, Munich, Germany; Department of Anesthesiology, Columbia University, New York, NY, United States},
  art_number              = {599962},
  author_keywords         = {burst suppression; elderly; electroencephalography (EEG); general anesthesia; monitoring},
  correspondence_address1 = {Kreuzer, M.; Department of Anesthesiology and Intensive Care Medicine, Germany; email: m.kreuzer@tum.de},
  document_type           = {Article},
  doi                     = {10.3389/fnsys.2020.599962},
  groups                  = {Journals},
  keywords                = {midazolam; propofol, action potential amplitude; adult; aged; aging; American Society of Anaesthesiologists score; anesthesia induction; area under the curve; Article; burst suppression; cognition; controlled study; diagnostic test accuracy study; electroencephalography; entropy; female; general anesthesia; human; linear regression analysis; major clinical study; male; nerve cell network; oscillation; pattern recognition; receiver operating characteristic; recovery room; retrospective study; spectroscopy; synaptic transmission},
  language                = {English},
  publisher               = {Frontiers Media S.A.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85097832061&doi=10.3389%2ffnsys.2020.599962&partnerID=40&md5=b82e3e081de9a4d1a3bea3218b669c13},
}

@Article{Lee2020,
  author                  = {Lee, H. and Wang, S. and Hudetz, A.G.},
  journal                 = {Journal of Neuroscience},
  title = {State-dependent cortical unit activity reflects dynamic brain state transitions in anesthesia},
  year                    = {2020},
  issn                    = {02706474},
  note                    = {cited By 16},
  number                  = {49},
  pages = {9440--9454},
  volume                  = {40},
  abbrev_source_title = {J. Neurosci.},
  abstract                = {Understanding the effects of anesthesia on cortical neuronal spiking and information transfer could help illuminate the neuronal basis of the conscious state. Recent investigations suggest that the brain state identified by local field potential spectrum is not stationary but changes spontaneously at a fixed level of anesthetic concentration. How cortical unit activity changes with dynamically transitioning brain states under anesthesia is unclear. Extracellular unit activity was measured with 64-channel silicon microelectrode arrays in cortical layers 5/6 of the primary visual cortex of chronically instrumented, freely moving male rats (n=7) during stepwise reduction of the anesthetic desflurane (6%, 4%, 2%, and 0%). Unsupervised machine learning applied to multiunit spike patterns revealed five distinct brain states. A novel desynchronized brain state with increased spike rate variability, sample entropy, and EMG activity occurred in 6% desflurane with 40.0% frequency. The other four brain states reflected graded levels of anesthesia. As anesthesia deepened the spike rate of neurons decreased regardless of their spike rate profile at baseline conscious state. Actively firing neurons with wide-spiking pattern showed increased bursting activity along with increased spike timing variability, unit-to-population correlation, and unit-to-unit transfer entropy, despite the overall decrease in transfer entropy. The narrow-spiking neurons showed similar changes but to a lesser degree. These results suggest that (1) anesthetic effect on spike rate is distinct from sleep, (2) synchronously fragmented spiking pattern is a signature of anesthetic-induced unconsciousness, and (3) the paradoxical, desynchronized brain state in deep anesthesia contends the generally presumed monotonic, dose-dependent anesthetic effect on the brain. Copyright © 2020 the authors},
  affiliation             = {Center for Consciousness Science, Department of Anesthesiology, University of Michigan, Ann Arbor, MI 48105, United States},
  author_keywords         = {Anesthesia; Consciousness; Functional connectivity; Neural network; Spike dynamics; Synchronization},
  coden                   = {JNRSD},
  correspondence_address1 = {Hudetz, A.G.; Center for Consciousness Science, United States; email: ahudetz@umich.edu},
  document_type           = {Article},
  doi                     = {10.1523/JNEUROSCI.0601-20.2020},
  groups                  = {Journals},
  keywords                = {desflurane; desflurane; inhalation anesthetic agent, adult; anesthesia; animal cell; animal experiment; Article; brain function; brain state transition; burst activity; cell population; consciousness; controlled study; cortex layer V; cortex layer VI; cortical unit activity; drug effect; electroencephalogram; electromyogram; entropy; firing rate; frequency; machine learning; male; nonhuman; priority journal; rat; spike; spike rate; spike wave; striate cortex; unconsciousness; animal; brain; brain cortex; dose response; drug effect; electrode implant; electroencephalography; electromyography; electrophysiology; extracellular space; Long Evans rat; nerve cell; pathophysiology; physiology; sleep; Sprague Dawley rat, Anesthesia; Anesthetics, Inhalation; Animals; Brain; Cerebral Cortex; Desflurane; Dose-Response Relationship, Drug; Electrodes, Implanted; Electroencephalography; Electromyography; Electrophysiological Phenomena; Entropy; Extracellular Space; Male; Neurons; Rats; Rats, Long-Evans; Rats, Sprague-Dawley; Sleep; Unconsciousness},
  language                = {English},
  publisher               = {Society for Neuroscience},
  pubmed_id               = {33122389},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85097161450&doi=10.1523%2fJNEUROSCI.0601-20.2020&partnerID=40&md5=cf0711c0462c8fcae2c400a423e30c53},
}

@Conference{Deka2020,
  author                  = {Deka, D. and Deka, B.},
  title = {Computer-aided Detection of Congestive Heart Failure based on Nonlinear HRV Features},
  year                    = {2020},
  note                    = {cited By 1},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {Proc. IEEE Int. Conf. Mach. Learn. Appl. Netw. Technol., ICMLANT},
  abstract                = {The aim of this study is to present an automated system for accurate detection of congestive heart failure (CHF) patients. Considering the intrinsic nonlinear characteristics of HRV signal, its fractal behaviour and dynamical complexity in case of CHF and normal subjects are assessed. To this end, multi-fractal analysis and wavelet packet based complexity analysis is performed. A total of 538 features are extracted, from which the top ranked 15 features are selected based on Mann-Whitney U test and correlation coefficient measures. The classification performance of SVM classifier for multiple kernel functions, namely linear, polynomial, radial basis function (RBF), tanh, Sigmoid, and rectified linear unit (ReLU) functions are examined. On cross-validation using leave-one-subject-out technique, it is found that ReLU based SVM classifier have performed the best with an accuracy of 97.72%, sensitivity of 97.93%, specificity of 97.33%, and Mathews correlation coefficient of 0.949. © 2020 IEEE.},
  affiliation             = {Central Institute of Technology, Department of Instrumentation Engineering, Kokrajhar, India; Tezpur University, Department of Electronics and Communication Engineering, Tezpur, India},
  art_number              = {9355706},
  author_keywords         = {Congestive heart failure; heart rate variability; nonlinear analysis; support vector machine},
  correspondence_address1 = {Deka, B.; Tezpur University, India; email: bdeka@tezu.ernet.in},
  document_type           = {Conference Paper},
  doi                     = {10.1109/ICMLANT50963.2020.9355706},
  groups                  = {Conference},
  isbn                    = {9781728188850},
  journal                 = {Proceedings of the 2020 IEEE International Conference on Machine Learning and Applied Network Technologies, ICMLANT 2020},
  keywords                = {Automation; Cardiology; Complex networks; Failure (mechanical); Fractals; Support vector machines, Classification performance; Complexity analysis; Computer aided detection; Congestive heart failures; Correlation coefficient; Dynamical complexity; Nonlinear characteristics; Radial Basis Function(RBF), Learning systems},
  language                = {English},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85102170452&doi=10.1109%2fICMLANT50963.2020.9355706&partnerID=40&md5=1eedfd64faf24d109810544065f94e3e},
}

@Article{MendozaRuiz2020,
  author                  = {Mendoza-Ruiz, J. and Alonso-Malaver, C.E. and Valderrama, M. and Rosso, O.A. and Martinez, J.H.},
  journal                 = {Chaos},
  title = {Dynamics in cortical activity revealed by resting-state MEG rhythms},
  year                    = {2020},
  issn                    = {10541500},
  note                    = {cited By 4},
  number                  = {12},
  volume                  = {30},
  abbrev_source_title = {Chaos},
  abstract                = {The brain is a biophysical system subject to information flows that may be thought of as a many-body architecture with a spatiotemporal dynamics described by its neuronal structures. The oscillatory nature of brain activity allows these structures (nodes) to be described as a set of coupled oscillators forming a network where the node dynamics and that of the network topology can be studied. Quantifying its dynamics at various scales is an issue that claims to be explored for several brain activities, e.g., activity at rest. The resting-state (RS) associates the underlying brain dynamics of healthy subjects that are not actively compromised with sensory or cognitive processes. Studying its dynamics is highly non-trivial but opens the door to understand the general principles of brain functioning, as well as to contrast a passive null condition vs the dynamics of pathologies or non-resting activities. Here, we hypothesize about how the spatiotemporal dynamics of cortical fluctuations could be for healthy subjects at RS. To do that, we retrieve the alphabet that reconstructs the dynamics (entropy-complexity) of magnetoencephalography (MEG) signals. We assemble the cortical connectivity to elicit the dynamics in the network topology. We depict an order relation between entropy and complexity for frequency bands that is ubiquitous for different temporal scales. We unveiled that the posterior cortex conglomerates nodes with both stronger dynamics and high clustering for α band. The existence of an order relation between dynamic properties suggests an emergent phenomenon characteristic of each band. Interestingly, we find the posterior cortex as a domain of dual character that plays a cardinal role in both the dynamics and structure regarding the activity at rest. To the best of our knowledge, this is the first study with MEG involving information theory and network science to better understand the dynamics and structure of brain activity at rest for different bands and scales. © 2020 Author(s).},
  affiliation             = {Department of Statistics, Universidad Nacional de Colombia, Cr 45 # 26-85, Bogotá, Colombia; Department of Biomedical Engineering, Universidad de los Andes, Cr 1 # 18A-12, Bogotá, Colombia; Instituto de Física, Universidade Federal de Alagoas (UFAL), BR 104 Norte km 97, Maceió, Alagoas, 57072-970, Brazil; Instituto de Física Interdisciplinar y Sistemas Complejos, IFISC (CSIC-UIB), Campus Universitat de les Illes Balears, Palma de Mallorca, E-07122, Spain},
  art_number              = {123138},
  correspondence_address1 = {Martinez, J.H.; Department of Biomedical Engineering, Cr 1 # 18A-12, Colombia; email: johemart@gmail.com},
  document_type           = {Article},
  doi                     = {10.1063/5.0025189},
  groups                  = {Journals},
  keywords                = {brain; brain mapping; human; information science; magnetoencephalography; nerve cell, Brain; Brain Mapping; Humans; Information Theory; Magnetoencephalography; Neurons},
  language                = {English},
  publisher               = {American Institute of Physics Inc.},
  pubmed_id               = {33380010},
