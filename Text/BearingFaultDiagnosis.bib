  keywords            = {Differential equations; Electroencephalography; Lyapunov functions; Lyapunov methods; Neurophysiology; Robots, Brain activity analysis; Brain activity patterns; Educational robotics; Electro-encephalogram (EEG); epilepsy; Hardware and software; Lyapunov exponent; Preprocessing modules, Brain},
