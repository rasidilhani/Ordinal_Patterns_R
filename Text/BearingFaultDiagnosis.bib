  coden                   = {CSDAD},
  correspondence_address1 = {Matilla-García, M.; Departamento de Economía Aplicada y Estadística, Spain; email: mmatilla@cee.uned.es},
  document_type           = {Article},
  doi                     = {10.1016/j.csda.2021.107381},
  groups                  = {Journals},
  keywords                = {Sampling; Testing; Time series analysis, Data set; Non-parametric analysis; Nonparametric tests; Ordering structure; Ordinal pattern; Ordinal time series; Real-valued time series; Serial dependence; Times series, Time series},
  language                = {English},
