  art_number              = {112951},
  author_keywords         = {Accelerometer shock testing; CEEMD; CNN-LSTM; Laser Doppler velocimeter; Signal denoising},
  coden                   = {MSRMD},
  correspondence_address1 = {Zhang, Z.; School of Mechatronical Engineering, China; email: zhzhang@bit.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.measurement.2023.112951},
  groups                  = {Journals},
  keywords                = {Accelerometers; Classifiers; Doppler effect; Laser Doppler velocimeters; Long short-term memory; Signal denoising; Velocity measurement, Accelerometer shock testing; Complementary ensemble empirical mode decomposition; Convolutional neural network; Convolutional neural network with long short-term memory; Denoising methods; Empirical Mode Decomposition; High-G accelerometers; Measurement accuracy; Reference velocity; Splittings, Empirical mode decomposition},
  language                = {English},
