  groups                  = {Journals},
  keywords                = {Carbon; Electric power transmission; Energy utilization; Frequency domain analysis; Fuel economy; Risk management, Carbon markets; Fuel markets; High renewable energy consumption; Information spillovers; Major events; Market Power; Renewable energy consumption; Time frequency domain; Transmission mechanisms; Withholding capacity, Fossil fuels, electricity generation; emissions trading; fossil fuel; research work; spillover effect; time dependent behavior},
  language                = {English},
