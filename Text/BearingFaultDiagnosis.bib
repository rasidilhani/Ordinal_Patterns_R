  groups                  = {Journals},
  keywords                = {Calculations; Chaos theory; Dynamics, BVP oscillators; Complex dynamics; Discrete modeling; DSP platforms; Dynamical behaviors; Fractional calculus; Fractional order; Nonlinear conductance, Dynamical systems},
  language                = {English},
