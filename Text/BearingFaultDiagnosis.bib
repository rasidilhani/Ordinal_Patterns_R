  document_type           = {Article},
  doi                     = {10.1016/j.psychres.2024.116100},
  groups                  = {Journals},
  keywords                = {aged; Article; attention deficit hyperactivity disorder; behavior assessment; child; cognition; cognitive processing therapy; conceptual framework; demographics; DSM-5; electroencephalogram; electroencephalography; electrophysiology; entropy; false discovery rate; female; functional connectivity; genetic heterogeneity; human; independent component analysis; interview; major clinical study; male; neuropsychological assessment; preschool child; task performance; brain; connectome; diagnostic imaging; electroencephalography; pathophysiology; physiology; processing speed, Attention Deficit Disorder with Hyperactivity; Brain; Child; Child, Preschool; Cognition; Connectome; Electroencephalography; Female; Humans; Male; Processing Speed},
