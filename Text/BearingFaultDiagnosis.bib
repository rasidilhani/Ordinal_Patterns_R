  correspondence_address1 = {Toledano-Ayala, M.; Faculty of Engineering, Mexico; email: toledano@uaq.mx},
  document_type           = {Article},
  doi                     = {10.3390/s20010009},
  groups                  = {Journals},
  keywords                = {Electrocardiography; Entropy; Fractals, ECG signals; Empirical Mode Decomposition; Higuchi fractal value; Nonlinear measurement; Novel methodology; Permutation entropy; Sudden cardiac deaths; Sudden cardiac deaths (SCD), Signal processing, adolescent; adult; aged; analysis of variance; electrocardiography; entropy; female; human; male; middle aged; pathology; procedures; sudden cardiac death; very elderly; young adult, Adolescent; Adult; Aged; Aged, 80 and over; Analysis of Variance; Death, Sudden, Cardiac; Electrocardiography; Entropy; Female; Humans; Male; Middle Aged; Neural Networks, Computer; Young Adult},
  language                = {English},
  publisher               = {MDPI AG},
  pubmed_id               = {31861320},
