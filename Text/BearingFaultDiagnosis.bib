  journal             = {Proceedings of the International Joint Conference on Neural Networks},
  keywords            = {Bioelectric phenomena; Genetic algorithms; Informatics; Nearest neighbor search; Neural networks; Neurophysiology; Support vector machines, Classification models; Computational approach; Computational technique; Epileptic seizures; K nearest neighbours (k-NN); Neural network (nn); Statistical features; Subjective rating, Brain},
  language            = {English},
