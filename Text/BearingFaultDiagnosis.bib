  document_type           = {Article},
  doi                     = {10.1016/j.bja.2019.06.004},
  groups                  = {Journals},
  keywords                = {dexmedetomidine; propofol; sevoflurane; anesthetic agent, anesthesia level; Article; clinical article; controlled study; electroencephalogram; entropy; feature selection; female; human; male; priority journal; scoring system; sedation; anesthesia level; drug effect; electroencephalography; frontal lobe; machine learning; reference value; reproducibility; wakefulness, Anesthetics; Consciousness Monitors; Electroencephalography; Frontal Lobe; Humans; Machine Learning; Reference Values; Reproducibility of Results; Wakefulness},
