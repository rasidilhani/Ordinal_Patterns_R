}

@Article{Gromov2023,
  author                  = {Gromov, V.A. and Dang, Q.N.},
  journal                 = {Chaos, Solitons and Fractals},
  title = {Semantic and sentiment trajectories of literary masterpieces},
  year                    = {2023},
  issn                    = {09600779},
  note                    = {cited By 2},
  volume                  = {175},
  abbrev_source_title = {Chaos Solitons Fractals},
  abstract                = {The paper deals with semantic and sentiment trajectories of literary masterpieces (we used corpora of 12 languages of various language families), composed of individual embeddings or n-grams. We ascertain that, for all languages, semantic and sentiment trajectories are markedly chaotic: positive largest Lyapunov exponents; ‘entropy-complexity’ pairs belonging to the ‘chaotic’ area of the respective plane; the distinctive ‘chaotic’ drop of the number of false nearest neighbours at a particular value of an embedding dimension. The Russian language turns out to be more ‘chaotic’ than, for example, the English one; we attribute this fact to the free order of words. The Esperanto language, for various ‘approaches’ to different Indo-European languages. The results do not corroborate its claim to be equidistant from all languages. However, it seems to be equidistant from all Indo-European languages. These characteristics are utilised in order to develop a method to compare styles of an original masterpiece and its translations (to automatically assess translation quality). It appears that machine translations are still worse than human ones, however, for example, the Facebook translation is comparable with them. © 2023},
  affiliation             = {HSE University, Russian Federation},
  art_number              = {113934},
  author_keywords         = {Chaotic time series; Literature masterpieces; Natural language as a whole; Quality of machine translation; Semantic trajectories; Sentiment trajectories},
  coden                   = {CSFOE},
  correspondence_address1 = {Gromov, V.A.; HSE UniversityRussian Federation; email: stroller@rambler.ru},
  document_type           = {Article},
  doi                     = {10.1016/j.chaos.2023.113934},
  groups                  = {Journals},
  keywords                = {Computational linguistics; Computer aided language translation; Embeddings; Lyapunov methods; Machine translation; Semantics, Chaotic time series; Chaotics; European languages; Literature masterpiece; Machine translations; Natural language as a whole; Natural languages; Quality of machine translation; Semantic trajectories; Sentiment trajectory, Trajectories},
  language                = {English},
  publisher               = {Elsevier Ltd},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85168003711&doi=10.1016%2fj.chaos.2023.113934&partnerID=40&md5=11e4754fec56f173d045698cb19a3d5a},
