@Article{Shahriari2020,
  author                  = {Shahriari, Z. and Small, M.},
  journal                 = {International Journal of Bifurcation and Chaos},
  title = {Permutation Entropy of State Transition Networks to Detect Synchronization},
  year                    = {2020},
  issn                    = {02181274},
  note                    = {cited By 8},
  number                  = {10},
  volume                  = {30},
  abbrev_source_title = {Int. J. Bifurcation Chaos},
  abstract                = {The dynamic behavior of many physical, biological, and other systems, are organized according to the synchronization of chaotic oscillators. In this paper, we have proposed a new method with low sensitivity to noise for detecting synchronization by mapping time series to complex networks, called the ordinal partition network, and calculating the permutation entropy of that structure. We show that this method can detect different kinds of synchronization such as complete synchronization, phase synchronization, and generalized synchronization. In all cases, the estimated permutation entropy decreases with increased synchronization. This method is also capable of estimating the topology of the network graph from the time series, without knowledge of the dynamical equations of individual nodes. This approach has been applied for the two identical and nonidentical coupled Rössler systems, two nonidentical coupled Lorenz systems, and a ring of coupled Lorenz96 oscillators. © 2020 World Scientific Publishing Company.},
  affiliation             = {Complex Systems Group, Department of Mathematics and Statistics, University of Western Australia, Crawley, WA 6009, Australia; Mineral Resources, Csiro, Kensington, WA 6151, Australia},
  art_number              = {2050154},
  author_keywords         = {chaotic systems; Network synchronization; nonlinear dynamics; permutation entropy; time series},
  correspondence_address1 = {Shahriari, Z.; Complex Systems Group, Australia; email: zahra0shahriari@gmail.com},
  document_type           = {Article},
  doi                     = {10.1142/S0218127420501540},
  groups                  = {Journals},
  keywords                = {Circuit oscillations; Complex networks; Entropy; Time series; Topology, Chaotic oscillators; Complete synchronization; Coupled Lorenz systems; Dynamic behaviors; Dynamical equation; Generalized synchronization; Permutation entropy; Phase synchronization, Synchronization},
  language                = {English},
  publisher               = {World Scientific Publishing Co. Pte Ltd},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85090832674&doi=10.1142%2fS0218127420501540&partnerID=40&md5=357f0e3c2488a6c4bc3574e96d76fea4},
}

