@Conference{Zhang2021l,
  author                  = {Zhang, J. and Wang, C. and Gui, P. and Wang, M. and Zou, T.},
  title = {State Assessment of Rolling Bearings Based on the Multiscale Bubble Entropy},
  year                    = {2021},
