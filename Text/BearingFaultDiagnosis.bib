@Article{Waschke2025,
  author                  = {Waschke, L. and Kamp, F. and van den Elzen, E. and Krishna, S. and Lindenberger, U. and Rutishauser, U. and Garrett, D.D.},
  journal                 = {Nature Communications},
  title = {Single-neuron spiking variability in hippocampus dynamically tracks sensory content during memory formation in humans},
  year                    = {2025},
  issn                    = {20411723},
  note                    = {cited By 0},
  number                  = {1},
  volume                  = {16},
  abbrev_source_title = {Nat. Commun.},
  abstract                = {During memory formation, the hippocampus is presumed to represent the content of stimuli, but how it does so is unknown. Using computational modelling and human single-neuron recordings, we show that the more precisely hippocampal spiking variability tracks the composite features of each individual stimulus, the better those stimuli are later remembered. We propose that moment-to-moment spiking variability may provide a new window into how the hippocampus constructs memories from the building blocks of our sensory world. © The Author(s) 2024.},
