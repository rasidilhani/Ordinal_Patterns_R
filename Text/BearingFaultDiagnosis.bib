@Article{Liu2022d,
  author                  = {Liu, L. and Wei, Z.X. and Xiang, H.},
  journal                 = {Multimedia Tools and Applications},
  title = {A novel image encryption algorithm based on compound-coupled logistic chaotic map},
  year                    = {2022},
  issn                    = {13807501},
  note                    = {cited By 7},
  number                  = {14},
  pages = {19999--20019},
  volume                  = {81},
  abbrev_source_title = {Multimedia Tools Appl},
  abstract                = {Chaos has been widely used in many different kinds of scientific fields, especially in the field of cryptography. While most of the original chaotic systems are not complex and secure enough for practical uses, therefore, in this paper, a novel compounding coupling technique is firstly proposed to enhance the complexity of chaotic systems. The provided compound-coupled chaotic model is universal for all different chaotic maps. Here, to prove the validity of the proposed model, 1D Logistic map, the most widely used chaotic map, is taken as the example. Then a series of numerical experiments were conducted to compare and analyze the maps before and after improvement. From the results, it’s obvious that the improved map has higher dynamical complexity than the original one. Furthermore, a novel image encryption algorithm based on the compound-coupled Logistic map is proposed to prove the practicability of the improvement model. Sufficient experimental tests indicate that this encryption algorithm has a high security level, which can be competitive to other chaos-based image encryption algorithms. © 2022, The Author(s), under exclusive licence to Springer Science+Business Media, LLC, part of Springer Nature.},
