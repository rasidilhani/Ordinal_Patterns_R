  doi                     = {10.17116/jnevro2022122071106},
  groups                  = {Journals},
  keywords                = {brain; depression; electroencephalography; entropy; human, Brain; Depression; Electroencephalography; Entropy; Humans},
  language                = {Russian},
  publisher               = {Media Sphera Publishing Group},
