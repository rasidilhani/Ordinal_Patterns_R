  groups                  = {Journals},
  keywords                = {Circuit oscillations; Transistors, +i; 05.45.; 84.35.; A; Ac; Chaos generation; Pattern formation; Reservoir Computing; Spiking dynamic; Tp; Xt, Synchronization},
  language                = {English},
