@Conference{Lei2022b,
  author                  = {Lei, Q. and Che, K. and Gao, F. and Xie, G. and Han, N.},
  title = {Fault diagnosis of rolling bearings based on improved multiscale diversity entropy (MDE)},
  year                    = {2022},
  note                    = {cited By 0},
  pages = {181--185},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {Proc. - Youth Acad. Annu. Conf. Chin. Assoc. Autom., YAC},
  abstract                = {In multiscale diversity entropy (MDE), after multiscale coarse-grained reorganization, the data distance between the reconstructed subsequences is too close, and the difference decreases after average operation, the feature extracted by this coarse-grained method is not conducive to fault classification. To solve this problem, in this study, an improvement on the multiscale coarse-graining process by adding a sliding factor is proposed, and a reasonable range of sliding factor value is set according to the value of scale factor. Under the same scale factor, the original sequence is coarsely reconstructed by using multiple values within the value range of the sliding factor, then multiple entropy values are calculated, finally, average the MDE entropy value calculated for many times as the result. Such coarsening method avoids the distance between data too close or too far, and makes entropy calculation more accurate. The fault diagnosis framework of coarse-grained improved MDE combined with extreme learning machine (ELM) and support vector machine (SVM) respectively is constructed, and the algorithm is verified with German Paderborn bearing data set. Compared with MDE, the diagnosis accuracy of coarsegrained improved MDE combined with the same machine learning method has increased significantly. © 2022 IEEE.},
  affiliation             = {Xi'An University of Technology, School of Automation and Information Engineering, Xi'an, China},
  author_keywords         = {coarse-grained; fault diagnosis; Multiscale diversity entropy; rolling bearings},
  correspondence_address1 = {Lei, Q.; Xi'An University of Technology, China; email: 1365043929@qq.com},
  document_type           = {Conference Paper},
  doi                     = {10.1109/YAC57282.2022.10023780},
  groups                  = {Conference},
  isbn                    = {9781665465366},
  journal                 = {Proceedings - 2022 37th Youth Academic Annual Conference of Chinese Association of Automation, YAC 2022},
  keywords                = {Coarsening; Failure analysis; Fault detection; Learning systems; Roller bearings; Support vector machines, Coarse Graining; Coarse-grained; Coarsenings; Entropy value; Fault classification; Faults diagnosis; Multiscale diversity entropy; Reorganisation; Rolling bearings; Scale Factor, Entropy},
  language                = {English},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85147931466&doi=10.1109%2fYAC57282.2022.10023780&partnerID=40&md5=6cbb99eda0337e2b44a4a7460e339d1a},
}

