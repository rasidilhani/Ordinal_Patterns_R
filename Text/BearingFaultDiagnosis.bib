  groups                  = {Journals},
  keywords                = {Computational complexity; Entropy; Finance; Financial data processing, Dynamic change detection; Financial time series; Fractional multiscale phase permutation entropy; Multiscale weighted phase permutation entropy; Nonlinear time series; Permutation entropy; Phases transformation; Stock indices, Time series},
