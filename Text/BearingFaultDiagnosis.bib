  correspondence_address1 = {Kumar, D.; Department of Computer Science and Engineering, Uttarakhand, India; email: d_kumar@cs.iitr.ac.in},
  document_type           = {Article},
  doi                     = {10.1016/j.bspc.2024.106609},
  groups                  = {Journals},
  keywords                = {Behavioral research; Forecasting; Learning systems; Network architecture; Physiology; Pipelines, Attention mechanisms; Big five; Big five personality trait; Dual-pipelines; Human behavior analysis; Multihead; Multihead attention; Personality traits; Physiological signals; Symbolic Dynamics, Long short-term memory, Article; attention; dynamics; electrocardiogram; electrocardiography; electrodermal response; electroencephalogram; electroencephalography; extraversion; feature extraction; human; long short term memory network; machine learning; neurosis; personality; prediction; temporal attention},
  language                = {English},
