@Article{Siddagangaiah2020,
  author                  = {Siddagangaiah, S. and Chen, C.-F. and Hu, W.-C. and Akamatsu, T. and McElligott, M. and Lammers, M.O. and Pieretti, N.},
  journal                 = {Ecological Indicators},
  title = {Automatic detection of dolphin whistles and clicks based on entropy approach},
  year                    = {2020},
  issn                    = {1470160X},
  note                    = {cited By 19},
  volume                  = {117},
  abbrev_source_title = {Ecol. Indic.},
  abstract                = {Long-term monitoring of cetacean vocalizations allows for the exploration of their occurrence, seasonality and abundance. However, accurate automatic detection of vocalizations from vast acoustic datasets containing diverse sound sources remains a challenge. In this study, we propose the permutation entropy (H) and the sample entropy (SE) as metrics for the unattended detection of whistles and clicks. We tested the detection performance of whistles and clicks in various scenarios commonly occurring in marine habitats, including dense snapping shrimps, vessel engine noise and overlapping whistles and clicks. The use of the entropy metrics resulted in detection accuracy of over 95%. In particular, H outcomes correctly detected whistles even if associated with snapping shrimps or engine noise, while SE was a reliable indicator for clicks and robust to vessel noise. These algorithms do not require prior training in vocalization and are computationally fast. The advancement of metrics such as those presented here, will enable non-invasive and cost-effective assessment of cetacean population dynamics and health and may inform future conservation management. © 2020 The Authors},
  affiliation             = {Underwater Acoustic Laboratory, Department of Engineering Sciences and Ocean Engineering, National Taiwan University, Taipei, Taiwan; Sasakawa Peace Foundation Ocean Policy Research Institute Tokyo, Japan; Hawaiʻi Institute of Marine Biology, University of Hawaiʻi at Mānoa, United States; Oceanwide Science Institute, Honolulu, HI, United States; Department of Life and Environmental Sciences, Polytechnic University of Marche, Ancona, Italy},
  art_number              = {106559},
  author_keywords         = {Acoustic indices; Complexity; Eastern Taiwan Strait; Honolua Bay; Passive Acoustic Monitoring},
  correspondence_address1 = {Siddagangaiah, S.; Underwater Acoustic Laboratory, Taiwan; email: shashi.18j@gmail.com},
  document_type           = {Article},
  doi                     = {10.1016/j.ecolind.2020.106559},
  groups                  = {Journals},
  keywords                = {Acoustic noise; Cost effectiveness; Engines; Entropy, Automatic Detection; Conservation management; Detection accuracy; Detection performance; Entropy approach; Entropy metrics; Long term monitoring; Permutation entropy, Signaling, accuracy assessment; algorithm; biomonitoring; detection method; dolphin; entropy; exploration; population dynamics; seasonality; vocalization, Alpheidae; Cetacea},
  language                = {English},
  publisher               = {Elsevier B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85086725642&doi=10.1016%2fj.ecolind.2020.106559&partnerID=40&md5=130e14828184c2259d1e764e3e0f2dd6},
}

@Article{Zhang2020c,
  author                  = {Zhang, B. and Shang, P.},
  journal                 = {Communications in Nonlinear Science and Numerical Simulation},
  title = {Measuring information transfer by dispersion transfer entropy},
  year                    = {2020},
  issn                    = {10075704},
  note                    = {cited By 9},
  volume                  = {89},
  abbrev_source_title = {Comm. Nonlinear Sci. Numer. Simul.},
  abstract                = {In this paper, we propose a novel technique, called dispersion transfer entropy(DTE), to determine the information transfer and causal relation in the analysis of complex systems. Symbolization is used to solve the computational burden and noise sensitivity. To deal with the two major issues in symbolization, generating partition and information loss, we use the Ragwitz criterion to dynamically select parameters and utilize dispersion pattern to keep influential information. Moreover, we extend DTE into the multivariate system and propose dispersion multivariate transfer entropy(DMTE), dispersion multivariate transfer entropy curve(DMTEC) and dispersion partial transfer entropy(DPTE). DMTE greatly weakens the influence of synchronicity and similarity in data on information transfer detection, which is a breakthrough in solving the limitation of transfer entropy. DMTEC shows the evolution of causal relation over time and DPTE measures the direct causal effect between systems. These statistics can be combined to obtain a more comprehensive and accurate measurement of causality for multivariable systems. Also, we apply these methods to simulation data as well as stock markets to verify the effectiveness of our methods. © 2020 Elsevier B.V.},
  affiliation             = {Department of Mathematics, School of Science, Beijing Jiaotong University, Beijing, 100044, China},
  art_number              = {105329},
  author_keywords         = {Correlation; Financial time series; Information flow; Transfer entropy},
  correspondence_address1 = {Zhang, B.; Department of Mathematics, China; email: 19118020@bjtu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.cnsns.2020.105329},
  groups                  = {Journals},
  keywords                = {Curve fitting; Entropy; Financial data processing; Multivariable systems, Causal relations; Computational burden; Correlation; Financial time series; Information flows; Information transfers; Noise sensitivity; Novel techniques; Transfer entropy; Transfer relations, Dispersions},
  language                = {English},
  publisher               = {Elsevier B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85084602020&doi=10.1016%2fj.cnsns.2020.105329&partnerID=40&md5=a27527b4678f4d2b44ac400f3f685839},
}

@Article{Bao2020,
  author                  = {Bao, X. and Li, Q. and Wu, T. and Deng, Y. and Hu, M. and Zeng, R.},
  journal                 = {Optics Communications},
  title = {WDM-based bidirectional chaotic communication for semiconductor lasers system with time delay concealment},
  year                    = {2020},
  issn                    = {00304018},
  note                    = {cited By 13},
  volume                  = {472},
  abbrev_source_title = {Opt Commun},
  abstract                = {In this paper, we propose a wavelength-division-multiplexing (WDM)-based chaos communication configuration allowing for the bidirectional exchange of information. In the scheme, the output of a master semiconductor laser (MSL), is injected into slave semiconductor lasers (SSLs), drives the chaotic synchronization of SSLs with optical feedback and electro-optical phase feedback. By calculating the largest Lyapunov exponent (LLE), Lempel–Ziv complexity (LZC) and permutation entropy (PE), we find that the system can generate the chaotic signal with high complexity. We also demonstrate that the chaotic signal bandwidth obtained is as high as 24.68 GHz by selecting the suitable parameters; this configuration intrinsically conceals the electro-optical phase feedback time delay signature (TDS) and optical feedback TDS in transmitted variable; this delayed chaotic dynamics are identically synchronized when the parameters of emitter are exactly matched with that of receiver; while the external and internal parameters’ mismatch between emitter and receiver can lead to the decrease of the synchronization quality. In addition, the result reveals that the channel spacing has influence on cross-correlation coefficient (XCF) quantifying synchronization quality. At last, the messages introduced at two ends of the link can be successfully encrypted and decrypted, and we quantitatively analyze the corresponding Q-factor at different transmission rates. © 2020},
  affiliation             = {Institute of communication and Information Systems, College of communication, Hangzhou Dianzi University, Hangzhou, 310018, China},
  art_number              = {125868},
  author_keywords         = {All-optical network; Bandwidth; Optical chaos; Semiconductor lasers; Time delay signature concealment},
  coden                   = {OPCOB},
  correspondence_address1 = {Li, Q.; Institute of communication and Information Systems, China; email: liqiliang@sina.com},
  document_type           = {Article},
  doi                     = {10.1016/j.optcom.2020.125868},
  groups                  = {Journals},
  keywords                = {Chaotic systems; Lyapunov methods; Optical feedback; Q factor measurement; Signal receivers; Synchronization; Time delay; Timing circuits, Chaos communications; Chaotic communications; Chaotic synchronization; Cross-correlation coefficient; Exchange of information; Internal parameters; Largest Lyapunov exponent; Permutation entropy, Semiconductor lasers},
  language                = {English},
  publisher               = {Elsevier B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85083340579&doi=10.1016%2fj.optcom.2020.125868&partnerID=40&md5=61b972e2fbc38be99c99621b2ce25ba0},
}

@Article{Shang2020a,
  author                  = {Shang, D. and Shang, P.},
  journal                 = {Communications in Nonlinear Science and Numerical Simulation},
  title = {The Fisher-DisEn plane: A novel approach to distinguish different complex systems},
  year                    = {2020},
  issn                    = {10075704},
