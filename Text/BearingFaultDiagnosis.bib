  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85162146682&doi=10.1007%2fs11571-023-09984-6&partnerID=40&md5=9920a6ba83a5cc1e5d335d1bf25fd03c},
}

@Article{Kilpua2024,
  author                  = {Kilpua, E.K.J. and Good, S. and Ala-Lahti, M. and Osmane, A. and Koikkalainen, V.},
  journal                 = {Annales Geophysicae},
  title = {Permutation entropy and complexity analysis of large-scale solar wind structures and streams},
  year                    = {2024},
  issn                    = {09927689},
  note                    = {cited By 0},
  number                  = {1},
  pages = {163--177},
  volume                  = {42},
  abbrev_source_title = {Ann. Geophys.},
  abstract                = {In this work, we perform a statistical study of magnetic field fluctuations in the solar wind at 1ĝ€¯au using permutation entropy and complexity analysis and the investigation of the temporal variations of the Hurst exponents. Slow and fast wind, magnetic clouds, interplanetary coronal mass ejection (ICME)-driven sheath regions, and slow-fast stream interaction regions (SIRs) have been investigated separately. Our key finding is that there are significant differences in permutation entropy and complexity values between the solar wind types at larger timescales and little difference at small timescales. Differences become more distinct with increasing timescales, suggesting that smaller-scale turbulent features are more universal. At larger timescales, the analysis method can be used to identify localised spatial structures. We found that, except in magnetic clouds, fluctuations are largely anti-persistent and that the Hurst exponents, in particular in compressive structures (sheaths and SIRs), exhibit a clear locality. Our results shows that, in all cases apart from magnetic clouds at the largest scales, solar wind fluctuations are stochastic, with the fast wind having the highest entropies and low complexities. Magnetic clouds, in turn, exhibit the lowest entropy and highest complexity, consistent with them being coherent structures in which the magnetic field components vary in an ordered manner. SIRs, slow wind and ICME sheaths are intermediate in relation to magnetic clouds and fast wind, reflecting the increasingly ordered structure. Our results also indicate that permutation entropy-complexity analysis is a useful tool for characterising the solar wind and investigating the nature of its fluctuations. © Author(s) 2024 Emilia K. J. Kilpua et al.},
  affiliation             = {Department Of Physics, University Of Helsinki, P.O. Box 64, Helsinki, 00014, Finland; Department Of Climate And Space Sciences And Engineering, University Of Michigan, 2455 Hayward St., Ann Arbor, MI 48109-2143, United States},
  correspondence_address1 = {Kilpua, E.K.J.; Department Of Physics, P.O. Box 64, Finland; email: emilia.kilpua@helsinki.fi},
  document_type           = {Article},
  doi                     = {10.5194/angeo-42-163-2024},
  groups                  = {Journals},
  keywords                = {cloud; complexity; entropy; magnetic field; solar wind; temporal variation},
  language                = {English},
  publisher               = {Copernicus Publications},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85194490891&doi=10.5194%2fangeo-42-163-2024&partnerID=40&md5=eacbf7450703979d23ee5e54d74d5a13},
}

@Article{Kong2024,
  author                  = {Kong, C. and Jin, Y. and Li, G.},
  journal                 = {Energy and Buildings},
  title = {Innovative hybrid prediction method integrating wavelet threshold decomposition and entropy-based model selection strategy for building energy consumption prediction},
  year                    = {2024},
  issn                    = {03787788},
  note                    = {cited By 1},
  volume                  = {311},
  abbrev_source_title = {Energy Build.},
  abstract                = {Building energy prediction plays a pivotal role in the building energy management system, and an efficient prediction method is crucial to ensure the effective operation of building systems. Existing research enhances prediction accuracy by combining decomposition algorithms with prediction methods to separate non-stationary information from the original sequence. However, the decomposition process and the subsequent prediction of multiple decomposed subsequences result in significant time overhead, making it unsuitable for scenarios with high temporal requirements, such as short-term energy consumption forecasting. Additionally, a single prediction model struggles to adapt to the diverse features of decomposed subsequences, creating prediction accuracy and efficiency bottlenecks. Addressing these challenges, this study proposes a hybrid prediction method that combines wavelet threshold decomposition (WTD) with an entropy-based model selection strategy. The method initially utilizes the efficient WTD algorithm to decompose the original energy consumption data into three fixed subsequences. Subsequently, the permutation entropy for each subsequence is computed, and based on the comprehensive performance of four prediction models (ANN, LSTM, CNN-LSTM, and TCN) on sequences with different entropy values, the optimal prediction model is selected. Finally, the prediction results of the subsequences are aggregated to obtain the ultimate prediction outcome. Experimental results demonstrate that the proposed method significantly outperforms baseline methods in both prediction speed and accuracy across five real building energy consumption datasets with distinct operational modes. © 2024 Elsevier B.V.},
  affiliation             = {School of Engineering Science, University of Science and Technology of China, Anhui, Hefei, 230026, China; Department of Thermal Science and Energy Engineering, University of Science and Technology of China, 96 Jinzhai Road, Hefei, 230026, China},
  art_number              = {114169},
  author_keywords         = {Building energy prediction; Deep learning; Hybrid methods; Permutation entropy; Wavelet threshold decomposition},
  coden                   = {ENEBD},
  correspondence_address1 = {Jin, Y.; School of Engineering Science, Anhui, China; email: jinyi08@ustc.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.enbuild.2024.114169},
  groups                  = {Journals},
  keywords                = {Energy efficiency; Energy management systems; Energy utilization; Entropy; Long short-term memory; Wavelet decomposition, Building energy; Building energy prediction; Deep learning; Energy prediction; Hybrid method; Permutation entropy; Prediction methods; Threshold decomposition; Wavelet threshold; Wavelet threshold decomposition, Forecasting},
  language                = {English},
  publisher               = {Elsevier Ltd},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85190306511&doi=10.1016%2fj.enbuild.2024.114169&partnerID=40&md5=55b103fe16a126f6e0ed11e99b2f608c},
}

@Article{CardosoPereira2024,
  author                  = {Cardoso-Pereira, I. and Borges, J.B. and Viana, A.C. and Loureiro, A.A.F. and Ramos, H.S.},
  journal                 = {IEEE Internet of Things Journal},
  title = {POPAyI: Muscling Ordinal Patterns for Low-Complex and Usability-Aware Transportation Mode Detection},
  year                    = {2024},
  issn                    = {23274662},
  note                    = {cited By 0},
  number                  = {10},
  pages = {17170--17183},
  volume                  = {11},
  abbrev_source_title = {IEEE Internet Things J.},
  abstract                = {Detecting transportation modes' usability in spatiotemporal urban trajectories can provide valuable insights into the mobility preferences of urban populations, helping epidemic prevention and urban quality-of-life improvement. With this goal, we introduce polar ordinal patterns with amplitude information (POPAyI), a strategy that bases its design on the ordinal pattern (OP) transformation applied to mobility-related time series. POPAyI can quantify time-series dynamics with a low-complex cost, muscling time series' characteristics without the need for high computational and methodological complexities as the current machine learning (ML) and deep learning (DL) literature. POPAyI uses polar representation and captures amplitude information in time series, bringing the multivariate capability to the standard 1-D OP transformation. Our experiments show that POPAyI: 1) perfectly adapts to multidimensional mobility time series and natural nonlinear mobility behavior and 2) presents consistent detection results in any considered number of transportation mode's classes with efficiency in terms of storage and computation complexity, using fewer features than ML approaches and computational resources than DL methods, e.g., reaching 10000 fewer parameters than a lightweight DL approach while increasing by 3% the F1-score. © 2014 IEEE.},
  affiliation             = {Federal University of Minas Gerais, Department of Computer Science, Belo Horizonte, 31270-901, Brazil; Federal University of Rio Grande Do Norte, Department of Computing and Technology, Natal, 59078-970, Brazil; Inria, Paris, 75012, France},
  author_keywords         = {Multivariate ordinal patterns (OPs); pattern recognition; time series classification; transportation mode detection (TMD)},
  correspondence_address1 = {Cardoso-Pereira, I.; Federal University of Minas Gerais, Brazil; email: isadoracardoso@dcc.ufmg.br},
  document_type           = {Article},
  doi                     = {10.1109/JIOT.2024.3357632},
  groups                  = {Journals},
  keywords                = {Deep learning; Internet of things; Time series analysis; Trajectories; Urban transportation, Features extraction; Mode detection; Multivariate ordinal pattern; Ordinal pattern; Time series classifications; Time-series analysis; Times series; Transportation mode; Transportation mode detection; Vehicle's dynamics, Feature extraction},
  language                = {English},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85183943287&doi=10.1109%2fJIOT.2024.3357632&partnerID=40&md5=73f6343db51af73547541ad030dcefb2},
}

@Article{Xu2024c,
  author              = {Xu, S. and He, M. and Jia, W.},
  journal             = {Zhendong yu Chongji/Journal of Vibration and Shock},
  title = {Dynamical complexity of a bistable energy harvesting system under Poisson white noise excitation [泊松白噪声激励下双稳态能量采集系统的动力学复杂性研究]},
  year                = {2024},
  issn                = {10003835},
  note                = {cited By 0},
  number              = {10},
  pages               = {123-131 and 148},
  volume              = {43},
  abbrev_source_title = {J Vib Shock},
  abstract            = {The dynamic complexity of a bistable energy harvesting system under the combined effect of Poisson white noise and periodic signals was depicted by statistical complexity. Considering the complex statistical properties of Poisson white noise, firstly, the Bandt-Pompt algorithm was used to construct the residence time interval of the response of the bistable energy harvesting system, based on which the statistical complexity and standard Shannon entropy of the system were obtained. Then, the mean square voltage and effective output power of the system were calculated by numerical methods. Finally, the effects of the Poisson white noise, coupling coefficient, damping coefficient and periodic signal on the dynamics complexity and energy harvesting efficiency of the system were analyzed in detail. The results show that the non-monotonic evolution trend of the statistical complexity curve and the standard Shannon entropy curve indicates that the stochastic resonance phenomenon is generated in the system, and the selection of appropriate system parameters can promote the stochastic resonance behavior, at this time, the dynamical complexity of the system reaches maximum. In addition, the change trends of the mean square voltage and effective output power with the change of parameters are consistent with the evolutionary behavior of the statistical complexity curves, and when the stochastic resonance behavior occurs, the system has the highest energy harvesting efficiency. © 2024 Chinese Vibration Engineering Society. All rights reserved.},
  affiliation         = {School of Mathematics and Physics, Lanzhou Jiaotong University, Lanzhou, 730070, China; School of Mathematics and Statistics, Northwestern Polytechnical University, Xian, 710072, China},
