  groups                  = {Journals},
  keywords                = {Dynamical systems; Electrocardiograms; Harmonic analysis; Multivariant analysis; Real time systems; Time series analysis, Dynamical system analysis; Hard c-means; Hard c-means clustering algorithms; Multivariate time series; Nonlinear time-series analysis; One-dimensional time series; Real-world system; Time-series data; Times series; Transition network, Clustering algorithms},
