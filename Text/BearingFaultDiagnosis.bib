  keywords                = {Cable stayed bridges; Forecasting; Gas engineering; Geology; Monitoring; Soil mechanics; Time series, Combination method; Degree of randomness; Engineering applications; Model-based OPC; Number of components; Permutation entropy; Strain monitoring; Time series theories, Autoregressive moving average model},
  language                = {English},
