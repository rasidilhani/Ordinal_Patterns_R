  art_number              = {5930},
  author_keywords         = {Community-dwelling elderly; Fall risk; Features; Inertial sensor; Multiscale entropy; Permutation entropy; Random forest; Short form berg balance scale (SFBBS); Timed up and go (TUG)},
  correspondence_address1 = {Sun, T.-L.; Department of Industrial Engineering and Management, 135 Yuan Tung Road, Chungli District, Taiwan; email: tsun@saturn.yzu.edu.tw},
