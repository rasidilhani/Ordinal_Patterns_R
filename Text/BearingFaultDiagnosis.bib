  author                  = {Fernandes, L.H.S. and de Araujo, F.H.A. and Tabak, B.M.},
  journal                 = {Physica A: Statistical Mechanics and its Applications},
  title = {Insights from the (in)efficiency of Chinese sectoral indices during COVID-19},
