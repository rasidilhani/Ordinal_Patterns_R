  groups                  = {Journals},
  keywords                = {Fiber lasers; Locks (fasteners); Mode-locked fiber lasers; Random processes; Rotation; Solitons, Birefringents; Intensity distribution; Orthogonal polarizations; Peak values; Permutation entropy; Polarization components; Polarization rotation; Soliton bunches; Soliton intensity; Time interval, Polarization},
  language                = {English},
  publisher               = {Academic Press Inc.},
