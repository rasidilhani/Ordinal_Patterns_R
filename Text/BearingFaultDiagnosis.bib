  art_number              = {110516},
  author_keywords         = {Class-aware mean discrepancy; Contrastive adversarial network; Data augmentation; Dynamic fault-semantic embedding; Pipeline fault diagnosis},
  coden                   = {KNSYE},
  correspondence_address1 = {Dong, H.; Sanya Offshore Oil & Gas Research Institute, China; email: shiningdhl@vip.126.com},
