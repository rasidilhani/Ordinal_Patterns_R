}

@Article{Valdez2024,
  author                  = {Valdez, Z.I. and Díaz, L.A. and Vizcardo Cornejo, M. and Ravelo-García, A.G.},
  journal                 = {Biomedical Physics and Engineering Express},
  title = {A Permutation Entropy analysis to determine significant daily intervals to improve risk stratification tasks from COVID patients},
  year                    = {2024},
  issn                    = {20571976},
  note                    = {cited By 0},
  number                  = {2},
  volume                  = {10},
  abbrev_source_title = {Biomed. Phys. Eng. Express},
  abstract                = {SARS-CoV-2 infection has a wide range of clinical manifestations making its diagnosis difficult, which is an important problem to solve. We evaluated heart rate data extracted from the Stanford University database. The data set considers heart rate and step records of 118 patients, where 90 correspond to healthy individuals and 28 patients with COVID. Each daily record was divided into 5-minute segments, providing 288 data per patient. The date of symptom onset was considered as a reference point to extract subsets of data whose variability was considerable, such as 30 days before the date and 30 days after it. Each of the 60 segments of 288 data per patient was treated using Permutation Entropy, Approximate Entropy, Spectral Entropy and Singular Value Decomposition Entropy. The average of the data from each group was used to construct the circadian profiles which were analyzed using the Mann-Whitney-Wilcoxon test, determining the most relevant 5-minute segments, whose p-value was less than 0.05. In this way, the Spectral Entropy was discarded as it did not show any significantly different segment. The efficiency of the method was reflected in the performance of a logistic model for binary classification proposed in this work, which reflected an accuracy of 94.12% in the PE case, 88% in the ApEn case and 94% in the SVDE case. The proposed analysis turns out to be highly efficient when detecting significant segments that allow improving the classification tasks carried out by Machine Learning models, which provides a basis for the study of statistics such as entropy to delimit databases and improve the performance of classifier models. © 2024 IOP Publishing Ltd},
  affiliation             = {Escuela de Física, Universidad Nacional de San Agustin de Arequipa, Av. Independencia s/n, Arequipa, Arequipa, 04002, Peru; Departmento de Señales y Comunicaciones, Universidad Las Palmas de Gran Canaria, Campus Tafira, Las Palmas de Gran Canaria, Las Palmas, 35017, Spain},
  art_number              = {025010},
  author_keywords         = {Covid-19; permutation entropy; risk stratification},
  correspondence_address1 = {Vizcardo Cornejo, M.; Escuela de Física, Av. Independencia s/n, Arequipa, Peru; email: mvizcardoc@unsa.edu.pe},
  document_type           = {Article},
  doi                     = {10.1088/2057-1976/ad1d0a},
  groups                  = {Journals},
  keywords                = {Classification (of information); Coronavirus; Data mining; Diagnosis; Heart; Patient treatment; Risk assessment; Singular value decomposition; Spectrum analysis, Clinical manifestation; Covid-19; Data set; Entropy analysis; Healthy individuals; Heart-rate; Permutation entropy; Risk stratification; Spectral entropy; Stanford University, Entropy, Article; binary classification; coronavirus disease 2019; data processing; diagnostic test accuracy study; entropy; female; heart rate; heart rate variability; human; human experiment; machine learning; major clinical study; male; normal human; singular value decomposition; entropy; risk assessment; Severe acute respiratory syndrome coronavirus 2, COVID-19; Entropy; Humans; Risk Assessment; SARS-CoV-2},
  language                = {English},
