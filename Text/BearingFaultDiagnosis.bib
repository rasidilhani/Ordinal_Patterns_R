@InProceedings{WOS:000459864800144,
  author                     = {Liu, Guozeng and Li, Haiping and Liu, Wei},
  booktitle = {2018 PROGNOSTICS AND SYSTEM HEALTH MANAGEMENT CONFERENCE (PHM-CHONGQING 2018)},
  title = {Bearing Fault Detection in Varying Operational Conditions based on Empirical Mode Decomposition and Random Forest},
  year                       = {2018},
  address                    = {345 E 47TH ST, NEW YORK, NY 10017 USA},
  editor                     = {Ding, P and Li, C and Sanchez, RV and Yang, S},
  note                       = {Prognostics and System Health Management Conference (PHM-Chongqing), Chongqing, PEOPLES R CHINA, OCT 26-28, 2018},
  organization               = {Chongqing Technol \& Business Univ; Ctr Adv Life Cycle Engn; CAS, Key Lab Space Utilizat; Univ Algarve; Harbin Inst Technol; Chinese Journal Aeronaut; IEEE Reliabil Soc; Carleton Univ; Int Soc Measurement, Management \& Maintenance; Life Predict Technologies Inc; MDPI, Sensors},
  pages = {851--854},
  publisher                  = {IEEE},
  series                     = {Prognostics and System Health Management Conference},
  abstract                   = {Roller bearings play a significant role in kinds of machine. In most
   cases, it won't work in steadily operational conditions. The paper
   proposed a method which combines empirical mode decomposition and
   auto-regressive model to extract features of faults in various
   operational conditions and uses random forests to set an effective
   pattern recognition model. In addition, the paper compares the result of
   random forests with that of some other classification method. The
   bearing vibration data comes from Case Western Reserve University
   Bearing Data Center. The result indicates that the method is effective
   and can be used in actual situations.},
