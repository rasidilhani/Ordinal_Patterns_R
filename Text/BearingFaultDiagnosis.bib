  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85126973557&doi=10.1016%2fj.cnsns.2022.106294&partnerID=40&md5=8bf8177455a86fba08fef0c423408c85},
}

@Article{Schnurr2022,
  author                  = {Schnurr, A. and Fischer, S.},
  journal                 = {Computational Statistics and Data Analysis},
  title = {Generalized ordinal patterns allowing for ties and their applications in hydrology},
  year                    = {2022},
  issn                    = {01679473},
  note                    = {cited By 8},
  volume                  = {171},
  abbrev_source_title = {Comput. Stat. Data Anal.},
  abstract                = {When using ordinal patterns, which describe the ordinal structure within a data vector, the problem of ties appears permanently. So far, model classes were used which do not allow for ties; randomization has been another attempt to overcome this problem. Often, time periods with constant values even have been counted as times of monotone increase. However, ties can contain valuable information which is disregarded by all of these approaches. To overcome this, a new approach is proposed: it explicitly allows for ties and, hence, considers more patterns than before. Ties are no longer seen as nuisance, but the information they carry is taken into account explicitly. Limit theorems in the new framework are provided, both, for a single time series and for the dependence between two time series. The methods are applied to hydrological data sets. In hydrology, it is common to distinguish five flood classes (plus ‘absence of flood’). Considering data vectors of these classes at a certain gauge in a river basin, one will usually encounter several ties. Co-monotonic behavior between the data sets of two gauges (increasing, constant, decreasing) can be detected by the method as well as spatial patterns. Thus, it helps to analyze the strength of dependence between different gauges in an intuitive way. This knowledge can be used to assess risk and to plan future construction projects. © 2022 Elsevier B.V.},
  affiliation             = {Department Mathematik, Universität, Siegen, Germany; SPATE research unit, Ruhr-University Bochum, Germany},
  art_number              = {107472},
  author_keywords         = {Discrete time series; Flood events; Limit theorems; Ordinal data analysis},
  coden                   = {CSDAD},
  correspondence_address1 = {Fischer, S.; Ruhr-University Bochum, Universitätsstr. 150, Germany; email: svenja.fischer@rub.de},
  document_type           = {Article},
  doi                     = {10.1016/j.csda.2022.107472},
  groups                  = {Journals},
  keywords                = {Gages; Risk assessment; Time series; Time series analysis, Data set; Data vectors; Discrete time series; Flood event; Limit theorem; Ordinal data analyse; Ordinal pattern; Ordinal structure; Randomisation; Time-periods, Floods},
  language                = {English},
  publisher               = {Elsevier B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85126545818&doi=10.1016%2fj.csda.2022.107472&partnerID=40&md5=26176770c889a33a90ecc5ef51faa775},
}

@Article{Dovedi2022,
  author                  = {Dovedi, T. and Upadhyay, R. and Kumar, V.},
  journal                 = {International Journal of Imaging Systems and Technology},
  title = {Hybrid time-reassigned multisynchrosqueezing transform-Picard-based automated electroencephalography artifact correction methodology for brain–computer interface applications},
  year                    = {2022},
  issn                    = {08999457},
  note                    = {cited By 0},
  number                  = {4},
  pages = {1338--1356},
  volume                  = {32},
  abbrev_source_title = {Int J Imaging Syst Technol},
  abstract                = {The electroencephalographic activity is often contaminated with non-cerebral origins resulting in erroneous classification in brain–computer interface (BCI) applications. In the present work, a novel automated Electroencephalogram artifact correction methodology is proposed. Preconditional independent component analysis (ICA) is utilized for de-mixing the electroencephalographic activity into original components. The sparse entropy-based thresholding criterion is developed to automatically identify the artifactual components and the time-reassigned multisynchrosqueezing transform coefficients are estimated. The transform coefficients are processed to retain leaked cerebral activity into artifactual components. Finally, inverse transformation and inverse ICA are performed to attain artifact-free electroencephalographic activity. The efficiency of the proposed methodology is validated on simulated and real electroencephalographic activity. The results illustrate the efficacy of the proposed methodology on both simulated and real electroencephalography activities in retaining useful cerebral information and rejecting artifactual origins, with a potential to be used in various BCI applications. © 2021 Wiley Periodicals LLC.},
  affiliation             = {Department of Electronics and Communication Engineering, Thapar Institute of Engineering and Technology, Punjab, Patiala, India},
  author_keywords         = {artifact removal; electroencephalogram; independent component analysis; sparse entropy; time reassigned multisynchrosqueezing transform},
  coden                   = {IJITE},
  correspondence_address1 = {Dovedi, T.; Department of Electronics and Communication Engineering, Punjab, India; email: tdovedi_phd18@thapar.edu},
  document_type           = {Article},
  doi                     = {10.1002/ima.22680},
  groups                  = {Journals},
  keywords                = {Brain; Brain computer interface; Electrophysiology; Entropy; Independent component analysis; Interfaces (computer); Inverse problems, Artefact correction; Artifact removal; Brain-computer interface applications; Correction methodology; De-mixing; Entropy-based; Independent components analysis; Sparse entropy; Time reassigned multisynchrosqueezing transform; Transform coefficients, Electroencephalography},
  language                = {English},
  publisher               = {John Wiley and Sons Inc},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85120342117&doi=10.1002%2fima.22680&partnerID=40&md5=ee96f311042f038647744df038f2709a},
}

@Article{Wen2022a,
  author                  = {Wen, M. and Dang, Z. and Yu, Z. and Lü, Y. and Wei, G.},
  journal                 = {Zhendong yu Chongji/Journal of Vibration and Shock},
  title = {Dynamic mode decomposition and its application in early bearing fault diagnosis [动态模式分解及其在轴承早期故障诊断中的应用]},
  year                    = {2022},
  issn                    = {10003835},
  note                    = {cited By 3},
  number                  = {12},
  pages = {313--320},
  volume                  = {41},
  abbrev_source_title = {J Vib Shock},
  abstract                = {A rolling bearing is a key component in the equipment manufacturing industry, and its working status in the service process directly determines the performance, quality, and reliability of host products. Effective supervision and detection technology for early fault of bearing is an important guarantee for equipment preventive maintenance. An improved dynamic mode decomposition (DMD) algorithm was proposed and applied to early fault extraction of bearing signals. The original time series collected by the sensor was decomposed by DMD after projection denoising, then the soft threshold method was adopted to obtain several single-frequency modes adaptively according to the noise level of original signal. Multi-scale permutation entropy values of these modes were calculated next, the low-rank components in the original dynamic system were picked out by the threshold method. After the reconstruction, the early fault frequencies were extracted. The effectiveness of the proposed algorithm was verified with experimental study on simulation signal and measured signal. © 2022, Editorial Office of Journal of Vibration and Shock. All right reserved.},
  affiliation             = {Key Laboratory of Metallurgical Equipment and Control Technology, Ministry of Education, Wuhan University of Science and Technology, Wuhan, 430081, China; Hubei Key Laboratory of Mechanical Transmission and Manufacturing Engineering, Wuhan University of Science and Technology, Wuhan, 430081, China; National Demonstration Center for Experimental Mechanical Education, Wuhan University of Science and Technology, Wuhan, 430081, China},
  author_keywords         = {Adaptive truncated rank; Dynamic mode decomposition(DMD); Feature extraction; Multi-scale permutation entropy},
  correspondence_address1 = {Dang, Z.; Key Laboratory of Metallurgical Equipment and Control Technology, China; Dang, Z.; Hubei Key Laboratory of Mechanical Transmission and Manufacturing Engineering, China; Dang, Z.; National Demonstration Center for Experimental Mechanical Education, China},
  document_type           = {Article},
  doi                     = {10.13465/j.cnki.jvs.2022.12.038},
  groups                  = {Journals},
  keywords                = {Entropy; Extraction; Feature extraction; Preventive maintenance; Roller bearings, Adaptive truncated rank; Bearing fault diagnosis; Dynamic mode decompositions; Early fault; Features extraction; ITS applications; Multi-scale permutation entropy; Multi-scales; Permutation entropy; Threshold methods, Dynamic mode decomposition},
  language                = {Chinese},
