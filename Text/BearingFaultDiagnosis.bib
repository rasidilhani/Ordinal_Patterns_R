  issn                    = {17426588},
  journal                 = {Journal of Physics: Conference Series},
  keywords                = {Hydraulic equipment; Hydraulic machinery, Analysis method; Automatic recognition; Deep belief networks; External vibrations; Fault-based; Hydraulic system; Multi-scales; Permutation entropy; Variable-parameters; Weak faults, Entropy},
  language                = {English},
