  keywords                = {Data mining; Entropy; Intelligent systems; Intelligent vehicle highway systems; Time series, Attention mechanisms; BiGRU; Combined modeling; EMD; Entropy value; Flow data; Short-term traffic flow; Time-series data; Traffic flow; Traffic flow prediction, Forecasting},
  language                = {English},
