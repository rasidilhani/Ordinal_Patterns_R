  groups                  = {Journals},
  keywords                = {Automobile manufacture; Blockchain; Computer crime; Control system synthesis; Controllers; Data privacy; Data Sharing; Decision trees; Frequency domain analysis; Intrusion detection; Network security; Vehicle to vehicle communications; Vehicles, Authentication mechanisms; Controller area network; Electronic control units; In-vehicle communication; Intrusion Detection Systems; Random forest modeling; Sensitive informations; Software defined networking (SDN), Learning systems},
  language                = {English},
