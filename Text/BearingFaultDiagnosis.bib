  coden                   = {MSTCE},
  correspondence_address1 = {Lu, N.; Yellow River Laboratory, China; email: pyzhaocool@126.com},
  document_type           = {Article},
  doi                     = {10.1088/1361-6501/acc3b8},
  groups                  = {Journals},
  keywords                = {Extraction; Fault detection; Rotating machinery; Signal denoising; Wavelet analysis, Adaptive wavelet denoising; Adaptive wavelets; Faults feature extractions; Features extraction; Machinery faults; Synthetic detection index; Vibration signal; Wavelet denoising; Wavelet denoising method, Feature extraction},
  language                = {English},
  publisher               = {Institute of Physics},
