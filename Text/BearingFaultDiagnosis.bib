@Article{Zheng2023b,
  author                  = {Zheng, S. and Zhang, X. and Song, P. and Hu, Y. and Gong, X. and Peng, X.},
  journal                 = {Frontiers in Computational Neuroscience},
  title = {Complexity-based graph convolutional neural network for epilepsy diagnosis in normal, acute, and chronic stages},
  year                    = {2023},
  issn                    = {16625188},
  note                    = {cited By 1},
  volume                  = {17},
  abbrev_source_title = {Front. Comput. Neurosci.},
  abstract                = {Introduction: The automatic precision detection technology based on electroencephalography (EEG) is essential in epilepsy studies. It can provide objective proof for epilepsy diagnosis, treatment, and evaluation, thus helping doctors improve treatment efficiency. At present, the normal and acute phases of epilepsy can be well identified through EEG analysis, but distinguishing between the normal and chronic phases is still tricky. Methods: In this paper, five popular complexity indicators of EEG signal, including approximate entropy, sample entropy, permutation entropy, fuzzy entropy and Kolmogorov complexity, are computed from rat hippocampi to characterize the normal, acute, and chronic phases during epileptogenesis. Results of one-way ANOVA and principal component analysis both show that utilizing complexity features, we are able to easily identify differences between normal, acute, and chronic phases. We also propose an innovative framework for epilepsy detection based on graph convolutional neural network (GCNN) using multi-channel EEG complexity as input. Results: Combining information of five complexity measures at eight channels, our GCNN model demonstrate superior ability in recognizing the normal, acute, and chronic phases. Experiments results show that our GCNN model reached the high prediction accuracy above 98% and F1 score above 97% among these three phases for each individual rat. Discussion: Our research practice based on real data shows that EEG complexity characteristics are of great significance for recognizing different stages of epilepsy. Copyright © 2023 Zheng, Zhang, Song, Hu, Gong and Peng.},
  affiliation             = {Guangdong Provincial Key Laboratory of Interdisciplinary Research and Application for Data Science, BNU-HKBU United International College, Zhuhai, China; Department of Neurology, Children's Hospital of Chongqing Medical University, Chongqing, China},
  art_number              = {1211096},
  author_keywords         = {chronic stage; EEG complexity measures; entropy; epilepsy diagnosis; graph convolutional neural network},
  correspondence_address1 = {Peng, X.; Guangdong Provincial Key Laboratory of Interdisciplinary Research and Application for Data Science, China; email: xlpeng@uic.edu.cn},
  document_type           = {Article},
  doi                     = {10.3389/fncom.2023.1211096},
  groups                  = {Journals},
  keywords                = {Complex networks; Computational complexity; Convolution; Convolutional neural networks; Electrophysiology; Entropy; Graph theory; Neurology; Principal component analysis; Rats, Chronic stage; Complexity based; Complexity measures; Convolutional neural network; Detection technology; Electroencephalography complexity measure; Epilepsy diagnose; Graph convolutional neural network; Neural network model; Precision detections, Electroencephalography, diazepam; pilocarpine, accuracy; analysis of variance; animal experiment; animal model; animal tissue; Article; controlled study; convolutional neural network; electroencephalography; entropy; epilepsy; epileptogenesis; hippocampus; Kolmogorov Smirnov test; nonhuman; prediction; principal component analysis; rat; recognition},
  language                = {English},
  publisher               = {Frontiers Media SA},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85174187621&doi=10.3389%2ffncom.2023.1211096&partnerID=40&md5=46d5051979ae4d14365b53f12c83148d},
}

@Article{Li2023ab,
  author                  = {Li, Y. and Tang, B. and Jiao, S. and Su, Q.},
  journal                 = {IEEE Transactions on Instrumentation and Measurement},
  title = {Snake Optimization-Based Variable-Step Multiscale Single Threshold Slope Entropy for Complexity Analysis of Signals},
  year                    = {2023},
  issn                    = {00189456},
  note                    = {cited By 65},
  volume                  = {72},
  abbrev_source_title = {IEEE Trans. Instrum. Meas.},
  abstract                = {Slope entropy (SloEn) is an effective complexity analysis measure of signals that has been applied to many areas in recent years. Whereas SloEn can only reflect the complexity information of signal at a single scale and SloEn is sensitive to its threshold value, the choice of the threshold value will affect the SloEn value. In this article, the variable-step multiscale single threshold SloEn (VSM-StSloEn) is proposed, not only reflecting the complexity information hidden in different time scales but also compensating for the shortcomings of traditional multiscale processing, which is based on the recently proposed single threshold SloEn (StSloEn) that simplifies the calculation process of SloEn and combines variable-step multiscale processing. Furthermore, to overcome the threshold selection problem of VSM-StSloEn, this article proposes snake optimization-based VSM-StSloEn (SO-VSM-StSloEn) by introducing snake optimizer (SO). Finally, we have verified the performance of SO-VSM-StSloEn on simulated and real-world experiments, and the results demonstrate that SO-VSM-StSloEn is insensitive to signal length, independent on the threshold and has stronger distinguishing capability than other similar improved algorithms based on SloEn; furthermore, SO-VSM-StSloEn is superior to other commonly used entropies in classifying different categories of real-world signals. © 2023 IEEE.},
  affiliation             = {Xi'an University of Technology, School of Automation and Information Engineering, Xi'an, 710048, China},
  art_number              = {6505313},
  author_keywords         = {Complexity analysis; single threshold; slope entropy (SloEn); snake optimizer (SO); threshold optimization; variable-step multiscale},
  coden                   = {IEIMA},
  correspondence_address1 = {Li, Y.; Xi'an University of Technology, China; email: liyuxing@xaut.edu.cn},
  document_type           = {Article},
  doi                     = {10.1109/TIM.2023.3317908},
  groups                  = {Journals},
  keywords                = {Entropy; Optimization; Signal analysis, Complexity analysis; Complexity theory; Metaheuristic; Optimizers; Signals analysis; Single threshold; Slope entropy; Snake optimizer; Symbol; Threshold optimization; Time-series analysis; Variable step; Variable-step multiscale, Time series analysis},
  language                = {English},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85173059481&doi=10.1109%2fTIM.2023.3317908&partnerID=40&md5=a3034b49615c3e2b56477ddda924f874},
}

@Conference{Zhang2023l,
  author                  = {Zhang, Y. and Lo, S. and Tang, S. and Tu, W.},
  title = {Quantitative Evaluation of Passenger Flow at Metro Stations Based on Coarse-to-Fine Analysis},
  year                    = {2023},
  editor                  = {Hu S., Ye X., Lin H., Mu L., Cheng T., Chen H.},
  note                    = {cited By 0},
  publisher               = {IEEE Computer Society},
  volume                  = {2023-July},
  abbrev_source_title = {Int. Conf. Geoinformatics},
  abstract                = {The dense urban metro network plays an important role in urban transportation, and it is becoming increasingly important to improve the operation and management of metro facilities. The monitoring and management of passenger flow is a main concern in metro operation, and the reliable analysis of passenger flow can greatly improve the operational efficiency and safety of a metro station. Therefore, using the long-time in-and-out smart card data of Shenzhen metro stations, this paper proposes a Coarse-to-Fine passenger flow analysis method for the characterization of passenger flow on multiple time scales. This method, which is proposed from a new perspective based on the time series clustering of metro stations, precisely defines the peak travel hours and then extracts features for the evaluation of the crowdedness and disorderliness at each station. Finally, the metro stations are classified into nine levels according to those features. The stations that need urgent attention in terms of their passenger flow, including Shenzhen North Station, Buji, and Grand Theater, are identified for the reference of city managers. © 2023 IEEE.},
  affiliation             = {City University of Hong Kong, Department of Architecture and Civil Engineering, Hong Kong, Hong Kong; Shenzhen University, School of Architecture and Urban Planning, Department of Urban Informatics, Shenzhen, China},
  author_keywords         = {Coarse-to-Fine Analysis; Metro Stations; Passenger Flow; Peak Hours; Time-series Clustering},
  correspondence_address1 = {Zhang, Y.; City University of Hong Kong, Hong Kong; email: yunjzhang4-c@my.cityu.edu.hk},
  document_type           = {Conference Paper},
  doi                     = {10.1109/Geoinformatics60313.2023.10247659},
  groups                  = {Conference},
  isbn                    = {9798350344240},
  issn                    = {2161024X},
  journal                 = {International Conference on Geoinformatics},
  keywords                = {Smart cards; Subway stations; Time series; Time series analysis, Coarse to fine; Coarse-to-fine analyse; Fine analysis; Metro networks; Metro stations; Operation and management; Passenger flows; Peak hour; Quantitative evaluation; Time series clustering, Urban transportation},
  language                = {English},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85172732381&doi=10.1109%2fGeoinformatics60313.2023.10247659&partnerID=40&md5=eb8c2ead2bbe39290ce8537ef1ae17c3},
