}

@Article{Guo2021c,
  author                  = {Guo, Y. and Wang, L. and Dong, Q. and Lou, X.},
  journal                 = {Mathematics and Computers in Simulation},
  title = {Dynamical complexity of FitzHugh–Nagumo neuron model driven by Lévy noise and Gaussian white noise},
  year                    = {2021},
  issn                    = {03784754},
