  groups                  = {Journals},
  keywords                = {Chaotic systems, Co-existing attractors; Discrete maps; Discrete memristor; Fixed points; Hidden attractor; Hyperchaotic maps; ITS applications; Memristor; Self - excited; Self-excited attractor, Memristors},
  language                = {English},
