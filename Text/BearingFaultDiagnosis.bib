  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85164833846&doi=10.32604%2fSDHM.2023.022317&partnerID=40&md5=3000e45d9bf1d61ca8fc75002a76be00},
}

@Article{JaniferJabinJui2023,
  author                  = {Janifer Jabin Jui, S. and Deo, R.C. and Barua, P.D. and Devi, A. and Soar, J. and Rajendra Acharya, U.},
  journal                 = {IEEE Access},
  title = {Application of Entropy for Automated Detection of Neurological Disorders With Electroencephalogram Signals: A Review of the Last Decade (2012-2022)},
  year                    = {2023},
  issn                    = {21693536},
  note                    = {cited By 14},
  pages = {71905--71924},
  volume                  = {11},
  abbrev_source_title = {IEEE Access},
  abstract                = {An automated Neurological Disorder detection system can be considered as a cost-effective and resource efficient tool for medical and healthcare applications. In automated Neurological Disorder detection, electroencephalograms are commonly used, but their low signal intensity and nonlinear features are difficult to analyze visually. A promising approach for processing of electroencephalogram signals is the concept of entropy, a nonlinear signal processing method to measure the chaos in the signal. The aim of this study was to find out the effective entropy measures and the machine learning approaches that produced promising output. Using Preferred Reporting Items for Systematic Reviews and Meta-Analyses (PRISMA) guidelines as our method, we have identified 84 studies published between 2012 and 2022 that has investigated epilepsy, Parkinson's disease, autism, Attention Deficit Hyperactive disorder, schizophrenia, Alzheimer's disease, depression, and alcohol use disorder with machine learning approaches considering entropy measures. We show that Support Vector Machines was the most commonly used machine learning model, with consistent performance in most of the studies whereas sample entropy was the most commonly used entropy measure, followed by the approximate entropy. For epilepsy detection, the most used entropy feature was the log energy entropy, whereas the multi-scale entropy was commonly used for Alzheimer's Disease, approximate and sample entropy used for Parkinson's Disease, multi scale and Shannon entropy applied for autism, approximate and Shannon entropy used for attention deficit hyperactive disorder, sample entropy used for depression, approximate and spectral entropy adopted for schizophrenia, and the approximate and sample entropy employed for alcohol use disorder. According to the majority of the studies, there is growing concern about the increase in neuro patients and the heavy resource burden that is associated with their prevalence and diagnosis. Based on these studies, we conclude that Computer-Aided Design systems would be economically advantageous in detecting Neurological Disorders. To incorporate Computer-Aided Design system into the mainstream health care system, future research could focus on multi-modal approaches to the disorder and its interpretation and explanation. We believe this is the first review that has combined the electroencephalograms, entropy, and automated detection possibility of the 8 distinct neurological disorders. The study is limited to the papers that used accuracy as their performance evaluation metric. The findings and synthesis of previous studies provides a clear pathway that identifies the entropy approach as a practical solution for automated detection of neurological disorder using electroencephalograms with potential applications in other kinds of signal analysis. © 2013 IEEE.},
  affiliation             = {University of Southern Queensland, School of Mathematics, Physics and Computing, Springfield, QLD 4300, Australia; School of Business, University of Southern Queensland, Springfield, QLD 4300, Australia; Faculty of Engineering and Information Technology, University of Technology Sydney, Sydney, NSW 2007, Australia; Australian International Institute of Higher Education, Sydney, NSW 2000, Australia; Sydney School of Education and Social Work, The University of Sydney, Camperdown, NSW 2006, Australia; School of Science and Technology, University of New England, Armidale, NSW 2350, Australia; School of Biosciences, Taylor s University, Subang Jaya, 47500, Malaysia; School of Computing, Srm Institute of Science and Technology, Kattankulathur, 603203, India; School of Science and Technology, Kumamoto University, Kumamoto, 860-0862, Japan; School of Education and Tertiary Access, University of the Sunshine Coast, Caboolture Campus, Caboolture, QLD 4510, Australia},
  author_keywords         = {artificial intelligence; automated detection; EEG; entropy; machine; Neurological disorder},
  correspondence_address1 = {Janifer Jabin Jui, S.; University of Southern Queensland, Australia; email: sjanifer.jui@usq.edu.au; Deo, R.C.; University of Southern Queensland, Australia; email: ravinesh.deo@usq.edu.au},
  document_type           = {Review},
  doi                     = {10.1109/ACCESS.2023.3294473},
  groups                  = {Journals},
  keywords                = {Automation; Bioelectric phenomena; Biomedical signal processing; Computer aided design; Cost effectiveness; Diseases; Electrophysiology; Feature extraction; Health care; Learning systems; Neurology; Support vector machines, Australia; Autism; Automated detection; Entropy measure; Epilepsy; Machine-learning; Mental disorders; Neurological disease; Neurological disorders; Sample entropy, Electroencephalography},
  language                = {English},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85164717506&doi=10.1109%2fACCESS.2023.3294473&partnerID=40&md5=2119fef03adaaf490af8ac50f5e4520b},
}

@Conference{Shi2023a,
  author                  = {Shi, X. and Qu, J. and Guo, J. and Huang, J. and Bai, Y. and Cao, W.},
  title = {A Novel Method to the Aging Feature Extraction of Viscoelastic Sandwich Structures},
  year                    = {2023},
  note                    = {cited By 2},
  number                  = {1},
  publisher               = {Institute of Physics},
  volume                  = {2501},
  abbrev_source_title = {J. Phys. Conf. Ser.},
  abstract                = {The viscoelastic sandwich structure exhibits highly nonlinear dynamic characteristics, and minimal changes in signal caused by aging state alterations, thus posing a challenge for extracting its aging characteristics. A method is proposed for extracting aging features from viscoelastic sandwich structures using variational mode decomposition (VMD) and permutation entropy (PE). First, the original dynamic response signal is decomposed by VMD to acquire several intrinsic mode functions (IMF). Then the permutation entropy characteristics of each IMF are calculated. The research results show that there are obvious differences in the distribution of permutation entropy corresponding to each IMF component, which indicates that the permutation entropy feature extracted based on the variational modal decomposition is more susceptive to the change of the aging state of the structure, thus verifying the availability of this method for feature extraction. © Published under licence by IOP Publishing Ltd.},
  affiliation             = {School of Mechatronic Engineering, Xi'An Technological University, Xi'an, 710021, China},
  art_number              = {012039},
  correspondence_address1 = {Qu, J.; School of Mechatronic Engineering, China; email: ytuqjx@163.com},
