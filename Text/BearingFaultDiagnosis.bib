@Article{Liu2023e,
  author                  = {Liu, H. and Li, Y. and Luo, L. and Zhang, C.},
  journal                 = {Batteries},
  title = {A Lithium-Ion Battery Capacity and RUL Prediction Fusion Method Based on Decomposition Strategy and GRU},
  year                    = {2023},
  issn                    = {23130105},
  note                    = {cited By 19},
  number                  = {6},
  volume                  = {9},
  abbrev_source_title = {Batteries},
  abstract                = {To safeguard the security and dependability of battery management systems (BMS), it is essential to provide reliable forecasts of battery capacity and remaining useful life (RUL). However, most of the current prediction methods use the measurement data directly to carry out prediction work, which ignores the objective measurement noise and capacity increase during the aging process of batteries. In this study, an integrated prediction method is introduced to highlight the prediction of lithium-ion battery capacity and RUL. This approach incorporates several techniques, including variational modal decomposition (VMD) with entropy detection, a double Gaussian model, and a gated recurrent unit neural network (GRU NN). Specifically, the PE−VMD algorithm is first utilized to perform a noise reduction process on the capacity data obtained from the measurements, and this results in a global degradation trend sequence and local fluctuation sequences. Afterward, the global degradation prediction model is established by employing the double Gaussian aging model proposed in this paper, and the local prediction models are built for each local fluctuation sequence by GRU NN. Lastly, the proposed hybrid prediction methodology is validated through battery capacity and RUL prediction studies on experimental data from three sources, and its accuracy is also compared with prediction algorithms from the recent related literature. Experimental results demonstrate that the proposed hybrid prediction method exhibits high precision in the predicting future capacity and RUL of lithium-ion batteries, along with strong robustness and predictive stability. © 2023 by the authors.},
  affiliation             = {School of Electronic Engineering and Intelligent Manufacturing, Anqing Normal University, Anqing, 246011, China; College of Intelligent Science and Control Engineering, Jinling Institute of Technology, Nanjing, 211169, China},
  art_number              = {323},
  author_keywords         = {double Gaussian model; gated recurrent unit neural network (GRU NN); lithium-ion battery; RUL prediction; variational modal decomposition (VMD)},
  correspondence_address1 = {Li, Y.; School of Electronic Engineering and Intelligent Manufacturing, China; email: liym@aqnu.edu.cn},
  document_type           = {Article},
  doi                     = {10.3390/batteries9060323},
  groups                  = {Journals},
  keywords                = {Battery management systems; Forecasting; Gaussian distribution; Ions; Noise abatement; Recurrent neural networks; Variational techniques, Battery capacity; Double gaussian model; Gated recurrent unit neural network; Local fluctuations; Modal decomposition; Neural-networks; Prediction methods; Remaining useful life predictions; Remaining useful lives; Variational modal decomposition, Lithium-ion batteries},
  language                = {English},
