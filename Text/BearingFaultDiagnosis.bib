  document_type           = {Article},
  doi                     = {10.1016/j.chaos.2025.115988},
  groups                  = {Journals},
  keywords                = {Normal distribution; Time series, Defect detection; Dispersion transition entropy; Dynamical complexity; Rail short-wave defect detection; Short waves; Similarity; Similarity measure; State transitions; Transition entropies; Transition matrices, White noise},
  language                = {English},
  publisher               = {Elsevier Ltd},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85215093909&doi=10.1016%2fj.chaos.2025.115988&partnerID=40&md5=98a1673b25ca85bbe3fb919c690b673a},
}

