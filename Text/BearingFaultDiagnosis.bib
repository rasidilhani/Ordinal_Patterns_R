  keywords                = {Entropy; Fault detection; Feature extraction; Multiresolution analysis, Bearing fault detection; Entropy-based methods; Faults detection; Multi-resolution analysis; Multiresolution; Multiresolutions analysis; Oscillatory patterns; Permutation entropy; Predictive maintenance; Rolling Element Bearing, Roller bearings},
