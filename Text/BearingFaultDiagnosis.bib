  groups                  = {Journals},
  keywords                = {alpha rhythm; Article; auditory stimulation; drowsiness; electroencephalogram; electroencephalography; human; magnetoencephalography; neurophysiology; prediction; sleep; stage 1 sleep; theta rhythm; wakefulness; electroencephalography; physiology; procedures; sleep; sleep stage, Acoustic Stimulation; Electroencephalography; Humans; Sleep; Sleep Stages; Wakefulness},
  language                = {English},
