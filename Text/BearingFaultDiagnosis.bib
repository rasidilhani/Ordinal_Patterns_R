  document_type           = {Article},
  doi                     = {10.1016/j.marpolbul.2024.116969},
  groups                  = {Journals},
  keywords                = {Background noise; Fish; Marine pollution, Behaviour changes; Fish behavior; Fish behavior change; Fish vocalization phenology; Long-term noise assessment; Noise assessments; Noise impact; Offshore wind farm noise; Offshore winds; Wind farm, Offshore wind farms, ambient noise; bioacoustics; environmental monitoring; fish; noise pollution; offshore structure; phenology; vocalization; wind farm, article; behavior change; duration; fish; marine species; noise; noise pollution; nonhuman; phenology; sound intensity; Taiwan; vocalization; wind farm; acoustics; animal; environmental monitoring; physiology; Taiwan; wind, Taiwan Strait, Acoustics; Animals; Environmental Monitoring; Fishes; Noise; Taiwan; Vocalization, Animal; Wind},
