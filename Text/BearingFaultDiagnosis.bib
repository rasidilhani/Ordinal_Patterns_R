@Conference{Rohila2020a,
  author              = {Rohila, A. and Sharma, A.},
  title = {Correlation between heart rate variability features},
  year                = {2020},
  note                = {cited By 0},
  pages = {669--674},
  publisher           = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {Int. Conf. Signal Process. Integr. Networks, SPIN},
  abstract            = {Several features for heart rate variability (HRV) are being proposed in many studies. However, it is unclear whether new methods are contributing to knowledge or just duplicating the information represented by existing methods. Therefore, in this study, the correlation between different traditional and modern approaches to HRV analysis has been analyzed. The HRV features were extracted from signals of four classes of subjects acquired from PhysioNet databases. Three correlation coefficients, namely Pearson's correlation (PearCorr), Kendall's rank correlation (KendCorr), and distance correlation (DistCorr), have been used. PearCorr is sensitive to only linear relationships, whereas KendCorr and DistCorr are sensitive to both linear and nonlinear associations between variables. The experimental results suggest that traditional time-domain based features show a significant correlation with Poincaré plot-based features. The frequency-domain features show a considerable relationship with entropy-based complexity measures of HRV. The modern approaches to complexity analysis, such as heart rate asymmetry indices and phase entropy, do not show a significant correlation with other existing HRV features. © 2020 IEEE.},
  affiliation         = {Indian Institute of Technology Roorkee, Electrical Engineering Department, Roorkee, India},
  art_number          = {9071381},
  author_keywords     = {Correlation; Heart rate asymmetry; Phase entropy},
  document_type       = {Conference Paper},
  doi                 = {10.1109/SPIN48934.2020.9071381},
  groups              = {Conference},
  isbn                = {9781728154756},
  journal             = {2020 7th International Conference on Signal Processing and Integrated Networks, SPIN 2020},
  keywords            = {Complex networks; Correlation methods; Entropy; Frequency domain analysis; Heart; Time domain analysis, Complexity analysis; Complexity measures; Correlation coefficient; Entropy-based; Frequency domains; Heart rate variability; Linear relationships; Rank correlation, Signal processing},
  language            = {English},
  source              = {Scopus},
  url                 = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85084279653&doi=10.1109%2fSPIN48934.2020.9071381&partnerID=40&md5=ddb89efdecc1c36644a59def876fa5d7},
}

@Conference{Xin2020a,
  author                  = {Xin, L. and Li, Z. and Gui, X. and Fan, M. and Wang, H.},
  title = {Surface intrusion recognition method for subway tunnel security system},
  year                    = {2020},
  note                    = {cited By 3},
  pages = {804--808},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {Proc. - Int. Conf. Meas. Technol. Mechatronics Autom., ICMTMA},
  abstract                = {Subway is the main means of urban transportation, so its security monitoring is very important. Aiming at the problems of traditional technology, such as low detection resolution, limited monitoring distance and high cost, this paper proposes a method for surface intrusion detection of subway tunnel based on the grating array. The method uses spectral subtraction and short-time Fourier transform to extract the intrusion signal, and combines empirical mode decomposition and permutation entropy to extract the features for identifying. An experimental platform based on grating array vibration sensing is built between Hugong and Yezhihu stations of Wuhan Metro Line 7. For actual sampling data, this method can effectively extract invasion signals. And four common events are distinguished, including subway train traveling in the tunnel, lorry passing, discrete pulse construction, and continuous pulse construction on the ground surface, with an average recognition rate of above 90%. © 2020 IEEE.},
