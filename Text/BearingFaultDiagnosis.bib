  doi                     = {10.1109/TITS.2024.3379740},
  groups                  = {Journals},
  keywords                = {Dispersions; Failure analysis; Fault detection; Railroad transportation; Railroads; Time domain analysis, Complexity theory; Correlation; Dispersion patterns; Distance correlation; Faults diagnosis; Martingale difference; Martingale difference correlation; Rail profile; Rail transportation; Weighted-dispersion pattern, Entropy},
