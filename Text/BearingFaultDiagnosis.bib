  groups                  = {Journals},
  keywords                = {Entropy; Fuzzy clustering; Wavelet transforms, Classification and identifications; Classification performance; Clustering centers; Empirical Mode Decomposition; GK fuzzy clustering; Partial discharge classification; Partial discharge signal; Permutation entropy, Partial discharges},
