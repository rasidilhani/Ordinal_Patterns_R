}

@Article{Amigo2008b,
  author            = {Amigó, José M. and Kennel, Matthew B.},
  journal           = {Physica D: Nonlinear Phenomena},
  title = {Forbidden ordinal patterns in higher dimensional dynamics},
  year              = {2008},
  note              = {Cited by: 20; All Open Access, Green Open Access},
  number            = {22},
  pages             = {2893 – 2899},
  volume            = {237},
  abstract          = {Forbidden ordinal patterns are ordinal patterns (or rank blocks) that cannot appear in the orbits generated by a map taking values on a linearly ordered space, in which case we say that the map has forbidden patterns. Once a map has a forbidden pattern of a given length L0, it has forbidden patterns of any length L ≥ L0 and their number grows superexponentially with L. Using recent results on topological permutation entropy, in this paper we study the existence and some basic properties of forbidden ordinal patterns for self-maps on n-dimensional intervals. Our most applicable conclusion is that expansive interval maps with finite topological entropy have necessarily forbidden patterns, although we conjecture that this is also the case under more general conditions. The theoretical results are nicely illustrated for n = 2 both using the naive counting estimator for forbidden patterns and Chao's estimator for the number of classes in a population. The robustness of forbidden ordinal patterns against observational white noise is also illustrated. © 2008 Elsevier B.V. All rights reserved.},
  doi               = {10.1016/j.physd.2008.05.003},
  groups            = {Journals},
  publication_stage = {Final},
  source            = {Scopus},
  type              = {Article},
  url               = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-53249107755&doi=10.1016%2fj.physd.2008.05.003&partnerID=40&md5=6ec0fd28247fb2894a1b21f5911cda87},
}

@Conference{Nicolaou2010,
  author            = {Nicolaou, Nicoletta and Georgiou, Julius},
  title = {Permutation entropy: A new feature for brain-computer interfaces},
  year              = {2010},
  note              = {Cited by: 9},
  pages             = {49 – 52},
  abstract          = {This paper investigates the use of Permutation Entropy (PE) as a feature for mental task classification for a Brain-Computer Interface system. PE is a recently introduced measure which quantifies signal complexity by measuring the departure of a time series from a random one. More regular signals are characterized by lower PE values. Here, PE is utilized to characterize signals from electroencephalograms of 3 subjects performing 4 motor imagery tasks, which are then classified using a Support Vector Machine. Even though it is possible to obtain 100% single-trial classification accuracy, this is very much subject-dependent. ©2010 IEEE.},
  doi               = {10.1109/BIOCAS.2010.5709568},
  groups            = {Conference},
  journal           = {2010 IEEE Biomedical Circuits and Systems Conference, BioCAS 2010},
  publication_stage = {Final},
  source            = {Scopus},
  type              = {Conference paper},
  url               = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-79952390220&doi=10.1109%2fBIOCAS.2010.5709568&partnerID=40&md5=5939c116bd057f6ca9e4e35b89a90b0f},
}

@Conference{Liu2010,
  author            = {Liu, Yongbin and Yan, Ruqiang and Gao, Robert X.},
  title = {A nonlinear time series analysis method for health monitoring of rolling bearings},
  year              = {2010},
  note              = {Cited by: 5},
  pages             = {277 – 283},
  volume            = {2},
  abstract          = {This paper presents a nonlinear time series analysis method for rotating machine damage detection and diagnostics. Specifically, the permutation entropy is investigated as a statistical measure for signal characterization. Through space reconstruction, the permutation entropy describes the complexity of the time series measured on a physical system, and takes its non-linear behavior into account. By identifying changes in the vibration signals measured on rotating machines, which are typical precursors of defect occurrence, permutation entropy can serve as a diagnostic tool. Experiments on a custom-designed gearbox system have confirmed its effectiveness for machine structural health monitoring applications. Copyright © 2010 by ASME.},
  doi               = {10.1115/DSCC2010-4118},
  groups            = {Conference},
  journal           = {ASME 2010 Dynamic Systems and Control Conference, DSCC2010},
  publication_stage = {Final},
