}

@Article{Alvarez2017,
  author            = {Alvarez, Nuria Martinez and Borkar, Saurabh and Masoller, Cristina},
  journal           = {European Physical Journal: Special Topics},
  title = {Predictability of extreme intensity pulses in optically injected semiconductor lasers},
  year              = {2017},
  note              = {Cited by: 22},
  number            = {9},
  pages             = {1971 – 1977},
  volume            = {226},
  abstract          = {The predictability of extreme intensity pulses emitted by an optically injected semiconductor laser is studied numerically, by using a well-known rate equation model. We show that symbolic ordinal time-series analysis allows to identify the patterns of intensity oscillations that are likely to occur before an extreme pulse. The method also gives information about patterns which are unlikely to occur before an extreme pulse. The specific patterns identified capture the topology of the underlying chaotic attractor and depend on the model parameters. The methodology proposed here can be useful for analyzing data recorded from other complex systems that generate extreme fluctuations in their output signals. © 2017, EDP Sciences and Springer-Verlag GmbH Germany.},
  doi               = {10.1140/epjst/e2016-60391-4},
  groups            = {Journals},
  publication_stage = {Final},
  source            = {Scopus},
