  document_type           = {Article},
  doi                     = {10.1080/03081079.2021.1915305},
  groups                  = {Journals},
  keywords                = {Information systems; Systems science, Diversity measure; Diversity metrics; First-passage; Policy process; Public policy decisions, Decision making},
  language                = {English},
  publisher               = {Taylor and Francis Ltd.},
  source                  = {Scopus},
