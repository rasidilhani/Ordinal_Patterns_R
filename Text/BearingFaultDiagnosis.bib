  groups                  = {Journals},
  keywords                = {Financial data processing; Fisher information matrix; Time series, Complexity-entropy curves; Distribution entropies; Effective tool; Extreme value; Financial time series; Fisher information measures; Information quantifiers; Stock indices, Entropy},
  language                = {English},
  publisher               = {Elsevier Ltd},
