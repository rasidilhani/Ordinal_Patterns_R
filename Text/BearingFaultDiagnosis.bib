  journal             = {IEEE Region 10 Annual International Conference, Proceedings/TENCON},
  keywords            = {Biomedical signal processing; Machine learning; Physiology, E health; e-Health systems; Ehealth; Entropy measure; Entropy methods; Feature extraction methods; Machine-learning; Neurodegenerative disorders; Patterns classification; Physiological signals, Neurodegenerative diseases},
  language            = {English},
