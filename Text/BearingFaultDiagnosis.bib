  author_keywords         = {Conditional entropy; ECG Classification; Ordinal patterns; Permutation entropy},
  correspondence_address1 = {Eyebe Fouda, J.S.A.; Department of Physics, P.O. Box 812, Cameroon; email: efoudajsa@yahoo.fr},
  document_type           = {Article},
  doi                     = {10.1016/j.cnsns.2019.105156},
  groups                  = {Journals},
  keywords                = {Classification (of information); Database systems; Entropy, Beat classification; Classification rates; Conditional entropy; Electrocardiogram classification; MIT-BIH database; Ordinal pattern; Parameter-setting; Pattern entropy; Permutation entropy, Electrocardiograms},
  language                = {English},
