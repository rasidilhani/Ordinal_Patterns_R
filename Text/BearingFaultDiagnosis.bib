@Article{Yang2023a,
  author                  = {Yang, Y.G. and Cheng, F.E. and Jiang, D.H. and Zhou, Y.H. and Shi, W.M. and Liao, X.},
  journal                 = {Physica Scripta},
  title = {A visually meaningful image encryption algorithm based on P-tensor product compressive sensing and newly-designed 2D memristive chaotic map},
  year                    = {2023},
  issn                    = {00318949},
  note                    = {cited By 9},
  number                  = {10},
  volume                  = {98},
  abbrev_source_title = {Phys Scr},
  abstract                = {The noise-like visual feature of cipher images produced by using the traditional image encryption technology explicitly reflects the presence of secret information. To overcome this issue, a visually meaningful image encryption algorithm is proposed based on a newly designed 2D memristive chaotic map, P-tensor product compressive sensing (PTP-CS) and discrete Hartley transform (DHT). For concreteness, a new two-dimensional discrete memristive chaotic map is first designed to provide highly unpredictable secret code streams while maintaining low time consumption. Second, the threshold processing and zigzag confusion operations are performed on the discrete wavelet coefficients of the plain image to meet the prerequisites for effective compression. Third, the intermediate secret information is obtained by utilizing PTP-CS in the compression layer. Information entropy and edge entropy are employed to adaptively identify the complex regions that are suitable for embedding due to inconspicuous visual degradation in the carrier image. Finally, the embedding of the secret information in the DHT domain of these regions is accomplished. Security test and performance analysis confirm that our algorithm has the advantage of a high balance between the encryption security and the decryption recovery, and exhibits excellent performance in important indicators such as visual quality, robustness and timeliness. © 2023 IOP Publishing Ltd.},
  affiliation             = {Faculty of Information Technology, Beijing University of Technology, Beijing, 100124, China; Beijing Key Laboratory of Trusted Computing, Beijing, 100124, China; School of Computer Science and Engineering, Sun Yat-Sen University, Guangzhou, 511400, China; College of Computer Science and Electronic Engineering, Hunan University, Changsha, 410082, China},
  art_number              = {105211},
  author_keywords         = {compressive sensing; discrete hartley transform; memristive chaotic map; visually meaningful cipher image},
  coden                   = {PHSTB},
  correspondence_address1 = {Yang, Y.-G.; Faculty of Information Technology, China; email: yangyang7357@bjut.edu.cn},
  document_type           = {Article},
  doi                     = {10.1088/1402-4896/acf52d},
  groups                  = {Journals},
  keywords                = {Chaotic systems; Cryptography; Embeddings; Image processing; Tensors, Chaotic map; Compressive sensing; Discrete Hartley transforms; Embeddings; Image encryption algorithm; Memristive chaotic map; Secret information; Tensor products; Visual feature; Visually meaningful cipher image, Compressed sensing},
  language                = {English},
  publisher               = {Institute of Physics},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85172727676&doi=10.1088%2f1402-4896%2facf52d&partnerID=40&md5=3e0c96ff966be6390a9bf76274b3b9f0},
}

@Article{Zhan2023,
  author                  = {Zhan, J. and Gan, Z. and Chou, L. and Hu, L. and Zhou, Y. and Yang, H. and Chou, Y.},
  journal                 = {Medical Engineering and Physics},
  title = {A fast permutation entropy for pulse rate variability online analysis with one-sample recursion},
  year                    = {2023},
  issn                    = {13504533},
  note                    = {cited By 3},
  volume                  = {120},
  abbrev_source_title = {Med. Eng. Phys.},
  abstract                = {Pulse rate variability (PRV) signals are extracted from pulsation signal can be effectively used for cardiovascular disease monitoring in wearable devices. Permutation entropy (PE) algorithm is an effective index for the analysis of PRV signals. However, PE is computationally intensive and impractical for online PRV processing on wearable devices. Therefore, to overcome this challenge, a fast permutation entropy (FPE) algorithm is proposed based on the microprocessor data updating process in this paper, which can analyze PRV signals with single-sample recursive. The simulation data and PRV signals extracted from pulse signals in “Fantasia database” were utilized to verify the performance and accuracy of the improved methods. The results show that the speed of FPE is 211 times faster than PE and maintain the accuracy of algorithm (Root Mean Squared Error = 0) for simulation data with a length of 10,000 samples and embedded dimension m = 5, time delay τ = 5, buffer length Lw = 512. For the RRV signals with 3000∼5000 samples, the result show that the consumption of FPE is less than 0.2 s, which is 175 times faster than PE. This indicates that FPE has better application performance than PE. Furthermore, a low-cost wearable signal detection system is developed to verify the proposed method, the result show that the proposed method can calculate the FPE of PRV signal online with single-sample recursive calculation. Subsequently, entropy-based features are used to explore the performance of decision trees in identifying life-threatening arrhythmias, and the method resulted in a classification accuracy of 85.43%. It can therefore be inferred that the proposed method has great potential in cardiovascular disease. © 2023 IPEM},
  affiliation             = {School of Electrical and Automatic Engineering, Changshu Institute of Technology, Suzhou, 215500, China; School of Computer and Information Technology, Northeast Petroleum University, Daqing, 163318, China; School of Chemical Engineering, Huaiyin Institute of Technology, Huaian, 223003, China; College of Electrical and Information Engineering, Lanzhou University of Technology, Lanzhou, 730050, China},
  art_number              = {104050},
  author_keywords         = {Online processing; Permutation entropy; Portable wearable devices; Pulsation signal; Pulse rate variability},
  coden                   = {MEPHE},
  correspondence_address1 = {Chou, Y.; School of Electrical and Automatic Engineering, China; email: cslgchouyx@cslg.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.medengphy.2023.104050},
  groups                  = {Journals},
  keywords                = {Biomedical signal processing; Cardiology; Data mining; Decision trees; Diseases; Entropy; Extraction; Mean square error; Signal analysis, Cardiovascular disease; Entropy algorithms; Online processing; Permutation entropy; Portable wearable device; Pulsation signal; Pulse rate variability; Simulation data; Single sample; Wearable devices, Wearable technology, accuracy; algorithm; Article; classification; controlled study; cost; data analysis; decision tree; entropy; factual database; fast permutation entropy; heart arrhythmia; heart rate variability; human; human experiment; intermethod comparison; normal human; online system; performance; pulsation signal; pulse rate; pulse rate variability; root mean squared error; sampling; simulation; cardiovascular disease; entropy; heart rate; physiologic monitoring, Algorithms; Cardiovascular Diseases; Entropy; Heart Rate; Humans; Monitoring, Physiologic},
  language                = {English},
