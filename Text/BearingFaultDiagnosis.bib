@Article{Chagas2022,
  author                  = {Chagas, E.T.C. and Frery, A.C. and Gambini, J. and Lucini, M.M. and Ramos, H.S. and Rey, A.A.},
  journal                 = {Chaos},
  title = {Statistical properties of the entropy from ordinal patterns},
  year                    = {2022},
  issn                    = {10541500},
  note                    = {cited By 4},
  number                  = {11},
  volume                  = {32},
  abbrev_source_title = {Chaos},
  abstract                = {The ultimate purpose of the statistical analysis of ordinal patterns is to characterize the distribution of the features they induce. In particular, knowing the joint distribution of the pair entropy-statistical complexity for a large class of time series models would allow statistical tests that are unavailable to date. Working in this direction, we characterize the asymptotic distribution of the empirical Shannon's entropy for any model under which the true normalized entropy is neither zero nor one. We obtain the asymptotic distribution from the central limit theorem (assuming large time series), the multivariate delta method, and a third-order correction of its mean value. We discuss the applicability of other results (exact, first-, and second-order corrections) regarding their accuracy and numerical stability. Within a general framework for building test statistics about Shannon's entropy, we present a bilateral test that verifies if there is enough evidence to reject the hypothesis that two signals produce ordinal patterns with the same Shannon's entropy. We applied this bilateral test to the daily maximum temperature time series from three cities (Dublin, Edinburgh, and Miami) and obtained sensible results. © 2022 Author(s).},
  affiliation             = {Departamento de Ciência da Computação, Universidade Federal de Minas Gerais, MG, Belo Horizonte, 30123-970, Brazil; School of Mathematics and Statistics, Victoria University of Wellington, Wellington, 6140, New Zealand; Departamento de Ingeniería Informática, Instituto Tecnológico de Buenos Aires, Av. Madero 399, Buenos Aires, C1106ACD, Argentina; Facultad de Ciencias Exactas, Naturales y Agrimensura, Universidad Nacional de Nordeste, Av. Libertad 5450 - Campus "Deodoro Roca, Corrientes, 3400, Argentina; Consejo Nacional de Investigaciones Científicas y Técnicas de Argentina (CONICET), Godoy Cruz 2290, Buenos Aires, Argentina; Centro de Procesamiento de Se Nales e Imágenes, Department of Mathematics, Universidad Tecnológica Nacional Facultad Regional Buenos Aires, Ciudad de Buenos Aires, C1179AAQ, Argentina},
  art_number              = {113118},
  correspondence_address1 = {Chagas, E.T.C.; Departamento de Ciência da Computação, MG, Brazil; email: eduarda.chagas@dcc.ufmg.br},
  document_type           = {Article},
  doi                     = {10.1063/5.0118706},
  groups                  = {Journals},
  keywords                = {entropy; temperature; time factor, Entropy; Temperature; Time Factors},
  language                = {English},
  publisher               = {American Institute of Physics Inc.},
  pubmed_id               = {36456325},
  source                  = {Scopus},
