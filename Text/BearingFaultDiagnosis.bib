}

@Article{Kowalski2008,
  author            = {Kowalski, A.M. and Plastino, A.},
  journal           = {Physica A: Statistical Mechanics and its Applications},
  title = {The interaction between matter and a field's single-mode as a quantum game},
  year              = {2008},
  note              = {Cited by: 2},
  number            = {21},
  pages             = {5065 – 5072},
  volume            = {387},
  abstract          = {We introduce a game admitting both classical and quantal players. Strategies are determined by the initial conditions of the associated dynamical system, whose time evolution is characterized by the existence of attractors that represent the possible results of the game. The physics associated to the interaction between matter and a single-mode of an electromagnetic field within a cavity is cast in these game theory terms. © 2008 Elsevier B.V. All rights reserved.},
  doi               = {10.1016/j.physa.2008.05.005},
  groups            = {Journals},
  publication_stage = {Final},
  source            = {Scopus},
  type              = {Article},
