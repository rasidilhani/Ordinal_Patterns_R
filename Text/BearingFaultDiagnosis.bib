  groups                  = {Journals},
  keywords                = {Backpropagation; Engines; Entropy; Forestry; Support vector machines; Tractors (agricultural); Vectors; Vibration analysis, Empirical Mode Decomposition; Engine state; Features vector; Information recognition; Measurement points; Permutation entropy; Random forests; State identification; Support vectors machine; Vibration signal, Empirical mode decomposition; Variational mode decomposition},
  language                = {English},
