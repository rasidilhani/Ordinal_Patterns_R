@Article{Fan2019,
  author                  = {Fan, C. and Ding, Q.},
  journal                 = {Nonlinear Dynamics},
  title = {Analysing the dynamics of digital chaotic maps via a new period search algorithm},
  year                    = {2019},
  issn                    = {0924090X},
  note                    = {cited By 20},
  number                  = {1},
  pages = {831--841},
  volume                  = {97},
  abbrev_source_title = {Nonlinear Dyn},
  abstract                = {The dynamics of chaotic maps are severely inhibited by the limited precision of the computational device that is used to implement them, and thus, their applications in cryptography and secure communications are seriously limited. To evaluate the degree of degradation of digital chaotic maps, we designed a fast period search algorithm (FPSA) that is based on a tree structure for analysing the periodicities of digital chaotic maps from a new perspective. FPSA can calculate the maximal transient length, fixed points and periodic limit cycles of digital chaotic maps in finite-precision domains quickly and accurately. Furthermore, based on this algorithm, the security of 1-D logistic maps and 2-D Arnold maps in engineering applications is analysed to demonstrate the versatility and effectiveness of our proposed algorithm. This algorithm plays an active role in analysing the structures of the functional graphs of digital chaotic maps in digital computers. © 2019, Springer Nature B.V.},
  affiliation             = {Electrical Engineering College, Heilongjiang University, Harbin, 150080, China},
  author_keywords         = {Digital chaotic maps; Dynamic degradation; Finite-precision domains; Periodic limit cycles},
