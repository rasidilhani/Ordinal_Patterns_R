  groups                  = {Journals},
  keywords                = {Electric utilities; Entropy; Forecasting; Learning systems; Multilayer neural networks; Radial basis function networks; Speed; Wind; Wind power, Ensemble empirical mode decomposition; Generalization ability; Implicit informations; Permutation entropy; Radial basis function neural networks; Unsteady characteristics; Wind speed forecasting; Wind speed time series, Recurrent neural networks},
