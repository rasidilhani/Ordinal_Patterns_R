@Article{Liu2020d,
  author                  = {Liu, X. and Xi, X. and Hua, X. and Wang, H. and Zhang, W.},
  journal                 = {Journal of Healthcare Engineering},
  title = {Feature extraction of surface electromyography using wavelet weighted permutation entropy for hand movement recognition},
  year                    = {2020},
  issn                    = {20402295},
  note                    = {cited By 8},
  volume                  = {2020},
  abbrev_source_title = {J. Healthc. Eng.},
  abstract                = {The feature extraction of surface electromyography (sEMG) signals has been an important aspect of myoelectric prosthesis control. To improve the practicability of myoelectric prosthetic hands, we proposed a feature extraction method for sEMG signals that uses wavelet weighted permutation entropy (WWPE). First, wavelet transform was used to decompose and preprocess sEMG signals collected from the relevant muscles of the upper limbs to obtain the wavelet sub-bands in each frequency segment. Then, the weighted permutation entropies (WPEs) of the wavelet sub-bands were extracted to construct WWPE feature set. Lastly, the WWPE feature set was used as input to a support vector machine (SVM) classifier and a backpropagation neural network (BPNN) classifier to recognize seven hand movements. Experimental results show that the proposed method exhibits remarkable recognition accuracy that is superior to those of single sub-band feature set and commonly used time-domain feature set. The maximum recognition accuracy rate is 100% for hand movements, and the average recognition accuracy rates of SVM and BPNN are 100% and 98%, respectively. © 2020 Xiaoyun Liu et al. This is an open access article distributed under the Creative Commons Attribution License, which permits unrestricted use, distribution, and reproduction in any medium, provided the original work is properly cited.},
  affiliation             = {School of Artificial Intelligence, Hangzhou Dianzi University, Hangzhou, 310018, China; Key Laboratory of Brain Machine Collaborative Intelligence of Zhejiang Province, Hangzhou, 310018, China; Jinhua People's Hospital, Jinhua, 321000, China; Hangzhou Vocational & Technology College, Hangzhou, 310018, China},
  art_number              = {8824194},
  correspondence_address1 = {Xi, X.; School of Artificial Intelligence, China; email: xixi@hdu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1155/2020/8824194},
  groups                  = {Journals},
  keywords                = {Backpropagation; Entropy; Extraction; Feature extraction; Motion estimation; Myoelectrically controlled prosthetics; Palmprint recognition; Support vector machines; Time domain analysis; Wavelet transforms, Back-propagation neural networks; Feature extraction methods; Frequency segments; Myoelectric prosthesis controls; Permutation entropy; Recognition accuracy; Surface electromyography; Time domain features, Biomedical signal processing, article; back propagation neural network; decomposition; electromyography; entropy; feature extraction; hand movement; human; muscle; support vector machine; upper limb; wavelet transform; algorithm; electromyography; entropy; hand; movement (physiology), Algorithms; Electromyography; Entropy; Hand; Humans; Movement; Support Vector Machine},
  language                = {English},
