  groups                  = {Journals},
  keywords                = {Commerce; Financial data processing; Financial markets; Time series, Complexity; Distribution entropies; Entropy metric; Financial time series; Parameter changes; Simulation data; Spatial distance; Tsallis entropies, Entropy},
  language                = {English},
  publisher               = {Elsevier B.V.},
