}

@Article{FabilaCarrasco2023,
  author                  = {Fabila-Carrasco, J.S. and Tan, C. and Escudero, J.},
  journal                 = {Chaos, Solitons and Fractals},
  title = {Dispersion entropy for graph signals},
  year                    = {2023},
  issn                    = {09600779},
  note                    = {cited By 7},
  volume                  = {175},
  abbrev_source_title = {Chaos Solitons Fractals},
  abstract                = {We present a novel method, called Dispersion Entropy for Graph Signals, DEG, as a powerful tool for analysing the irregularity of signals defined on graphs. DEG generalizes the classical dispersion entropy concept for univariate time series, enabling its application in diverse domains such as image processing, time series analysis, and network analysis. Furthermore, DEG establishes a theoretical framework that provides insights into the irregularities observed in graph centrality measures and in the spectra of operators acting on graphs. We demonstrate the effectiveness of DEG in detecting changes in the dynamics of signals defined on both synthetic and real-world graphs, by defining a mix process on random geometric graphs or those exhibiting small-world properties. Our results indicate that DEG effectively captures the irregularity of graph signals across various network configurations, successfully differentiating between distinct levels of randomness and connectivity. Consequently, DEG provides a comprehensive framework for entropy analysis of various data types, enabling new applications of dispersion entropy not previously feasible, and uncovering nonlinear relationships between graph signals and their graph topology. © 2023 The Author(s)},
  affiliation             = {School of Engineering, Institute for Digital Communications, University of Edinburgh, West Mains Rd, Scotland, Edinburgh, EH9 3FB, United Kingdom; School of Electrical and Information Engineering, Tianjin University, Tianjin, 300072, China},
  art_number              = {113977},
  author_keywords         = {Dispersion entropy; Entropy metrics; Graph signals; Graph topology; Nonlinear analysis},
  coden                   = {CSFOE},
  correspondence_address1 = {Fabila-Carrasco, J.S.; School of Engineering, West Mains Rd, Scotland, United Kingdom; email: John.Fabila@ed.ac.uk},
  document_type           = {Article},
  doi                     = {10.1016/j.chaos.2023.113977},
  groups                  = {Journals},
  keywords                = {Dispersion (waves); Dispersions; Graphic methods; Harmonic analysis; Image processing; Nonlinear analysis; Time series analysis; Topology, Dispersion entropy; Diverse domains; Entropy concept; Entropy metrics; Graph signal; Graph topology; Images processing; ITS applications; Novel methods; Univariate time series, Entropy},
  language                = {English},
  publisher               = {Elsevier Ltd},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85171780787&doi=10.1016%2fj.chaos.2023.113977&partnerID=40&md5=099ffb371ebdb8798fdb07223640b400},
}

@Article{Liu2023a,
  author                  = {Liu, L. and Wang, J.},
  journal                 = {Nonlinear Dynamics},
  title = {A shift coupling digital chaotic model with counteracting dynamical degradation},
  year                    = {2023},
  issn                    = {0924090X},
  note                    = {cited By 3},
  number                  = {20},
  pages = {19459--19486},
  volume                  = {111},
  abbrev_source_title = {Nonlinear Dyn},
  abstract                = {Chaotic systems are widely used in various scientific fields for their excellent nonlinear dynamics. However, when the chaotic systems are implemented on a finite precision device, their trajectories will enter a cycle, which leads to dynamical degradation. In this paper, a universal shifting coupling chaotic model is proposed, which can effectively counteract the dynamical degradation. The model couples the fractional parts of the state variables of multiple chaotic maps and shifts cyclically to the left by appropriate steps. We prove that this shift coupling method has the ideal chaotic feature, and the shift coupling chaotic model is rigorously chaotic under Wiggins’ chaos definition. Furthermore, we experiment on two different shift coupling digital chaotic models with different dimensions. Such results further demonstrate that the shift coupling digital chaotic model can effectively reduce the dynamical degradation and is quite competitive with other strategies. © 2023, The Author(s), under exclusive licence to Springer Nature B.V.},
  affiliation             = {School of Software, Nanchang University, Nanchang, 330029, China; School of Cyberspace Security, Beijing University of Posts and Telecommunications, Beijing, 100876, China},
  author_keywords         = {Chaos; Digital chaotic map; Dynamical degradation; Shift coupling},
  coden                   = {NODYE},
  correspondence_address1 = {Liu, L.; School of Software, China; email: lfliu@ncu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1007/s11071-023-08853-5},
  groups                  = {Journals},
  keywords                = {Chaotic map; Chaotic model; Chaotics; Digital chaotic map; Dynamical degradation; Finite precision; Fractional parts; Precision devices; Scientific fields; Shift coupling},
  language                = {English},
  publisher               = {Springer Science and Business Media B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85171450777&doi=10.1007%2fs11071-023-08853-5&partnerID=40&md5=30a808f5aa94293dd374e9a87c4ecd2a},
}

@Article{Gong2023,
  author                  = {Gong, J. and Yang, X. and Qian, K. and Chen, Z. and Han, T.},
  journal                 = {Alexandria Engineering Journal},
  title = {Application of improved bubble entropy and machine learning in the adaptive diagnosis of rotating machinery faults},
