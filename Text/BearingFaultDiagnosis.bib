  author_keywords         = {automatic analysis; multiple sleep latency test; narcolepsy; sleep stage classification},
  coden                   = {JNEOB},
  correspondence_address1 = {Chen, C.; Human Phenome Institute, China; email: chenchen_fd@fudan.edu.cn; Zhou, Y.; Department of Neurology, China; email: yuanfengzhou@fudan.edu.cn; Wang, Y.; Department of Neurology, China; email: yiwang@shmu.edu.cn; Chen, W.; Center for Intelligent Medical Electronics (CIME), China; email: w_chen@fudan.edu.cn},
  document_type           = {Article},
  doi                     = {10.1088/1741-2552/ac8c6b},
  groups                  = {Journals},
  keywords                = {Dynamics; Metals; Principal component analysis; Sleep research, Automatic analysis; In-phase; Joint models; Multiple sleep latency test; Narcolepsy; Sleep latency; Sleep stage; Sleep stages classifications; Sleep staging; Transition dynamics, Electroencephalography, Article; autoanalysis; child; clinical article; clinical assessment; clinical feature; comparative study; controlled study; diagnostic test accuracy study; dimensionality reduction; electroencephalogram; electromyogram; electrooculogram; eye movement; feature extraction; feature selection; female; human; information processing; male; narcolepsy; nonREM sleep; patient identification; polysomnography; principal component analysis; sensitivity and specificity; sleep latency; sleep stage; wavelet transform; electrooculography; physiology; procedures; sleep; sleep stage, Child; Electrooculography; Humans; Narcolepsy; Polysomnography; Sleep; Sleep Stages},
