}

@Article{Zhao2020a,
  author                  = {Zhao, D. and Liu, S. and Cheng, S. and Sun, X. and Wang, L. and Wei, Y. and Zhang, H.},
  journal                 = {Measurement Science and Technology},
  title = {Dense multi-scale entropy and it's application in mechanical fault diagnosis},
  year                    = {2020},
  issn                    = {09570233},
  note                    = {cited By 7},
  number                  = {12},
  volume                  = {31},
  abbrev_source_title = {Meas. Sci. Technol.},
  abstract                = {Multi-scale entropy (MSE) is a widely recognized feature extraction approach to mechanical fault diagnosis, for it can effectively estimate the complexity of nonlinear time series. For MSE algorithm, due to the sensitivity of entropy estimation on series length, the scale factors are often required to be limited to a small range. Nevertheless, in the existing MSE methods, the scale factors can only be set to positive integers with a fixed minimum step size, which may result in insufficient analysis precision and cannot provide high-quality feature vectors with sufficient eigenvalues for intelligent diagnosis in the limited scale range. In view of the above defects, this paper subdivides the scale factors and proposes dense multi-scale entropy. In the suggested method, the number of data points in the raw sequence is expanded on the premise of guaranteeing the characteristics of the original series. Based on this, the timescale of the original series is refined and more intensive scale factors with higher precision can be provided. The superiority of the method developed in this work is verified by using CWRU bearing and reciprocating compressor gas valve fault data sets, and the results indicate that the method of this paper can provide more precise analysis scale and feature vectors with higher quality for intelligent diagnosis. © 2020 IOP Publishing Ltd.},
  affiliation             = {School of Mechatronic Engineering and Automation, Shanghai University, Shanghai, 200072, China},
  art_number              = {125008},
  author_keywords         = {dense scale factor; feature vector; mechanical fault diagnosis; multi-scale entropy; up-sample},
  coden                   = {MSTCE},
  correspondence_address1 = {Liu, S.; School of Mechatronic Engineering and Automation, China; email: lsl346@shu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1088/1361-6501/aba4da},
  groups                  = {Journals},
  keywords                = {Compressibility of gases; Eigenvalues and eigenfunctions; Entropy; Failure analysis; Quality control; Reciprocating compressors, Entropy estimation; Feature vectors; Intelligent diagnosis; Mechanical fault diagnosis; Multi-scale entropies; Nonlinear time series; Positive integers; Precise analysis, Fault detection},
  language                = {English},
  publisher               = {IOP Publishing Ltd},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85094200623&doi=10.1088%2f1361-6501%2faba4da&partnerID=40&md5=c0fe363fc31b25d15b519d35fb992947},
}

@Article{Wu2020a,
  author                  = {Wu, Z. and Zhang, Q. and Cheng, L. and Hou, S. and Tan, S.},
  journal                 = {Renewable Energy},
  title = {The VMTES: Application to the structural health monitoring and diagnosis of rotating machines},
  year                    = {2020},
  issn                    = {09601481},
  note                    = {cited By 7},
  pages = {2380--2396},
  volume                  = {162},
  abbrev_source_title = {Renew. Energy},
  abstract                = {It is a challenging task to perform the non-linear system state recognition and safety monitoring under strong noise and complex excitation, to tackle this problem, we innovatively propose the variational mode decomposition multiscale holographic transfer entropy statistics (VMTES) method based on the energy transfer relationship between non-linear system signals. The VMTES is a method that measures the information flow direction and coupling degree between non-linear systems, which can precisely measure the slight changes of energy transfer of a mechanical system, accurately assess the slight mutation of dynamical behaviors and status change of a mechanical system and therefore realize fault location and quantification of the non-linear rotating machinery system. The damage severity and direction of the measure point can be precisely described with the VMTES damage assessment indicator, providing the reliable basis for the structural health monitoring and fault diagnosis of the mechanical system. By applying the result to the state recognition of a chaotic system and the structural health monitoring of a rotating machinery system, we can see from the experimental results that the VMTES can effectively detect the fault of gears and rolling bearings under several working conditions. Based on the experiment, we also explain how this method simultaneously locate and quantify the non-linear vibration caused by the fault. © 2020 Elsevier Ltd},
  affiliation             = {School of Mechanical Engineering, Hebei University of Science and Technology, Shijiazhuang, 050018, China; Key Laboratory of vehicle Transmission, China North Vehicle Research Institute, Beijing, 100072, China; School of Mechanical and Vehicle Engineering, Beijing Institute of Technology, Beijing, 100081, China},
  author_keywords         = {Multiscale holographic transfer entropy; Rotating machinery; Structural health monitoring; VMTES},
  correspondence_address1 = {Wu, Z.; School of Mechanical Engineering, China; email: wuzhe@hebust.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.renene.2020.10.021},
  groups                  = {Journals},
  keywords                = {Chaotic systems; Damage detection; Energy transfer; Excited states; Fault detection; Linear systems; Mechanics; Nonlinear systems; Roller bearings; Rotating machinery; State estimation, Damage assessments; Dynamical behaviors; Information flows; Mechanical systems; Mode decomposition; Non-linear vibrations; Safety monitoring; Structural health, Structural health monitoring, decomposition analysis; detection method; experimental study; health monitoring; machinery; vibration},
  language                = {English},
  publisher               = {Elsevier Ltd},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85092481824&doi=10.1016%2fj.renene.2020.10.021&partnerID=40&md5=f4faeb8162aa6e51743b47ce0d8a6104},
}

@Article{Melchor2020,
  author                  = {Melchor, I. and Almendros, J. and Carniel, R. and Konstantinou, K.I. and Hantusch, M. and Caselli, A.},
  journal                 = {Earth, Planets and Space},
  title = {On data reduction methods for volcanic tremor characterization: the 2012 eruption of Copahue volcano, Southern Andes},
  year                    = {2020},
  issn                    = {13438832},
  note                    = {cited By 8},
  number                  = {1},
  volume                  = {72},
  abbrev_source_title = {Earth Planets Space},
  abstract                = {Improving the ability to detect and characterize long-duration volcanic tremor is crucial to understand the long-term dynamics and unrest of volcanic systems. We have applied data reduction methods (permutation entropy and polarization degree, among others) to characterize the seismic wave field near Copahue volcano (Southern Andes) between June 2012 and January 2013, when phreatomagmatic episodes occurred. During the selected period, a total of 52 long-duration events with energy above the background occurred. Among them, 32 were classified as volcanic tremors and the remaining as noise bursts. Characterizing each event by averaging its reduced parameters, allowed us to study the range of variability of the different events types. We found that, compared to noise burst, tremors have lower permutation entropies and higher dominant polarization degrees. This characterization is a suitable tool for detecting long-duration volcanic tremors in the ambient seismic wave field, even if the SNR is low.[Figure not available: see fulltext.] © 2020, The Author(s).},
  affiliation             = {Instituto de Investigación en Paleobiología y Geología, Universidad Nacional de Río Negro–CONICET, General Roca, Río Negro, Argentina; Instituto Andaluz de Geofísica, Universidad de Granada, Granada, Spain; Dipartimento Politecnico di Ingegneria e Architettura, Università degli Studi di Udine, Udine, Friuli, Italy; Department of Earth Sciences, National Central University, Jhongli, Taiwan},
  art_number              = {134},
  author_keywords         = {Copahue volcano; Data reduction method; Permutation entropy; Phreatic eruption; Polarization degree; Volcanic tremor},
  correspondence_address1 = {Melchor, I.; Instituto de Investigación en Paleobiología y Geología, Argentina; email: ifmelchor@unrn.edu.ar},
  document_type           = {Article},
  doi                     = {10.1186/s40623-020-01270-7},
  groups                  = {Journals},
  keywords                = {phreatomagmatism; polarization; seismic wave; volcanic eruption; volcanism; volcanology; wave field, Andes; Copahue; Neuquen; Southern Volcanic Zone},
  language                = {English},
  publisher               = {Springer Science and Business Media Deutschland GmbH},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85090936585&doi=10.1186%2fs40623-020-01270-7&partnerID=40&md5=b23704d5637ca691cfec9b01c08d9c80},
}

@Article{Silva2020,
  author                  = {Silva, L.E.V. and Fazan, R., Jr. and Marin-Neto, J.A.},
