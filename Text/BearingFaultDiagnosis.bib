  groups                  = {Journals},
  keywords                = {Building materials; Coal; Coal industry; Construction industry; Decomposition; Energy conservation; Forecasting; Motion planning; Production control; Steelmaking, Coal demand; Coal demand forecasting; Data characteristics; Data-characteristic-driven; Demand forecasting; Ensemble models; Industry based; Key coal consuming industry; Power industry; Thermal power, Emission control, accuracy assessment; coal industry; demand-side management; forecasting method; model test; prediction; thermal power, China},
  language                = {English},
