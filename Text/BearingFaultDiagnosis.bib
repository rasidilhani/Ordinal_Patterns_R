  doi                     = {10.1177/1077546320929145},
  groups                  = {Journals},
  keywords                = {Tall buildings; Vibration analysis, Approximate entropy; Civil structure; Dynamic vibration; Entropy algorithms; High rise building; Permutation entropy; Shannon entropy; Vibrational response, Damage detection},
  language                = {English},
  publisher               = {SAGE Publications Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85085469712&doi=10.1177%2f1077546320929145&partnerID=40&md5=9ce0f30110537618a288a46690b5a719},
