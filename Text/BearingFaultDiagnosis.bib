  author_keywords         = {AMDSDE; Fault diagnosis; Fault pattern recognition; Planetary gearbox; VMSMF},
  coden                   = {IJATE},
  correspondence_address1 = {Cui, L.; Key Laboratory of Advanced Manufacturing Technology, Chao Yang District, China; email: acuilingli@163.com},
  document_type           = {Article},
  doi                     = {10.1007/s00170-021-08085-0},
  groups                  = {Journals},
  keywords                = {Entropy; Failure analysis; Fault detection; Gears; Signal to noise ratio; Statistics, Average multi-scale double symbolic dynamic entropy; Dynamic-entropy; Fault pattern recognition; Fault patterns; Faults diagnosis; Morphological filtering; Multi-scales; Planetary gearboxes; Symbolic Dynamics; Variable multi-scale morphological filtering, Pattern recognition},
  language                = {English},
