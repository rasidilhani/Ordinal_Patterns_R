  document_type           = {Review},
  doi                     = {10.1016/j.neuroscience.2024.08.017},
  groups                  = {Journals},
  keywords                = {biological marker, aged; Alzheimer disease; brain function; controlled study; degenerative disease; double blind procedure; electroencephalogram; electroencephalography; entropy; female; functional neuroimaging; human; magnetoencephalography; major clinical study; neurologic disease; oral drug administration; quality of life; review; treatment response; brain; diagnosis; electroencephalography; magnetoencephalography; pathophysiology; procedures, Alzheimer Disease; Biomarkers; Brain; Electroencephalography; Entropy; Humans; Magnetoencephalography},
  language                = {English},
