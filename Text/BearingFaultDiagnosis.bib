  document_type           = {Article},
  doi                     = {10.1177/14759217221116417},
  groups                  = {Journals},
  keywords                = {Continuous time systems; Failure analysis; Fault detection; Time series analysis, Fault diagnosis of rotating machineries; Faults diagnosis; Features extraction; Hierarchical analysis; Industrial equipment; Intelligent fault diagnosis; Key topics; Sample entropy; Symbolic data; Symbolization, Rotating machinery},
  language                = {English},
