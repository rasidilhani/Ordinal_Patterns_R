  groups                  = {Journals},
  keywords                = {Costs; Dynamics; Economics; Entropy; Gasoline; Information theory; Petroleum industry; Petroleum refining; Wavelet transforms, Continuous Wavelet Transform; Geopolitical risks; Granger Causality; Information theoretic measure; Investment horizon; Novel methodology; Price transmission; Wavelet transfers, Crude oil price, asymmetry; crude oil; Granger causality test; maximum entropy analysis; nonlinearity; oil production; price dynamics},
