  document_type           = {Article},
  doi                     = {10.1109/TCSII.2023.3240405},
  groups                  = {Journals},
  keywords                = {Behavioral research; Bifurcation (mathematics); Field programmable gate arrays (FPGA); Stability; Timing circuits, Behavioral science; Bifurcation; Cascaded bi-memristor map; Circuit stability; Fixed points; FPGA implementations; FPGAs implementation; Hyperchaos; Memristor; Stability analyze, Memristors},
  language                = {English},
