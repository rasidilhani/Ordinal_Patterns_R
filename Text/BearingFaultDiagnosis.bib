  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85180221001&doi=10.1002%2fjbio.202300363&partnerID=40&md5=0eac2fb6fed9b6e62340e750bac657aa},
}

@Article{Mishra2024,
  author                  = {Mishra, S.P. and Warule, P. and Deb, S.},
  journal                 = {Biomedical Signal Processing and Control},
  title = {Improvement of emotion classification performance using multi-resolution variational mode decomposition method},
  year                    = {2024},
  issn                    = {17468094},
  note                    = {cited By 9},
  volume                  = {89},
  abbrev_source_title = {Biomed. Signal Process. Control},
  abstract                = {Automated speech emotion recognition (SER) has been gaining popularity among researchers for three decades because of its vast number of applications in the real world. It is helpful to improve the relationship between humans and machines, online marketing and education, customer relations, medical treatment, safe driving, online search, etc. Researchers adopt various methods to improve emotion recognition performance from speech signals, like using different combinations of features (acoustic, non-acoustic, or both), classifiers (machine learning, deep learning, or both). Our study tried to improve emotion classification performance using features based on the multi-resolution variational mode decomposition (MRVMD) method. We first decompose each signal frame into several sub-signals known as modes or intrinsic mode functions (IMFs) using the MRVMD method. Then the proposed features, multi-resolution variational mode mel-frequency cepstral coefficient (MRVMMFCC), multi-resolution variational mode approximate entropy (MRVMAE), and multi-resolution variational mode permutation entropy (MRVMPE), were extracted using the MRVMD-decomposed IMF signals. Finally, different combinations of the proposed features are used to classify the emotion using a deep neural network (DNN) classifier. From the experimental results, we found that combination of the proposed feature (MRVMMFCC + MRVMAE + MRVMPE) performs better than the other combination in recognizing emotion using speech signals. The proposed feature combination with a DNN classifier achieved an emotion classification accuracy of 83.4%, 85.01%, and 90.51% for the SAVEE, EMOVO, and EMO-DB datasets, respectively. We found that the proposed MRVMD method performed better than the state-of-the-art methods. © 2023 Elsevier Ltd},
  affiliation             = {Sardar Vallabhbhai National Institute of Technology, Gujarat, Surat, India},
  art_number              = {105708},
  author_keywords         = {Deep neural network; MRVMAE; MRVMD; MRVMMFCC; MRVMPE; Speech emotion recognition},
  correspondence_address1 = {Mishra, S.P.; Sardar Vallabhbhai National Institute of Technology, Gujarat, India; email: ds20ec005@eced.svnit.ac.in},
  document_type           = {Article},
  doi                     = {10.1016/j.bspc.2023.105708},
  groups                  = {Journals},
  keywords                = {Classification (of information); Deep neural networks; Emotion Recognition; Entropy; Public relations; Speech communication; Speech recognition, Emotion classification; Mel frequency cepstral co-efficient; Mel-frequency cepstral coefficients; Mode decomposition method; Multi-resolution variational mode approximate entropy; Multi-resolution variational mode decomposition; Multi-resolution variational mode mel-frequency cepstral coefficient; Multi-resolution variational mode permutation entropy; Permutation entropy; Speech emotion recognition, Variational mode decomposition, article; classifier; decomposition; deep neural network; emotion; entropy; human; human experiment; intrinsic mode function; machine learning; speech},
  language                = {English},
