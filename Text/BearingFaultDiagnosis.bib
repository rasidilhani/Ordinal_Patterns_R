@Conference{DominguezMonterroza2023,
  author                  = {Dominguez-Monterroza, A. and Patino-Vanegas, A.},
  title = {Quantifying the Complexity of Mental Stress during Academic Exams Using Wearable Skin Conductance Signals},
  year                    = {2023},
  editor                  = {Mendoza P.S., Navarro A.},
  note                    = {cited By 0},
