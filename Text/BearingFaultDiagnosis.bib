  groups                  = {Journals},
  keywords                = {Commerce; Costs; Crude oil; Entropy; Information theory; Investments, Causal relationships; Complexity; Delayed information; Dynamic complexity; Granger Causality; Information flows; Information transfers; Oil Prices, Financial markets, commodity price; complexity; crude oil; energy market; Granger causality test; information; stock market},
  language                = {English},
