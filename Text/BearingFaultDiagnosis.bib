  document_type           = {Article},
  doi                     = {10.1016/j.chaos.2023.113258},
  groups                  = {Journals},
  keywords                = {Chaotic systems; Differential equations; Discrete Fourier transforms; Geometry; Iterative methods; Lyapunov functions; Lyapunov methods, Calculation accuracy; Chaotic map; Design control; Geometric control; Hardware devices; Information assurance; Iterative model; Lyapunov exponent; Polynomial chaotic map; PRNG, Polynomials},
  language                = {English},
