  coden                   = {CSFOE},
  correspondence_address1 = {Yang, Z.; School of Electronics and Information Engineering, China; email: yzl_04116@163.com},
  document_type           = {Article},
  doi                     = {10.1016/j.chaos.2023.113841},
  groups                  = {Journals},
  keywords                = {Cryptography; Differential equations; Field programmable gate arrays (FPGA); Image processing; Lyapunov functions; Lyapunov methods, Chaotic behaviour; Chaotic map; Chaotics; Field-programmable gate array implementations; Images encryptions; ITS applications; Lyapunov exponent; Multi dimensional; One-dimensional; Simple structures, Chaotic systems},
  language                = {English},
  publisher               = {Elsevier Ltd},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85166302255&doi=10.1016%2fj.chaos.2023.113841&partnerID=40&md5=d96cc493d1882b8fba5f4a23dbd06f8f},
}

