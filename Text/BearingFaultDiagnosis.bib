@Article{Soni2024,
  author                  = {Soni, A. and Rawal, K.},
  journal                 = {Biomedical Signal Processing and Control},
  title = {Analyzing the effect of postural change on heart rate variability using multi-distance sample entropy (MDSE)},
  year                    = {2024},
  issn                    = {17468094},
  note                    = {cited By 3},
  volume                  = {87},
  abbrev_source_title = {Biomed. Signal Process. Control},
  abstract                = {One of the most studied physiological measures is heart-rate variability. In this research paper, a new nonlinear method called Multi Distance Sample Entropy (MDSE) is proposed to accurately detect the variation of Heart rate variability (HRV) for different body postures and examine its effect on the activity of the autonomic nervous system. The proposed method used a multi-distance function to calculate the distance between other matched vector pairs. The goal of employing considerable distances is to investigate the distance aspect for enhancing the accuracy of recognizing the proper trend of HRV for the postural shift. Thus, the ECG signals of 55 participants were recorded in the supine posture for 10 min and similarly, for 10 min in the standing posture using the BIOPAC®MP36 system. The noise signals have been simulated for varied data lengths, and their error bars have been plotted using the proposed and conventional sample entropy (SE) methods to demonstrate the superiority of the proposed MDSE method over the SE. Afterward, the proposed method (MDSE) and other existing methods were applied to the recorded dataset. From the obtained results, it is clear that the proposed method can accurately detect the variation of HRV in supine and standing postures than other applied methods. Using the MDSE method, HRV trends are 6.91% more accurate than Conventional SE and 10.85% more accurate than approximation entropy (AE) for the recorded dataset. The Spearman rank correlation between proposed and applied nonlinear methods has also been evaluated. © 2023 Elsevier Ltd},
  affiliation             = {School of Electronics and Electrical Engineering, Lovely Professional University, Punjab, Phagwara, India},
  art_number              = {105476},
  author_keywords         = {Autonomic nervous system (ANS); Heart rate variability; Postural change; Sample entropy},
  correspondence_address1 = {Rawal, K.; School of Electronics and Electrical Engineering, Punjab, India; email: kirti.20248@lpu.co.in},
  document_type           = {Article},
  doi                     = {10.1016/j.bspc.2023.105476},
  groups                  = {Journals},
  keywords                = {Heart, Autonomic nervous; Autonomic nervous system; Entropy methods; Heart rate variability; Non-linear methods; Physiological measures; Postural change; Research papers; Sample entropy; Standing posture, Entropy, adult; article; autonomic nervous system; body position; controlled study; electrocardiogram; electrocardiography; entropy; female; heart rate variability; human; human experiment; major clinical study; male; noise; simulation},
  language                = {English},
  publisher               = {Elsevier Ltd},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85171984929&doi=10.1016%2fj.bspc.2023.105476&partnerID=40&md5=5573c4435cda63d85ca44c1dafea4f62},
}

@Article{MarinLopez2024,
  author                  = {Marin-Lopez, A. and Martinez-Martinez, F. and Martínez-Cadena, J.A. and Alvarez-Ramirez, J.},
  journal                 = {Biomedical Signal Processing and Control},
  title = {Multiscale {Svd} entropy for the analysis of gait dynamics},
  year                    = {2024},
  issn                    = {17468094},
  note                    = {cited By 1},
  volume                  = {87},
  abbrev_source_title = {Biomed. Signal Process. Control},
  abstract                = {This work explores the use of singular value decomposition (SVD) entropy to characterize the complexity of stride interval sequences from gait dynamics. The computation of the approximate (ApEn) and sample (SampEn) entropies require the specification of the length of the scrutinized patterns (m) and the pattern similarity tolerance (r). In contrast, the SVD entropy estimation does not require these parameters since the computations are based on the inspection of similarities among lagged vectors. In this regard, the present work aims to assess the SVD entropy to characterize gait dynamics. The gait maturation and the neurodegenerative disease (NDD) datasets from Physionet were considered. The SVDEn of the gait dynamics decreased with the age to normalized values of about 0.2. In contrast, the SampEn, which was used for comparison, decreased to values close to zero. For the gait NDD dataset, it was found that the gait dynamics of Parkinson, ASL and Huntington pathologies exhibit increased SVDEn relative to a control group, with normalized values of about 0.2 and 0.4, respectively. However, the SVDEn and the SampEn were unable to distinguish between the control and neurodisease groups (p < 0.05). Overall, the results indicated that the gait dynamics of the NDD are less regular than that of the control group. Although the SVDEn and other entropy metrics (e.g., SampEn) showed similar results, the SVDEn offers the advantage that the computation require the specification of only the scale parameter. © 2023},
  affiliation             = {Departamento de Ingeniería de Procesos e Hidráulica, Universidad Autonoma Metropolitana-Iztapalapa, Apartado Postal 55-534, Iztapalapa, CDMX, 09340, Mexico; Facultad de Ciencias Químicas, Universidad Veracruzana-Región Xalapa, Circuito Gonzalo Aguirre Beltrán S/N, Ver, Xalapa, 91000, Mexico; Departamento de Matemáticas, Universidad Autonoma Metropolitana-Iztapalapa, Apartado Postal 55-534, Iztapalapa, CDMX, 09340, Mexico},
  art_number              = {105439},
  author_keywords         = {Entropy; Gait dynamics; Multiscale; SVD},
  correspondence_address1 = {Martinez-Martinez, F.; Facultad de Ciencias Químicas, Circuito Gonzalo Aguirre Beltrán S/N, Ver, Mexico; email: filmartinez@uv.mx},
  document_type           = {Article},
  doi                     = {10.1016/j.bspc.2023.105439},
  groups                  = {Journals},
  keywords                = {Dynamics; Neurodegenerative diseases; Parameter estimation; Singular value decomposition; Specifications, Control groups; Entropy estimation; Entropy metrics; Gait dynamic; Interval sequences; Multiscale; Normalized values; Pattern similarity; PhysioNet; Scale parameter, Entropy, adult; aged; amyotrophic lateral sclerosis; Article; child; comparative study; controlled study; degenerative disease; entropy; gait; human; Huntington chorea; locomotion; major clinical study; maximum entropy model; neurofeedback; Parkinson disease; singular value decomposition; spectroscopy; walking},
  language                = {English},
