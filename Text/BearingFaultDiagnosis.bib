  keywords                = {Entropy; Field programmable gate arrays (FPGA); Integrated circuit design; Lyapunov methods; Number theory; Random number generation; Throughput, Cross-coupled; Discrete hyper-chaotic system; Embedded cross-coupled; Field programmables; Field-programmable gate array; High-throughput; Hyper-chaotic systems; NIST; Programmable gate array; Pseudorandom number generators, Chaotic systems},
