@Article{Ramos2020,
  author                  = {Ramos, A.M.T. and Casagrande, H.L. and Macau, E.E.N.},
  journal                 = {Physica A: Statistical Mechanics and its Applications},
  title = {Investigation on the high-order approximation of the entropy bias},
  year                    = {2020},
  issn                    = {03784371},
  note                    = {cited By 2},
  volume                  = {549},
  abbrev_source_title = {Phys A Stat Mech Appl},
  abstract                = {The estimation of entropy from experimental data has a considerable bias when the discretization of the variable domain is comparable to the sample size. In this case, the source of the bias is the difference between the a priori distribution and the observed distribution from sampled data. In this paper, we estimate the entropy bias considering an infinite sum of central moments of the binomial distribution using two probability mass functions. We analyze the bias in the light of the ratio between the number of the partition of the domain and the sample size. The main motivation of this study is improving statistical hypothesis testing in which probabilities are conceived beforehand. We examine the adequacy of high-order approximation according to the ratio between the sample size and the number of domain partitions. Finally, we expand the analysis to the entropy-derived mutual information and present an application for network reconstruction. © 2020},
  affiliation             = {Quantitative Research, Itaú Asset Management, São Paulo, 04538-132, Brazil; National Institute for Space Research - INPE, 12227-010 São José dos Campos, SP, Brazil; Institute of Science and Technology, Federal University of São Paulo- UNIFESP, 12247-014 São José dos Campos, SP, Brazil},
  art_number              = {124301},
  author_keywords         = {Complex network; Entropy bias; Multiple comparison analysis; Mutual information},
  coden                   = {PHYAD},
  correspondence_address1 = {Ramos, A.M.T.; National Institute for Space Research - INPE, 12227-010 São José dos Campos, Brazil; email: amtramos@protonmail.com},
  document_type           = {Article},
  doi                     = {10.1016/j.physa.2020.124301},
  groups                  = {Journals},
  keywords                = {Probability distributions; Testing, Binomial distribution; Central moments; High-order approximation; Mutual informations; Network reconstruction; Priori distribution; Probability mass function; Statistical hypothesis testing, Entropy},
  language                = {English},
  publisher               = {Elsevier B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85079868660&doi=10.1016%2fj.physa.2020.124301&partnerID=40&md5=0e45aad4370f4c2d216022cde078825d},
}

@Article{Hu2020a,
  author                  = {Hu, Y. and Li, H. and Luan, T.H. and Yang, A. and Sun, L. and Wang, Z. and Wang, R.},
  journal                 = {Future Generation Computer Systems},
  title = {Detecting stealthy attacks on industrial control systems using a permutation entropy-based method},
  year                    = {2020},
  issn                    = {0167739X},
  note                    = {cited By 31},
  pages = {1230--1240},
  volume                  = {108},
  abbrev_source_title = {Future Gener Comput Syst},
  abstract                = {The modern Industrial Control Systems (ICS) now exhibit an increasing connectivity to the corporate Internet Technology (IT) networks so as to make use of the rich resources in IT networks. The increasing interaction between ICS and the outside IT world, however, has made them an attractive target for a variety of cyber attacks, raising great need to secure the ICS. In ICS, skilled attackers can manipulate sensor readings or control signals until the system crashes, while still keeping the attack process hidden by closely following the expected behavior of the system. This kind of attacks is called stealthy attacks, which cannot be detected by traditional intrusion detection methods in which only the magnitudes of residuals are evaluated. In this paper, we show that the residuals generated during a stealthy attack present some sort of regularity besides the magnitudes. Based on this observation, we propose a novel permutation entropy-based approach to detect stealthy attacks on ICS. The permutation entropy can characterize the non-randomness contained in the residuals so as to distinguish the residuals during a stealthy attack from a random series effectively. A significant change of the permutation entropy indicates the occurrence of a stealthy attack. Finally, we conduct comprehensive experiments to verify the effectiveness of the proposed stealthy attack detection approach. © 2018 Elsevier B.V.},
  affiliation             = {School of Computer and Communication Engineering, University of Science and Technology Beijing, China; Beijing Key Laboratory of IoT Information Security, Institute of Information Engineering, Chinese Academy of Sciences, China; School of Cyber Security, University of Chinese Academy of Sciences, China; School of Cyber Engineering, Xidian University, China; Science and Technology on Integrated Information System Laboratory, Institute of Software, Chinese Academy of Sciences, China},
  author_keywords         = {Industrial control systems; Intrusion detection systems; Permutation entropy; Stealthy attacks},
  coden                   = {FGCSE},
  correspondence_address1 = {Li, H.; Beijing Key Laboratory of IoT Information Security, China; email: lihong@iie.ac.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.future.2018.07.027},
  groups                  = {Journals},
  keywords                = {Computer crime; Control systems; Entropy; Intrusion detection; Network security, Attack detection; Industrial control systems; Internet technology; Intrusion detection method; Intrusion Detection Systems; Permutation entropy; Sensor readings; Stealthy attacks, Intelligent control},
  language                = {English},
  publisher               = {Elsevier B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85052062165&doi=10.1016%2fj.future.2018.07.027&partnerID=40&md5=8134cbcf5668debc0968ce8f0862b9fa},
}

@Article{Aung2020,
  author                  = {Aung, S.T. and Wongsawat, Y.},
  journal                 = {Frontiers in Physiology},
  title = {Modified-Distribution Entropy as the Features for the Detection of Epileptic Seizures},
  year                    = {2020},
  issn                    = {1664042X},
  note                    = {cited By 15},
  volume                  = {11},
  abbrev_source_title = {Front. Physiol.},
  abstract                = {Epilepsy is one of the most common chronic neurological disorders, and therefore, diagnosis and treatment methods are urgently needed for these patients. Many methods and algorithms that can detect seizures in epileptic patients have been proposed. Electroencephalogram (EEG) is one of helpful tools for investigating epilepsy forms in patients, however, an expert in the neurological field must perform a visual inspection to identify a seizure. Such analyses require longer time because of the huge dataset recorded from many electrodes which are put on the human scalp. With the non-stationary nature of EEG, especially during the abnormality periods, entropy measures gain more interest in the field. In this work, by exploring the advantages of both reliable state-of-the-art entropies, fuzzy entropy and distribution entropy, a modified-Distribution entropy (mDistEn) for epilepsy detection is proposed. As the results, the proposed mDistEn method can successfully achieve the same consistency and better accuracy than using the state-of-the-art entropies. The mDistEn corresponds to higher Area Under the Curve (AUC) values compared with the fuzzy entropy and the distribution entropy and yields 92% classification accuracy. © Copyright © 2020 Aung and Wongsawat.},
  affiliation             = {Department of Biomedical Engineering, Faculty of Engineering, Mahidol University, Salaya, Thailand},
  art_number              = {607},
  author_keywords         = {distribution entropy; electroencephalogram (EEG); entropy; epilepsy; fuzzy entropy},
  correspondence_address1 = {Wongsawat, Y.; Department of Biomedical Engineering, Thailand; email: yodchanan.won@mahidol.ac.th},
  document_type           = {Article},
  doi                     = {10.3389/fphys.2020.00607},
  groups                  = {Journals},
  keywords                = {Article; clinical feature; controlled study; data analysis; diagnostic accuracy; diagnostic test accuracy study; disease classification; electroencephalogram; epileptic patient; fuzzy system; human; maximum entropy model; prediction; seizure; sensitivity and specificity},
  language                = {English},
  publisher               = {Frontiers Media S.A.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85087685298&doi=10.3389%2ffphys.2020.00607&partnerID=40&md5=e8698900caee7859c07b5877a361c78a},
}

@Article{Lang2020,
  author                  = {Lang, X. and Zhang, Y. and Xie, L. and Jin, X. and Horch, A. and Su, H.},
  journal                 = {Industrial and Engineering Chemistry Research},
  title = {Use of Fast Multivariate Empirical Mode Decomposition for Oscillation Monitoring in Noisy Process Plant},
  year                    = {2020},
  issn                    = {08885885},
  note                    = {cited By 27},
  number                  = {25},
  pages = {11537--11551},
  volume                  = {59},
  abbrev_source_title = {Ind. Eng. Chem. Res.},
  abstract                = {Industrial signal measurement and processing are increasingly being deployed in control performance assessment, particularly in oscillation monitoring applications. In this paper, we present a novel oscillation detector, which mainly leverages the recently developed fast multivariate empirical mode decomposition (FMEMD). Our use of FMEMD is motivated by the following facts: (i) considerably fewer techniques are now available for monitoring both single-loop and plant-wide oscillations; (ii) the presence of noise and signal intermittency can severely deteriorate the detecting performance of most decomposition-based time-frequency methods; and (iii) the currently popular multivariate empirical mode decomposition (MEMD)-based methods are limited by high computational load and overdecomposition. The proposed approach is tested against the related techniques, including empirical mode decomposition (EMD), direct multivariate intrinsic time-scale decomposition (DMITD), and the noise-assisted MEMD (NA-MEMD) by extensive simulations, and is shown to offer considerable progress, especially in noise robustness, mode-mixing reduction, and intermittent and nonlinearity-induced oscillation extraction. The validity of this work is finally demonstrated by industrial cases. © 2020 American Chemical Society.},
  affiliation             = {Department of Electronic Engineering, Information School, Yunnan University, Kunming, 650091, China; State Key Laboratory of Industrial Control Technology, Zhejiang University, Hangzhou, 310027, China; School of Software, Yunnan University, Kunming, 650091, China; HIMA Paul Hildebrandt GmbH, Albert-Bassermann-Str. 28, Bruehl bei Mannheim, 68782, Germany},
  coden                   = {IECRE},
  correspondence_address1 = {Xie, L.; State Key Laboratory of Industrial Control Technology, China; email: leix@iipc.zju.edu.cn},
  document_type           = {Article},
  doi                     = {10.1021/acs.iecr.9b06351},
  groups                  = {Journals},
  keywords                = {Computational loads; Empirical Mode Decomposition; Extensive simulations; Intrinsic time-scale decompositions; Monitoring applications; Multivariate empirical mode decomposition (MEMD); Plant-wide oscillation; Time-frequency methods, Signal processing},
  language                = {English},
  publisher               = {American Chemical Society},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85087629858&doi=10.1021%2facs.iecr.9b06351&partnerID=40&md5=6452bef9fa478f660e612b29bb7df7ff},
}

@Article{AliShah2020,
  author                  = {Ali Shah, S.A. and Habib, N. and Ahmed Nadeem, M.S. and Alshdadi, A.A. and Alqarni, M. and Aziz, W.},
  journal                 = {Traitement du Signal},
  title = {Extraction of dynamical information and classification of heart rate variability signals using scale based permutation entropy measures},
  year                    = {2020},
  issn                    = {07650019},
  note                    = {cited By 7},
  number                  = {3},
  pages = {355--365},
  volume                  = {37},
  abbrev_source_title = {Trait. Signal},
  abstract                = {The dynamical fluctuations in the Heart Rate Variability (HRV) signals show structures at multiple time scales revealing that complexity of the autonomic nervous system control of the heart is multiscale and hierarchical. Multiscale Entropy (MSE) and its variant Composite MSE (CMSE) were proposed to quantify the complexity at multiple time scales, however, these measures failed to quantify complexity accurately for short duration signals at large temporal scales. To address the downsides of MSE and CMSE, Multiscale Permutation Entropy (MPE) and Improved MPE (IMPE) were proposed. The preliminary results reveal that MPE and IMPE were able to distinguish healthy and pathological subjects, however, further studies are needed to investigate the robustness of these measures. In this study, we investigate the robustness of scale based PE measures in terms of dynamical information, induction of undefined entropy estimates for short duration signals and to classify HRV signals under different physiological and pathological conditions. The results were compared with SE, PE, MSE and CMSE. The MPE and IMPE along with MSE and CMSE provided accurate dynamical information. The results revealed that MPE and IMPE resolved the issue of inducing undefined entropy estimates and are robust in classifying healthy and different pathological subjects. © 2020 Lavoisier. All rights reserved.},
  affiliation             = {Department of Computer Sciences and Information Technology, University of Azad Jammu and Kashmir, Muzaffarabad, AJ&K, 13100, Pakistan; Department of Sociology and Rural Development, University of Azad Jammu and Kashmir, Muzaffarabad, AJ&K, 13100, Pakistan; College of Computer Sciences and Engineering, University of Jeddah, Jeddah, 21959, Saudi Arabia},
  author_keywords         = {Classification; Complexity analysis; Heart rate variability; Improved multiscale permutation entropy; Multiscale permutation entropy},
  correspondence_address1 = {Ali Shah, S.A.; Department of Computer Sciences and Information Technology, Pakistan; email: ahsin.shah@aiku.edu.rjk},
  document_type           = {Article},
  doi                     = {10.18280/ts.370302},
  groups                  = {Journals},
  keywords                = {Classification (of information); Entropy; Heart, Autonomic nervous system; Dynamical fluctuations; Heart rate variability; Heart rate variability signals; Multi-scale entropies; Multiscale permutation entropies (MPE); Pathological conditions; Permutation entropy, Biomedical signal processing},
  language                = {English},
  publisher               = {International Information and Engineering Technology Association},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85089306169&doi=10.18280%2fts.370302&partnerID=40&md5=4d4f1057e1a6188f4178557a199aaaf5},
}

@Book{Kowalski2020,
  author                  = {Kowalski, A.M. and Piastino, A.},
  publisher               = {Nova Science Publishers, Inc.},
  title = {Semiquantum time evolution: Classical limit, dissipation and quantum measurement},
  year                    = {2020},
  isbn                    = {9781536178746},
  note                    = {cited By 0},
  abbrev_source_title = {Underst. Time Evol.},
  abstract                = {The interplay between quantum and classical systems, is a subject of current interest. Consider two coupled systems. If quantum effects in one of them are small with regards to the other, that one regards as classical greatly simplifies the description and yields deep insight into the composite system's dynamics. In this methodology, we consider that the evolution of quantum operators is canonical, with the total Hamiltonian and that the generator of the temporal evolution of the classical variables, is the mean value of this Hamiltonian, evaluated with a purely quantum Density Matrix. As a result, all the properties of the quantum system are fulfilled at any time, even when considering dissipation. This methodology can not only represent a good approximation, but it can be the one that describes the interaction between microscopic and macroscopic systems, as in the case of the interaction of a quantum system with a bath or in that of a measurement process. © 2020 Nova Science Publishers, Inc.},
  affiliation             = {CICPBA and Depto. de Fisica-IFLP, FCE, Universidad Nacional de la Plata, La Plata, Argentina},
  author_keywords         = {Classical limit; Quantum dissipation; Quantum measurement; Semiclassical; Semiquantum},
  correspondence_address1 = {Kowalski, A.M.; CICPBA and Depto. de Fisica-IFLP, Argentina; email: kowalski@fisica.unlp.edu.ar},
  document_type           = {Book Chapter},
  groups                  = {Books},
  journal                 = {Understanding Time Evolution},
  language                = {English},
  pages = {1--24},
  source                  = {Scopus},
