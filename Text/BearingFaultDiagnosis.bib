  groups                  = {Journals},
  keywords                = {Cathode ray oscilloscopes; Chaotic systems; Controllers; Cryptography; Lyapunov methods; Microcontrollers, Dynamics analysis; Julium fractal; Micro controller unit implementation; Micro controller units; Multi-scroll attractors; Multi-scrolls; MultiRing; Multiring attractor; Performance; Separated attractor, Fractals},
