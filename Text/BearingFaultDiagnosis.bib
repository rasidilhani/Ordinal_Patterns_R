@Article{Feng2023,
  author                  = {Feng, C. and Li, S.-S. and Li, J. and Zou, X. and Zhang, L. and Jiang, L. and Wang, L. and Wang, A. and Pan, W. and Yan, L.},
  journal                 = {Optics Express},
  title = {Numerical and experimental investigation of a dispersive optoelectronic oscillator for chaotic time-delay signature suppression},
  year                    = {2023},
  issn                    = {10944087},
  note                    = {cited By 8},
  number                  = {8},
  pages = {13073--13083},
  volume                  = {31},
  abbrev_source_title = {Opt. Express},
  abstract                = {Chaos generation from a novel single-loop dispersive optoelectronic oscillator (OEO) with a broadband chirped fiber Bragg grating (CFBG) is numerically and experimentally investigated. The CFBG has much broader bandwidth than the chaotic dynamics such that its dispersion effect rather than filtering effect dominates the reflection. The proposed dispersive OEO exhibits chaotic dynamics when sufficient feedback strength is guaranteed. Suppression of chaotic time-delay signature (TDS) is observed as the feedback strength increases. The TDS can be further suppressed as the amount of grating dispersion increases. Without compromising bandwidth performance, our proposed system extends the parameter space of chaos, enhances the robustness to modulator bias variation, and improves TDS suppression by at least five times comparing to the classical OEO. Experimental results qualitatively agree well with numerical simulations. In addition, the advantage of dispersive OEO is further verified by experimentally demonstrating random bit generation with tunable rate up to 160 Gbps. © 2023 Optica Publishing Group under the terms of the Optica Open Access Publishing Agreement.},
  affiliation             = {School of Information Science and Technology, Southwest Jiaotong University, Chengdu, 610031, China; College of Physics and Optoelectronics, Taiyuan University of Technology, Taiyuan, 030024, China; Key Lab of Advanced Transducers & Intelligent Control System, Taiyuan University of Technology), Ministry of Education, Taiyuan, 030024, China},
  correspondence_address1 = {Li, S.-S.; School of Information Science and Technology, China; email: ssli@swjtu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1364/OE.484659},
  groups                  = {Journals},
  keywords                = {Bandwidth; Feedback; Fiber Bragg gratings; Time delay; Timing circuits, Broad bandwidths; Chaos generation; Chaotic dynamics; Chaotics; Chirped fibre Bragg gratings; Experimental investigations; Feedback strength; Numerical investigations; Single loop; Time-delays, Optoelectronic devices},
  language                = {English},
  publisher               = {Optica Publishing Group (formerly OSA)},
  pubmed_id               = {37157453},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85152480562&doi=10.1364%2fOE.484659&partnerID=40&md5=e14a606539fe48d1ac6afcd7161d41b7},
}

