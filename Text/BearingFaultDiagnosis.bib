  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85148018366&doi=10.1016%2fj.actaastro.2023.02.017&partnerID=40&md5=a658ed8408d255db7ca93616d7714337},
}

@Article{Liu2023f,
  author                  = {Liu, S. and Yang, L. and Gu, R.},
