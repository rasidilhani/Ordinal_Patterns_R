  author                  = {Yan, S. and Liu, J. and Gong, Z. and Guan, X. and Zhang, G.},
  journal                 = {Lecture Notes in Electrical Engineering},
  title = {Dry-Type Transformers Fault Diagnosis Method Based on Signal Wavelet Transform and DBN},
  year                    = {2024},
  issn                    = {18761100},
  note                    = {cited By 0},
  pages = {252--261},
  volume                  = {1136},
  abbrev_source_title = {Lect. Notes Electr. Eng.},
  abstract                = {Traction power supply system is a key infrastructure of urban rail transit, and dry-type transformer is an important equipment in traction power supply system, whose operation status is crucial to the safe and reliable operation of the whole power supply system. For the fault diagnosis of dry-type transformers, a fault diagnosis algorithm based on signal decomposition is proposed, and noise reduction is performed by reconstruction and hybrid feature extraction. First, the vibration signal is collected by vibration sensors, and the signal decomposition and reconstruction method based on wavelet decomposition is proposed for the noise reduction problem of the original signal. This method solves the problem that the traditional wavelet noise reduction method will lose feature information. Secondly, four relatively stable features are selected in the time domain and frequency domain respectively to form a new two-dimensional feature matrix, which enriches the fault feature information of the dry-type transformer. Finally, the extracted signals are put into the DBN deep confidence network for fault diagnosis. © 2024, Beijing Paike Culture Commu. Co., Ltd.},
  affiliation             = {Traffic Control Technology Co. Ltd, Beijing, 100044, China; Beijing Jiaotong University, Beijing, China; Rail Transit Electrical Engineering Technology Research Center, Beijing, 100044, China},
