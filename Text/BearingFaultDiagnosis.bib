  author_keywords         = {Cointegration theory; Degradation feature; Rolling bearings; Trend prediction},
  coden                   = {ZCZHF},
  correspondence_address1 = {Li, H.; Departmetn of Missile Engineering, China; email: lihr168@sohu.com},
  document_type           = {Article},
  doi                     = {10.16450/j.cnki.issn.1004-6801.2021.02.025},
  groups                  = {Journals},
  keywords                = {Entropy, Cointegration relationship; Cointegration theories; Comparison and analysis; Evolution process; Fusion algorithms; Rolling bearings; Root Mean Square; Run to failures, Roller bearings},
  language                = {English; Chinese},
