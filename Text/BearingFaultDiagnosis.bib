  groups                  = {Journals},
  keywords                = {Autonomous agents; Commerce; Computational methods; Finance; Financial data processing; Potts model; Stochastic models; Stochastic systems; Synchronization; Time series, Agent-based model; Complexity analysis; Cross correlations; Financial modeling; Financial time series; MGCS analysis; MSCE analysis; Stochastic dynamic systems, Time series analysis},
  language                = {English},
