@Conference{Karlis2020,
  author              = {Karlis, E. and Hardalupas, Y. and Taylor, A.M.K.P.},
  title = {Flowfield and flame structure during intermittent transitions into thermoacoustic oscillations in a swirl stabilized model gas turbine combustor},
  year                = {2020},
  note                = {cited By 0},
  pages = {1--19},
  publisher           = {American Institute of Aeronautics and Astronautics Inc, AIAA},
  volume              = {1 PartF},
  abbrev_source_title = {AIAA Scitech Forum},
  abstract            = {Development of gas turbine combustors operating on the lean premixed mode has been hindered by the establishment of thermoacoustic instabilities that may prove challenging to the structural integrity of the engine. Transitions between a quiescent state of thermoacoustic operation towards an oscillatory one occur via a Hopf bifurcation, namely via the emergence of periodic oscillations amidst broadband fluctuations. Hopf bifurcations can be distinguished between supercritical and subcritical, with the later type introducing especially undesirable effects due the abrupt and intermittent nature of their demonstration. Subcritical Hopf bifurcations in a model swirl stabilized gas turbine combustor are investigated in the current work. The system is driven towards the intermittently unstable regime namely close to the subcritical Hopf bifurcation point via gradual hydrogen enrichment of close to blow-off methane mixtures, at a constant equivalence ratio of 0.55. High speed (3 kHz) particle image velocimetry (PIV) measurements were employed to capture the flowfield structure during the transition from the stable to the unstable state. Phase conditioned low speed (10 Hz) OH planar laser induced fluorescence (PLIF) measurements provided information with regards to the flame structure. The transition from the low amplitude state towards the high amplitude one is always preceded by a precessing motion of the inner recirculation zone (IRZ) that is followed by a complete collapse of the IRZ. The collapse is caused by a disturbance of high positive axial velocity, convected downstream by the mean flow acting as the triggering event of the subcritical Hopf bifurcation. The PIV measurements show that the mean and standard deviation of the spatial distribution of the turbulent intensity increase, thus the flame interacts with a greater range of length scales during the intermittent bursts. This is also exemplified by the PDFs of the curvature distribution of the flame front quantified via PLIF. The analysis shows that transitional flames are more wrinkled than their quiescent counterparts, as evidenced by the higher curvature standard deviations and the lower curvature kurtosis values. © 2020, American Institute of Aeronautics and Astronautics Inc, AIAA. All rights reserved.},
  affiliation         = {Imperial College London, London, SW7 2AZ, United Kingdom},
  document_type       = {Conference Paper},
  doi                 = {10.2514/6.2020-1357},
  groups              = {Conference},
  isbn                = {9781624105951},
  journal             = {AIAA Scitech 2020 Forum},
  keywords            = {Aviation; Combustors; Flow fields; Gas turbines; Hopf bifurcation; Plasma oscillations; Statistics; Thermoacoustic engines; Velocity measurement, Curvature distributions; Intermittent transitions; Mean and standard deviations; Oh planar laser induced fluorescences; Particle image velocimetries; Subcritical Hopf bifurcation; Thermoacoustic instability; Thermoacoustic oscillations, Flame research},
  language            = {English},
  source              = {Scopus},
  url                 = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85091931511&doi=10.2514%2f6.2020-1357&partnerID=40&md5=d54486ff077fdf815821b638608e0c8c},
}

@Conference{Goswami2020,
  author              = {Goswami, M. and Chen, L. and Dubrawski, A.},
  title = {Discriminating cognitive disequilibrium and flow in problem solving: A semi-supervised approach using involuntary dynamic behavioral signals},
  year                = {2020},
  note                = {cited By 7},
  pages = {420--427},
  publisher           = {AAAI press},
  abbrev_source_title = {AAAI - AAAI Conf. Artif. Intell.},
  abstract            = {Problem solving is one of the most important 21st century skills. However, effectively coaching young students in problem solving is challenging because teachers must continuously monitor their cognitive and affective states, and make real-time pedagogical interventions to maximize their learning outcomes. It is an even more challenging task in social environments with limited human coaching resources. To lessen the cognitive load on a teacher and enable affect-sensitive intelligent tutoring, many researchers have investigated automated cognitive and affective detection methods. However, most of the studies use culturally-sensitive indices of affect that are prone to social editing such as facial expressions, and only few studies have explored involuntary dynamic behavioral signals such as gross body movements. In addition, most current methods rely on expensive labelled data from trained annotators for supervised learning. In this paper, we explore a semi-supervised learning framework that can learn low-dimensional representations of involuntary dynamic behavioral signals (mainly gross-body movements) from a modest number of short time series segments. Experiments on a real-world dataset reveal a significant advantage of these representations in discriminating cognitive disequilibrium and flow, as compared to traditional complexity measures from dynamical systems literature, and demonstrate their potential in transferring learned models to previously unseen subjects. Copyright © 2020, Association for the Advancement of Artificial Intelligence (www.aaai.org). All rights reserved.},
  affiliation         = {Delhi Technological University, New Delhi, India; Auton Lab, Carnegie Mellon University, Pittsburgh, United States},
  document_type       = {Conference Paper},
  groups              = {Conference},
  isbn                = {9781577358350},
  journal             = {AAAI 2020 - 34th AAAI Conference on Artificial Intelligence},
  keywords            = {Dynamical systems; Problem solving; Semi-supervised learning, Complexity measures; Detection methods; Facial Expressions; Intelligent tutoring; Learning outcome; Low-dimensional representation; Short time series; Social environment, Cognitive systems},
  language            = {English},
  source              = {Scopus},
  url                 = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85091740737&partnerID=40&md5=bb9a209c7403b52b6f3dafddc34c6ae9},
}

@Article{Lingli2020,
  author                  = {Lingli, J. and Liman, C. and Hongchuang, T. and Xuejun, L.},
  journal                 = {Smart Innovation, Systems and Technologies},
  title = {Fault Diagnosis of Spiral Bevel Gears Based on CEEMDAN Permutation Entropy},
  year                    = {2020},
  issn                    = {21903018},
  note                    = {cited By 5},
  pages = {695--704},
  volume                  = {166},
  abbrev_source_title = {Smart Innov. Syst. Technol.},
  abstract                = {Spiral bevel gear is a basic transmission component and widely used in mechanical equipment, so it is important to monitor and diagnose its run state to ensure the whole equipment’s safe operation. The vibration signal of spiral bevel gears is extremely complicated because of the changing number of meshing gear pairs, the varing meshing point, and the collisions between tooth during the meshing process. Especially, when the fault occurs, the vibration signal of spiral bevel gears presents highly non-linear and non-stationary. The complete ensemble empirical mode decomposition with adaptive noise (CEEMDAN) method is proved to analyze non-linear and non-stationary signals. This paper takes the CEEMDAN permutation entropy as the sensitive features to identify the failure modes of spiral bevel gears. Firstly, the vibration signal is decomposed using CEEMDAN to obtain a series of internal and external modal functions (IMFs) from high frequency to low frequency. Then, permutation entropy values are calculated. And then the multi-class SVMs is used as the classifier to identify the spiral bevel gear faults. The method is applied to diagnosis and identify three different state spiral bevel gears, and the results show that it is effective and can obtain high diagnostic accuracy. © 2020, Springer Nature Switzerland AG.},
  affiliation             = {School of Mechanical and Electrical Engineering, Foshan University, Foshan, 528000, China; Hunan Provincial Key Laboratory of Health Maintenance for Mechanical Equipment, Hunan University of Science and Technology, Xiangtan, 411201, China},
  author_keywords         = {CEEMDAN; Fault diagnosis; Permutation entropy; Spiral bevel gears; Support vector machine},
  correspondence_address1 = {Xuejun, L.; School of Mechanical and Electrical Engineering, China; email: hnkjdxlxj@163.com},
  document_type           = {Conference Paper},
  doi                     = {10.1007/978-3-030-57745-2_58},
  editor                  = {Ball A., Gelman L., Rao B.K.N.},
  groups                  = {Journals},
  isbn                    = {9783030577445},
  keywords                = {Condition monitoring; Entropy; Signal processing; Vibrations (mechanical), Diagnostic accuracy; Ensemble empirical mode decomposition; Mechanical equipment; Nonstationary signals; Permutation entropy; Sensitive features; Spiral bevel gears; Transmission components, Bevel gears},
  language                = {English},
  publisher               = {Springer Science and Business Media Deutschland GmbH},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85091313624&doi=10.1007%2f978-3-030-57745-2_58&partnerID=40&md5=b9d9126b0ac333bb0735b951f4221177},
}

@Article{Zhou2020d,
  author                  = {Zhou, F. and Shen, J. and Yang, X. and Liu, X. and Liu, W.},
  journal                 = {IEEE Access},
  title = {Modified Hierarchical Multiscale Dispersion Entropy and its Application to Fault Identification of Rotating Machinery},
  year                    = {2020},
  issn                    = {21693536},
  note                    = {cited By 14},
  pages = {161361--161376},
  volume                  = {8},
  abbrev_source_title = {IEEE Access},
  abstract                = {The rotating machinery possesses complicated structures and various fault types, whose health state monitoring is essential for the normal production and operation of the equipment. To distinguish different working states of rotating machinery efficiently and accurately, this article presents a novel approach for extracting fault features of vibration signals called modified hierarchical multiscale dispersion entropy (MHMDE). And on this basis, an innovative approach for fault diagnosis of rotating machinery based on MHMDE, multi-cluster feature selection (MCFS) and particle swarm optimization kernel extreme learning machine (PSO-KELM) is developed. Firstly, MHMDE is employed to extract the high-dimensional fault features of rotating machinery. This approach can effectively overcome the shortcomings that multi-scale entropy only focuses on the information in the low-frequency components but discards the high-frequency information, as well as the significant dropping of efficiency if the number of hierarchical layers of hierarchical entropy is large. Then MCFS is employed to screen the sensitive features from the high-dimensional fault features. Finally, the sensitive feature vectors are input into the PSO-KELM-based fault classifier to complete the rotating machinery fault diagnosis. It is proved that the presented approach can effectively identify different fault states of rotating machinery through three typical examples. Meanwhile, the presented approach is compared with multi-scale dispersion entropy (MDE) and hierarchical dispersion entropy (HDE), etc. The results show that the presented approach possesses more superior performance. © 2013 IEEE.},
  affiliation             = {College of Field Engineering, Army Engineering University, Nanjing, China},
  art_number              = {9186110},
  author_keywords         = {fault diagnosis; modified hierarchical multiscale dispersion entropy; multi-cluster feature selection; PSO-KELM; Rotating machinery},
  correspondence_address1 = {Yang, X.; College of Field Engineering, China; email: 3113593699@qq.com},
  document_type           = {Article},
  doi                     = {10.1109/ACCESS.2020.3021431},
  groups                  = {Journals},
  keywords                = {Dispersions; Entropy; Failure analysis; Fault detection; Particle swarm optimization (PSO); Rotating machinery; Structural health monitoring, Complicated structures; Extreme learning machine; Fault diagnosis of rotating machineries; Hierarchical entropies; High-frequency informations; Low-frequency components; Machinery fault diagnosis; Multi-scale entropies, Learning systems},
  language                = {English},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85091291015&doi=10.1109%2fACCESS.2020.3021431&partnerID=40&md5=745c93573adf74098b977db5fddaaf1f},
}

@Article{Fan2020,
  author                  = {Fan, L. and Shen, W. and Lou, G. and Zhang, P.},
  journal                 = {IEEE Access},
  title = {Detecting and Characterizing Multiple Oscillations in Process Control Loop Based on PSO-NCMD},
  year                    = {2020},
  issn                    = {21693536},
  note                    = {cited By 2},
  pages = {160374--160386},
  volume                  = {8},
  abbrev_source_title = {IEEE Access},
  abstract                = {Oscillations are a common abnormal phenomenon in the process control system. They can degrade control performance or even cause plant shutdown. It is crucial to accurately detect and characterize the process oscillations. In this article, a novel oscillation detector is proposed by combining the particle swarm optimization (PSO) and nonlinear chirp mode decomposition (NCMD). Because the performance of NCMD relies on the selection of mode number $Q$ and bandwidth parameter $\alpha $ , PSO is utilized to search the optimal parameter pairs. Then, the multiple oscillations contained in the process variables (PV) can be extracted by NCMD with the optimal parameters. The normalized correlation index and sparseness index are used to discarding the spurious modes and quantifying the degree of oscillations, respectively. After detecting, by utilizing the time-frequency information provided by the oscillating modes, multiple oscillation types can be accurately characterized. Comparisons are provided to show the advantages of the proposed method. The effectiveness and utility are validated by simulations as well as various industrial cases. © 2013 IEEE.},
  affiliation             = {School of Engineering, Lishui University, Lishui, China; School of Engineering, Huzhou University, Huzhou, 313000, China},
  art_number              = {9184048},
  author_keywords         = {control performance assessment; nonlinear chirp mode decomposition; Oscillation detection; particle swarm optimization},
  correspondence_address1 = {Zhang, P.; School of Engineering, China; email: b03330219@126.com},
  document_type           = {Article},
  doi                     = {10.1109/ACCESS.2020.3021018},
  groups                  = {Journals},
  keywords                = {Control systems; Particle swarm optimization (PSO); Plant shutdowns, Abnormal phenomenon; Bandwidth parameters; Control performance; In-process control; Mode decomposition; Normalized correlation; Process oscillations; Time frequency information, Process control},
  language                = {English},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85091275954&doi=10.1109%2fACCESS.2020.3021018&partnerID=40&md5=1f7e213d2ecdb2c8deaaf9b391a62612},
}

@Article{Guo2020c,
  author                  = {Guo, Z. and Liu, M. and Wang, Y. and Qin, H.},
  journal                 = {IEEE Access},
