  correspondence_address1 = {Zhang, S.; School of Electrical Engineering, China; email: zhshq-yd@163.com},
  document_type           = {Article},
  doi                     = {10.1063/5.0119415},
  groups                  = {Journals},
  keywords                = {article; entropy; molecular recognition; probability; time series analysis},
  language                = {English},
