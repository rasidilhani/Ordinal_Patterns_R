@Article{Zhao2020b,
  author                  = {Zhao, R.-Z. and Sun, Z.-J.},
  journal                 = {Zhendong Gongcheng Xuebao/Journal of Vibration Engineering},
  title = {Method of fault identification based on fusion of CEEMD_MPE and GK fuzzy clustering [融合CEEMD_MPE和GK模糊聚类的故障识别方法]},
  year                    = {2020},
  issn                    = {10044523},
  note                    = {cited By 5},
  number                  = {3},
  pages = {629--635},
  volume                  = {33},
  abbrev_source_title = {Zhendong Gongcheng Xuebao},
  abstract                = {Aiming at the nonlinear and non-stationary characteristics of rotor fault signal, a fault feature extraction and recognition method based on complementary ensemble empirical mode decomposition, multi-scale permutation entropy and GK clustering is proposed. Firstly, the fault signal is decomposed by the complementary set empirical mode decomposition. According to the correlation coefficient principle, the modal component with the largest correlation coefficient is selected as the analysis object. Then, the multi-scale array entropy is used to quantify the fault feature of the modal component as eigenvectors. Finally, the low-dimensional feature set after dimension reduction by the PCA is input into the GK fuzzy clustering algorithm for fault identification classification. The proposed method is applied to identify the fault feature set of a typical rotor test bench. The classification effect is tested by classification coefficient and partition entropy, and compared with the results obtained by other mode combination methods. The results show that the proposed method extracts fault features more effectively. © 2020, Nanjing Univ. of Aeronautics an Astronautics. All right reserved.},
  affiliation             = {School of Mechatronic Engineering, Lanzhou University of Technology, Lanzhou, 730050, China},
  author_keywords         = {Complementary ensemble empirical mode decomposition; Fault diegnosis; GK fuzzy clustering; Multi-scale permutation entropy},
