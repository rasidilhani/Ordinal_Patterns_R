  groups                  = {Journals},
  keywords                = {Cryptography; Image processing; Lyapunov methods; One dimensional; Topology, 1d quadratic chaotic map; Chaotic map; Dynamical performance; Encryption algorithms; Image encryption algorithm; Images encryptions; ITS applications; One-dimensional; Quadratic maps; Topological conjugate, Chaotic systems},
  language                = {English},
