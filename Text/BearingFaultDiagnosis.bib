  coden                   = {PHYAD},
  correspondence_address1 = {López Pérez, M.; Facultad de Ciencias, Ciudad Universitaria, Mexico; email: malp@comunidad.unam.mx},
  document_type           = {Article},
  doi                     = {10.1016/j.physa.2022.127331},
  groups                  = {Journals},
  keywords                = {Commerce; Electronic trading; Financial markets; Information theory; Markov processes; Time series analysis, Algorithmic trading; Centralised; Clusterings; Dynamical networks; High frequency HF; High-frequency trading; Network; Ordinal pattern; Synchronicity; US markets, Clustering algorithms},
  language                = {English},
  publisher               = {Elsevier B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85128298169&doi=10.1016%2fj.physa.2022.127331&partnerID=40&md5=6430b459ead3eb952789249205d6f6c1},
}

@Article{Feng2022,
  author              = {Feng, Z. and Xiong, X. and Wang, X.},
  journal             = {Zhendong yu Chongji/Journal of Vibration and Shock},
  title = {Early fault diagnosis method of check valve based on mean dispersion negentropy infograph [基于均值散布负熵信息图的单向阀早期故障诊断方法]},
  year                = {2022},
  issn                = {10003835},
  note                = {cited By 2},
  number              = {13},
  pages = {211--219},
  volume              = {41},
  abbrev_source_title = {J Vib Shock},
  abstract            = {Here, aiming at the problem of impact component energy to be able to reveal fault characteristics in early fault signals of diaphragm pump check valve being weak and difficult to extract, a fault diagnosis method of check valve based on mean dispersion negentropy infograph was proposed. Firstly, spectrum divisions with different frequency resolutions were performed for signal using a tree band-pass filter. Then, square envelope (SE) and square envelope spectrum (SES) of each frequency band were calculated, respectively to characterize its pulse and cyclostationary characteristics, and the SE signal of each frequency band was equally divided according to a fixed proportion. Finally, the negative dispersion entropy (NDE) was introduced to improve the sensitivity of Shannon negative entropy to noise in original infograph. The position of the best frequency band was determined using weighted averaging NDE mean calculation results of SE and SES. The selected frequency band was used for band-pass filtering and demodulation analysis to realize early fault diagnosis. Simulation and engineering tests showed that the proposed method can accurately extract early fault characteristics of check valve, and have a certain reliability and engineering application value. © 2022 Chinese Vibration Engineering Society. All rights reserved.},
  affiliation         = {Faculty of Information Engineering & Automation, Kunming University of Science and Technology, Kunming, 650500, China; Yunnan Institute of Mineral Pipeline Engineering Technology, Kunming, 650500, China; Yunnan Provincial Key Lab of Artificial Intelligence, Kunming University of Science and Technology, Kunming, 650500, China},
  author_keywords     = {diaphragm pump check valve; dispersion entropy; fault diagnosis; infograph; mean calculation},
  document_type       = {Article},
  doi                 = {10.13465/j.cnki.jvs.2022.13.027},
  groups              = {Journals},
  keywords            = {Bandpass filters; Dispersions; Entropy; Fault detection, Check valves; Diaphragm pump check valve; Diaphragm pumps; Dispersion entropy; Early fault; Fault diagnosis method; Faults diagnosis; Infograph; Mean calculation; Negentropy, Failure analysis},
  language            = {Chinese},
  publisher           = {Chinese Vibration Engineering Society},
  source              = {Scopus},
  url                 = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85141485224&doi=10.13465%2fj.cnki.jvs.2022.13.027&partnerID=40&md5=5299fc133a303eb71adf94bcb04295c1},
}

@Article{Ran2022,
  author                  = {Ran, B. and Zhang, T. and Wang, L. and Liu, S. and Zhou, X.},
  journal                 = {Entropy},
  title = {Image Security Based on Three-Dimensional Chaotic System and Random Dynamic Selection},
  year                    = {2022},
  issn                    = {10994300},
  note                    = {cited By 14},
  number                  = {7},
  volume                  = {24},
  abbrev_source_title = {Entropy},
  abstract                = {Image encryption based on a chaos system can effectively protect the privacy of digital images. It is said that a 3D chaotic system has a larger parameter range, better unpredictability and more complex behavior compared to low-dimension chaotic systems. Motivated by this fact, we propose a new image cryptosystem that makes use of a 3D chaotic system. There are three main steps in our scheme. In the first step, the chaotic system uses the hash value of the plaintext image to generate three sequences. In step two, one of the sequences is used to dynamically select confusion and diffusion methods, where confusion and diffusion have three algorithms, respectively, and will produce 32n (n &gt; 100) combinations for encryption. In step three, the image is divided into hundreds of overlapping subblocks, along with the other two sequences, and each block is encrypted in the confusion and diffusion process. Information entropy, NPCR, UACI results and various security analysis results show that the algorithm has a better security performance than existing, similar algorithms, and can better resist clipping, noise, statistical analysis and other attacks. © 2022 by the authors.},
  affiliation             = {School of Cyberspace Security, Hainan University, Haikou, 570100, China},
  art_number              = {958},
  author_keywords         = {chaotic system; image encryption; random dynamic selection},
  correspondence_address1 = {Zhou, X.; School of Cyberspace Security, China; email: xy.zhou@hainanu.edu.cn},
  document_type           = {Article},
  doi                     = {10.3390/e24070958},
  groups                  = {Journals},
  language                = {English},
  publisher               = {MDPI},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85137185909&doi=10.3390%2fe24070958&partnerID=40&md5=5bf99483bc22482d623c84809889feb6},
}

@Article{YamashitaRiosDeSousa2022,
  author                  = {Yamashita Rios De Sousa, A.M. and Hlinka, J.},
  journal                 = {Chaos},
  title = {Assessing serial dependence in ordinal patterns processes using chi-squared tests with application to {Eeg} data analysis},
  year                    = {2022},
  issn                    = {10541500},
  note                    = {cited By 7},
  number                  = {7},
  volume                  = {32},
  abbrev_source_title = {Chaos},
  abstract                = {We extend Elsinger's work on chi-squared tests for independence using ordinal patterns and investigate the general class of m-dependent ordinal patterns processes, to which belong ordinal patterns processes derived from random walk, white noise, and moving average processes. We describe chi-squared asymptotically distributed statistics for such processes that take into account necessary constraints on ordinal patterns probabilities and propose a test for m-dependence, with which we are able to quantify the range of serial dependence in a process. We apply the test to epilepsy electroencephalography time series data and observe shorter m-dependence associated with seizures, suggesting that the range of serial dependence decreases during those events. © 2022 Author(s).},
