  groups                  = {Journals},
  keywords                = {calcium ion; dexmedetomidine; propofol; calcium; dexmedetomidine; hypnotic sedative agent; propofol, anesthesia level; animal cell; animal experiment; animal tissue; Article; colonic migrating motor complex; controlled study; distal colon bead expulsion; drug mechanism; electrocorticography; electroencephalogram; enteric glia cell; feces analysis; gastrointestinal motility; gastrointestinal motility disorder; gastrointestinal transit; glia cell; in vitro study; in vivo study; intestine transit time; male; mouse; nonhuman; priority journal; sedation; stomach emptying; stool weight; whole gut transit time; animal; C57BL mouse; cell culture; colon; cytology; defecation; drug effect; gastrointestinal motility; glia; metabolism; small intestine, Animals; Calcium; Cells, Cultured; Colon; Defecation; Dexmedetomidine; Gastric Emptying; Gastrointestinal Motility; Gastrointestinal Transit; Hypnotics and Sedatives; Intestine, Small; Male; Mice, Inbred C57BL; Neuroglia; Propofol},
