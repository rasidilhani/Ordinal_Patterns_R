  groups                  = {Journals},
  keywords                = {Mineral resources; Signal denoising; Transient analysis, Electromagnetic noise; Gray wolf optimization; Gray wolves; Mode decomposition; Optimisations; Transient electromagnetic methods; Transient electromagnetic noise; Transient electromagnetics; Variational mode decomposition; Wavelet threshold de-noising, Wavelet decomposition},
