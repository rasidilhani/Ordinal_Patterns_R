  keywords                = {Cranes; Extraction; Fault detection; Feature extraction; Frequency domain analysis; Frequency estimation; Maximum likelihood estimation; Roller bearings; Statistics, Early fault; Fault feature; Faults diagnosis; Feature extraction methods; Features extraction; Generalized likelihood ratio; Maximum-likelihood estimation; Rolling bearings; Signal features; Statistic modeling, Failure analysis},
  language                = {English},
