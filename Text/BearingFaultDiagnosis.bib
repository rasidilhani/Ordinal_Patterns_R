  author_keywords         = {Complete total empirical mode decomposition based on adaptive white noise; Time convolution network; Time mode attention mechanism; Wind power prediction},
  correspondence_address1 = {Shen, X.; College of Electrical Engineering, China; email: shenxd@sch.edu.cn},
  document_type           = {Article},
  doi                     = {10.19783/j.cnki.pspc.210252},
  groups                  = {Journals},
  keywords                = {Convolution; Weather forecasting; White noise, Adaptive noise; Attention mechanisms; Complete total empirical mode decomposition based on adaptive white noise; Convolutional networks; Empirical Mode Decomposition; Short-Term wind power predictions; Time convolution; Time convolution network; Time mode attention mechanism; Wind power predictions, Wind power},
  language                = {Chinese},
  publisher               = {Power System Protection and Control Press},
