  document_type           = {Article},
  doi                     = {10.1142/S0218127424501244},
  groups                  = {Journals},
  keywords                = {Chaotic systems, Bifurcation parameter; Co-existing attractors; Discrete memristor; Hyperchaotic; Hyperchaotic attractor; Map analysis; Memristor; New chaotic systems; One dimensional map; Two-dimensional, Memristors},
  language                = {English},
