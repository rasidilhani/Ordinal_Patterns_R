  coden                   = {CSFOE},
  correspondence_address1 = {Liu, Y.; School of Information Science and Engineering, Gansu, China; email: liuyzh19@lzu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.chaos.2022.113039},
  groups                  = {Journals},
  keywords                = {Chaotic systems; Field programmable gate arrays (FPGA); Number theory; Random number generation, Chaotic map; Field programmables; Field-programmable gate array; High Speed; High-throughput; Hyperchaos; Programmable gate array; Pseudo random bit generators; Pseudorandom number generators; Randomness test, Random processes},
  language                = {English},
