@Article{Valverde2025,
  author                  = {Valverde, E.R. and Vampa, V. and Rosso, O.A. and Arini, P.D.},
  journal                 = {Entropy},
  title = {Spatio-Temporal Analysis of Acute Myocardial Ischaemia Based on Entropy–Complexity Plane},
  year                    = {2025},
  issn                    = {10994300},
  note                    = {cited By 0},
  number                  = {1},
  volume                  = {27},
  abbrev_source_title = {Entropy},
  abstract                = {Myocardial ischaemia is a decompensation of the oxygen supply and demand ratio, often caused by coronary atherosclerosis. During the initial stage of ischaemia, the electrical activity of the heart is disrupted, increasing the risk of malignant arrhythmias. The aim of this study is to understand the differential behaviour of the ECG during occlusion of both the left anterior descending (LAD) and right anterior coronary artery (RCA), respectively, using spatio-temporal quantifiers from information theory. A standard 12-lead ECG was recorded for each patient in the database. The control condition was obtained initially. Then, a percutaneous transluminal coronary angioplasty procedure (PTCA), which encompassed the occlusion/reperfusion period, was performed. To evaluate information quantifiers, the Bandt and Pompe permutation method was used to estimate the probability distribution associated with the electrocardiographic vector modulus. Subsequently, we analysed the positioning in the (Formula presented.) causal plane for the control and ischaemia. In LAD occlusion, decreased entropy and increased complexity can be seen, i.e., the behaviour is more predictable with an increase in the degree of complexity of the system. RCA occlusion had the opposite effects, i.e., the phenomenon is less predictable and exhibits a lower degree of organisation. Finally, both entropy and complexity decrease during the reperfusion phase in LAD and RCA cases. © 2024 by the authors.},
  affiliation             = {Grupo de Sistema Cardiovascular, Instituto de Ingeniería Biomédica (IIBM), Facultad de Ingeniería, Universidad de Buenos Aires, C1063, Buenos Aires, Argentina; Grupo de Neurociencia de Sistemas, Instituto de Fisiología y Biofísica “Bernardo Houssay” (IFIBIO-Houssay), Departamento de Ciencias Fisiológicas, Facultad de Medicina, CONICET-Universidad de Buenos Aires, Buenos AiresC1121, Argentina; Departamento de Ciencias Básicas, Facultad de Ingeniería, Universidad Nacional de La Plata, B1900, La Plata, Argentina; Instituto de Física, Universidade Federal de Alagoas (UFAL), Maceió, 57072-970, Brazil; Instituto de Física La Plata (IFLP), CONICET-Universidad Nacional de La Plata, B1900, La Plata, Argentina; Grupo de Investigación en Cardioseñales, Instituto Argentino de Matemática “Alberto P. Calderón” (IAM), CONICET, C1425, Buenos Aires, Argentina},
  art_number              = {8},
  author_keywords         = {dynamic electrocardiography; ECG permutation entropy; PTCA},
  correspondence_address1 = {Arini, P.D.; Grupo de Sistema Cardiovascular, C1063, Argentina; email: pedro.arini@conicet.gov.ar; Vampa, V.; Departamento de Ciencias Básicas, B1900, Argentina; email: victoria.vampa@ing.unlp.edu.ar},
  document_type           = {Article},
  doi                     = {10.3390/e27010008},
  groups                  = {Journals},
  language                = {English},
  publisher               = {Multidisciplinary Digital Publishing Institute (MDPI)},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85215790011&doi=10.3390%2fe27010008&partnerID=40&md5=bbe6f1fd4c675b432e630a0bc8e516bf},
}

@Article{Abid2025,
  author                  = {Abid, M. and Hitam, M.S. and Ali, R. and Azami, H. and Humeau-Heurtier, A.},
  journal                 = {Entropy},
  title = {Bidimensional Increment Entropy for Texture Analysis: Theoretical Validation and Application to Colon Cancer Images},
  year                    = {2025},
  issn                    = {10994300},
  note                    = {cited By 0},
  number                  = {1},
  volume                  = {27},
  abbrev_source_title = {Entropy},
  abstract                = {Entropy algorithms are widely applied in signal analysis to quantify the irregularity of data. In the realm of two-dimensional data, their two-dimensional forms play a crucial role in analyzing images. Previous works have demonstrated the effectiveness of one-dimensional increment entropy in detecting abrupt changes in signals. Leveraging these advantages, we introduce a novel concept, two-dimensional increment entropy (IncrEn2D), tailored for analyzing image textures. In our proposed method, increments are translated into two-letter words, encoding both the size (magnitude) and direction (sign) of the increments calculated from an image. We validate the effectiveness of this new entropy measure by applying it to MIX2D(p) processes and synthetic textures. Experimental validation spans diverse datasets, including the Kylberg dataset for real textures and medical images featuring colon cancer characteristics. To further validate our results, we employ a support vector machine model, utilizing multiscale entropy values as feature inputs. A comparative analysis with well-known bidimensional sample entropy (SampEn2D) and bidimensional dispersion entropy (DispEn2D) reveals that IncrEn2D achieves an average classification accuracy surpassing that of other methods. In summary, IncrEn2D emerges as an innovative and potent tool for image analysis and texture characterization, offering superior performance compared to existing bidimensional entropy measures. © 2025 by the authors.},
  affiliation             = {Faculty of Computer Science and Mathematics, Universiti Malaysia Terengganu, Kuala Terengganu, 21030, Malaysia; Centre for Addiction and Mental Health, University of Toronto, Toronto, ON M6J 1H1, Canada; LARIS, SFR MATHSTIC, Univ Angers, Angers, F-49000, France},
  art_number              = {80},
  author_keywords         = {biomedical imaging; multiscale increment entropy; texture analysis; texture irregularity; two-dimensional increment entropy},
  correspondence_address1 = {Hitam, M.S.; Faculty of Computer Science and Mathematics, Malaysia; email: suzuri@umt.edu.my},
  document_type           = {Article},
  doi                     = {10.3390/e27010080},
  groups                  = {Journals},
  language                = {English},
  publisher               = {Multidisciplinary Digital Publishing Institute (MDPI)},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85215707384&doi=10.3390%2fe27010080&partnerID=40&md5=71c654896d8545624197bb0ee4432c33},
}

@Article{Li2025f,
  author                  = {Li, H. and Yao, L.},
  journal                 = {IEEE Transactions on Industrial Informatics},
  title = {Motor Fault Diagnosis Based on Generative Adversarial Network Using Hyperchaotic Sequences and Mixed-Dimensional Network},
  year                    = {2025},
  issn                    = {15513203},
  note                    = {cited By 0},
  abbrev_source_title = {IEEE Trans. Ind. Inf.},
  abstract                = {Fault is extremely destructive in industrial process, and imbalanced data greatly affect the accuracy of fault diagnosis. Many methods have been proposed to deal with imbalanced data, but the concern for improving the performance of fault diagnostic networks is not enough. Therefore, novel modified conditional generative adversarial network (MCGAN) based on memristive hyperchaotic sequences and mixed-dimensional convolutional neural network (MCNN) is proposed. The 2-D data are obtained by fast Fourier transform and piecewise reconstruction of vibration signals. A novel tanh-input-type memristive hyperchaotic map is utilized to obtain chaos-based random noises. MCGAN can generate synthetic samples for augmenting the fault sample and reducing the imbalanced rate, and chaos-based random noises are used as the noise variable of MCGAN to generate high-quality synthetic samples. By cascading convolution layers with different dimensions, the lightweight MCNN is designed to improve accuracy of motor fault diagnosis. Experiments are implemented using the Case Western Reserve University and practical laboratory platform. The results show that the accuracy of the proposed method is higher than that of some diagnostic networks under imbalanced data. © 2005-2012 IEEE.},
  affiliation             = {Zhengzhou University, School of Electrical and Information Engineering, Zhengzhou, 450001, China},
  author_keywords         = {Fault diagnosis; generative adversarial network (GAN); hyperchaotic time series; imbalanced data; mixed-dimensional convolutional neural network (MCNN)},
  correspondence_address1 = {Yao, L.; Zhengzhou University, China; email: yaoln@zzu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1109/TII.2024.3523570},
  groups                  = {Journals},
  keywords                = {Adversarial networks; Convolutional neural network; Faults diagnosis; Generative adversarial network; Hyperchaotic; Hyperchaotic time series; Imbalanced data; Mixed-dimensional convolutional neural network; Motor fault; Times series, Convolutional neural networks},
  language                = {English},
  publisher               = {IEEE Computer Society},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85215663961&doi=10.1109%2fTII.2024.3523570&partnerID=40&md5=f5e7df18024378f693251ae911d02de4},
}

@Article{Yan2025,
  author                  = {Yan, X. and Song, Y. and Wang, Z. and Meng, Z. and Fang, L.},
  journal                 = {IEEE Transactions on Instrumentation and Measurement},
  title = {Performance Degradation Assessment for Bearing based on Angle-Time Cyclostationarity},
  year                    = {2025},
  issn                    = {00189456},
  note                    = {cited By 0},
  abbrev_source_title = {IEEE Trans. Instrum. Meas.},
  abstract                = {Rolling element bearing signals are known to exhibit pseudo-cyclostationary properties that limit the efficiency of health monitoring. This study extends angle-time cyclostationary (AT-CS) to performance degradation assessment (PDA) of rolling bearings. First, the life-cycle phase map is proposed to demonstrate the degradation process and the cyclic kinematic properties of energy distribution. Second, combining the entropy feature extraction technique of nonlinear dynamics, the angle-time instantaneous power spectrum entropy (AT-IPS-E) and angle-time instantaneous power spectrum permutation entropy (AT-IPS-PE) are further introduced to extract energy distribution characteristics. Finally, the feature vector set (FVS) composed of AT-IPS-E and AT-IPS-PE is constructed as the bearing health indicators (HIs), and comparative experiments are conducted by assessment models. The analysis results from the two bearing fault degradation examples demonstrate the validity and reliability of the FVS as a new HIs, while also confirming the universality of the PDA model. © 1963-2012 IEEE.},
  affiliation             = {Hebei University, College of Quality and Technical Supervision, Baoding, 071002, China; Yanshan University, Key Laboratory of Measurement Technology and Instrumentation of Hebei Province, Qinhuangdao, 066000, China},
  author_keywords         = {Angle-time Cyclostationarity; HIs; PDA; Phase map; Rolling bearing},
  coden                   = {IEIMA},
  correspondence_address1 = {Fang, L.; Hebei University, China},
  document_type           = {Article},
  doi                     = {10.1109/TIM.2025.3529049},
  groups                  = {Journals},
  keywords                = {Photomapping; Reliability analysis, Angle-time cyclostationarity; Cyclostationarity; Energy distributions; Health indicators; Instantaneous power spectrum; Performance degradation assessment; Permutation entropy; Phase maps; Power spectrum entropy; Rolling bearings, Roller bearings},
  language                = {English},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85215546710&doi=10.1109%2fTIM.2025.3529049&partnerID=40&md5=02f831b056b9473db0dd42a34c5d12c9},
}

@Article{Abram2025,
  author                  = {Abram, R. and Nowak, R. and Chrobak, D.},
  journal                 = {Journal of Physical Chemistry A},
  title = {Atom’s Dynamics and Crystal Structure: An Ordinal Pattern Method},
  year                    = {2025},
  issn                    = {10895639},
  note                    = {cited By 0},
  abbrev_source_title = {J Phys Chem A},
  abstract                = {The ubiquitous nature of thermal fluctuations poses a limitation on the identification of crystal structures. However, the trajectory of an atom carries a fingerprint of its surroundings. This rationalizes the search for a method that can determine the local atomic configuration via the analysis of the movement of an individual atom. Here, we report, while using molecular modeling, how a statistical analysis of a single-atom speed trajectory, represented by ordinal patterns, distinguishes between actual crystal structures. Using the Shannon entropy of ordinal patterns enabled discernment of the studied high-pressure silicon phases. Identification of the atoms occupying the 2(c) and 6(f) Wyckoff positions of the r8 crystal revealed an increase in the developed method’s accuracy with trajectory length. The proposed concept of studying the structure of crystals offers new opportunities in solid-solid phase transformation studies. © 2025 The Authors. Published by American Chemical Society.},
  affiliation             = {Nordic Hysitron Laboratory, School of Chemical Engineering, Aalto University, Aalto, 00076, Finland; Institute of Scientific and Industrial Research (SANKEN), Osaka University, Mihogaoka 8-1, Osaka, Ibaraki, 567-0047, Japan; Institute of Materials Engineering, University of Silesia in Katowice, 75 Pułku Piechoty 1A, Chorzów, 41-500, Poland},
  coden                   = {JPCAF},
  correspondence_address1 = {Chrobak, D.; Institute of Materials Engineering, 75 Pułku Piechoty 1A, Poland; email: dariusz.chrobak@us.edu.pl},
  document_type           = {Article},
  doi                     = {10.1021/acs.jpca.4c06151},
  groups                  = {Journals},
  keywords                = {Crystal atomic structure; Molecular modeling; Phase transitions, Atomic configuration; Crystals structures; Dynamic structure; High pressure; Ordinal pattern; Shannon's entropy; Silicon phase; Single-atoms; Speed trajectories; Thermal fluctuations, Atoms},
  language                = {English},
  publisher               = {American Chemical Society},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85215540426&doi=10.1021%2facs.jpca.4c06151&partnerID=40&md5=4a9a53d3606fbd2ac5a8bf89de1f33b4},
}

@Article{Brugnoli2025,
  author                  = {Brugnoli, E. and Delmastro, M.},
  journal                 = {PLoS ONE},
  title = {Dynamics and triggers of misinformation on vaccines},
  year                    = {2025},
  issn                    = {19326203},
  note                    = {cited By 0},
  number                  = {1 January},
  volume                  = {20},
  abbrev_source_title = {PLoS ONE},
  abstract                = {The Covid-19 pandemic has sparked renewed attention to the risks of online misinformation, emphasizing its impact on individuals' quality of life through the spread of health-related myths and misconceptions. In this study, we analyze 6 years (2016-2021) of Italian vaccine debate across diverse social media platforms (Facebook, Instagram, Twitter, YouTube), encompassing all major news sources-both questionable and reliable. We first use the symbolic transfer entropy analysis of news production time-series to dynamically determine which category of sources, questionable or reliable, causally drives the agenda on vaccines. Then, leveraging deep learning models capable to accurately classify vaccine-related content based on the conveyed stance and discussed topic, respectively, we evaluate the focus on various topics by news sources promoting opposing views and compare the resulting user engagement. Our study uncovers misinformation not as a parasite of the news ecosystem that merely opposes the perspectives offered by mainstream media, but as an autonomous force capable of even overwhelming the production of vaccine-related content from the latter. While the pervasiveness of misinformation is evident in the significantly higher engagement of questionable sources compared to reliable ones (up to 11 times higher in median value), our findings underscore the need for consistent and thorough pro-vax coverage to counter this imbalance. This is especially important for sensitive topics, where the risk of misinformation spreading and potentially exacerbating negative attitudes toward vaccines is higher. While reliable sources have successfully promoted vaccine efficacy, reducing anti-vax impact, gaps in pro-vax coverage on vaccine safety led to the highest engagement with anti-vax content. Copyright: © 2025 Brugnoli, Delmastro. This is an open access article distributed under the terms of the Creative Commons Attribution License, which permits unrestricted use, distribution, and reproduction in any medium, provided the original author and source are credited.},
  affiliation             = {Sony Computer Science Laboratories Rome, Joint Initiative CREF-SONY, Centro Ricerche Enrico Fermi, Rome, Italy; Centro Ricerche Enrico Fermi, Rome, Italy; Sapienza University of Rome, Rome, Italy; Ca' Foscari University of Venice, Venice, Italy},
  art_number              = {e0316258},
  coden                   = {POLNC},
  correspondence_address1 = {Brugnoli, E.; Sony Computer Science Laboratories Rome, Italy; email: emanuele.brugnoli@sony.com},
  document_type           = {Article},
  doi                     = {10.1371/journal.pone.0316258},
  groups                  = {Journals},
  keywords                = {chickenpox vaccine; diphtheria vaccine; Haemophilus influenzae vaccine; hepatitis B vaccine; mumps vaccine; pertussis vaccine; poliomyelitis vaccine; rubella vaccine; SARS-CoV-2 vaccine; vaccine; vaccine, adolescent; Article; causality; child; commensal; coronavirus disease 2019; deep learning; dynamics; ecosystem; entropy; female; generative pretrained transformer; human; infant; literature; male; misinformation; newborn; pandemic; prevalence; quality of life; rank sum test; reliability; social media; standing; therapeutic misconception; time series analysis; training; vaccination; coronavirus disease 2019; immunology; interpersonal communication; Italy; prevention and control; Severe acute respiratory syndrome coronavirus 2; social media; vaccination, Communication; COVID-19; COVID-19 Vaccines; Humans; Italy; Pandemics; SARS-CoV-2; Social Media; Vaccination; Vaccines},
  language                = {English},
