  document_type           = {Article},
  doi                     = {10.1016/j.physleta.2019.125854},
  groups                  = {Journals},
  keywords                = {Chaos theory; Dynamical systems; Entropy; Time series; Time series analysis; White noise, Chaotic attractors; Chaotic time series; Constant values; Embedding dimensions; Information loss; Network entropy; Network topology; Recurrence analysis, Complex networks},
  language                = {English},
