  groups                  = {Journals},
  keywords                = {Accident prevention; Classification (of information); Entropy; Failure analysis; Fault detection; Signal to noise ratio; Support vector machines; Time series analysis, Bearing fault diagnosis; Complexity analysis; Entropy measure; High reliability and safeties; Improved entropies; Industrial machinery; Permutation entropy; Rolling bearings, Roller bearings},
