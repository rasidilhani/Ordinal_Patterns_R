  doi                     = {10.1155/2022/7618380},
  groups                  = {Journals},
  keywords                = {Acoustic noise; Dispersions; Extraction; Feature extraction, Ambient noise; Feature extraction and classification; Feature extraction methods; Features extraction; Multi-scales; Permutation entropy, Entropy},
  language                = {English},
  publisher               = {Hindawi Limited},
