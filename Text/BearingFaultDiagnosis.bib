  author                  = {Wang, Y. and Xu, F. and Yang, J.},
  journal                 = {Shengxue Xuebao/Acta Acustica},
  title = {Acoustic feature extraction of divers based on multivariate variational mode decomрosition with low signal-to-noise ratio [低信噪比下基于多元变分模态分解的水下蛙人特征提取]},
