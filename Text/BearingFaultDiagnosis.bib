  groups                  = {Journals},
  keywords                = {Entropy; Flow patterns; Nonlinear analysis, Complex nonlinear behavior; Entropy analysis; Flow pattern transition; Large-diameter pipes; Nonlinear behaviours; Oil water flow; Pattern evolution; Permutation entropy; Structure evolution; Well production, Hydraulics},
  language                = {English},
  publisher               = {Springer Science and Business Media B.V.},
  source                  = {Scopus},
