  groups                  = {Journals},
  keywords                = {Deep learning; Embeddings; Fault detection; Pipelines; Semantic Web; Semantics, Adversarial networks; Class-aware mean discrepancy; Contrastive adversarial network; Data augmentation; Dynamic fault-semantic embedding; Dynamic faults; Faults diagnosis; Learning techniques; Pipeline fault diagnose; Semantic embedding, Failure analysis},
  language                = {English},
