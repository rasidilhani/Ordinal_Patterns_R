  art_number              = {124623},
  author_keywords         = {Adaptive decomposition method; Convolutional deep learning model; Equilibrium optimisation; Ocean wave power prediction; Significant wave height; Wave energy flux},
  coden                   = {ENEYD},
  correspondence_address1 = {Neshat, M.; Center for Artificial Intelligence Research and Optimization, Australia; email: neshat.mehdi@gmail.com},
  document_type           = {Article},
