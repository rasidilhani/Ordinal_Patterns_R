  groups                  = {Journals},
  keywords                = {Acoustic noise; Entropy; Extraction; Feature extraction; Motion compensation; Nearest neighbor search; Ships; Underwater acoustic communication; Underwater acoustics, Features extraction; High-precision; High-precision sensor; K-near neighbor; Nearest-neighbour; Noise signals; Precision sensors; Ship radiated noise; Ship's radiated noise; Ship-radiated noise signal; Slope entropy, Variational mode decomposition},
  language                = {English},
