  keywords                = {Commerce; Dispersions; Dynamical systems; Financial data processing; Financial markets; Numerical methods; Time series, Box-counting; Box-counting dimension; Dispersion entropy; Dynamics characteristic; Financial time series; Mathematical tools; Numerical simulation; Simulation and analysis; Stock indices; Times series, Entropy},
