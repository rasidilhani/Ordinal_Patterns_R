  art_number              = {111190},
  author_keywords         = {Fault diagnosis; Improved Multivariate Variational Mode Decomposition; Multivariate Composite Multiscale Weighted Permutation Entropy; Particle Swarm Optimization - Support Vector Machine; Rolling mill multi-row bearing},
  coden                   = {MSRMD},
  correspondence_address1 = {Sun, J.; National Engineering Research Center for Equipment and Technology of Cold Rolled Strip, China; email: sunjianliang@ysu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.measurement.2022.111190},
  groups                  = {Journals},
  keywords                = {Failure analysis; Fault detection; Particle swarm optimization (PSO); Roller bearings; Signal reconstruction; Vibration analysis, Faults diagnosis; Improved multivariate variational mode decomposition; Modal decomposition; Mode decomposition; Multi channel; Multivariate composite multiscale weighted permutation entropy; Particle swarm optimization - support vector machine; Permutation entropy; Rolling mill multi-row bearing; Support vectors machine, Support vector machines},
