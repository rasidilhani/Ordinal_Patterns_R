  title = {Characterization of the allowed patterns of signed shifts},
  year              = {2017},
  note              = {Cited by: 3; All Open Access, Bronze Open Access, Green Open Access},
  pages             = {97 – 109},
  volume            = {217},
  abstract          = {The allowed patterns of a map are those permutations in the same relative order as the initial segments of orbits realized by the map. In this paper, we characterize and provide enumerative bounds for the allowed patterns of signed shifts, a family of maps on infinite words. © 2016 Elsevier B.V.},
