  groups                  = {Journals},
  keywords                = {Commerce; Dispersions; Entropy; Financial markets; Time series analysis; Vector spaces, Complexity analysis; Dual-embedded dimensional multivariate multiscale dispersion entropy; Empirical analysis; Financial portfolio; Fractional order; Fractional order entropy; Multi-scale system; Multiscale system dispersion entropy; Time series complexity; Times series, Time series},
  language                = {English},
