  document_type           = {Article},
  doi                     = {10.1016/j.physleta.2022.127977},
  groups                  = {Journals},
  keywords                = {Amplitude permutation; Comparative analyzes; Equal value; Ordinal pattern; Structural pattern; Symbolic analysis; Symmetrics; Temporal structures; Topological data analysis; Vector structures, Vectors},
  language                = {English},
  publisher               = {Elsevier B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85124269212&doi=10.1016%2fj.physleta.2022.127977&partnerID=40&md5=4ebb404ed3cbe74836b6c8d73df376f9},
