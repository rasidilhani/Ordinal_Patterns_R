  document_type           = {Article},
  doi                     = {10.1016/j.istruc.2024.107373},
  groups                  = {Journals},
  keywords                = {Empirical mode decomposition; Tall buildings; Time and motion study, Ground motions simulations; Half wavelength; Half-wavelength width; Inelastic response; Near fault ground motion; Pulse components; Pulse extraction; Pulse time; Pulse-like ground motion simulation; Pulse-like ground motions, Seismic response},
