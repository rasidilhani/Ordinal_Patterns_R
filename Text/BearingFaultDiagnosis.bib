  document_type           = {Article},
  doi                     = {10.1063/5.0107427},
  groups                  = {Journals},
  keywords                = {entropy, Entropy},
  language                = {English},
  publisher               = {American Institute of Physics Inc.},
  pubmed_id               = {36319309},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85139992541&doi=10.1063%2f5.0107427&partnerID=40&md5=a29090ac3bfa63a310c241a4758fc8e4},
