}

@Article{Zhou2023b,
  author                  = {Zhou, Z. and Chen, W. and Yang, C.},
  journal                 = {Journal of Mechanical Science and Technology},
  title = {Adaptive range selection for parameter optimization of {Vmd} algorithm in rolling bearing fault diagnosis under strong background noise},
  year                    = {2023},
  issn                    = {1738494X},
  note                    = {cited By 9},
  number                  = {11},
  pages = {5759--5773},
  volume                  = {37},
  abbrev_source_title = {J. Mech. Sci. Technol.},
  abstract                = {The optimized variational modal decomposition (VMD) algorithm is widely used in the diagnosis of rolling bearing faults. However, the subjectivity of the optimization range can compromise the effect of fault feature extraction under strong background noise (SBN). To enhance the fault diagnosis accuracy of rolling bearings under SBN, an adaptive range selection for parameter optimization of the VMD algorithm was developed. The proposed algorithm utilizes a method based on peak spectral clustering and center frequency to determine the optimal range of mode number and penalty factor. An optimization process based on the weighted kurtosis spectrum L 2/L 1 norm is then employed as the fitness function to obtain the optimal values of modes and penalty factor. Experimental results have demonstrated that the proposed method achieves a 20.02 % increase in fault diagnosis accuracy compared to the classical adaptive variational mode decomposition (AVMD) method. © 2023, The Korean Society of Mechanical Engineers and Springer-Verlag GmbH Germany, part of Springer Nature.},
  affiliation             = {National and Local Joint Engineering Research Center of Reliability Analysis and Testing for Mechanical and Electrical Products, Zhejiang Sci-Tech University, Hangzhou, 310018, China; Department of epidemiology, Harvard TH Chan School of Public Health, Boston, MA, United States},
  author_keywords         = {Fault diagnosis; Parameter optimization; Rolling bearings; Variational modal decomposition},
  correspondence_address1 = {Zhou, Z.; National and Local Joint Engineering Research Center of Reliability Analysis and Testing for Mechanical and Electrical Products, China; email: zjnu_zzy@163.com},
  document_type           = {Article},
  doi                     = {10.1007/s12206-023-1015-3},
  groups                  = {Journals},
  keywords                = {Clustering algorithms; Fault detection; Parameter estimation; Roller bearings, Background noise; Bearing fault; Bearing fault diagnosis; Decomposition algorithm; Faults diagnosis; Modal decomposition; Parameter optimization; Penalty factor; Rolling bearings; Variational modal decomposition, Failure analysis},
  language                = {English},
  publisher               = {Korean Society of Mechanical Engineers},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85176229396&doi=10.1007%2fs12206-023-1015-3&partnerID=40&md5=8091eadb8a8b7c71c440361bca1bd1c8},
}

@Article{Chen2023b,
  author                  = {Chen, W.-H. and Zhou, X.-F. and Zheng, N. and Li, M.-J. and Hu, M.},
  journal                 = {Physica Scripta},
  title = {Image encryption scheme based on optical chaos and DNA Rubik’s cube algorithm},
  year                    = {2023},
  issn                    = {00318949},
  note                    = {cited By 6},
  number                  = {11},
  volume                  = {98},
  abbrev_source_title = {Phys Scr},
  abstract                = {In order to improve the complexity of optical chaotic sequence output and the encryption efficiency of bit plane encryption, an image encryption algorithm based on optical chaos and DNA Rubik’s cube scrambling is proposed. An external disturbance structure of light injection is proposed to improve the complexity of the chaotic sequence of light output from the slave laser by the external disturbance generated by the mutual injection between the driving laser and the main laser. Meanwhile, in the image algorithm, in addition to Rubik’s cube scrambling at the pixel level, this paper proposes a bit plane encryption method based on DNA plane Rubik’s cube scrambling, which reduces the amount of encrypted data and further improves the security of image encryption by using encryption selection of different DNA encoding modes. The scrambled images are diffused by DNA calculation and optical chaos sequence at the bit-level and pixel level respectively. Through the quantitative analysis of the security simulation of the proposed algorithm, the results show that the algorithm guarantees a certain encryption efficiency under the condition of good security, the key space is 1064, the information entropy of each test ciphertext image is close to the theoretical maximum, and the test indexes of plaintext sensitivity and key sensitivity are close to ideal values. For differential attacks, chosen plaintext attacks, known plaintext attacks, exhaustive attacks, cropping attacks, and noise attacks have good robustness. © 2023 IOP Publishing Ltd.},
  affiliation             = {School of Communication Engineering, Hangzhou Dianzi University, Hangzhou, 310018, China; School of Cyberspace, Hangzhou Dianzi University, Hangzhou, 310018, China},
  art_number              = {115507},
  author_keywords         = {DNA encryption; image encryption; optical chaos; Rubik’s cube scrambling; sub-blocks scrambling},
