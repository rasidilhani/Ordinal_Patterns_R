  document_type           = {Article},
  doi                     = {10.1038/s41598-019-50106-2},
  groups                  = {Journals},
  keywords                = {adult; biological model; brain; brain mapping; connectome; female; human; image processing; magnetoencephalography; male; nerve tract; physiology; procedures; rest; young adult, Adult; Brain; Brain Mapping; Connectome; Female; Humans; Image Processing, Computer-Assisted; Magnetoencephalography; Male; Models, Biological; Neural Pathways; Rest; Young Adult},
  language                = {English},
  publisher               = {Nature Publishing Group},
  pubmed_id               = {31527782},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85072279542&doi=10.1038%2fs41598-019-50106-2&partnerID=40&md5=55bc5aadc07f5d3eca25e13040c1452b},
