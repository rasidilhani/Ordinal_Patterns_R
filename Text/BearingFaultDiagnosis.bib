}

@Article{Song2023,
  author                  = {Song, H. and Yuan, R. and Lv, Y. and Liu, H. and Li, Y.},
  journal                 = {Structural Health Monitoring},
  title = {Cubic spline interpolation-based refined composite multiscale dispersion entropy and its application to bearing fault identification},
  year                    = {2023},
  issn                    = {14759217},
  note                    = {cited By 11},
  number                  = {4},
  pages = {2651--2673},
  volume                  = {22},
  abbrev_source_title = {Struct. Health Monit.},
  abstract                = {As a powerful tool, dispersion entropy (DE) has good capability to measure the irregularity and complexity of nonlinear systems, so it is extensively utilized in the field of structural health monitoring. However, traditional multiscale dispersion entropy (MDE) will suffer from down-sampling as the scale factor increases, which compresses some intrinsic feature information, so that the representation ability of MDE for nonlinear system is significantly restrained. Aiming at this problem, a new method called cubic spline interpolation-based refined composite multiscale dispersion entropy (CSIRCMDE) is proposed. In this frame, the coarse-graining series are regarded as knots to calculate the interpolative points in different sub-sections. Then, the obtained coarse-graining samples and interpolative samples are used to construct interpolation series to capture the potential vibration characteristics and constrain the down-sampling phenomenon. Finally, the first coarse-graining point is gradually shifted back to make multiple groups of interpolation series, and the entropy values are rectified by calculating mean pattern probabilities at the same scale. Through these steps, CSIRCMDE can grasp sufficient feature information to reduce entropy errors and overcome the dependence on sample size compared with traditional algorithms, which is demonstrated by simulation and noise signals. Furthermore, two types of bearing damage experiments prove that CSIRCMDE has good capability to characterize the bearing states, therefore, based on the proposed algorithm, the classification model that can fully identify different bearing faults is established. © The Author(s) 2022.},
  affiliation             = {Key Laboratory of Metallurgical Equipment and Control Technology, Ministry of Education, Wuhan University of Science and Technology, Wuhan, China; Hubei Key Laboratory of Mechanical Transmission and Manufacturing Engineering, Wuhan University of Science and Technology, Wuhan, China; School of Railway Tracks and Transportation, Wuyi University, Jiangmen, China; Department of Mechanical Engineering, University of Alberta, Edmonton, AB, Canada},
  author_keywords         = {cubic spline interpolation; Dispersion entropy; fault identification; feature extraction; rolling bearing},
  correspondence_address1 = {Yuan, R.; Key Laboratory of Metallurgical Equipment and Control Technology, China; email: yuanrui@wust.edu.cn},
  document_type           = {Article},
  doi                     = {10.1177/14759217221134050},
  groups                  = {Journals},
  keywords                = {Dispersions; Entropy; Interpolation; Nonlinear systems; Signal sampling; Structural health monitoring, Bearing fault; Coarse Graining; Cubic-spline interpolation; Dispersion entropy; Down sampling; Fault identifications; Feature information; Features extraction; ITS applications; Rolling bearings, Roller bearings},
  language                = {English},
  publisher               = {SAGE Publications Ltd},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85142234457&doi=10.1177%2f14759217221134050&partnerID=40&md5=e48f51d062fc051d5f56e256b6b9bd3b},
}

@Article{Zhou2023f,
  author                  = {Zhou, X. and Ji, Z. and Wang, F.},
  journal                 = {Dalian Haishi Daxue Xuebao/Journal of Dalian Maritime University},
  title = {Short-term ship traffic flow prediction based on EEMD-{Pe}-LSTM and visualization of channel traffic state [基于 EEMD-{Pe}-LSTM 的短时船舶交通流量预测与航道交通状态可视化]},
  year                    = {2023},
  issn                    = {10067736},
  note                    = {cited By 1},
  number                  = {2},
  pages = {58--68},
  volume                  = {49},
  abbrev_source_title = {Dalian Haishi Daxue Xuebao},
  abstract                = {In order to meet the demand of accurate and rapid prediction of short-term ship traffic flow, a short-term ship traffic flow prediction model based on ensemble empirical mode decomposition (EEMD) and permutation entropy (PE) optimized long short term memory (LSTM) neural network was proposed. The prediction process was divided into three stages. Firstly, EEMD was used to reduce the non-stationarity effect of short-term ship traffic flow. Secondly, PE was used to reconstruct the phase space of the time series components decomposed by EEMD to greatly shorten the operation time of the prediction model. Finally, the reconstructed high and low frequency components and residuals were imported into the LSTM model for prediction, and the final prediction result originated with the superimposed predicted values. The effectiveness of the model was verified by collecting 4392 sets of ship traffic flow data from the main channel of Qingdao Port for 366 consecutive days. The results show that the comprehensive evaluation value of EEMD-PE-LSTM model is the highest, which is 167% and 226% higher than that of LSTM model and EEMD-LSTM model respectively, which can more accurately and rapidly reflect the changes of short-term ship traffic flow in the future. In addition, in order to more intuitively present the dynamic transformation process of ship traffic status and simplify the difficulty of manual identification, the K-means clustering algorithm is used to cluster the prediction results and to realize the visualization of the channel traffic status and effectively reduces the workload of the front-line ship traffic management personnel. © 2023 Editorial Office of Journal of Dalian Maritime University. All rights reserved.},
  affiliation             = {Navigation College, Dalian Maritime University, Dalian, 116026, China; Dalian Key Laboratory of Safety & Security Technology for Autonomous Shipping, Dalian, 116026, China},
  author_keywords         = {ensemble empirical mode decomposition (EEMD); long short term memory (LSTM); permutation entropy (PE); shore-time ship traffic flow prediction; visualization of channel traffic state},
  coden                   = {DHDXF},
  correspondence_address1 = {Zhou, X.; Dalian Key Laboratory of Safety & Security Technology for Autonomous ShippingChina; email: zhou.x.y@outlook.com},
  document_type           = {Article},
  doi                     = {10.16411/j.cnki.issn1006-7736.2023.02.007},
  groups                  = {Journals},
  language                = {Chinese},
  publisher               = {Editorial Office of Journal of Dalian Maritime University},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85165149048&doi=10.16411%2fj.cnki.issn1006-7736.2023.02.007&partnerID=40&md5=ed221a9b3da5572e62de824fb9a137dd},
}

@Article{Chen2023e,
  author                  = {Chen, X. and Xu, G. and He, B. and Zhang, S. and Su, Z. and Jia, Y. and Zhang, X. and Zhao, Z.},
  journal                 = {Royal Society Open Science},
  title = {Capturing synchronization with complexity measure of ordinal pattern transition network constructed by crossplot},
  year                    = {2023},
  issn                    = {20545703},
  note                    = {cited By 0},
  number                  = {6},
  volume                  = {10},
  abbrev_source_title = {R. Soc. Open Sci.},
  abstract                = {To evaluate the synchronization of bivariate time series has been a hot topic, and a number of measures have been proposed. In this work, by introducing the ordinal pattern transition network into the crossplot, a new method for measuring the synchronization of bivariate time series is proposed. After the crossplot been partitioned and coded, the coded partitions are defined as network nodes and a directed weighted network is constructed based on the temporal adjacency of the nodes. The crossplot transition entropy of the network is proposed as an indicator of the synchronization between two time series. To test the characteristics and performance of the method, it is used to analyse the unidirectional coupled Lorentz model and compared it with existing methods. The results showed the new method had the advantages of easy parameter setting, efficiency, robustness, good consistency and suitability for short time series. Finally, electroencephalogram (EEG) data from auditory-evoked potential EEG-biometric dataset are investigated, and some useful and interesting results are obtained. © 2023 The Authors.},
  affiliation             = {School of Mechanical Engineering, Xi'an Jiaotong University, Xi'an, 710049, China; State Key Laboratory for Manufacturing Systems Engineering, Xi'an Jiaotong University, Xi'an, 710049, China; School of Microelectronics, Xi'an Jiaotong University, Xi'an, 710049, China; The First Affiliated Hospital, Xi'an Jiaotong University, Xi'an, China; School of Materials, Sun Yat-sen University, Shenzhen, 518107, China},
  art_number              = {221067},
  author_keywords         = {crossplot; ordinal pattern transition network; synchronization; transition entropy},
  correspondence_address1 = {Xu, G.; School of Mechanical Engineering, China; email: ghxu@xjtu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1098/rsos.221067},
  groups                  = {Journals},
  language                = {English},
  publisher               = {Royal Society Publishing},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85165624138&doi=10.1098%2frsos.221067&partnerID=40&md5=b0590099c3cf3564aac4ac174ece77e3},
}

@Article{Li2023k,
  author                  = {Li, J. and Zheng, J. and Pan, H. and Tong, J.},
  journal                 = {Measurement: Journal of the International Measurement Confederation},
  title = {Use of two-dimensional refined composite multi-scale time-frequency dispersion entropy for rolling bearing condition monitoring},
  year                    = {2023},
  issn                    = {02632241},
  note                    = {cited By 7},
  volume                  = {214},
  abbrev_source_title = {Meas J Int Meas Confed},
  abstract                = {Rolling bearing vibration signals with local failure usually contain rich fault characteristic in the time and frequency domains. Two-dimensional multi-scale dispersion entropy (MDE2D) is a nonlinear dynamic analysis method widely used in image signal processing. However, the multi-scale coarse-grained process of MDE2D is relatively complex and the computational cost is high. Therefore, this paper develops a two-dimensional multi-scale time-frequency dispersion entropy (MTFDE2D) to solve the problem of high calculation cost of MDE2D. Unfortunately, the length of the coarse-grained sequence used in MTFDE2D will become shorter as the scale factor increases, resulting in a loss of potential useful information. To address this, a two-dimensional refined composite multi-scale time–frequency dispersion entropy (RCMTFDE2D) is proposed. In RCMTFDE2D, the utilization of information contained in the original date is first effectively improved through the coarse-grained process of sliding values of adjacent elements, and then the refined process is used to avoid the fluctuation of entropy on large scale factors. Furthermore, the rolling bearing test data under two different operating conditions are analyzed. The results illustrate that RCMTFDE2D can successfully extract the rolling bearing fault information in time–frequency domain, and the condition monitoring method based on RCMTFDE2D can effectively identify the rolling bearings in different health states and has the highest recognition rate. © 2023 Elsevier Ltd},
  affiliation             = {The State Key Laboratory of Mechanical Transmissions, Chongqing University400044, China; School of Mechanical Engineering, Anhui University of Technology, Ma'anshan, 243032, China},
  art_number              = {112808},
  author_keywords         = {Condition monitoring; Rolling bearing; Time-frequency distribution; Two-dimensional refined composite multi-scale time-frequency dispersion entropy},
  coden                   = {MSRMD},
  correspondence_address1 = {Zheng, J.; The State Key Laboratory of Mechanical Transmissions, China},
  document_type           = {Article},
  doi                     = {10.1016/j.measurement.2023.112808},
  groups                  = {Journals},
  keywords                = {Dispersions; Entropy; Frequency domain analysis; Roller bearings; Signal processing, Bearing condition monitoring; Coarse-grained; Frequency dispersion; Multi-scales; Rolling bearings; Scale Factor; Time frequency; Time-frequency distributions; Two-dimensional; Two-dimensional refined composite multi-scale time-frequency dispersion entropy, Condition monitoring},
  language                = {English},
  publisher               = {Elsevier B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85152145386&doi=10.1016%2fj.measurement.2023.112808&partnerID=40&md5=cce9e8d3d43d040a9c9aa9efb3391ae7},
}

@Article{Chen2023f,
  author                  = {Chen, X. and Willis, J.L.},
  journal                 = {Seeds},
  title = {Characterizing the Change of Annual Cone Production in Longleaf Pine Forests},
  year                    = {2023},
  issn                    = {26741024},
  note                    = {cited By 0},
  number                  = {2},
  pages = {220--231},
  volume                  = {2},
  abbrev_source_title = {Seeds},
  abstract                = {Sporadic cone (or seed) production challenges longleaf pine forest restoration. Characterizing annual cone production change from long-term monitored data provides functional information on the foundational species of this imperiled ecosystem. In this study, permutation entropy (PE) and phase change were used to analyze longleaf pine annual cone production based on cone counts from four sites (Escambia Experimental Forest, Blackwater River State Forest, The Jones Center at Ichauway, and Sandhills State Forest). PE is an analytical tool to measure the complexity of a dynamic system while phase change characterizes the stage of self-organization. Results indicate that PE at each site was close to 1.0 (largely random changes in annual cone production) and generally increased with time. The positive association between the permutation entropy of cone production and average air temperature at different times was significant at two sites (Blackwater River State Forest and The Jones Center at Ichauway). The frequency distribution of phases (e.g., Poor (P), Fair (F), Good (G), Bumper (B)) in cone production followed negative power laws. Phase P could transition to any stage, but more than 50% remained in P across sites. For phase G, it would revert to P more than 50% of the time. Phase B would shift to P, except at Sandhills State Forest. The average lasting time of phase P was approximately 3.7 years. The overall relationship between the interval time of phase B and cone production was not statistically significant. Similarly, the overall relationship between cone production in phase B and the phase change times between consecutive B phases was not statistically significant. These results provide information on the ecological complexity of cone (or seed) production. Our methods can be helpful for estimating the occurrence of bumper cone (or seed) production, the lasting period between phase changes, and providing a tool for predicting natural regeneration potential over time for longleaf pine and other tree species (e.g., masting species). © 2023 by the authors.},
  affiliation             = {Department of Biological & Environmental Sciences, Alabama A & M University, Normal, AL 35762, United States; USDA Forest Service, Southern Research Station, 521 Devall Drive, Auburn, AL 36849, United States},
  author_keywords         = {bumper year; complexity; permutation entropy; phase change},
  correspondence_address1 = {Chen, X.; Department of Biological & Environmental Sciences, United States; email: xiongwen.chen@aamu.edu},
  document_type           = {Article},
  doi                     = {10.3390/seeds2020017},
  groups                  = {Journals},
  language                = {English},
  publisher               = {Multidisciplinary Digital Publishing Institute (MDPI)},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85202771434&doi=10.3390%2fseeds2020017&partnerID=40&md5=87ba403daec1d4c175b51b40ef2a93cd},
}

@Article{Chang2023,
