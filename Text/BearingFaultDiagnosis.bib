  correspondence_address1 = {Liu, C.; School of Civil Engineering, No.111, 1st Section, North of 2nd Ring Road, China; email: lcqjd@swjtu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.soildyn.2021.106942},
  groups                  = {Journals},
  keywords                = {Seismic response; Separation; Signal processing; Tall buildings, Aliasing; Diagrid structure; EMD; Empirical mode decomposition method; Ground-motion; Long-period component; Long-period ground motions; Modified ensemble empirical mode decompositions; Period component; Permutation entropy, Entropy, entropy; ground motion; multistorey building; seismic response; signal processing},
  language                = {English},
