  groups                  = {Journals},
  language                = {Chinese},
  publisher               = {Chinese Mechanical Engineering Society},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85175722129&doi=10.16579%2fj.issn.1001.9669.2023.05.001&partnerID=40&md5=8ad7b7c9abf54f4d4bd04d2f39dbfabc},
}

@Conference{Zhao2023b,
  author                  = {Zhao, L. and Yu, Z. and Cai, J.},
  title = {A novel method for sEMG-Based Hand Gesture Recognition},
  year                    = {2023},
  note                    = {cited By 1},
  pages = {1668--1672},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {Int. Conf. Intell. Comput. Signal Process., ICSP},
  abstract                = {Surface electromyography (sEMG) has significant importance in the development of human-machine interface due to its intrinsic information of human movement intention. As a result, there has been an increasing interest in the analysis and identification techniques of sEMG signals. This study proposes an approach for efficiently decomposing and identifying sEMG signals. Firstly, an improved method for decomposing sEMG signals is proposed, which offers faster computation and smaller reconstruction errors. Secondly, a novel convolutional neural network architecture for hand gesture recognition is proposed. This architecture amalgamates the benefits of the improved decomposition method and the slow-fusion model, facilitating superior acquisition of crucial features from sEMG. To validate the effectiveness of the proposed approach, experiments were conducted on a common sEMG dataset, achieving an average classification accuracy of 97.91%. © 2023 IEEE.},
