  author_keywords         = {Clinical manifestation of complexity; Intracranial pressure; Permutation entropy},
  correspondence_address1 = {Redelico, F.O.; Instituto de Medicina Traslacional e Ingenieria Biomedica, Potosí 4239, Argentina; email: francisco.redelico@hospitalitaliano.org.ar},
