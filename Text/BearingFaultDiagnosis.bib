@Article{Wang2024n,
  author                  = {Wang, D. and Tong, Y. and Yang, D. and Wang, P. and Lu, J.},
  journal                 = {Petroleum Science and Technology},
  title = {Optimized variational mode decomposition denoising method based on weighted mean of vectors algorithm},
  year                    = {2024},
  issn                    = {10916466},
  note                    = {cited By 1},
  abbrev_source_title = {Petrol Sci Technol},
  abstract                = {Aiming at the noise interference in oil and gas pipeline leakage detection, a signal denoising method based on improved variational mode decomposition (VMD) algorithm is proposed. First, the weighted mean of vectors algorithm (INFO) is used to select the parameters of the VMD algorithm adaptively to obtain the best decomposition level K value and penalty factor α value, which effectively solves the problem that the parameters are difficult to select in VMD. Then, according to the Hausdorff distance between the original signal and the probability density of each IMF, the effective modal components are selected for reconstruction and denoising signal is obtained. In oil and gas pipeline leakage signal processing, compared with whale optimization algorithm, grey wolf optimization algorithm, and particle swarm optimization algorithm, the reconstructed signal obtained by the proposed INFO algorithm optimized VMD parameters has higher signal-to-noise ratio and lower mean square error and mean absolute error. It shows that the proposed algorithm has better denoising effect. © 2024 Taylor & Francis Group, LLC.},
  affiliation             = {Sanya Marine Oil and Gas Research Institute, Northeast Petroleum University, Hainan, Sanya, China; School of Electrical Information Engineering, Northeastern Petroleum University, Heilongjiang, Daqing, China; Artificial Intelligence Energy Research Institute, Northeast Petroleum University, Heilongjiang, Daqing, China; Heilongjiang Provincial Key Laboratory of Networking and Intelligent Control, Heilongjiang, Daqing, China},
  author_keywords         = {Hausdorff distance; leakage signal; signal-to-noise ratio; variational modal decomposition; weighted mean of vectors algorithm},
  coden                   = {PSTEF},
  correspondence_address1 = {Wang, D.; Sanya Marine Oil and Gas Research Institute, Hainan, China; email: wdmljy@126.com; Tong, Y.; Sanya Marine Oil and Gas Research Institute, Hainan, China; email: 425702398@qq.com},
  document_type           = {Article},
  doi                     = {10.1080/10916466.2024.2314182},
