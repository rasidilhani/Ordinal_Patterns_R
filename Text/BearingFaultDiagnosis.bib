  doi                     = {10.1016/j.oceaneng.2023.115573},
  groups                  = {Journals},
  keywords                = {Acoustic noise; Acoustic noise measurement; Finite difference method; Ships; Signal processing; Underwater acoustics, Coarse-grained; ITS applications; Multi-scale coarse-grained processing; Multi-scales; Ship radiated noise; Ship's radiated noise; Signal information; Variable step; Variable-step multi-scale fractal dimension, Fractal dimension, acoustic data; noise; shipping; signal; time series},
  language                = {English},
