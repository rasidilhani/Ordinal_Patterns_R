@Conference{Gao2023,
  author                  = {Gao, H. and Wu, C. and Zhu, D. and Li, Y. and Zhang, Y.},
  title = {Feature Extraction Method of Underwater Acoustic Signals Using {Vmd} and Reverse Weighted Permutation Entropy},
  year                    = {2023},
  note                    = {cited By 0},
  pages = {465--470},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {Int. Conf. Inf. Commun. Signal Process., ICICSP},
  abstract                = {The underwater acoustic signals are rife with various non-linear and non-stationary elements. Denoising is vital in processing these signals. In this paper, we propose a denoising method for underwater acoustic signals based on an enhanced variational mode decomposition (VMD) and reverse weighted permutation entropy (RWPE). A significant challenge in the VMD algorithm is the incorrect selection of the mode component K and the penalty factor alpha. This can lead to partial decomposition and mode interference. To tackle this issue, we employed the whale optimization algorithm (WOA). This algorithm refines the penalty factor and adjusts the mode component count in the VMD. Consequently, the optimal parameter combination for K and alpha is identified. Using this optimal set, the VMD processes the acoustic signal to yield several intrinsic mode functions (IMFs). The RWPE then identifies the IMFs embodying significant signal features. These selected IMFs are utilized for reconstruction, culminating in the denoising of the underwater acoustic signal. Comparative analyses indicate that our refined VMD method outperforms other denoising techniques. © 2023 IEEE.},
  affiliation             = {School of Marine Science and Technology, Northwestern Polytechnical University, Xi'an, China},
  author_keywords         = {reverse weighted permutation entropy; underwater acoustic signals; variational mode decomposition; whale optimization algorithm},
  correspondence_address1 = {Li, Y.; School of Marine Science and Technology, China; email: liyaan@nwpu.edu.cn},
  document_type           = {Conference Paper},
  doi                     = {10.1109/ICICSP59554.2023.10390552},
  groups                  = {Conference},
  isbn                    = {9798350339994},
  journal                 = {2023 6th International Conference on Information Communication and Signal Processing, ICICSP 2023},
  keywords                = {Acoustic waves; Entropy; Intrinsic mode functions; Optimization; Underwater acoustics, De-noising; Feature extraction methods; Intrinsic Mode functions; Non linear; Optimization algorithms; Penalty factor; Permutation entropy; Reverse weighted permutation entropy; Underwater acoustic signal; Whale optimization algorithm, Variational mode decomposition},
  language                = {English},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85184818046&doi=10.1109%2fICICSP59554.2023.10390552&partnerID=40&md5=5c48d48555e4f3a5062dd0e713255709},
}

