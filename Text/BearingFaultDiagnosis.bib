  groups                  = {Journals},
  keywords                = {Fourier series; Frequency domain analysis; Large scale systems, Complex time series; Financial stock index time series; Fourier; Fourier distance; Frequency domains; Multi-dimensional scaling; Multi-dimensional scaling methods; Stock indices; Times series; Wasserstein, Time series},
