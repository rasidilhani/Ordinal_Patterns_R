  issn                = {1557170X},
  journal             = {Proceedings of the Annual International Conference of the IEEE Engineering in Medicine and Biology Society, EMBS},
  keywords            = {Diseases; Electrocardiograms; Signal processing; Wearable technology, Atrial fibrillation; Cardiac arrhythmia; ECG signal processing; High order statistics; High-order dynamics; Higher-order dynamics; Higherorder statistic (HOS); Self-monitoring; Sensor technologies; Wearable devices, Higher order statistics, atrial fibrillation; electronic device; heart muscle conduction disturbance; human; information processing; signal processing, Atrial Fibrillation; Cardiac Conduction System Disease; Humans; Records; Signal Processing, Computer-Assisted; Wearable Electronic Devices},
  language            = {English},
