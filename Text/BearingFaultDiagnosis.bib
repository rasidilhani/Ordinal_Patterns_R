  groups                  = {Journals},
  keywords                = {Classification (of information); Data visualization; Decision trees; Electroencephalography; Electrophysiology; Eye movements; Neurology; Patient monitoring; Quality control; Sleep research; Support vector machines, Classification accuracy; epilepsy; Epilepsy monitoring units; Epileptiform discharges; Multi-class support vector machines; Sleep quality evaluation; Sleep staging; Vagus nerve, Patient treatment, adult; aged; Article; clinical article; diagnostic accuracy; drug resistant epilepsy; electroencephalogram; electroencephalography; epileptic discharge; epileptic patient; female; hierarchical clustering; human; long term care; male; patient monitoring; phylogenetic tree; polysomnography; REM sleep; seizure; short course therapy; signal processing; sleep quality; sleep spindle; sleep stage; slow wave sleep; stage 2 sleep; support vector machine; vagus nerve stimulation; wakefulness; wavelet transform; adolescent; epilepsy; factual database; middle aged; pathophysiology; physiology; procedures; signal processing; vagus nerve stimulation; young adult, Adolescent; Adult; Aged; Databases, Factual; Electroencephalography; Epilepsy; Female; Humans; Male; Middle Aged; Polysomnography; Seizures; Signal Processing, Computer-Assisted; Sleep Stages; Support Vector Machine; Vagus Nerve Stimulation; Wakefulness; Young Adult},
  language                = {English},
