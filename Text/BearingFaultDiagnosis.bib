  groups                  = {Journals},
  keywords                = {Entropy; Functions; Signal processing; Structures (built objects); Turning, Correlation coefficient; Cross-correlation coefficient; Cutting chatter; Detection and identifications; Empirical Mode Decomposition; Instantaneous frequency; Intrinsic Mode functions; Permutation entropy, Cutting tools},
