@Article{Chen2022,
  author                  = {Chen, M. and Wu, S. and Chen, T. and Wang, C. and Liu, G.},
  journal                 = {Biosensors},
  title = {Information-Based Similarity of Ordinal Pattern Sequences as a Novel Descriptor in Obstructive Sleep Apnea Screening Based on Wearable Photoplethysmography Bracelets},
  year                    = {2022},
  issn                    = {20796374},
  note                    = {cited By 2},
  number                  = {12},
  volume                  = {12},
  abbrev_source_title = {Biosensors},
  abstract                = {Obstructive sleep apnea (OSA) is a common respiratory disorder associated with autonomic nervous system (ANS) dysfunction, resulting in abnormal heart rate variability (HRV). Capable of acquiring heart rate (HR) information with more convenience, wearable photoplethysmography (PPG) bracelets are proven to be a potential surrogate for electrocardiogram (ECG)-based devices. Meanwhile, bracelet-type PPG has been heavily marketed and widely accepted. This study aims to investigate the algorithm that can identify OSA with wearable devices. The information-based similarity of ordinal pattern sequences (OP_IBS), which is a modified version of the information-based similarity (IBS), has been proposed as a novel index to detect OSA based on wearable PPG signals. A total of 92 PPG recordings (29 normal subjects, 39 mild–moderate OSA subjects and 24 severe OSA subjects) were included in this study. OP_IBS along with classical indices were calculated. For severe OSA detection, the accuracy of OP_IBS was 85.9%, much higher than that of the low-frequency power to high-frequency power ratio (70.7%). The combination of OP_IBS, IBS, CV and LF/HF can achieve 91.3% accuracy, 91.0% sensitivity and 91.5% specificity. The performance of OP_IBS is significantly improved compared with our previous study based on the same database with the IBS method. In the Physionet database, OP_IBS also performed exceptionally well with an accuracy of 91.7%. This research shows that the OP_IBS method can access the HR dynamics of OSA subjects and help diagnose OSA in clinical environments. © 2022 by the authors.},
  affiliation             = {School of Biomedical Engineering, Sun Yat-Sen University, Shenzhen, 518107, China; Alfred E. Mann Department of Biomedical Engineering, University of Southern California, Los Angeles, CA 90089-1112, United States},
  art_number              = {1089},
  author_keywords         = {information-based similarity of ordinal pattern sequences (OP_IBS); obstructive sleep apnea (OSA); photoplethysmography (PPG); wearable bracelets},
  coden                   = {BISSE},
  correspondence_address1 = {Wang, C.; School of Biomedical Engineering, China; email: wangchh55@mail.sysu.edu.cn; Liu, G.; School of Biomedical Engineering, China; email: liugzh3@163.com},
  document_type           = {Article},
  doi                     = {10.3390/bios12121089},
  groups                  = {Journals},
  keywords                = {Clinical research; Electrocardiography; Heart; Photoplethysmography; Wearable technology, Apnea screening; Descriptors; Information-based similarity of ordinal pattern sequence (OP_information-based similarity); Obstructive sleep apnea; Ordinal pattern; Pattern sequences; Photoplethysmography; Respiratory disorders; Wearable bracelet, Sleep research, adult; apnea hypopnea index; Article; controlled study; diagnostic accuracy; diagnostic test accuracy study; electrocardiography; female; heart rate; heart rate variability; human; information; k nearest neighbor; machine learning; major clinical study; male; ordinal pattern sequence; photoelectric plethysmography; random forest; respiratory tract disease; sensitivity and specificity; sleep disordered breathing; electronic device; irritable colon; photoelectric plethysmography; physiology; procedures, Heart Rate; Humans; Irritable Bowel Syndrome; Photoplethysmography; Sleep Apnea, Obstructive; Wearable Electronic Devices},
