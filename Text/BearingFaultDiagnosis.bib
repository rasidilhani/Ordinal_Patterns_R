}

@Article{Chen2024e,
  author                  = {Chen, G. and Lu, T. and Wang, X. and Wei, Y. and Ma, H.},
  journal                 = {Transactions of the Institute of Measurement and Control},
  title = {Fault severity identification of planetary gearbox based on refined composite multiscale diversity entropy},
  year                    = {2024},
  issn                    = {01423312},
  note                    = {cited By 0},
  number                  = {11},
  pages = {2161--2173},
  volume                  = {46},
  abbrev_source_title = {Trans Inst Meas Control},
  abstract                = {Planetary gearbox is a key component in modern industry. A sudden failure may cause disastrous consequences. Thus, accurately acquiring the fault severity can be of importance. Diversity entropy emerges as a promising feature extraction tool for monitoring the health condition. However, the original diversity entropy has the defect that the data length of multiple time series will shorten at deep scales, resulting in unstable complexity estimation at high scale. To overcome this defect, a new feature extraction method has been proposed named refined composite multiscale diversity entropy (RCMDE). The proposed RCMDE method combines moving average windows under each scale factor and the refined state probability to improve the statistical reliability, which allows the diversity entropy to explore more refined fault information hidden at deeper scales. The simulation and experiment results proved that the proposed method has the highest diagnostic accuracy with the best stability in fault severity identification of planetary gearbox. © The Author(s) 2024.},
  affiliation             = {School of Communications and Information Engineering & School of Artificial Intelligence, Xi’an University of Posts and Telecommunications, China; Shaanxi Union Research Center of University and Enterprise for 5G+, Industrial Internet Communication Terminal Technology, Xi’an University of Posts and Telecommunications, China; School of Automation, Xi’an University of Posts and Telecommunications, China},
  author_keywords         = {Fault diagnosis; fault severity identification; feature extraction; planetary gearbox; refined composite multiscale diversity entropy},
  coden                   = {TICOD},
  correspondence_address1 = {Wang, X.; Shaanxi Union Research Center of University and Enterprise for 5G+, China; email: cagallilan@xupt.edu.cn},
  document_type           = {Article},
  doi                     = {10.1177/01423312241232006},
  groups                  = {Journals},
  keywords                = {Defects; Extraction; Feature extraction; Gears, Complexity estimation; Data length; Fault severities; Fault severity identification; Faults diagnosis; Features extraction; Health condition; Multiple time series; Planetary gearboxes; Refined composite multiscale diversity entropy, Entropy},
  language                = {English},
  publisher               = {SAGE Publications Ltd},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85186399387&doi=10.1177%2f01423312241232006&partnerID=40&md5=33dcf0c2419e5a9d5ceb1777ecb3b54f},
}

@Article{Chen2024f,
  author                  = {Chen, S. and Wang, H. and Jiang, Y. and Zhang, X. and Zheng, K. and Guo, S. and Yang, X. and Huang, D. and Hu, B.},
  journal                 = {Optics and Laser Technology},
  title = {Surface defect detection from additive manufacturing components at elevated temperatures using laser-generated Rayleigh waves},
  year                    = {2024},
  issn                    = {00303992},
  note                    = {cited By 3},
  volume                  = {174},
  abbrev_source_title = {Opt Laser Technol},
  abstract                = {Online monitoring is a critical issue for additive manufacturing components layer by layer to ensure the integrity of the structure. However, the rough surface and high temperature make it difficult to use conventional non-destructive testing methods to carry out. In this work, the laser ultrasonic technique, as a non-contact nondestructive testing method, is applied to detect defects in a 316L stainless steel specimen manufactured using selective laser melting at elevated temperatures. The unreported phenomenon of phase evolution of Rayleigh waves for different excitation locations and temperatures is observed and systematically explored using the finite element method and experiments. Furthermore, an improved variational mode decomposition strategy based on particle swarm optimization is proposed to enhance the signal-to-noise ratio. A fitness function based on permutation entropy and mutual information is developed to determine the optimized parameters in variational mode decomposition. The experimental results indicate that, for the different excitation locations, the amplitude of the Rayleigh wave generated by laser irradiation on the defect is larger than on the small area around the defect, and the defect can be effectively detected using B-scans at elevated temperatures according to the abnormal evolution of Rayleigh waves; for the fixed excitation locations, the amplitude and velocity of Rayleigh waves gradually decreases at 100–500 °C, which will provide a scientific basis for online monitoring and evaluation of additive manufacturing components. © 2024 Elsevier Ltd},
  affiliation             = {College of Automation Engineering, Nanjing University of Aeronautics and Astronautics, Nanjing, 211106, China; College of Electrical Engineering, Nanjing Vocational University of Industry Technology, Nanjing, 210023, China; School of Mechanical and Electrical Engineering, Huzhou Vocational and Technical College, Huzhou, 313000, China; Special Equipment Safety Supervision Inspection Institute of Jiangsu Province, Nanjing, 210036, China; Shenzhen Key Laboratory of Smart Sensing and Intelligent Systems, Shenzhen Institutes of Advanced Technology, Chinese Academy of Sciences, Shenzhen, 518055, China; China Greatwall Technology Group Co., LTD., Beijing, 100083, China; Nanjing Huajian Testing Technology Co., LTD., Nanjing, 210046, China},
  art_number              = {110690},
  author_keywords         = {Additive manufacturing; Elevated temperature; Improved variational mode decomposition; Laser ultrasonic; Rayleigh waves},
  coden                   = {OLTCA},
  correspondence_address1 = {Chen, S.; College of Automation Engineering, China; email: chenshuai_123@nuaa.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.optlastec.2024.110690},
  groups                  = {Journals},
  keywords                = {3D printing; Additives; Laser excitation; Location; Nondestructive examination; Partial discharges; Particle swarm optimization (PSO); Rayleigh waves; Signal to noise ratio; Surface defects; Ultrasonic testing, Critical issues; Elevated temperature; Improved variational mode decomposition; Laser ultra-sonics; Laser-ultrasonic; Layer by layer; Manufacturing components; Nondestructive testing method; Online monitoring; Surface defect detections, Variational mode decomposition},
  language                = {English},
