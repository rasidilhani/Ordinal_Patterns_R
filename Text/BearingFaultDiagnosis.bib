  document_type           = {Article},
  doi                     = {10.3788/LOP202259.1106001},
  groups                  = {Journals},
  language                = {Chinese},
  publisher               = {Universitat zu Koln},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85133120963&doi=10.3788%2fLOP202259.1106001&partnerID=40&md5=04fa5d48f14e28e0f699f37e04908084},
