  document_type           = {Article},
  doi                     = {10.1140/epjp/s13360-019-00052-9},
  groups                  = {Journals},
  language                = {English},
  publisher               = {Springer Science and Business Media Deutschland GmbH},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85077523365&doi=10.1140%2fepjp%2fs13360-019-00052-9&partnerID=40&md5=4fd8e2d81adb0c220bc7c503f17ee703},
