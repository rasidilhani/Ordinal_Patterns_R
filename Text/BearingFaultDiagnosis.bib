  groups                  = {Journals},
  keywords                = {Chaotic systems; Gaussian noise (electronic); Random processes; Stochastic systems; Time series, Continuous state; Fractional brownian motion; Fractional Gaussian noise; Non-linear chaotic maps; Permutation entropy; Shannon entropy; Stochasticity, Parallel processing systems},
