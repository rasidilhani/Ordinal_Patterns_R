@Conference{Dang2024a,
  author                  = {Dang, M. and Yu, Z. and Chen, L. and Wang, Z. and Guo, B. and Nugent, C.},
  title = {Human Mobility: Prediction and Predictability},
  year                    = {2024},
  note                    = {cited By 0},
  pages = {445--448},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {IEEE Int. Conf. Pervasive Comput. Commun. Workshops other Affil. Events, PerCom Workshops},
  abstract                = {Predicting human mobility is of significant social and economic benefits, such as for urban planning and infectious disease prevention, e.g., COVID-19. Predictability, namely to what extent a trustworthy prediction can be made from limited data, is key to exploiting prediction for informed decision-making. Current approaches to predictability are usually model-specific along with a relative measurement, leading to varying approximate results and the lack of benchmark assessment criteria. To address this, this study proposes a model-independent method based on permutation entropy to compute an absolute measure of predictability, in particular to derive the maximum level of prediction. Special emphasis is placed on investigating the sensitivity of the predictability methods to changing data loss rates and data lengths. The method has been evaluated using a public dataset with the mobile data of 500,000 individuals. Initial results show a 92%-tighter than before potential predictability and prove the hypothesis of correlation between the minimum amount of data and the level of accuracy of prediction. © 2024 IEEE.},
  affiliation             = {Northwestern Polytechnical University, Xi'an, China; Ulster University, Belfast, United Kingdom},
  author_keywords         = {human mobility; permutation entropy; predictability; the efficient minimum data amount},
  correspondence_address1 = {Dang, M.; Northwestern Polytechnical UniversityChina; email: yixi@mail.nwpu.edu.cn},
  document_type           = {Conference Paper},
  doi                     = {10.1109/PerComWorkshops59983.2024.10502436},
  groups                  = {Conference},
  isbn                    = {9798350304367},
  journal                 = {2024 IEEE International Conference on Pervasive Computing and Communications Workshops and other Affiliated Events, PerCom Workshops 2024},
  keywords                = {COVID-19; Decision making; Entropy, Disease prevention; Economic benefits; Human mobility; Human mobility predictions; Infectious disease; Limited data; Permutation entropy; Predictability; Social benefits; The efficient minimum data amount, Forecasting},
  language                = {English},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85192468711&doi=10.1109%2fPerComWorkshops59983.2024.10502436&partnerID=40&md5=cec35f754f6dbb6077d3c008e3966ab9},
}

@Article{Shang2024b,
  author                  = {Shang, D. and Su, S. and Sun, Y. and Wang, F. and Cao, Y. and Liu, H. and Yang, W. and Zhou, J.},
  journal                 = {IEEE Transactions on Intelligent Transportation Systems},
  title = {Fault Diagnosis for Rail Profile Data Using Refined Dispersion Entropy and Dependence Measurements},
  year                    = {2024},
  issn                    = {15249050},
  note                    = {cited By 0},
  number                  = {9},
  pages = {11689--11700},
  volume                  = {25},
  abbrev_source_title = {IEEE Trans. Intell. Transp. Syst.},
  abstract                = {The diagnosis of railway system faults is significant for its comfort, efficiency, and safety. The rail profile faults are the most direct impact factors when considering the health conditions of rails. This paper puts forward rail fault diagnosis from two perspectives: quantifying the level of complexity and chaos of different profiles, and measuring the level of correlation between different profiles, which correspond to the newly proposed refined dispersion entropy (RDE) method and the correlation plane method, respectively. The RDE uses weighted-dispersion patterns to extract accurate time domain features from rail profile data, and the correlation plane can characterize nonlinear and non-monotonic relationships between analyzing subjects, which are the main contributions of this study. Experimental results with simulated and reality-based data show that the proposed methods can identify faulty profile data and discriminate different types of profile faults more effectively when compared with existing methods. © 2024 IEEE.},
  affiliation             = {Beijing Jiaotong University, School of Automation and Intelligence, Beijing, 100044, China; CRRC Zhuzhou Electric Locomotive Research Institute, Zhuzhou, 412000, China; East China Jiaotong University, School of Mechatronics and Vehicle Engineering, Nanchang, 330013, China},
