  journal                 = {Optical Fiber Technology},
  title = {Randomness of scalar and vector random distributed soliton bunch in mode-locked fiber lasers},
  year                    = {2024},
  issn                    = {10685200},
  note                    = {cited By 0},
  volume                  = {84},
  abbrev_source_title = {Opt. Fiber Technol.},
  abstract                = {The randomness of scalar and vector random distributed soliton bunch in mode-locked fiber laser is certified experimentally by correlation of the pulse trace and permutation entropy of time interval distribution of solitons. Scalar random distributed soliton bunch are obtained in an extremely low birefringent of fiber laser and the output before and after the polarization beam splitter have the same randomness. The polarization locked and polarization rotation vector random distributed soliton bunch are achieved. For the polarization locked random distributed soliton bunch, each soliton of the orthogonal polarization components has the same soliton intensity, and the peak value of correlation of the pulse trace increases as the polarization distribution of the components becomes more uniform and the randomness increases with the uniform of the intensity distribution. For the polarization rotation random distributed soliton bunch, the peak value of correlation of the pulse trace for the orthogonal polarization and the randomness remains unchanged with the change of the distribution of intensities when the orthogonal polarization components have the two kinds of intensity distributions. When the soliton intensity of the polarization rotation random distributed soliton bunch for the two orthogonal polarization components varies randomly, the randomness shows the change with the distribution of intensities. © 2024},
  affiliation             = {College of Electronic Information and Optical Engineering, Taiyuan University of Technology, Shanxi, Taiyuan, 030024, China; Key Laboratory of Advanced Transducers and Intelligent Control System, Ministry of Education, Taiyuan University of Technology, Shanxi, Taiyuan, 030024, China},
