  document_type           = {Article},
  doi                     = {10.1063/5.0235846},
  groups                  = {Journals},
  keywords                = {article; controlled study; time series analysis},
  language                = {English},
  publisher               = {American Institute of Physics},
  pubmed_id               = {39485135},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85208290457&doi=10.1063%2f5.0235846&partnerID=40&md5=78b0067267ffc295b3858723e9dc7d42},
