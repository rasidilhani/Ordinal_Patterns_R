}

@Article{Shu2021,
  author                  = {Shu, L. and Shen, J. and Liu, X.},
  journal                 = {Shock and Vibration},
  title = {Fault Diagnosis Method for Rotating Machinery Based on Hierarchical Amplitude-Aware Permutation Entropy and Pairwise Feature Proximity},
  year                    = {2021},
  issn                    = {10709622},
  note                    = {cited By 3},
  volume                  = {2021},
  abbrev_source_title = {Shock Vib},
  abstract                = {With a view to solving the defect that multiscale amplitude-aware permutation entropy (MAAPE) can only quantify the low-frequency features of time series and ignore the high-frequency features which are equally important, a novel nonlinear time series feature extraction method, hierarchical amplitude-aware permutation entropy (HAAPE), is proposed. By constructing high and low-frequency operators, this method can extract the features of different frequency bands of time series simultaneously, so as to avoid the issue of information loss. In view of its advantages, HAAPE is introduced into the field of fault diagnosis to extract fault features from vibration signals of rotating machinery. Combined with the pairwise feature proximity (PWFP) feature selection method and gray wolf algorithm optimization support vector machine (GWO-SVM), a new intelligent fault diagnosis method for rotating machinery is proposed. In our method, firstly, HAPPE is adopted to extract the original high and low-frequency fault features of rotating machinery. After that, PWFP is used to sort the original features, and the important features are filtered to obtain low-dimensional sensitive feature vectors. Finally, the sensitive feature vectors are input into GWO-SVM for training and testing, so as to realize the fault identification of rotating machinery. The performance of the proposed method is verified using two data sets of bearing and gearbox. The results show that the proposed method enjoys obvious advantages over the existing methods, and the identification accuracy reaches 100%. © 2021 Ling Shu et al.},
  affiliation             = {School of Mechatronical Engineering, Beijing Institute of Technology, Beijing, 100081, China; School of Field Engineering, Army Engineering University of Pla, Nanjing, 210007, China; School of Automation, Beijing Institute of Technology, Beijing, 100081, China},
  art_number              = {4395500},
  coden                   = {SHVIE},
  correspondence_address1 = {Shen, J.; School of Field Engineering, China; email: 565423803@qq.com},
  document_type           = {Article},
  doi                     = {10.1155/2021/4395500},
  groups                  = {Journals},
  keywords                = {Entropy; Failure analysis; Fault detection; Feature extraction; Support vector machines; Time series, Algorithms optimizations; Fault diagnosis method; Fault feature; Gray wolves; High frequency HF; Lower frequencies; Permutation entropy; Sensitive features; Support vectors machine; Times series, Rotating machinery},
  language                = {English},
  publisher               = {Hindawi Limited},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85121623119&doi=10.1155%2f2021%2f4395500&partnerID=40&md5=8b6bcc7ecb000633f519c8860a47e373},
}

@Article{Wanghua2021,
  author                  = {Wanghua, Z. and Lingzhen, Y. and Jingfeng, R. and Jia, L. and Tianlong, W. and Juanfen, W.},
  journal                 = {Laser and Optoelectronics Progress},
  title = {Study on random characteristic of chaotic output of ytterbium-doped fiber amplifier [掺镱光纤放大器混沌输出随机特性研究]},
  year                    = {2021},
  issn                    = {10064125},
  note                    = {cited By 0},
  number                  = {19},
  volume                  = {58},
  abbrev_source_title = {Laser Optoelectron. Prog.},
  abstract                = {The experimental study on the random characteristic of chaotic laser in the amplification process is carried out. A ring cavity structure is usually applied to generate chaotic laser based on the nonlinear Kerr effect in fiber. The outputs of chaotic laser with different powers are realized by controlling pump current, and they are amplified by ytterbium-doped fiber amplifier. Then, the random characteristic of chaotic laser in the amplification process is analyzed quantitatively by permutation entropy, skewness and kurtosis. The results show that the permutation entropy decreases with the increase of the pump current of the fiber amplifier and tends to a stable value. The skewness and kurtosis first increase and then decrease with the increase of the pump current of the fiber amplifier when the permutation entropy is similar, indicating that the random characteristic of the chaotic laser first decreases and then increases during the amplification process. © 2021 Universitat zu Koln. All rights reserved.},
  affiliation             = {College of Physics and Optoelectronics, Taiyuan University of Technology, Shanxi, Taiyuan, 030024, China; Key Laboratory of Advanced Transducers and Intelligent Control System, Ministry of Education, Taiyuan University of Technology, Shanxi, Taiyuan, 030024, China},
  art_number              = {1914005},
  author_keywords         = {Chaotic laser; Kurtosis; Laser optics; Permutation entropy; Random characteristic; Skewness; Ytterbium-doped fiber amplifier},
  correspondence_address1 = {Lingzhen, Y.; College of Physics and Optoelectronics, Shanxi, China; email: office-science@tyut.edu.cn},
  document_type           = {Article},
  doi                     = {10.3788/LOP202158.1914005},
  groups                  = {Journals},
  language                = {Chinese},
  publisher               = {Universitat zu Koln},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85119927717&doi=10.3788%2fLOP202158.1914005&partnerID=40&md5=ed42377f6ea7c93e14958332781b7b20},
}

