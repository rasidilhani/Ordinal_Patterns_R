  coden                   = {IEBEA},
  correspondence_address1 = {Pascual, D.; Swiss Federal Institute of Technology Zurich (ETHZ)Switzerland; email: dpascual@ethz.ch},
  document_type           = {Article},
  doi                     = {10.1109/TBME.2020.3042574},
  groups                  = {Journals},
  keywords                = {Brain; Learning algorithms; Machine learning; Neurophysiology, Brain electrical activity; Epileptic seizures; Neurological disorders; Personal information; Privacy concerns; Privacy preservation; Seizure detection; State of the art, Privacy by design, adult; Article; caregiver; clinical article; comparative study; data privacy; detection algorithm; electroencephalogram; epilepsy; generative adversarial network; human; nerve cell network; patient identification; quality of life; seizure; sensitive personal information; task performance; algorithm; brain; electroencephalography; epilepsy; privacy; seizure, Algorithms; Brain; Electroencephalography; Epilepsy; Humans; Privacy; Quality of Life; Seizures},
  language                = {English},
  publisher               = {IEEE Computer Society},
