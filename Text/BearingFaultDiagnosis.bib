  groups                  = {Journals},
  keywords                = {Electrophysiology; Entropy; Signal processing; Sleep research; Stochastic systems; Time series, Conditional entropy; Embeddings; Health-study; Instantaneous causality; Multivariate time series; Non-uniform; Non-uniform bedding; Polysomnography; Sleep heart health study database; Transfer entropy, Embeddings},
  language                = {English},
