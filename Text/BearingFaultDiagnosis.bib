  journal                 = {INDICON 2022 - 2022 IEEE 19th India Council International Conference},
  keywords                = {Classification (of information); Errors; Learning systems; Speech recognition, Asvspoof 2019; Automatic speaker verification; Classifier models; Data augmentation; Equal error rate; Learning classifiers; Machine-learning; Performance; Speaker verification system; Spoofing attacks, Deep learning},
