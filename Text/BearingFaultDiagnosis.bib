  author_keywords         = {Coal; digital images of coal surface; gas-dynamic phenomena; outburst-hazardous and outburst-nonhazardous zones; statistical entropy and complexity},
  correspondence_address1 = {Ul’yanova, E.V.; Academician Melnikov Research Institute of Comprehensive Exploitation of Mineral Resources, Russian Federation; email: ekaterina-ulyanova@yandex.ru},
  document_type           = {Article},
