}

@Article{Masoller2011,
  author            = {Masoller, Cristina and Rosso, Osvaldo A.},
  journal           = {Philosophical Transactions of the Royal Society A: Mathematical, Physical and Engineering Sciences},
  title = {Quantifying the complexity of the delayed logistic map},
  year              = {2011},
  note              = {Cited by: 16},
  number            = {1935},
  pages             = {425 – 438},
  volume            = {369},
  abstract          = {Statistical complexity measures are used to quantify the degree of complexity of the delayed logistic map, with linear and nonlinear feedback. We employ two methods for calculating the complexity measures, one with the 'histogram-based' probability distribution function and the other one with ordinal patterns. We show that these methods provide complementary information about the complexity of the delay-induced dynamics: there are parameter regions where the histogram-based complexity is zero while the ordinal pattern complexity is not, and vice versa. We also show that the time series generated from the nonlinear delayed logistic map can present zero missing or forbidden patterns, i.e. all possible ordinal patterns are realized into orbits. This journal is © 2011 The Royal Society.},
  doi               = {10.1098/rsta.2010.0281},
  groups            = {Journals},
  publication_stage = {Final},
  source            = {Scopus},
  type              = {Article},
  url               = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-79251488502&doi=10.1098%2frsta.2010.0281&partnerID=40&md5=17d1ff0a6f8d599ebe84e872d6d7c3ff},
}

@Article{Amigo2012,
  author            = {Amigó, Jos M.},
  journal           = {Physica D: Nonlinear Phenomena},
  title = {The equality of Kolmogorov-Sinai entropy and metric permutation entropy generalized},
  year              = {2012},
  note              = {Cited by: 38},
  number            = {7},
  pages             = {789 – 793},
  volume            = {241},
  abstract          = {In a 2005 paper, the author and collaborators proposed an approach to permutation entropy based on symbolic dynamics. This approach allowed us to prove the equality of metric permutation entropy to the conventional metric entropy for symbolic dynamics and, as a consequence, also for n-dimensional interval maps, under the assumption of ergodicity. In this paper we generalize our approach and extend that equality both to general (i.e., not necessarily ergodic) symbolic dynamics and to just measurable maps on (not necessarily ordered) finite-measure spacesarguably the most general setting possible. © 2012 Elsevier B.V. All rights reserved.},
  doi               = {10.1016/j.physd.2012.01.004},
  groups            = {Journals},
  publication_stage = {Final},
  source            = {Scopus},
