  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85094072557&doi=10.3390%2fe22010063&partnerID=40&md5=530809e273ffd18990ab21b2f4b24977},
}

@Conference{Omata2020a,
  author              = {Omata, N. and Tsutsumi, S. and Shimizu, T. and Koizumi, H.},
  title = {Causal analysis of flow physics using transfer entropy},
  year                = {2020},
  note                = {cited By 0},
  pages = {1--17},
  publisher           = {American Institute of Aeronautics and Astronautics Inc, AIAA},
  volume              = {1 PartF},
  abbrev_source_title = {AIAA AVIATION FORUM},
  abstract            = {It has become difficult to clarify the mechanism of complicated flowfield deductively, and the analysis of causal relation by inductive data-driven method is getting attention. Using one of such techniques called clustering transfer entropy, combustion instability in Continuously Variable Resonant Combustor (CVRC) was analyzed as a representative for a complicated but industrially and scientifically important flowfield. The mechanism of increasing longitudinal pressure oscillation by changing the oxidizer temperature was shown through deductive analysis. Based on the knowledge obtained deductively, the causal relationship between physical quantities in the fields was analyzed by the clustering transfer entropy. Physically consistent causal relationships between fuel and oxidizer flowfield are extracted. The causality from heat release rate to pressure was also consistent with the previous study. © 2020, American Institute of Aeronautics and Astronautics Inc, AIAA. All rights reserved.},
  affiliation         = {Japan Aerospace Exploration Agency (JAXA), Kanagawa, Sagamihara, 252-5210, Japan; Mizuho Information & Research Institute, Chiyoda-ku, Tokyo, 101-8443, Japan},
