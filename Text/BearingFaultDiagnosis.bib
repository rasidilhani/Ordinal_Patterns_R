  coden               = {JLTED},
  document_type       = {Article},
  doi                 = {10.1109/JLT.2022.3174169},
  groups              = {Journals},
  keywords            = {Bandwidth; Chaos theory; Distributed feedback lasers; Feedback amplifiers; Fiber amplifiers; Fiber Bragg gratings; Laser mirrors; Optical feedback; Optical fiber communication; Time delay; Timing circuits, Chaotic communications; Chaotic signal; Chaotics; Chirped fibre Bragg gratings; Distributed feedback laser diode; External cavity semiconductor lasers; Grating; Optical fibers amplifiers; Optical reflection; Tunables, Semiconductor lasers},
  language            = {English},
