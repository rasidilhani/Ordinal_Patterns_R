  document_type           = {Article},
  doi                     = {10.16385/j.cnki.issn.1004-4523.2020.03.023},
  groups                  = {Journals},
  keywords                = {Entropy; Fuzzy clustering; Signal processing, Correlation coefficient; Dimension reduction; Empirical Mode Decomposition; Ensemble empirical mode decomposition; Fault feature extractions; Fault identifications; Mode combination method; Non stationary characteristics, Clustering algorithms},
  language                = {Chinese},
  publisher               = {Nanjing University of Aeronautics an Astronautics},
  source                  = {Scopus},
