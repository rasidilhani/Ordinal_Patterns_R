@Article{Wang2020j,
  author                  = {Wang, F. and Chen, Z. and Song, G.},
  journal                 = {Mechanical Systems and Signal Processing},
  title = {Monitoring of multi-bolt connection looseness using entropy-based active sensing and genetic algorithm-based least square support vector machine},
  year                    = {2020},
  issn                    = {08883270},
  note                    = {cited By 133},
  volume                  = {136},
  abbrev_source_title = {Mech Syst Signal Process},
  abstract                = {Looseness detection of bolted connections is an essential industrial issue that can reduce the maintenance and repair costs caused by joint failures; however, current loosening detection methods mainly focus on the single-bolt connection. Even though several methods, such as the vibration-based method and electro-mechanical impedance (EMI) method, have been employed to detect multi-bolt looseness, while they are easily affected by environmental issues. Therefore, the main contribution of this paper is to detect loosening of the multi-bolt connection through the PZT-enabled active sensing method, which has several merits including easy-to-implement, low cost, and good ability of anti-environment disturbance. Since the current indicator of the active sensing, namely the signal energy is insensitive to multiple damages, we developed a new damage index (DI) based on the multivariate multiscale fuzzy entropy (MMFE). Subsequently, the maximum relevance minimum redundancy (mRMR) was used to select significant features from the MMFE-based DI to construct the new datasets. After feeding the new datasets into the genetic algorithm-based least square support vector machine (GA-based LSSVM), we trained a classifier to detect loosening of the multi-bolt connection. Finally, repeated experiments were conducted to demonstrate the effectiveness of the proposed method, which can guide future investigations on bolt looseness detection. © 2019},
  affiliation             = {Department of Mechanical Engineering, University of Houston, Houston, TX 77204, United States},
  art_number              = {106507},
  author_keywords         = {Bolt looseness detection; Max-relevance and min redundancy; Multivariate multiscale fuzzy entropy; Piezoelectric transducer; Structural health monitoring; Support vector machine},
  coden                   = {MSSPE},
  correspondence_address1 = {Song, G.; Department of Mechanical Engineering, United States; email: gsong@uh.edu},
  document_type           = {Article},
  doi                     = {10.1016/j.ymssp.2019.106507},
  groups                  = {Journals},
  keywords                = {Classification (of information); Costs; Damage detection; Entropy; Genetic algorithms; Piezoelectric transducers; Redundancy; Repair; Structural health monitoring; Support vector machines; Vibrations (mechanical), Bolted connections; Detection methods; Electromechanical impedance; Environmental issues; Fuzzy entropy; Least square support vector machines; Looseness detection; Maximum relevance minimum redundancies, Bolts},
  language                = {English},
  publisher               = {Academic Press},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85075616023&doi=10.1016%2fj.ymssp.2019.106507&partnerID=40&md5=3d23c8dac588a5529fc94a6c7a533a26},
}

@Article{Back2020,
  author                  = {Back, A.D. and Angus, D. and Wiles, J.},
  journal                 = {IEEE Journal on Selected Topics in Signal Processing},
  title = {Transitive Entropy -A Rank Ordered Approach for Natural Sequences},
  year                    = {2020},
  issn                    = {19324553},
  note                    = {cited By 7},
  number                  = {2},
  pages = {312--321},
  volume                  = {14},
  abbrev_source_title = {IEEE J. Sel. Top. Sign. Proces.},
  abstract                = {Information theoretic entropy measures are calculated from estimates of the probabilities of the constituent symbolic events. In natural sequences, such as those occurring in human language, the probabilistic structure typically follows a rank ordering pattern. Entropy has been used to model language by using large data sets to characterize the underlying source. To model the dynamic characteristics of language, methods such as N-gram entropy are normally used which rely on a very large database from which the statistical samples can be obtained. However it is of interest to apply entropy based methods for classifying natural sequence behavior, such as characterizing changes in language due to diseases such as dementia, using only a small number of samples. There are multiple problems with this approach however: the number of samples required and in addition, we show that degenerative solutions can occur when using current entropy measures which can render them less suitable for classifying disorders in natural language which may result in rank reordering variations of the feature space probability distributions. We propose a new probabilistic measure, termed Transitive Entropy which overcomes this problem. We examine the properties of the proposed entropy measure and demonstrate its effectiveness on successfully classifying patient dementia by application to a probabilistic model of pause length in their speech. © 2007-2012 IEEE.},
  affiliation             = {School of Information Technology and Electrical Engineering, University of Queensland, Brisbane, QLD 4072, Australia; Queensland University of Technology, Kelvin Grove, QLD 4059, Australia},
  art_number              = {8826273},
  author_keywords         = {computational linguistics; conversation analysis; dementia identification; information theory; natural sequences; Shannon entropy},
  correspondence_address1 = {Back, A.D.; School of Information Technology and Electrical Engineering, Australia; email: andrew@andrewback.com},
  document_type           = {Article},
  doi                     = {10.1109/JSTSP.2019.2939998},
  groups                  = {Journals},
  keywords                = {Entropy; Information theory; Neurodegenerative diseases, Dynamic characteristics; Entropy-based methods; Number of samples; Probabilistic measures; Probabilistic modeling; Probabilistic structures; Statistical samples; Very large database, Probability distributions},
  language                = {English},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85075530814&doi=10.1109%2fJSTSP.2019.2939998&partnerID=40&md5=318dea4b9560bda13b3d9320f3bb88b1},
}

@Article{Wang2020k,
  author                  = {Wang, X. and Si, S. and Li, Y. and Du, X.},
  journal                 = {JVC/Journal of Vibration and Control},
  title = {An integrated method based on refined composite multivariate hierarchical permutation entropy and random forest and its application in rotating machinery},
  year                    = {2020},
  issn                    = {10775463},
  note                    = {cited By 22},
  number                  = {3-4},
  pages = {146--160},
  volume                  = {26},
  abbrev_source_title = {JVC/J Vib Control},
  abstract                = {Fault feature extraction of rotating machinery is crucial and challenging due to its nonlinear and nonstationary characteristics. In order to resolve this difficulty, a quality nonlinear fault feature extraction method is required. Hierarchical permutation entropy has been proven to be a promising nonlinear feature extraction method for fault diagnosis of rotating machinery. Compared with multiscale permutation entropy, hierarchical permutation entropy considers the fault information hidden in both high frequency and low frequency components. However, hierarchical permutation entropy still has some shortcomings, such as poor statistical stability for short time series and inability of analyzing multichannel signals. To address such disadvantages, this paper proposes a new entropy method, called refined composite multivariate hierarchical permutation entropy. Refined composite multivariate hierarchical permutation entropy can extract rich fault information hidden in multichannel signals synchronously. Based on refined composite multivariate hierarchical permutation entropy and random forest, a novel fault diagnosis framework is proposed in this paper. The effectiveness of the proposed method is validated using experimental and simulated signals. The results demonstrate that the proposed method outperforms multivariate multiscale fuzzy entropy, refined composite multivariate multiscale fuzzy entropy, multivariate multiscale sample entropy, multivariate multiscale permutation entropy, multivariate hierarchical permutation entropy, and composite multivariate hierarchical permutation entropy in recognizing the different faults of rotating machinery. © The Author(s) 2019.},
  affiliation             = {School of Mechanical Engineering, Northwestern Polytechnical University, China; MIIT Key Laboratory of Dynamics and Control of Complex Systems, School of Aeronautics, Northwestern Polytechnical University, China},
  author_keywords         = {fault diagnosis; feature extraction; random forest; refined composite multivariate hierarchical permutation entropy; Rotating machinery},
  coden                   = {JVCOF},
  correspondence_address1 = {Li, Y.; MIIT Key Laboratory of Dynamics and Control of Complex Systems, China; email: yongbo@nwpu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1177/1077546319877711},
  groups                  = {Journals},
  keywords                = {Decision trees; Extraction; Failure analysis; Feature extraction; Rotating machinery, Fault diagnosis of rotating machineries; Fault feature extractions; Low-frequency components; Non-stationary characteristics; Nonlinear feature extraction method; Permutation entropy; Random forests; Statistical stability, Fault detection},
  language                = {English},
  publisher               = {SAGE Publications Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85075067523&doi=10.1177%2f1077546319877711&partnerID=40&md5=67c6338ea53d642b98fc35d15617184a},
}

@Book{Fartacek2020,
  author                  = {Fartacek, C. and Plöderl, M. and Schiepek, G.},
  publisher               = {Elsevier},
  title = {Alternatives to suicide: A nonlinear dynamic perspective},
  year                    = {2020},
  isbn                    = {9780128142981; 9780128142974},
  note                    = {cited By 0},
  abbrev_source_title = {Altern. to Suicide: Beyond Risk and Towar. a Life Worth Living},
  abstract                = {The aim of the chapter at hand is to outline a nonlinear dynamic perspective on suicidal processes and to discuss principles of interventions as well as resilience to suicide within this framework. Within this theoretical framework, the suicidal process can be described as a cascade of order transitions between different suicide-related states (i.e., order parameters) of an underlying nonlinear dynamic system. Successful treatment requires the realization of conditions for self-organized order transitions of the suicidal mode into functional, healthy regimes. Resilience can be understood, on the one hand, through the stability of the order parameter regimes associated with health. On the other hand, resilience to suicidality is associated with the development of alternative modes for coping with future crises. Finally, a number of implications for suicide research are outlined. © 2020 Elsevier Inc. All rights reserved..},
  affiliation             = {Department of Crisis Intervention and Suicide Prevention, University Clinic of Psychiatry, Psychotherapy, and Psychosomatics, Paracelsus Medical University, Salzburg, Austria; Department of Clinical Psychology, University Clinic of Psychiatry, Psychotherapy, and Psychosomatics, Paracelsus Medical University, Salzburg, Austria; Institute of Synergetics and Psychotherapy Research, Paracelsus Medical University, Salzburg, Austria},
