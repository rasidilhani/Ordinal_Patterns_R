  groups                  = {Journals},
  isbn                    = {9783031224188},
  keywords                = {Entropy; Ice; Internal combustion engines; Machine learning; Nearest neighbor search; Signal analysis; Vibration analysis, Contaminant emissions; Engine efficiency; Machine; Machine-learning; Multiescale; Non-intrusive; Novel methodology; Permutation entropy; Rotational speed; Vibration, Combustion},
