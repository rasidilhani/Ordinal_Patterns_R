  groups                  = {Journals},
  keywords                = {Acoustic noise measurement; Extraction; Finite difference method; Fractal dimension; Ships, Feature extraction methods; Features extraction; Hierarchical refined composite multi-scale fractal dimension; ITS applications; Multi-scales; Multifeatures; Refined composite multi-scale fractal dimension; Ship radiated noise; Ship's radiated noise, Feature extraction},
