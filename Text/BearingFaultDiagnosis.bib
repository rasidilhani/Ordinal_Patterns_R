  document_type           = {Article},
  doi                     = {10.1016/j.resourpol.2023.104059},
  groups                  = {Journals},
  keywords                = {Costs; Gases; Natural gas; Search engines, Empirical studies; Energy data; High complexity; Multisource data; Multivariate decomposition; Natural gas price; Price forecasting; Primary decomposition; Secondary decomposition; Single models, Forecasting, computer simulation; decomposition analysis; forecasting method; gas production; natural gas; numerical model; price determination},
  language                = {English},
