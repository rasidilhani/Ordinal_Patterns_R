  author_keywords         = {Amnestic mild cognitive impairment; Electroencephalogram; Genetic algorithm-based support vector machine; Genuine symbolic nonlinear granger causality},
  correspondence_address1 = {Li, X.; Measurement Technology and Instrumentation Key Lab of Hebei ProvinceChina; email: yddylixin@ysu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.bspc.2024.106314},
