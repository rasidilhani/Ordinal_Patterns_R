  groups                  = {Journals},
  keywords                = {Stochastic systems; Time series; Time series analysis, Analytical analysis; Chaotics; Degree of diversity; Deterministic systems; Dynamical transition; Multiple time series; Numerical and experimental analysis; Optimal operating conditions; Process system; Times series, Random processes, article; big data; human; machine learning; nonhuman; stochastic model; time series analysis},
  language                = {English},
