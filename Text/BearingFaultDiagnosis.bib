  keywords                = {Empirical mode decomposition; Image acquisition; Image annotation; Image coding; Image compression; Image matching; Image quality; Image texture; Image thinning; Radar clutter; Signal denoising; Ultra-wideband (UWB), Adaptive noise; Empirical Mode Decomposition; Heart beats; Improved global empirical mode decomposition with adaptive noise; Permutation entropy; Radar detection; Target positioning; Time-frequency Analysis; Time-series analysis; Ultra wideband radars; Vital sign; Vital sign extraction, Fast Fourier transforms},
  language                = {English},
