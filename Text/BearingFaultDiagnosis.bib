  document_type           = {Article},
  doi                     = {10.1016/j.apacoust.2022.109169},
  groups                  = {Journals},
  keywords                = {Defects; Extraction; Fault detection; Iterative methods; Machine components; Signal analysis, Curve identifications; Faults diagnosis; Multicomponent signals; Multicomponents; Nonstationary signals; Ridge curve identification; Ridge curves; Synchroextracting transform; Time-frequency Analysis; Time-frequency representations, Failure analysis},
  language                = {English},
