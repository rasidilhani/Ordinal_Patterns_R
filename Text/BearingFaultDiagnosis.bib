  document_type           = {Article},
  doi                     = {10.3390/engproc2022018014},
  groups                  = {Journals},
  language                = {English},
  publisher               = {MDPI},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85145391700&doi=10.3390%2fengproc2022018014&partnerID=40&md5=bf6a9d6346a60a1f11e76fb386912fe5},
}

@Article{Thorne2022,
  author                  = {Thorne, B. and Jüngling, T. and Small, M. and Corrêa, D. and Zaitouny, A.},
  journal                 = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
  title = {A Novel Approach to Time Series Complexity via Reservoir Computing},
  year                    = {2022},
  issn                    = {03029743},
  note                    = {cited By 1},
  pages = {442--455},
  volume                  = {13728 LNAI},
  abbrev_source_title = {Lect. Notes Comput. Sci.},
  abstract                = {When working with time series, it is often beneficial to have an idea as to how complex the signal is. Periodic, chaotic and random signals (from least to most complex) may each be approached in different ways, and knowing when a signal can be identified as belonging to one of these categories can reveal a lot about the underlying system. In the field of time series analysis, permutation entropy has emerged as one of the premier measures of time series complexity due to its ability to be calculated from data alone. We propose an alternative method for calculating complexity based on the machine learning paradigm of reservoir computing, and how the outputs of these neural networks capture similar information regarding signal complexity. We observe similar behaviour in our proposed measure to both the Lyapunov exponent and permutation entropy for well known dynamical systems. Additionally, we assess the dependence of our measure on key hyperparameters of the model, drawing conclusions about the invariance of the measure and possible implications on informing network structure. © 2022, The Author(s), under exclusive license to Springer Nature Switzerland AG.},
  affiliation             = {University of Western Australia, Crawley, WA, Australia; ARC Centre for Transforming Maintenance Through Data Science, Crawley, WA, Australia; University of Doha for Science and Technology, Duhail North Doha, Qatar},
  author_keywords         = {Information entropy; Recurrent neural networks; Reservoir computing; Time series analysis},
  correspondence_address1 = {Thorne, B.; ARC Centre for Transforming Maintenance Through Data ScienceAustralia; email: braden.thorne@research.uwa.edu.au},
  document_type           = {Conference Paper},
  doi                     = {10.1007/978-3-031-22695-3_31},
  editor                  = {Aziz H., Correa D., French T.},
  groups                  = {Journals},
  isbn                    = {9783031226946},
  keywords                = {Complex networks; Dynamical systems; Harmonic analysis; Lyapunov methods; Recurrent neural networks, Calculating complexity; Chaotic signal; Information entropy; Periodic signal; Permutation entropy; Random signal; Reservoir Computing; Time-series analysis; Times series; Underlying systems, Time series analysis},
  language                = {English},
  publisher               = {Springer Science and Business Media Deutschland GmbH},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85144824731&doi=10.1007%2f978-3-031-22695-3_31&partnerID=40&md5=09a849499ed54de9a2f099587f2014e0},
}

@Conference{Toptan2022,
