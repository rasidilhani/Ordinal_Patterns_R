  document_type           = {Article},
  doi                     = {10.1016/j.measurement.2023.112862},
  groups                  = {Journals},
  keywords                = {Fault detection; Frequency stability; Image enhancement; Railroads; Wheels, Faults diagnosis; Image entropy; Multi slices; Multidimensional time; Multidimensional time-frequency analyse method; Multislice methods; Multislice time-frequency image entropy; Railway wheel fault diagnose; Railway wheels; Time-frequency analysis methods; Time-frequency images, Failure analysis},
