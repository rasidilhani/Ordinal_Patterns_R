  document_type           = {Article},
  doi                     = {10.1016/j.bspc.2022.104145},
  groups                  = {Journals},
  keywords                = {Decision trees; Feature Selection; Frequency domain analysis; Students, Detection models; Distribution entropies; Exposed to; Feasibility studies; Major depressive disorder; Mental state; Mental stress; Multi-domain features; Pulse rate variability; Real- time, Support vector machines, adult; Article; clinical article; controlled study; diagnostic accuracy; feasibility study; female; human; major depression; male; mental arithmetic; mental stress; pulse rate; pulse rate variability; random forest; recursive feature elimination; support vector machine; young adult},
