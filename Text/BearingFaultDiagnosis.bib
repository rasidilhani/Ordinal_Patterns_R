  groups              = {Journals},
  keywords            = {Perturbation techniques; Quantum theory; Statistical mechanics, Central Limit Theorem; Quantum mechanical; Quantum mechanical perturbation theory; Standard conditions; Statistical tools; Time independents; Univariate, Markov chains},
  language            = {English},
