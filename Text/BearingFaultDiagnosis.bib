  groups                  = {Journals},
  keywords                = {Analog circuits; Cryptography; Image processing; System stability; Timing circuits; Transients, Control parameters; Hardware circuits; Heterogeneous time-lag chaotic system; Images encryptions; Initial conditions; Multi-directional attractor; Multistability; Performance; Time lag; Transient chaos, Chaotic systems},
