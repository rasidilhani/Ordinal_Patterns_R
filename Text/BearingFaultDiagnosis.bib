@Article{Pei2021,
  author                  = {Pei, M. and Li, H. and Yu, H.},
  journal                 = {Measurement Science Review},
  title = {Degradation State Identification for Hydraulic Pumps Based on Multi-scale Ternary Dynamic Analysis, NSGA-II and {Svm}},
  year                    = {2021},
  issn                    = {13358871},
  note                    = {cited By 6},
  number                  = {3},
  pages = {82--92},
  volume                  = {21},
  abbrev_source_title = {Meas. Sci. Rev.},
  abstract                = {Degradation state identification for hydraulic pumps is crucial to ensure system performance. As an important step, feature extraction has always been challenging. The non-stationary and non-Gaussian characteristics of the vibration signal are likely to weaken the performance of traditional features. In this paper, an efficient feature extraction algorithm named multi-scale ternary dynamic analysis (MTDA) is proposed. MTDA reconstructs the phase space based on the given signal and converts each embedding vector into a ternary pattern independently, which enhances its capacity of describing the details of non-stationary signals. State entropy (SE) and state transition entropy (STE) are calculated to estimate the dynamical changes and complexity of each signal sample. The excellent performance of SE and STE in detecting frequency changes, amplitude changes, and the development process of fault is verified with the use of four simulated signals. The proposed multi-scale analysis enables them to provide a more precise estimation of entropy. Furthermore, support vector machine (SVM) and nondominated sorting genetic algorithm II (NSGA-II) are introduced to conduct feature selection and state identification. NSGA-II and SVM can conduct the joint optimization of these two goals. The details of the method proposed in this paper are tested using simulated signals and experimental data, and some studies related to the fault diagnosis of rotating machinery are compared with our method. All the results show that our proposed method has better performance, which obtains higher recognition accuracy and lower feature set dimension. © 2021 Mochao Pei et al., published by Sciendo.},
  affiliation             = {Army Engineering University, Shijiazhuang, 050003, China},
  author_keywords         = {Degradation state identification; Hydraulic pump; Multi-scale ternary dynamic analysis(MTDA); NSGA-II and SVM},
  correspondence_address1 = {Li, H.; Army Engineering UniversityChina; email: lihr168@sohu.com},
  document_type           = {Article},
  doi                     = {10.2478/msr-2021-0012},
  groups                  = {Journals},
  keywords                = {Entropy; Extraction; Fault detection; Feature extraction; Genetic algorithms; Machinery; Phase space methods; Vector spaces, Development process; Fault diagnosis of rotating machineries; Feature extraction algorithms; Multi scale analysis; Non dominated sorting genetic algorithm ii (NSGA II); Nonstationary signals; Recognition accuracy; State identification, Support vector machines},
  language                = {English},
  publisher               = {Sciendo},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85109109215&doi=10.2478%2fmsr-2021-0012&partnerID=40&md5=ae8aa36b8eb66b2b902ae4b1811c1f42},
}

@Article{Gu2021,
  author                  = {Gu, J. and Peng, Y. and Cao, B.},
  journal                 = {Insight: Non-Destructive Testing and Condition Monitoring},
  title = {Studies of filtering effect on fault diagnosis of spindle device in hoist},
  year                    = {2021},
  issn                    = {13542575},
  note                    = {cited By 0},
  number                  = {6},
  pages = {348--356},
  volume                  = {63},
  abbrev_source_title = {Insight Non Destr Test Cond Monit},
  abstract                = {Spindle devices, which are among the core components of mine hoists, are typical rotor-bearing systems. Vibration-based fault diagnosis techniques are often used to help prevent mechanical failures of such systems. The fault vibration signals generally include pulse information reflecting fault type, independent vibration components caused by other non-faulty mechanical components, noise in the surrounding environment and so on. The reduction of noise in the vibration signal collected by the sensor is of practical significance for the correct diagnosis of subsequent rotating machinery faults. To solve this problem, a fault diagnosis method based on a smooth (SM) filtering algorithm combined with variational mode decomposition (VMD) and a support vector machine (SVM) is proposed. Wavelet transform (WT) and wavelet packet transform (WPT) methods are used to compare the noise reduction. The reliability and effectiveness of the method are verified by experiments on a hoist mechanical fault simulator. Experimental results show that the proposed method has high prediction accuracy and can provide a good practical reference for fault diagnosis of rotating machinery. © 2021 British Institute of Non-Destructive Testing. All rights reserved.},
  affiliation             = {The School of Mechatronic Engineering, China University of Mining and Technology, Xuzhou, 221116, China; The Jiangsu Key Laboratory of Mine Mechanical and Electrical Equipment, China University of Mining and Technology, Xuzhou, 221116, China},
  author_keywords         = {Empirical mode decomposition; Fault diagnosis; Hoist; Support vector machine; Variational mode decomposition},
  coden                   = {ITMOE},
  correspondence_address1 = {Gu, J.; The School of Mechatronic Engineering, China; email: gujuncumt@163.com},
  document_type           = {Article},
  doi                     = {10.1784/insi.2021.63.6.348},
  groups                  = {Journals},
  keywords                = {Failure (mechanical); Failure analysis; Hoists; Rotating machinery; Support vector machines; Vibrations (mechanical); Wavelet transforms, Fault diagnosis method; Fault diagnosis of rotating machineries; Fault diagnosis technique; Mechanical components; Mechanical failures; Rotor-bearing system; Surrounding environment; Wavelet packet transform(WPT), Fault detection},
