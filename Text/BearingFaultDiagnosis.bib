  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85204349706&doi=10.1007%2f978-3-031-70235-8_40&partnerID=40&md5=a74842f117adc88b2c9d925f2a7ddc2f},
}

@Article{Nourani2024,
  author                  = {Nourani, V. and Gholinia, A. and Abbaszadeh, P. and Ahmadi, R. and Ke, C.-Q.},
  journal                 = {Hydrological Sciences Journal},
  title = {Unravelling the impact of climate change and anthropogenic activities on streamflow: the benefit of newly developed evapotranspiration data},
  year                    = {2024},
  issn                    = {02626667},
  note                    = {cited By 4},
  number                  = {14},
  pages = {2026--2043},
  volume                  = {69},
  abbrev_source_title = {Hydrol. Sci. J.},
  abstract                = {To separate the contributions of climate change and human activities to alterations in flow for the Ahar Chay watershed in Iran, change points of the normalized difference vegetation index (NDVI) and evapotranspiration (ET) were distinguished before and after significant alterations. The Budyko model and Soil and Water Assessment Tool (SWAT) were used to find the reduction in runoff. New Penman-Monteith-Leuning (PML) ET data was used to consider plant types. Results revealed an increase in NDVI coinciding with the change point in 1998, as well as ET in 1999. The significance of the Sattarkhan Dam became evident when distinguishing the impacts upstream versus downstream of the dam. Results also indicated that climate change contributed significantly to upstream flow reduction (83.5%), whereas downstream reductions were primarily linked to human-related impacts (59.7–82.5%). Assuming no dam interception, 2007 became the change point, signifying a 37.5% reduction in average flow from before to after this point due to the increased vegetation cover. © 2024 IAHS.},
  affiliation             = {Center of Excellence in Hydroinformatics, Faculty of Civil Engineering, University of Tabriz, Tabriz, Iran; College of Engineering, Information Technology and Environment, Charles Darwin University, Ellengowan, Australia; Faculty of Civil and Environmental Engineering, Near East University, Nicosia, Turkey; Department of Civil and Environmental Engineering, Portland State University, Portland, OR, United States; School of Geographic and Oceanographic Sciences, Nanjing University, Nanjing, China},
  author_keywords         = {Ahar Chay watershed; Budyko model; climate change; human activities; PML evapotranspiration model; SWAT model},
  coden                   = {HSJOD},
  correspondence_address1 = {Nourani, V.; Center of Excellence in Hydroinformatics, Iran; email: vahid.nourani@cdu.edu.au},
  document_type           = {Article},
