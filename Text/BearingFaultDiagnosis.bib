  keywords                = {3D printing; Cell engineering; Cell signaling; Collagen; Scaffolds (biology); Scanning electron microscopy; Swelling; Tissue; Tissue regeneration, Cells signaling; Collagen scaffolds; Design and evaluations; Destructive disease; Extracellular; Graphene oxides; Major elements; Property; Signaling molecules; Tissues engineerings, Graphene oxide},
  language                = {English},
