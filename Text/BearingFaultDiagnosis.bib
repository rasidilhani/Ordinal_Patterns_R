  doi                     = {10.1016/j.cnsns.2020.105556},
  groups                  = {Journals},
  keywords                = {Entropy; Financial data processing; Graphic methods; Synchronization, Complex time series; Cumulative histogram; Entropy measure; Financial time series; Heartbeat signals; Refined cross-sample entropy; Robust synchronization; Sample entropy; Synchronization estimation; Times series, Time series},
