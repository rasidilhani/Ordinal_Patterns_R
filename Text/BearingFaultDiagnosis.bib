}

@Article{Amigo2009,
  author            = {Amigó, José María},
  journal           = {International Journal of Bifurcation and Chaos},
  title = {The ordinal structure of the signed shift transformations},
  year              = {2009},
  note              = {Cited by: 8},
  number            = {10},
  pages             = {3311 – 3327},
  volume            = {19},
  abstract          = {Ordinal patterns bring in the dynamic novel aspects, difficult questions, and useful tools for entropy estimation, time series analysis and other applications. In [Amigó et al., 2008a], the structure of the ordinal patterns of the one- and two-sided shifts on N symbols was elucidated with great detail. The results are applied via order isomorphy to the ordinal structure of the sawtooth maps x → Nx mod 1 and the baker map. In this paper, we generalize the technique employed there, to cope with the so-called signed shifts on N symbols and signed sawtooth maps. © 2009 World Scientific Publishing Company.},
  doi               = {10.1142/S0218127409024773},
  groups            = {Journals},
  publication_stage = {Final},
  source            = {Scopus},
  type              = {Article},
  url               = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-73149093230&doi=10.1142%2fS0218127409024773&partnerID=40&md5=638808ba4e0fab7139f988064b5c0425},
}

@Article{MatillaGarcia2010a,
  author            = {Matilla-García, M and Rodríguez, José Miguel and Marín, Manuel Ruiz},
  journal           = {Journal of Time Series Analysis},
  title = {A symbolic test for testing independence between time series},
  year              = {2010},
  note              = {Cited by: 11},
  number            = {2},
  pages             = {76 – 85},
  volume            = {31},
  abstract          = {In this article we introduce a test for independence between two processes {Xt} and {Yt}. To this end we rely on symbolic dynamics and permutation entropy as a measure of dependence. As a result, a nonparametric (model-free) test for either linear or nonlinear processes is presented. The test is consistent for a broad range of dependent alternatives. Empirical simulations indicate and highlight the general utility of the test for time-series analysts. Copyright © 2010 Blackwell Publishing Ltd.},
  doi               = {10.1111/j.1467-9892.2009.00645.x},
  groups            = {Journals},
  publication_stage = {Final},
  source            = {Scopus},
  type              = {Article},
