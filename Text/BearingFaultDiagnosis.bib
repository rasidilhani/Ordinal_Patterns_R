  groups                  = {Conference},
  isbn                    = {9781728143439},
  journal                 = {2019 IEEE Signal Processing in Medicine and Biology Symposium, SPMB 2019 - Proceedings},
  keywords                = {Artificial life; Biomedical signal processing; Data visualization; Decision trees; Electroencephalography; Electrophysiology; Learning systems; Support vector machines; User experience, Classification performance; Machine learning approaches; Mental health; Multi-class support vector machines; Physical health; Polysomnography; Quality of life; Quantitative features, Sleep research},
  language                = {English},
