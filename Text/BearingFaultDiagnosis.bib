  keywords            = {Anesthesiology; Neural networks; Real time control, Detrended fluctuation analysis; Loss of consciousness; Offline data; Real time; Real-time implementations; Self-similarities; Two channel; Window Size, Image processing},
  language            = {English},
  source              = {Scopus},
  url                 = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85093961538&doi=10.1145%2f3417519.3419403&partnerID=40&md5=6b0f3d851c26b6aec698ebd2be02ab65},
}

@Article{Zhou2020,
  author                  = {Zhou, Y. and Chen, J. and Wang, H. and Jiang, J.},
  journal                 = {Zhendong yu Chongji/Journal of Vibration and Shock},
  title = {Early fault diagnosis for rolling bearing based on noise-assisted signal feature enhancement [基于噪声辅助信号特征增强的滚动轴承早期故障诊断]},
  year                    = {2020},
  issn                    = {10003835},
  note                    = {cited By 8},
  number                  = {15},
  pages = {66--73},
  volume                  = {39},
  abbrev_source_title = {J Vib Shock},
  abstract                = {Aiming at the problem of parts of useful signals being filtered to cause loss of feature signals during filtering interference noise for the purpose of rolling bearing vibration signal feature extraction, an early fault diagnosis method for rolling bearing based on noise-assisted signal feature enhancement was proposed. The generalized multi-scale permutation entropy screening criterion was used to screen rolling bearing vibration signals, and parameters of a Duffing vibrator system were optimized using the particle swarm optimization (PSO) algorithm to realize the optimal matching among Duffing vibrator system, input signals and noise, and improve the stochastic resonance effect. Some background noise energy was transferred to rolling bearing's early weak fault signal features to enhance them. The proposed method was applied in early fault diagnosis of rolling bearings under their life cycle state, and compared with the adaptive morphology method based on the variational mode decomposition (VMD). Results showed the effectiveness and feasibility of the proposed method are verified. © 2020, Editorial Office of Journal of Vibration and Shock. All right reserved.},
  affiliation             = {School of Mechanical Engineering, Nantong University, Nantong, 226019, China; Jiangsu Key Laboratory of 3D Printing Equipment and Application Technology, Nantong Institute of Technology, Nantong, 226002, China},
  author_keywords         = {Duffing vibrator; Generalized multi-scale permutation entropy; Rolling bearing; Stochastic resonance},
  correspondence_address1 = {Wang, H.; School of Mechanical Engineering, China; email: wangheng@ntu.edu.cn},
  document_type           = {Article},
  doi                     = {10.13465/j.cnki.jvs.2020.15.009},
  groups                  = {Journals},
  keywords                = {Failure analysis; Fault detection; Life cycle; Magnetic resonance; Particle swarm optimization (PSO); Signal processing; Stochastic systems; Vibrators, Adaptive morphologies; Background noise; Interference noise; Mode decomposition; Particle swarm optimization algorithm; Permutation entropy; Rolling bearing vibration; Stochastic resonances, Roller bearings},
  language                = {Chinese},
  publisher               = {Chinese Vibration Engineering Society},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85090506896&doi=10.13465%2fj.cnki.jvs.2020.15.009&partnerID=40&md5=82e595166009960e2366941b04fa5f2f},
}

@Article{Pan2020,
  author                  = {Pan, Z. and Huang, G. and Wu, M.},
  journal                 = {Zhendong yu Chongji/Journal of Vibration and Shock},
  title = {Check valve fault diagnosis based on {Vmd} parametric optimization and enhanced multi-scale permutation entropy [基于参数优化VMD和增强多尺度排列熵的单向阀故障诊断]},
  year                    = {2020},
  issn                    = {10003835},
  note                    = {cited By 5},
  number                  = {15},
  pages = {118--125},
  volume                  = {39},
  abbrev_source_title = {J Vib Shock},
  abstract                = {Aiming at the problem of extracting fault feature information of a check pump on a single scale being difficult due to the information being distributed on multi-scale in a high-pressure diaphragm pump with complex mechanical structure, A fault diagnosis method for check valves was proposed based on VMD parametric optimization and enhanced multi-scale permutation entropy (EMPE). Firstly, vibration signals of a check valve were decomposed using VMD, and parameters of VMD were optimized with the minimum envelope entropy principle to obtain several intrinsic mode functions (IMFs). Then, EMPEs of IMFs were calculated to construct fault feature vectors. Finally, the variable predictive model-based pattern recognition (VPMPR) was used to train and identify fault feature vectors, and the fault diagnosis of the check valve was realized. Simulation signals and engineering test analysis showed that the proposed method can accurately recognize fault types of the check valve; it has a certain reliability and is valuable in engineering application. © 2020, Editorial Office of Journal of Vibration and Shock. All right reserved.},
  affiliation             = {Faculty of Information Engineering & Automation, Kunming University of Science and Technology, Kunming, 650500, China; Yunnan Institute of Mineral Pipeline Engineering Technology, Kunming, 650500, China},
  author_keywords         = {Check valve; Enhanced multi-scale permutation entropy (EMPE); Fault diagnosis; Variable predictive model-based pattern recognition (VPMPR); Variational mode decomposition (VMD)},
  correspondence_address1 = {Huang, G.; Faculty of Information Engineering & Automation, China},
  document_type           = {Article},
  doi                     = {10.13465/j.cnki.jvs.2020.15.016},
  groups                  = {Journals},
  keywords                = {Entropy; Failure analysis; Pattern recognition; Predictive analytics; Reliability analysis; Valves (mechanical), Engineering applications; Fault diagnosis method; Intrinsic Mode functions; Mechanical structures; Parametric optimization; Permutation entropy; Predictive modeling; Simulation signals, Fault detection},
  language                = {Chinese},
  publisher               = {Chinese Vibration Engineering Society},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85090505709&doi=10.13465%2fj.cnki.jvs.2020.15.016&partnerID=40&md5=129a5580ca10d82a83a983a82bacf0aa},
}

@Article{SolisMontufar2020,
  author                  = {Solís-Montufar, E.E. and Gálvez-Coyt, G. and Muñoz-Diosdado, A.},
  journal                 = {Frontiers in Physiology},
  title = {Entropy Analysis of RR-Time Series From Stress Tests},
  year                    = {2020},
  issn                    = {1664042X},
  note                    = {cited By 36},
  volume                  = {11},
  abbrev_source_title = {Front. Physiol.},
  abstract                = {The RR-interval time series or tachograms obtained from electrocardiograms have been widely studied since they reflect the cardiac variability, and this is an indicative of the health status of a person. The tachogram can be seen as a highly non-linear and complex time series, and therefore, should be analyzed with non-linear techniques. In this work, several entropy measures, Sample Entropy (SampEn), Approximate Entropy (ApEn), and Fuzzy Entropy (FuzzyEn) are used as a measure of heart rate variability (HRV). Tachograms belonging to thirty-nine subjects were obtained from a cardiac stress test consisting of a rest period followed by a period of moderate physical activity. Subjects are grouped according to their physical activity using the IPAQ sedentary and active questionnaire, we work with youth and middle-aged adults. The entropy measures for each group show that for the sedentary subjects the values are high at rest and decrease appreciably with moderate physical activity, This happens for both young and middle-aged adults. These results are highly reproducible. In the case of the subjects that exercise regularly, an increase in entropy is observed or they tend to retain the entropy value that they had at rest. It seems that there is a possible correlation between the physical condition of a person with the increase or decrease in entropy during moderate physical activity with respect to the entropy at rest. It was also observed that entropy during longer physical activity tests tends to decrease as fatigue accumulates, but this decrease is small compared to the change that occurs when going from rest to physical activity. © Copyright © 2020 Solís-Montufar, Gálvez-Coyt and Muñoz-Diosdado.},
  affiliation             = {Unidad Profesional Interdisciplinaria de Biotecnología, Instituto Politécnico Nacional, Mexico City, Mexico; Centro de Investigación en Computación, Instituto Politécnico Nacional, Mexico City, Mexico},
  art_number              = {981},
  author_keywords         = {complexity; entropy; exercise; heart rate variability; physical conditioning; stress test; tachograms},
  correspondence_address1 = {Muñoz-Diosdado, A.; Unidad Profesional Interdisciplinaria de Biotecnología, Mexico; email: amunozdiosdado@gmail.com},
  document_type           = {Article},
  doi                     = {10.3389/fphys.2020.00981},
  groups                  = {Journals},
  keywords                = {adult; age; algorithm; Approximate Entropy; Article; controlled study; correlation analysis; electrocardiogram; entropy; exercise; exercise test; fatigue; female; Fuzzy Entropy; health status; heart rate variability; heart stress; human; human experiment; juvenile; male; middle aged; normal human; physical activity; questionnaire; reproducibility; RR interval; Sample Entropy; sedentary lifestyle; tachogram; young adult},
  language                = {English},
  publisher               = {Frontiers Media S.A.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85089882784&doi=10.3389%2ffphys.2020.00981&partnerID=40&md5=d3b9cd142664ac15cca3ea3bd7093bd4},
}

@Article{Wang2020b,
  author              = {Wang, L. and Liu, Q. and Xu, N.},
  journal             = {Zhongguo Guanxing Jishu Xuebao/Journal of Chinese Inertial Technology},
  title = {A geomagnetic signal de-noising method based on interference detection and {Ceemd} [基于干扰检测和CEEMD的地磁信号降噪方法]},
  year                = {2020},
  issn                = {10056734},
  note                = {cited By 0},
  number              = {4},
  pages = {474--479},
  volume              = {28},
  abbrev_source_title = {Zhongguo Guanxing Jishu Xuebao},
  abstract            = {Focusing on the random high-amplitude pulse magnetic interference from environment and vehicle in geomagnetic navigation fluxgate sensor, a de-noising algorithm based on the combination of multi-scale interference detection and complete ensemble empirical mode decomposition (CEEMD) is proposed. Firstly, according to the strong correlation of the geomagnetic signals, the autocorrelation function of each intrinsic mode functions (IMF) is calculated and the effective IMFs are selected adaptively. Secondly, permutation entropy is applied to perform a multi-scale analysis of each effective IMF to mark the IMF interference signal periods. Then, low frequency effective components are extracted through the secondary decomposition performed on each interference period to filter out high amplitude pulse interference information in the IMF. Finally, the filtered signal is obtained by performing signal reconstruction on effective IMF after interference suppression through superimposing. Experiment results show that signal de-noising method based on interference detection and CEEMD can effectively remove magnetic interference, and the signal-to-noise ratio(SNR) is improved 3 times when the SNR of the measurement signal is low. © 2020, Editorial Department of Journal of Chinese Inertial Technology. All right reserved.},
  affiliation         = {Key laboratory of micro-inertial instrument and advanced navigation technology, School of instrument science and engineering, Southeast University, Nanjing, 210096, China},
  author_keywords     = {Autocorrelation function; Complete Ensemble Empirical Mode Decomposition (CEEMD); Fluxgate sensor; Geomagnetic navigation; Geomagnetic signal de-noising},
  document_type       = {Article},
  doi                 = {10.13695/j.cnki.12-1222/o3.2020.04.009},
  groups              = {Journals},
  keywords            = {Geomagnetism; Signal interference; Signal reconstruction; Signal to noise ratio, Autocorrelation functions; Ensemble empirical mode decomposition; Geomagnetic navigation; Interference detection; Intrinsic Mode functions; Magnetic interference; Multi scale analysis; Secondary decomposition, Signal denoising},
  language            = {Chinese},
