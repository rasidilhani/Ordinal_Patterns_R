@Conference{Zhao2020e,
  author                  = {Zhao, H. and Yu, J. and Cao, J. and Liao, W.-H.},
  title = {Refined Weighted-Permutation Entropy: A Complexity Measure for Human Gait and Physiologic Signals with Outliers and Noise},
  year                    = {2020},
  editor                  = {Lacarbonara W., Balachandran B., Ma J., Tenreiro Machado J.A., Stepan G.},
  note                    = {cited By 1},
  pages = {223--231},
  publisher               = {Springer Nature},
  abbrev_source_title = {New Trends Nonlinear Dyn. - Proc. Int. Nonlinear Dyn. Conf., NODYCON},
  abstract                = {The complexity quantification of human gait and physiologic signals has received considerable interest for wearable healthcare. Permutation entropy is one of the most prevalent algorithms for measuring the complexity of time series, but it fails to account for amplitude information with outliers and noise in such time series. Though weighted-permutation entropy aims to incorporate amplitude information by counterweighing the motif with its variance, it mixes noise and outliers with abrupt changes, which have a negative effect on the analysis result. To overcome this problem, this chapter proposes a refined weighted-permutation entropy by assigning fewer weights to outliers and more weights to regular spiky patterns according to the normal distribution function. The refined weighted-permutation entropy is used to analyze simulated synthetic signals with noise and outliers. The comparative analyses with the permutation entropy and weighted-permutation entropy are also performed. Moreover, human gait and ECG experimental data are analyzed by the proposed method. The results demonstrate its better robustness and stability than traditional methods in distinguishing different states of human gait and physiologic signals. © Springer Nature Switzerland AG 2020.},
  affiliation             = {Xi'an Jiaotong University, Xi'an, China; China Ship Development and Design Center, Wuhan, China; The Chinese University of Hong Kong, Hong Kong},
  author_keywords         = {Human gait; Permutation entropy; Physiologic signals},
  correspondence_address1 = {Cao, J.; Xi'an Jiaotong UniversityChina; email: caojy@mail.xjtu.edu.cn},
  document_type           = {Conference Paper},
  doi                     = {10.1007/978-3-030-34724-6_23},
  groups                  = {Conference},
  isbn                    = {9783030347239},
  journal                 = {New Trends in Nonlinear Dynamics - Proceedings of the 1st International Nonlinear Dynamics Conference, NODYCON 2019},
  keywords                = {Distribution functions; Entropy; Normal distribution; Physiology, Amplitude information; Comparative analyzes; Complexity measures; Human gait; Normal distribution functions; Permutation entropy; Physiologic signal; Synthetic signals; Times series, Time series},
  language                = {English},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85125696755&doi=10.1007%2f978-3-030-34724-6_23&partnerID=40&md5=de3cc2101d8f25774f8ff1c88703d6b5},
}

@Book{Judge2020,
  author                  = {Judge, G.},
  publisher               = {Oxford University Press},
  title = {Information recovery related to adaptive economic behavior and choice},
