@Article{Xiong2020,
  author                  = {Xiong, H. and Shang, P. and He, J. and Zhang, Y.},
  journal                 = {Nonlinear Dynamics},
  title = {Complexity and information measures in planar characterization of chaos and noise},
  year                    = {2020},
  issn                    = {0924090X},
  note                    = {cited By 12},
  number                  = {2},
  pages = {1673--1687},
  volume                  = {100},
  abbrev_source_title = {Nonlinear Dyn},
  abstract                = {In this work, we present a comprehensive assessment of the Fisher information measure and statistical complexity measures based on Euclidean distance, Wootters distance and Jensen–Shannon divergence, regarding their abilities to (planar-) distinguish between/among (1) chaos and periodicity; (2) different degrees of periodicities; (3) different chaotic regimes; and (4) chaos and noise, and characterize delay dynamics. The Bandt–Pompe approach is used to build up the probability space to generate the entropy-complexity/information plane. The effect of embedding parameters on the evaluation is also considered. Within this framework, complexity measures based on the Wootters distance and Jensen–Shannon divergence are superior to the Fisher information measure in capturing subtle details of chaotic dynamics. The Fisher information measure shows advantages in robustness to additive noises and in planar-behavior representation of chaos and noise. Moreover, all measures are able to properly characterize the intrinsic delay dynamics of chaotic and stochastic systems. Nevertheless, the complexity measure based on the Euclidean distance is not valid by definition, thus, not applicable at any cases. © 2020, Springer Nature B.V.},
  affiliation             = {Department of Mathematics, School of Science, Beijing Jiaotong University, Beijing, 100044, China},
  author_keywords         = {Bandt–Pompe approach; Chaos; Entropy-complexity plane; Fisher information measure; Statistical complexity; Stochastic process; Time delay},
  coden                   = {NODYE},
  correspondence_address1 = {Xiong, H.; Department of Mathematics, China; email: xionghui@bjtu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1007/s11071-020-05560-3},
  groups                  = {Journals},
  keywords                = {Chaos theory; Dynamics; Entropy; Fisher information matrix; Random processes; Stochastic systems; Time delay, Behavior representation; Complexity measures; Comprehensive assessment; Embedding parameters; Euclidean distance; Fisher information measures; Information measures; Statistical complexity, Additive noise},
  language                = {English},
  publisher               = {Springer},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85081915396&doi=10.1007%2fs11071-020-05560-3&partnerID=40&md5=74061fdbf79cdafd762fbf3219e41e4d},
}

@Article{Xu2020,
  author                  = {Xu, F. and Huang, Z. and Yang, F. and Wang, D. and Tsui, K.L.},
  journal                 = {Applied Soft Computing Journal},
  title = {Constructing a health indicator for roller bearings by using a stacked auto-encoder with an exponential function to eliminate concussion},
  year                    = {2020},
  issn                    = {15684946},
  note                    = {cited By 70},
  volume                  = {89},
  abbrev_source_title = {Appl. Soft Comput. J.},
  abstract                = {Most deep-learning models, especially stacked auto-encoders (SAEs), have been used in recent years for the diagnosis of faults in rotating machinery. However, very few studies have reported on health indicator (HI) construction by using SAEs in deep learning. SAEs have a good feature-extraction ability when several hidden layers are used to reconstruct the original input. In this study, we first introduce a method to reduce dependence on prior knowledge that is based on SAEs and enables extraction of the preliminary degradation trend from the bearing's frequency domain directly. Second, to construct the final HI and improve the monotonicity of the indicators, an exponential function is used to eliminate global severe vibration after an SAE has extracted the preliminary degradation trend. To prove the effect of our presented method, some other HI construction models, such as root mean square, kurtosis, approximate entropy, permutations entropy, empirical mode decomposition-singular value decomposition, K-means/K-medoids, and various time–frequency fusion indicators are used for comparison. Moreover, to prove that the exponential-function effect exceeds other severe vibration-eliminating methods, examples of the latter methods such as exponentially weighted moving-average and outlier detection are used for comparative analysis. Finally, the results shows that our proposed model is better than the above-mentioned existing models. © 2020 Elsevier B.V.},
  affiliation             = {School of Data Science, City University of Hong Kong, Tat Chee Avenue, Kowloon, Hong Kong, 990777, Hong Kong; Department of Statistics, School of Economics, Shenzhen University, Shenzhen, 518061, China; The State Key Laboratory of Mechanical Systems and Vibration, Shanghai Jiao Tong University, Shanghai, 200240, China},
  art_number              = {106119},
  author_keywords         = {Deep learning; Exponent function; Health indicator; Roller bearings; Stacked auto-encoder},
  correspondence_address1 = {Huang, Z.; School of Data Science, Tat Chee Avenue, Kowloon, Hong Kong; email: zhuang44@cityu.edu.hk},
  document_type           = {Article},
  doi                     = {10.1016/j.asoc.2020.106119},
  groups                  = {Journals},
  keywords                = {Deep learning; Entropy; Exponential functions; Extraction; Frequency domain analysis; Health; Signal encoding; Singular value decomposition; Vibration analysis, Approximate entropy; Auto encoders; Comparative analysis; Construction model; Empirical Mode Decomposition; Exponent function; Exponentially weighted moving average; Health indicators, Roller bearings},
  language                = {English},
  publisher               = {Elsevier Ltd},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85078477095&doi=10.1016%2fj.asoc.2020.106119&partnerID=40&md5=5e62e5fa1a6fd46c56c03c2ac6a79c11},
}

@Article{Lopes2020a,
  author                  = {Lopes, S.R. and Prado, T.L. and Corso, G. and dos S. Lima, G.Z. and Kurths, J.},
  journal                 = {Chaos, Solitons and Fractals},
  title = {Parameter-free quantification of stochastic and chaotic signals},
  year                    = {2020},
  issn                    = {09600779},
  note                    = {cited By 16},
  volume                  = {133},
  abbrev_source_title = {Chaos Solitons Fractals},
  abstract                = {Recurrence entropy (S) is a novel time series quantifier based on recurrence microstates. Here we show for the first time that max(S) can be used as a parameter-free quantifier of short and long-term memories (time-correlations) of stochastic and chaotic signals. max(S) can also evaluate properties of the distribution function of the data set that are not related to time correlation. To illustrate this fact, we show that even shuffled versions of distinct time correlated stochastic signals lead to different, but coherently varying, values of max(S). Such a property of max(S) is associated to its ability to quantify in how many ways distinct short recurrence sequences can be found in time series. Applied to a deterministic dissipative system, the method brings evidence about the attractor properties and the degree of chaoticity. We conclude that the development of a new parameter-free quantifier of stochastic and chaotic time series can open new perspectives to stochastic data and deterministic time series analyses and may find applications in many areas of science. © 2020},
  affiliation             = {Departamento de Física, Universidade Federal do Paraná, Curitiba, PR 81531-980, Brazil; Universidade Federal do Rio Grande do Norte, Departamento de Biofísica e FarmacologiaNatal 59078-970, Brazil; Universidade Federal do Rio Grande do Norte, Escola de Ciências e TecnologiaNatal 59078-970, Brazil; Potsdam Institute for Climate Impact Research -, Telegraphenberg A 31Potsdam 14473, Germany; Humboldt University Berlin, Department of PhysicsBerlin 12489, Germany},
  art_number              = {109616},
  author_keywords         = {05.10.-a; 05.45.-a; 05.45.Tp; Neural network; Nonlinear dynamics; Synchronization},
  coden                   = {CSFOE},
  correspondence_address1 = {Lopes, S.R.; Departamento de Física, Brazil; email: lopes@fisica.ufpr.br},
  document_type           = {Article},
  doi                     = {10.1016/j.chaos.2020.109616},
  groups                  = {Journals},
  keywords                = {Distribution functions; Dynamics; Neural networks; Stochastic systems; Synchronization; Time series, 05.10.-a; 05.45.-a; 05.45.Tp; Attractor properties; Chaotic time series; Dissipative systems; Stochastic signals; Time correlations, Time series analysis},
  language                = {English},
  publisher               = {Elsevier Ltd},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85077950072&doi=10.1016%2fj.chaos.2020.109616&partnerID=40&md5=d99a0258a8661226b8e0ba2f25e53a9b},
}

@Article{Ye2020,
  author                  = {Ye, Y. and Zhang, Y. and Wang, Q. and Wang, Z. and Teng, Z. and Zhang, H.},
  journal                 = {Mechanical Systems and Signal Processing},
