  document_type           = {Conference Paper},
  doi                     = {10.1109/SDPC.2019.00112},
  groups                  = {Conference},
  isbn                    = {9781728101996},
  journal                 = {Proceedings - 2019 International Conference on Sensing, Diagnostics, Prognostics, and Control, SDPC 2019},
  keywords                = {Classification (of information); Dispersions; Entropy; Failure analysis; Fault detection; Signal processing; Support vector machines, Approximate entropy; Bearing fault diagnosis; Bearing vibrations; Ensemble empirical mode decomposition; Intrinsic Mode functions; Permutation entropy; Rolling bearings; Vibration signal, Roller bearings},
  language                = {English},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85091476161&doi=10.1109%2fSDPC.2019.00112&partnerID=40&md5=7353d6aaa7df5c34549b9bb99711e1a3},
