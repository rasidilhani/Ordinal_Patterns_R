  doi                     = {10.1063/5.0220376},
  groups                  = {Journals},
  keywords                = {Atmospheric thermodynamics; Magnetohydrodynamics; Magnetoplasma; Plasma simulation; Plasma theory; Plasma turbulence, Astrophysical plasma; Chaotic behaviour; Chaotic fluctuations; In-situ observations; Laboratory experiments; Natural environments; Space plasmas; Stochastic fluctuation; Stochastics; Turbulent plasmas, Solar wind},
  language                = {English},
