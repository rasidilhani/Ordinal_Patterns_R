@Article{Li2025a,
  author                  = {Li, W. and Shen, X. and Li, Y. and Chen, Z. and Zhou, J.},
  journal                 = {Journal of Sound and Vibration},
  title = {Detection of ship echo signals in reverberation background based on sample entropy and multiscale sample entropy},
  year                    = {2025},
  issn                    = {0022460X},
  note                    = {cited By 0},
  volume                  = {599},
  abbrev_source_title = {J Sound Vib},
  abstract                = {Detecting target signals in a reverberant underwater environment has long been a prominent and enduring challenge in the field of underwater acoustic signal processing. Traditional frequency-based methods are only effective when dealing with high signal-to-reverberation ratios (SRR) and significant Doppler shifts. This paper introduces the sample entropy (SampEn) and multiscale sample entropy (MSE) algorithms to explore the complexity differences between target echoes and reverberation. By conducting simulations under various SRR and Doppler shifts, we analyze the performance of traditional frequency-energy-based detection method, as well as entropy-based detection methods. The results show that in situations with a minor Doppler shift but a high SRR, frequency-based methods fail, yet the SampEn remains effective in detecting the target echo. Moreover, even when the Doppler shift is insignificant and SRR decreases to 0 dB, MSE can still detect the target echo. © 2024 Elsevier Ltd},
  affiliation             = {School of Marine Science and Technology, Northwestern Polytechnical University, Shaanxi, Xi'an, 710072, China; Key Laboratory of Ocean Acoustics and Sensing (Northwestern Polytechnical University), Ministry of Industry and Information Technology, Shaanxi, Xi'an, 710072, China; School of Information and Communication, Guilin University of Electronic Technology, Guilin, 541004, China; The 705 Research Institute, China Shipbuilding Corporation, Science and Technology on Underwater In-formation and Control Laboratory, Shannxi, Xi'an, 710077, China},
  art_number              = {118910},
  author_keywords         = {Nonlinear dynamics; Reverberation; Sample entropy; Target detection},
  coden                   = {JSVIA},
  correspondence_address1 = {Shen, X.; School of Marine Science and Technology, Shaanxi, China; email: xhshen@nwpu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.jsv.2024.118910},
  groups                  = {Journals},
  keywords                = {Detecting target; Detection methods; Doppler; Echo-signal; High signals; Sample entropy; Ship echoes; Signal to reverberation ratios; Target echo; Targets detection, Reverberation},
  language                = {English},
