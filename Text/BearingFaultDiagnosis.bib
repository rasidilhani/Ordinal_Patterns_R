  keywords                = {Classification (of information); Discrete wavelet transforms; Electroencephalography; Feature extraction; Fractal dimension; Human computer interaction; Speech recognition; Support vector machines, Classification accuracy; Computer interaction; Discriminative features; Electroencephalogram signals; Emotion classification; Emotion recognition; Higuchi fractal dimension; Permutation entropy, Biomedical signal processing},
  language                = {English},
