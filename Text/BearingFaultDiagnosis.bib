  keywords            = {Electric batteries; Errors; Image resolution; Neurology; Patient monitoring; Patient treatment; Wearable technology, Battery lifetime; Epileptic seizure detection; False alarm rate; Neurological disease; Quality of life; Seizure detection; Wearable devices; Wearable systems, Alarm systems},
