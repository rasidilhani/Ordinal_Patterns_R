  groups                  = {Journals},
  keywords                = {Classification (of information); Entropy; Feature extraction; Forecasting; Genetic algorithms; Learning algorithms; Motion compensation; Nearest neighbor search; Neurodegenerative diseases; Neurophysiology; Text processing, Channel selection; Electroen-cephalography channel selection; Epileptic seizure prediction; Genetic algorithm; K near neighbor; Nearest-neighbour; Permutation entropy; Seizure prediction; Support vector machine; Support vectors machine, Support vector machines, algorithm; electroencephalography; entropy; epilepsy; genetics; human; seizure; support vector machine, Algorithms; Electroencephalography; Entropy; Epilepsy; Humans; Seizures; Support Vector Machine},
