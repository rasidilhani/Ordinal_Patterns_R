  number                  = {8},
  pages = {2575--2592},
  volume                  = {39},
  abbrev_source_title = {Nondestr Test Eval},
  abstract                = {A new scheme for ultrasonic non-destructive evaluation of wire-to-terminal joints was developed in this study. A finite element simulation model of 2D porous media based on X-CT images of an NG sample was proposed to analyse acoustic scattering. The simulation signal features were extracted in the time domain, frequency domain, and time-frequency domain, and entropy analysis was conducted to explore the relationship between different characteristic values and porosity, thereby revealing prominent trends in these features. By controlling parameters, 28 welding samples labelled OK and NG were produced, and their echoes were acquired by an ultrasonic Full Matrix Capture (FMC) system. Features of the full matrix signals were extracted, and the combined XGBoost machine learning was used to classify the quality and order the attribution of features. The result highlighted the significance of the waveform factor, margin factor, and kurtosis which are consistent with simulation results. The accuracy of weld quality identification can reach 84%. The three factors may be performance criteria for ultrasonically welded wire-to-terminal joints. © 2024 Informa UK Limited, trading as Taylor & Francis Group.},
  affiliation             = {Institute of Shaanxi Key Laboratory of Ultrasonics, Shaanxi Normal University, Xi’an, China; School of Science, China Metrology University, Hangzhou, China},
  author_keywords         = {full matrix capture; signal processing; Ultrasonic metal welding; wire-to-terminal joints; xgboost machine learning},
  coden                   = {NTEVE},
  correspondence_address1 = {Mo, R.; Institute of Shaanxi Key Laboratory of Ultrasonics, China; email: mmrryycn@snnu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1080/10589759.2024.2304265},
  groups                  = {Journals},
  keywords                = {Computerized tomography; Finite element method; Frequency domain analysis; Machine learning; Porous materials; Time domain analysis; Ultrasonic testing; Welding; Wire, Feature analysis; Finite element simulation model; Full matrix captures; Machine-learning; Non destructive evaluation; Signal-processing; Ultrasonic evaluation; Ultrasonic metal welding; Wire-to-terminal joint; Xgboost machine learning, Nondestructive examination},
