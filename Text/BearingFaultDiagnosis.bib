@Article{Xue2019,
  author                  = {Xue, W. and Dai, X. and Zhu, J. and Luo, Y. and Yang, Y.},
  journal                 = {IEEE Geoscience and Remote Sensing Letters},
  title = {A Noise Suppression Method of Ground Penetrating Radar Based on EEMD and Permutation Entropy},
  year                    = {2019},
  issn                    = {1545598X},
  note                    = {cited By 33},
  number                  = {10},
  pages = {1625--1629},
  volume                  = {16},
  abbrev_source_title = {IEEE Geosci. Remote Sens. Lett.},
  abstract                = {Ensemble empirical mode decomposition (EEMD) is a noise-assisted analysis method, which can overcome the mode mixing problem in empirical mode decomposition (EMD). However, the choice of signal intrinsic mode functions (IMFs) still depends on subjective experience in most cases. In order to solve the problem, a noise suppression method based on EEMD and permutation entropy (PE) is proposed according to the characteristics of ground-penetrating radar (GPR) signal. In the proposed method, first EEMD is used to decompose the GPR signal into a series of IMFs, and the PE of each IMF is calculated; then, the global threshold obtained by the second-order difference of PE of all IMFs is used to distinguish between noise IMFs and target IMFs; finally, the signal is reconstructed with target IMFs to remove the noise. The experimental results for synthetic and practical GPR data show that the proposed method can effectively remove the noise in the GPR signal and improve the resolution of the target. © 2019 IEEE.},
  affiliation             = {School of Automation, China University of Geosciences, Wuhan, China; Hubei Key Laboratory of Advanced Control and Intelligent Automation for Complex Systems, China University of Geosciences, Wuhan, 430074, China},
  art_number              = {8676310},
  author_keywords         = {Ensemble empirical mode decomposition (EEMD); ground-penetrating radar (GPR); noise suppression; permutation entropy (PE); second-order difference},
  correspondence_address1 = {Xue, W.; School of Automation, China; email: xw12982044@163.com},
  document_type           = {Article},
  doi                     = {10.1109/LGRS.2019.2902123},
  groups                  = {Journals},
  keywords                = {Entropy; Geological surveys; Geophysical prospecting; Signal processing; Spurious signal noise, Ensemble empirical mode decompositions (EEMD); Ground penetrating radar (GPR); Noise suppression; Permutation entropy; Second orders, Ground penetrating radar systems, decomposition analysis; entropy; ground penetrating radar; noise; numerical method; spatial resolution},
  language                = {English},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85077760222&doi=10.1109%2fLGRS.2019.2902123&partnerID=40&md5=7662b713a1752ea80a086ec3a94db63f},
}

@Conference{Liu2019b,
  author              = {Liu, P.-K. and Beh, W.-K. and Shih, C.-Y. and Chen, Y.-T. and Wu, A.-Y.A.},
  title = {Entropy and Complexity Assisted {Eeg}-based Mental Workload Assessment System},
  year                = {2019},
  note                = {cited By 11},
  publisher           = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {BioCAS - Biomed. Circuits Syst. Conf., Proc.},
  abstract            = {As the era of Brain-Computer Interfacing (BCI) arrives, computationally measuring human mental workload via Electroencephalography (EEG) signal has become a crucial research field. Conventionally, mental workload assessment studies are mainly based on time-statistics, frequency, and wavelet domain features. In this paper, we present a mental workload assessment system in discriminating high and low mental workload by extracting EEG features from two new domains: Time-complexity and entropy domains features. According to statistical analysis, the result demonstrates that the Frontal and Frontal-Central are two dominating regions. In addition, by fusing the traditional and new features, we boosted the classification performance from 69% to 88%. It indicates time-complexity and entropy domain features are able to extract some non-linear characteristics of EEG, which could not be achieved by traditional approaches. We conclude that the new features are feasible to assess human mental workload, and could provide complementary information to traditional features. © 2019 IEEE.},
  affiliation         = {National Taiwan University, Graduate Institute of Electronics Engineering, Taipei, Taiwan},
  art_number          = {8919019},
