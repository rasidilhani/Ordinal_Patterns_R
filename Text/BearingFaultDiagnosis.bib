  keywords                = {Liquefied gases; Liquid membrane electrodes; Seebeck effect, Conductive fluids; Conductive liquids; Driving fatigue; Dry electrode; Electroencephalogram signals; Humidity conditions; Real- time; Refined composite multiscale fluctuation dispersion entropy; Self-replenishment of conductive fluid; Semi-dry electrode, Electroencephalography},
  language                = {English},
  publisher               = {Taylor and Francis Ltd.},
  pubmed_id               = {39494681},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85209348027&doi=10.1080%2f10255842.2024.2423268&partnerID=40&md5=91de3eff9b674213db51e869e494a4e5},
