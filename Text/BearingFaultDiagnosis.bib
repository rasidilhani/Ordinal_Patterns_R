}

@Article{Li2024i,
  author              = {Li, B. and Sun, K. and Wang, H. and Liu, W.},
  journal             = {Physica Scripta},
  title = {The hyperbolic sine chaotification model and its applications},
  year                = {2024},
  issn                = {00318949},
  note                = {cited By 0},
  number              = {7},
  volume              = {99},
  abbrev_source_title = {Phys Scr},
  abstract            = {Some existing chaotic systems suffer from issues such as period windows, discontinuous parameter ranges, and dynamical degradation, which seriously limit their application. Therefore, designing high-performance anti-degradation chaotic systems is of great significance. In this paper, a novel hyperbolic sine chaotification model (HSCM) is proposed. It allows for the use of any chaotic maps or linear functions as the seed maps, and employs a closed-loop modulation coupling (CMC) method to extend it to high-dimensional (HD) chaotic maps. Theoretical and experimental results show that this model can effectively improve the Lyapunov exponent (LE) of the seed chaotic map and expand the parameter ranges. In addition, it can also resist the dynamical degradation under finite computational precision. Based on the HSCM, a novel eight-dimensional (8D) HSCM is designed, and implemented through field-programmable gate array (FPGA) in both serial and parallel modes, respectively. Furthermore, the novel chaotic maps are applied to pseudo-random sequence generator (PRNG) and image compression under finite computing precision. Experimental results indicate that the novel chaotification model has greatly broad application prospects. © 2024 IOP Publishing Ltd},
  affiliation         = {School of Physics, Central South University, Changsha, 410083, China; School of Electronic Information, Central South University, Changsha, 410083, China},
  art_number          = {075274},
  author_keywords     = {chaos; chaotification; compressed sensing; dynamical degradation; field-programmable gate array (FPGA); pseudo-random number generator (PRNG)},
  coden               = {PHSTB},
  document_type       = {Article},
  doi                 = {10.1088/1402-4896/ad5804},
  groups              = {Journals},
  keywords            = {Field programmable gate arrays (FPGA); Image compression; Logic gates; Lyapunov methods; Number theory; Random number generation, Chaotic map; Chaotification; Compressed-Sensing; Dynamical degradation; Field programmables; Field-programmable gate array; Parameter range; Programmable gate array; Pseudo-random number generator; Pseudorandom number generators, Chaotic systems},
  language            = {English},
  publisher           = {Institute of Physics},
  source              = {Scopus},
  url                 = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85197424273&doi=10.1088%2f1402-4896%2fad5804&partnerID=40&md5=94e21f767dd25136705ce188e8c75488},
}

@Article{Xu2024b,
  author                  = {Xu, W. and Liu, L.},
