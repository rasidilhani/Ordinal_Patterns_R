@Article{Pan2024,
  author                  = {Pan, Z. and Liu, H. and Wang, L. and Dian, F. and Zhou, C. and Xu, B. and Li, Y.},
  journal                 = {Optics and Laser Technology},
  title = {A novel method for improving salinity resolution of optical fiber sensor based on modified adaptive variational mode decomposition},
  year                    = {2024},
  issn                    = {00303992},
  note                    = {cited By 2},
  volume                  = {177},
  abbrev_source_title = {Opt Laser Technol},
  abstract                = {Aiming at the problem that the salinity resolution of fiber optic sensors is significantly restricted by background noise of the system, a novel method is proposed based modified adaptive variational mode decomposition (MAVMD) to improved salinity resolution. Optimization objective is established by minimizing the permutation entropy (PE) mean of variational mode decomposition (VMD) modal components to realize the self-adaptive selection of parameters. Drawing upon the idea of noise assisted signal analysis, the VMD approach is improved by incorporating positive and negative paired Gaussian white noise into the original signal to assist in decomposition. The MAVMD is applied to adaptively decompose the original signal into several intrinsic mode function (IMF) components, and the component that include a significant amount of salinity characterization information is determined by the criterion of maximum correlation coefficient. Simulation and experimental findings demonstrate that MAVMD can effectively eliminate environmental noise and system noise, and greatly retain salinity characteristic information. Compared with VMD, the SNR of salinity signal is enhanced by 8.57 dB and the mean square error is decreased by about 7.2 times. Further, by the examination of the power spectral density (PSD) of salinity signal before and after noise suppression, we notice that the approach is capable of attaining a salinity resolution of 2.50 × 10−5 ‰, which is almost two orders of magnitude higher than that before noise suppression (2.77 × 10−3 ‰). © 2024 Elsevier Ltd},
  affiliation             = {National Engineering Research Center of Fiber Optic Sensing Technology and Networks, Wuhan, 430070, China; School of Information Engineering, Wuhan University of Technology, Wuhan, 430070, China; School of Mechanical and Electronic Engineering, Wuhan University of Technology, Wuhan, 430070, China; School of Telecommunications Engineering, Hubei Open University, Wuhan, 430070, China},
  art_number              = {111212},
  author_keywords         = {Correlation coefficient; FBG-FP; MAVMD; Permutation entropy; Salinity demodulation; VMD},
  coden                   = {OLTCA},
  correspondence_address1 = {Zhou, C.; National Engineering Research Center of Fiber Optic Sensing Technology and NetworksChina; email: zcm@whut.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.optlastec.2024.111212},
  groups                  = {Journals},
  keywords                = {Demodulation; Entropy; Fiber Bragg gratings; Fiber optic sensors; Mean square error; Optical variables measurement; Signal to noise ratio; Spectral density; White noise, Background noise; Correlation coefficient; FBG-FP; Fibre-optic sensor; Modified adaptive variational mode decomposition; Noise suppression; Novel methods; Original signal; Permutation entropy; Salinity demodulation, Variational mode decomposition},
  language                = {English},
  publisher               = {Elsevier Ltd},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85193903338&doi=10.1016%2fj.optlastec.2024.111212&partnerID=40&md5=c1a4a236f20ca20493bb9bb8657d6f08},
}

@Article{Shang2024,
  author                  = {Shang, D. and Su, S. and Sun, Y.K. and Wang, F. and Cao, Y. and Yang, W.F. and Li, P. and Zhou, J.H.},
  journal                 = {Computer-Aided Civil and Infrastructure Engineering},
  title = {Wear diagnosis for rail profile data using a novel multidimensional scaling clustering method},
  year                    = {2024},
  issn                    = {10939687},
  note                    = {cited By 1},
  number                  = {19},
  pages = {2971--2989},
  volume                  = {39},
  abbrev_source_title = {Comput.-Aided Civ. Infrastruct. Eng.},
  abstract                = {The diagnosis of railway system faults is significant for its comfort, efficiency, and safety. The rail surface wear is the key impact factor when considering the health conditions of rails. This paper accomplishes contactless rail wear diagnosis by using multidimensional scaling based on a novel informational dissimilarity measure (IDM) to cluster intact and different worn rail profile data. The IDM uses weighted-probability distribution of dispersion patterns to extract accurate time domain features from rail profile data, and the loss of information is minimized, which can greatly improve the accuracy for wear diagnosis. All the analyzing data for real experiments are collected by a laser scanner camera on an inspection car, where heavy-haul railway rails with different types of surface wear are inspected. Experimental results with simulated and reality-based data show that the proposed methods can identify worn profile data and discriminate different types of worn profiles more effectively when compared with existing methods. Thus, the proposed method offers a new thinking for the diagnosis of rail surface wear for heavy-haul railways. © 2024 Computer-Aided Civil and Infrastructure Engineering.},
  affiliation             = {School of Automation and Intelligence, Beijing Jiaotong University, Beijing, China; CRRC Zhuzhou Electric Locomotive Research Institute, Zhuzhou CRRC Times Electric Co. Ltd., Zhuzhou, China; East China Jiaotong University, School of Mechatronics and Vehicle Engineering, Nanchang, China},
  coden                   = {CCIEF},
  correspondence_address1 = {Su, S.; School of Automation and Intelligence, China; email: shuaisu@bjtu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1111/mice.13235},
  groups                  = {Journals},
  keywords                = {Computer aided diagnosis; Probability distributions; Rails; Time domain analysis; Wear of materials, Clustering methods; Dissimilarity measures; Heavy haul railway; Multi-dimensional scaling; Profile data; Rail surfaces; Railway system; Scaling clustering; Surface wear; Worn profiles, Railroads, cluster analysis; dispersion; experimental study; probability; railway; wear},
  language                = {English},
  publisher               = {John Wiley and Sons Inc},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85192978692&doi=10.1111%2fmice.13235&partnerID=40&md5=befd1e0894e1fd514fbfe1915fd33e6f},
}

@Article{Li2024e,
  author                  = {Li, Y. and Zhang, S. and Liang, L. and Wu, J.},
  journal                 = {Applied Acoustics},
  title = {Optimized dispersion Higuchi fractal dimension and its refined composite multi-scale version for signal analysis},
  year                    = {2024},
  issn                    = {0003682X},
  note                    = {cited By 1},
  volume                  = {224},
  abbrev_source_title = {Appl Acoust},
  abstract                = {Higuchi fractal dimension (HFD), as a classic nonlinear dynamic metric, which is commonly used to detect signal dynamic changes. However, it is difficult for HFD to process signal outliers. To address this issue, dispersion HFD (DHFD) is proposed, which improves the signal complexity representation ability of HFD by introducing the normal cumulative distribution function and round function in dispersion entropy. Nevertheless, the parameter selection of DHFD can affect the complexity value. Therefore, an optimized dispersion HFD (ODHFD) is proposed, which solves the threshold selection problem of DHFD and can more effectively reflect the complexity of the signal. In addition, an optimized refined composite DHFD (ORCMDHFD) has been proposed, which can more comprehensively reflect the complexity information for the signal at multiple scales. The simulation experiment results show that DHFD has a smaller standard deviation than HFD when calculating white noise signal complexity, and DHFD have the least dependence on signal length compared to other metrics, as well as RCMDHFD has the best separability for simulated noise signals. Actual experiments have shown that ODHFD and ORCMDHFD is superior to other entropy and fractal dimension metrics in distinguishing ship radiated noise and mechanical fault signals, and has broad application prospects in the field of signal analysis. © 2024 Elsevier Ltd},
  affiliation             = {School of Automation and Information Engineering, Xi'an University of Technology, Xi'an, 710048, China; Shaanxi Key Laboratory of Complex System Control and Intelligent Information Processing, Xi'an University of Technology, Xi'an, 710048, China},
  art_number              = {110161},
  author_keywords         = {Dispersion Higuchi fractal dimension; Higuchi fractal dimension; Optimized dispersion Higuchi fractal dimension; Optimized refined composite dispersion Higuchi fractal dimension},
  coden                   = {AACOB},
  correspondence_address1 = {Li, Y.; School of Automation and Information Engineering, China; email: liyuxing@xaut.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.apacoust.2024.110161},
  groups                  = {Journals},
  keywords                = {Dispersions; Entropy; Fractal dimension; Signal analysis; White noise, Composite dispersions; Dispersion higuchi fractal dimension; Higuchi fractal dimension; Optimized dispersion higuchi fractal dimension; Optimized refined composite dispersion higuchi fractal dimension; Signal complexity; Signals analysis, Distribution functions},
  language                = {English},
  publisher               = {Elsevier Ltd},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85197467265&doi=10.1016%2fj.apacoust.2024.110161&partnerID=40&md5=86ed98da25134b2aed01bd26feb6e8ed},
}

@Article{Wei2024,
  author                  = {Wei, X. and Qiao, L. and Guo, Z. and Zhang, M.},
  journal                 = {Applied Physics Letters},
  title = {Simultaneous generation of bandwidth-enhanced and time-delay signature-suppressed chaotic laser by microring resonator},
  year                    = {2024},
  issn                    = {00036951},
  note                    = {cited By 0},
  number                  = {10},
  volume                  = {125},
  abbrev_source_title = {Appl Phys Lett},
  abstract                = {A method for generating bandwidth-enhanced chaotic laser with time-delay signature suppression by a microring resonator is proposed and demonstrated experimentally. Through multiple beam interference effect and nonlinear effect within a microring resonator, chaotic laser generated by conventional optical feedback is optimized. A chaotic laser with the standard bandwidth of 26.5 GHz, the spectrum flatness of ±1.5 dB, and the time-delay signature value of 0.09 is obtained. The influence of the injection power and the frequency detuning on the optimized characteristics of chaotic laser are analyzed. The results show that chaotic laser with the standard bandwidth above 20 GHz and the spectrum flatness below ±3.5 dB can be achieved simultaneously in wide operating parameter regions. Furthermore, the effect of the radius of a microring resonator on the characteristics of the chaotic laser is investigated. The results show that a microring resonator can realize the performance optimization of chaotic laser. Due to the decreased loss, the time-delay signature suppression is better as the radius of a microring resonator increases. This scheme is simple and integration-compatible, which contributes to the development of an integrated, time-delay signature suppressed and broadband chaotic laser sources. © 2024 Author(s).},
  affiliation             = {College of Electronic Information and Optical Engineering, Taiyuan University of Technology, Taiyuan, 030024, China; Key Laboratory of Advanced Transducers and Intelligent Control System, Ministry of Education, Taiyuan University of Technology, Taiyuan, 030024, China; College of Physics, Taiyuan University of Technology, Taiyuan, 030024, China; Shanxi-Zheda Institute of Advanced Materials and Chemical Engineering, Taiyuan, 030024, China},
  art_number              = {101103},
  coden                   = {APPLA},
  correspondence_address1 = {Qiao, L.; Key Laboratory of Advanced Transducers and Intelligent Control System, China; email: qiaolijun@tyut.edu.cn; Zhang, M.; Key Laboratory of Advanced Transducers and Intelligent Control System, China; email: zhangmingjiang@tyut.edu.cn},
  document_type           = {Article},
  doi                     = {10.1063/5.0211770},
  groups                  = {Journals},
  keywords                = {Fiber optic sensors; Laser resonators; Nonlinear optics; Prisms; Time delay, Bandwidth enhanced; Chaotic lasers; Interference effects; Microrings; Multiple beam interference; Nonlinear effect; Optical-; Power; Spectra's; Time-delays, Optical feedback},
  language                = {English},
  publisher               = {American Institute of Physics},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85203414112&doi=10.1063%2f5.0211770&partnerID=40&md5=b9dfc9eccdc46d5cca0589f229d5e6e0},
}

@Article{Zhou2024c,
  author                  = {Zhou, T. and Yu, X. and Zhang, J. and Xu, H.},
  journal                 = {Shuili Xuebao/Journal of Hydraulic Engineering},
  title = {Characteristics of pressure fluctuation in pump turbines with splitter blades during the load rejection transient process [带分流叶片水泵水轮机甩负荷过渡过程中的压力脉动特征]},
  year                    = {2024},
  issn                    = {05599350},
  note                    = {cited By 0},
  number                  = {9},
  pages = {1098--1109},
  volume                  = {55},
  abbrev_source_title = {Shuili Xuebao},
  abstract                = {In order to reduce the adverse effects of severe pressure pulsations generated during the transition process of the pump turbine on the safety of pumped storage power stations, it is neeessary to fully understand the characteristics of pressure pulsation of pump—turbine. This paper conducts an in-depth study on the measured pressure data of the pump-turbine with splitter blades during the load rejection transition process. First, a method for extracting time —average pressure and pulsating pressure based on variational mode decomposition (VMD) is presen-ted based on the frequency domain characteristics of pressure pulsations. Then, Fast Fourier Transform (FFT) and Short Time Fourier Transform (STFT) are used to analyze the pulsating pressure at the spiral casing inlet, vaneless area, top cover, and draft tube cone inlet during the stable Operation and load rejection of the pump turbine. The general behaviors of frequency composition and time—frequency Variation features are revealed during the transition period of steady Operation and load rejection of pump turbines with splitter blades. The research shows that the main frequency of the pressure pulsation in the vaneless area of the pump turbine with splitter blades is dominated by the blade passing frequency (BPF) and its half-order harmonics, and the half-order harmonics of the BPF have the characteristics of upstream and downstream propagation. The draft tube inlet pressure pulastion frequency is mainly composed of the low frequency component and the half-harmonic of the BPF. During the load rejection transition process, the BPF and its harmonic frequency in the vaneless area will increase and decrease with time, and the change rule is consistent with the change trend of the runner speed. The method provided in this research presents a novel approach for analyzing collected pressure pulsations and provides a reference for the study of the pressure pulsation characteristics of pump turbines with splitter blades. It is of great significance to trace the source of the abnormal Vibration of structure and ensure the safe Operation of the units. © 2024 International Research and Training Center on Erosion and Sedimentation and China Water and Power Press. All rights reserved.},
  affiliation             = {College of Water Conservancy and Hydropower Engineering, Hohai University, Nanjing, 210098, China},
  author_keywords         = {pressure pulsations; pump-turbine with splitter blades; signal processing; transition process},
  coden                   = {SLHPB},
  correspondence_address1 = {Yu, X.; College of Water Conservancy and Hydropower Engineering, China; email: yuxiaodong_851@hhu.edu.cn},
  document_type           = {Article},
  doi                     = {10.13243/j.cnki.slxb.20230781},
  groups                  = {Journals},
  keywords                = {Hydraulic motors; Light transmission; Light velocity; Pumped storage power plants; Tubular turbines; Turbine components; Turbine pumps; Turbomachine blades; Vane pumps; Variational mode decomposition, Blade passing frequency; Characteristics of pressures; Loads rejections; Pressure pulsation; Pump-turbine with splitter blade; Pump-turbines; Signal-processing; Splitter blade; Transition process; Vaneless, Fast Fourier transforms},
  language                = {Chinese},
