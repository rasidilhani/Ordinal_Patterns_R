}

@Article{Borges2023,
  author                  = {Borges, J.B. and Medeiros, J.P.S. and Barbosa, L.P.A. and Ramos, H.S. and Loureiro, A.A.F.},
  journal                 = {IEEE Transactions on Knowledge and Data Engineering},
  title = {IoT Botnet Detection Based on Anomalies of Multiscale Time Series Dynamics},
  year                    = {2023},
  issn                    = {10414347},
  note                    = {cited By 8},
  number                  = {12},
  pages = {12282--12294},
  volume                  = {35},
  abbrev_source_title = {IEEE Trans Knowl Data Eng},
  abstract                = {In this work, we propose a solution for detecting botnet attacks on the Internet of Things (IoT) by identifying anomalies in the temporal dynamics of their devices. Given their limited computing capabilities, IoT devices are more vulnerable to attacks than conventional computers. In this scenario, botnets have a high degree of severity since they are used to trigging distributed denial-of-service attacks, which are amplified by a large number of IoT devices. Thus, solutions aiming to identify and mitigate the damage caused by botnets in IoT are urgent and essential. We evaluate the number of packets a device transmits, following a multiscale ordinal patterns transformation, and use Isolation Forest for anomaly detection. By investigating how devices evolve, we can distinguish between normal and anomalous behaviors. We apply the proposed solution to detect two major botnets for IoT: Mirai and Bashlite. We evaluated our model throughout two experimental setups. The first, using a single model for all devices, reaching 99.5% of accuracy and 99.6% of specificity, and the second, by tuning a model per device, reaching 100% of accuracy. These results show that, with the proper transformation, it is possible to use simple methods for detecting anomalies in IoT devices' behaviors. © 1989-2012 IEEE.},
  affiliation             = {Universidade Federal Do Rio Grande Do Norte, Department of Computing and Technology, RN, Caicó, 59300-000, Brazil; Universidade Federal de Minas Gerais, Department of Computer Science, MG, Belo Horizonte, 30123-970, Brazil},
  author_keywords         = {Anomaly detection; botnet detection; Internet of Things; multiscale dynamics; ordinal patterns; time series dynamics},
  coden                   = {ITKEE},
  correspondence_address1 = {Borges, J.B.; Universidade Federal Do Rio Grande Do Norte, RN, Brazil; email: joao.borges@ufrn.br},
  document_type           = {Article},
  doi                     = {10.1109/TKDE.2022.3157636},
  groups                  = {Journals},
  keywords                = {Anomaly detection; Botnet; Dynamics; Feature extraction; Internet of things; Network security; Time series analysis, Anomaly detection; Botnet detections; Botnets; Denialof- service attacks; Features extraction; Multi-scale dynamics; Ordinal pattern; Time series dynamics; Time-series analysis, Denial-of-service attack},
  language                = {English},
  publisher               = {IEEE Computer Society},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85126282700&doi=10.1109%2fTKDE.2022.3157636&partnerID=40&md5=277fbd770c7f02ab3f1654f833905c51},
}

@Article{Azami2023,
  author                  = {Azami, H. and Daftarifard, E. and Humeau-Heurtier, A. and Fernandez, A. and Abasolo, D. and Rajji, T.K.},
  journal                 = {Journal of Alzheimer's Disease},
  title = {Assessment and Comparison of Nonlinear Measures in Resting-State Magnetoencephalograms in Alzheimer’s Disease and Mild Cognitive Impairment},
  year                    = {2023},
  issn                    = {13872877},
  note                    = {cited By 2},
  number                  = {3},
  pages = {1151--1162},
  volume                  = {96},
  abbrev_source_title = {J. Alzheimer's Dis.},
  abstract                = {Background: Nonlinear dynamical measures, such as fractal dimension (FD), entropy, and Lempel-Ziv complexity (LZC), have been extensively investigated individually for detecting information content in magnetoencephalograms (MEGs) from patients with Alzheimer’s disease (AD). Objective: To compare systematically the performance of twenty conventional and recently introduced nonlinear dynamical measures in studying AD versus mild cognitive impairment (MCI) and healthy control (HC) subjects using MEG. Methods: We compared twenty nonlinear measures to distinguish MEG recordings from 36 AD (mean age = 74.06 ± 6.95 years), 18 MCI (mean age = 74.89 ± 5.57 years), and 26 HC subjects (mean age = 71.77 ± 6.38 years) in different brain regions and also evaluated the effect of the length of MEG epochs on their performance. We also studied the correlation between these measures and cognitive performance based on the Mini-Mental State Examination (MMSE). Results: The results obtained by LZC, zero-crossing rate (ZCR), FD, and dispersion entropy (DispEn) measures showed significant differences among the three groups. There was no significant difference between HC and MCI. The highest Hedge’s g effect sizes for HC versus AD and MCI versus AD were respectively obtained by Higuchi’s FD (HFD) and fuzzy DispEn (FuzDispEn) in the whole brain and was most prominent in left lateral. The results obtained by HFD and FuzDispEn had a significant correlation with the MMSE scores. DispEn-based techniques, LZC, and ZCR, compared with HFD, were less sensitive to epoch length in distinguishing HC form AD. Conclusions: FuzDispEn was the most consistent technique to distinguish MEG dynamical patterns in AD compared with HC and MCI. © 2023 – IOS Press. All rights reserved.},
  affiliation             = {Adult Neurodevelopment and Geriatric Psychiatry Division, Centre for Addiction and Mental Health, Toronto, ON, Canada; Department of Psychiatry, University of Toronto, Toronto, ON, Canada; Department of Pharmaceutics, Mazandaran University of Medical Sciences, Sari, Iran; Université Angers, LARIS, SFR MathSTIC, Angers, France; Department of Legal Medicine, Psychiatry and Pathology, Complutense University of Madrid, Madrid, Spain; Centre for Biomedical Engineering, School of Mechanical Engineering Sciences, University of Surrey, Guildford, United Kingdom; Toronto Dementia Research Alliance, University of Toronto, Toronto, ON, Canada},
  author_keywords         = {Alzheimer’s disease; entropy; fractal dimension; magnetoencephalogram; mild cognitive impairment; nonlinear dynamics},
  coden                   = {JADIF},
  correspondence_address1 = {Azami, H.; Adult Neurodevelopment and Geriatric Psychiatry Division, Canada; email: hamed.azami@camh.ca},
  document_type           = {Article},
  doi                     = {10.3233/JAD-230544},
  groups                  = {Journals},
  keywords                = {age; aged; Alzheimer disease; Article; brain region; case control study; clinical evaluation; cognition; comparative study; controlled study; correlation coefficient; dispersion entropy; entropy; fractal dimension; human; lempel ziv complexity; magnetoencephalography; major clinical study; mental performance; mild cognitive impairment; Mini Mental State Examination; nonlinear system; post hoc analysis; signal processing; zero crossing rate; Alzheimer disease; brain; cognitive defect; magnetoencephalography; procedures; psychology; very elderly, Aged; Aged, 80 and over; Alzheimer Disease; Brain; Cognitive Dysfunction; Entropy; Humans; Magnetoencephalography},
  language                = {English},
  publisher               = {IOS Press BV},
  pubmed_id               = {37980661},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85177976402&doi=10.3233%2fJAD-230544&partnerID=40&md5=b4d20821c1cb02e7690d643a4e40a1f1},
}

@Conference{Wang2023a,
  author                  = {Wang, H. and Zhao, J. and An, X.},
  title = {Analyzing the Effects of Varying Durations of Anesthesia on {Eeg} Characteristics in Children},
  year                    = {2023},
  note                    = {cited By 0},
  pages = {185--189},
  publisher               = {Association for Computing Machinery},
  abbrev_source_title = {ACM Int. Conf. Proc. Ser.},
  abstract                = {In recent years, there has been a growing focus on whether long-duration anesthesia in children affects their brain function and development. Electroencephalogram (EEG) signals are widely used in anesthesia and state of consciousness assessment, providing valuable insights into cortical activity. Spectrum and signal complexity are key features used to describe EEG signals and effectively characterize cortical activity. In this study, we conducted an analysis of multichannel EEG signals in children during surgery, specifically examining the spectrum and signal complexity. We compared the changes in EEG characteristics across different durations of anesthesia. The results revealed that long-duration anesthesia led to an increase in delta frequency power and a decrease in signal complexity. These EEG characteristics can serve as valuable indices for assessing the state of anesthesia. © 2023 Copyright held by the owner/author(s).},
  affiliation             = {Academy of Medical Engineering and Translational Medicine, Tianjin University, Tianjin, 300072, China},
