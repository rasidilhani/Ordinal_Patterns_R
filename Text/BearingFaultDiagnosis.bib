  groups                  = {Journals},
  keywords                = {Entropy; Fusion reactions; Geometry; Probability density function; Stochastic models; Stochastic systems, Edge localized modes; Fusion plasmas; Information entropy; Information geometry; Input power; Mode dynamics; Non equilibrium; Statistical properties; Time varying; Time-varying inputs, Hysteresis},
  language                = {English},
  publisher               = {American Institute of Physics Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85143510946&doi=10.1063%2f5.0109257&partnerID=40&md5=0a930b6fae7697a69539b61bd57499a4},
