  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85165611673&doi=10.1016%2fj.rinp.2023.106737&partnerID=40&md5=552f28979e4f2bb65f90034c0eb0353f},
