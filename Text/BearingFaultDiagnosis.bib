  document_type           = {Conference Paper},
  doi                     = {10.1109/SRSE63568.2024.10772503},
  groups                  = {Conference},
  isbn                    = {9798350356083},
  journal                 = {2024 6th International Conference on System Reliability and Safety Engineering, SRSE 2024},
  keywords                = {Concurrent control; Concurrent control chart pattern; Control chart pattern; Control chart pattern recognition; Feature analysis; Labelings; Manufacturing process; Ordinal pattern; Pattern features; Zero-shot learning component, Zero-shot learning},
  language                = {English},
  source                  = {Scopus},
