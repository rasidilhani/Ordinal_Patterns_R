}

@Conference{Blanks2024a,
  author              = {Blanks, Z. and Brown, D.E. and Adams, M.A. and Angadi, S.S.},
  title = {An Improved Bayesian Permutation Entropy Estimator},
  year                = {2024},
  editor              = {Pollard T., Choi E., Singhal P., Hughes M.C., Sizikova E., Mortazavi B.J., Chen I., Wang F., Sarker T., McDermott M., Ghassemi M.},
  note                = {cited By 2},
  pages = {120--126},
  publisher           = {ML Research Press},
  volume              = {248},
  abbrev_source_title = {Proc. Mach. Learn. Res.},
  abstract            = {We introduce a novel hierarchical Bayesian permutation entropy (PermEn) estimator designed to improve biomedical time series entropy assessments, especially for short signals. Unlike existing methods requiring a substantial number of observations or which impose restrictive priors, our non-centered, Wasserstein optimized hierarchical approach enables efficient MCMC inference and a broader range of PermEn priors. Evaluations on synthetic and secondary benchmark data demonstrate superior performance over the current state-of-the-art, including 13.33-63.67% lower estimation error, 8.16-47.77% lower posterior variance, and 47-60.83% lower prior construction error (p ≤ 2.42 × 10−10). Applied to cardiopulmonary exercise test oxygen uptake signals, we reveal a previously unreported 1.55% (95% credible interval: [0.62%, 2.52%]) entropy difference between obese and lean subjects that diminishes as exercise capacity increases. For individuals capable of completing at least 7.5 minutes of testing, the 95% credible interval contained zero, suggesting potential insights into physiological complexity, exercise tolerance, and obesity. Our estimator refines biomedical signal PermEn estimation and underscores entropy’s potential value as a health biomarker, opening avenues for further physiological and biomedical exploration. © 2024 Z. Blanks, D.E. Brown, M.A. Adams & S.S. Angadi.},
  affiliation         = {University of Virginia, United States; Arizona State University, United States},
  document_type       = {Conference Paper},
  groups              = {Conference},
  issn                = {26403498},
  journal             = {Proceedings of Machine Learning Research},
  keywords            = {95% credible intervals; Bayesian; Benchmark data; Entropy estimator; Hierarchical approach; Hierarchical bayesian; Performance; Permutation entropy; Short signal; Times series, Benchmarking},
  language            = {English},
  source              = {Scopus},
  url                 = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85203598264&partnerID=40&md5=f853be43d4343a170148695953c12139},
}

@Article{Zhang2024o,
  author                  = {Zhang, F. and Fang, M. and Tao, R. and Zhu, D. and Liu, W. and Lin, F. and Xiao, R.},
  journal                 = {Journal of Applied Fluid Mechanics},
  title = {Chaotic Analysis of the Reversible Pump Turbine Exhaust Process in Pump Mode Based on a Data-driven Method},
  year                    = {2024},
  issn                    = {17353572},
  note                    = {cited By 0},
  number                  = {11},
  pages = {2361--2376},
  volume                  = {17},
  abbrev_source_title = {J. Appl. Fluid Mech.},
  abstract                = {Due to the important strategic position of Pumped Storage Power Plants (PSPP) in global energy upgrading, conducting in-depth research on the various operating conditions of pump turbine units is important for their safe and stable operation. This study sought to clarify the gas–liquid phase motion and the nonlinear chaotic characteristics of the process of exhaust and pressurization in pump mode; with the simplified objective model proposed here, a visualization of the process is achieved using data-driven methods, and the nonlinear characteristics of gas–liquid phase motion during the process are theoretically demonstrated. A method that combines data-driven and chaotic analysis is proposed to qualitatively and quantitatively analyze the force and torque time-series signals of the runner under different exhaust rates. The results indicate that the chaotic characteristics of the force signals and torque signals of the runner are not in a single linear relationship with the exhaust rates. Therefore, this research also provides guidance on exhaust rates with the aim of informing actual engineering practice, the purpose of which is to reduce the vibration amplitude caused by repetitive torque and improve the stability of the unit operations. © (2024), (Isfahan University of Technology). All rights reserved.},
  affiliation             = {College of Water Resources and Civil Engineering, China Agricultural University, Beijing, 100083, China; Beijing Engineering Research Center of Safety and Energy Saving Technology for Water Supply Network System, China Agricultural University, Beijing, 100083, China; College of Engineering, China Agricultural University, Beijing, 100083, China; Dongfang Electric Machinery Co. Ltd., Sichuan, Deyang, 618000, China},
  author_keywords         = {Chaotic analysis; Data driven; Numerical simulation; Pump turbine; Transient process},
  correspondence_address1 = {Xiao, R.; College of Water Resources and Civil Engineering, China; email: xrf@cau.edu.cn},
  document_type           = {Article},
  doi                     = {10.47176/jafm.17.11.2669},
  groups                  = {Journals},
  language                = {English},
  publisher               = {Isfahan University of Technology},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85202965666&doi=10.47176%2fjafm.17.11.2669&partnerID=40&md5=0f7e4cc5a47b97245e21cbbf467c5863},
}

@Article{Zhao2024b,
  author                  = {Zhao, Z. and Feng, Y. and Wang, M. and Wei, J. and Tan, T. and Li, R. and Hu, H. and Wang, M. and Chen, P. and Gao, X. and Wei, Y. and Wang, C. and Gao, Z. and Jiang, W. and Zhou, X. and Li, M. and Wang, C. and Pang, T. and Yu, Y.},
  journal                 = {Frontiers in Neuroinformatics},
  title = {Investigating cortical complexity and connectivity in rats with schizophrenia},
  year                    = {2024},
  issn                    = {16625196},
  note                    = {cited By 0},
  volume                  = {18},
  abbrev_source_title = {Front. Neuroinformatics},
  abstract                = {Background: The above studies indicate that the SCZ animal model has abnormal gamma oscillations and abnormal functional coupling ability of brain regions at the cortical level. However, few researchers have focused on the correlation between brain complexity and connectivity at the cortical level. In order to provide a more accurate representation of brain activity, we studied the complexity of electrocorticogram (ECoG) signals and the information interaction between brain regions in schizophrenic rats, and explored the correlation between brain complexity and connectivity. Methods: We collected ECoG signal from SCZ rats. The frequency domain and time domain functional connectivity of SCZ rats were evaluated by magnitude square coherence and mutual information (MI). Permutation entropy (PE) and permutation Lempel-Ziv complexity (PLZC) were used to analyze the complexity of ECoG, and the relationship between them was evaluated. In addition, in order to further understand the causal structure of directional information flow among brain regions, we used phase transfer entropy (PTE) to analyze the effective connectivity of the brain. Results: Firstly, in the high gamma band, the complexity of brain regions in SCZ rats is higher than that in normal rats, and the neuronal activity is irregularity. Secondly, the information integration ability of SCZ rats decreased and the communication of brain network information was hindered at the cortical level. Finally, compared with normal rats, the causal relationship between brain regions of SCZ rats was closer, but the information interaction center was not clear. Conclusion: The above findings suggest that at the cortical level, complexity and connectivity are valid biomarkers for identifying SCZ. This bridges the gap between peak potentials and EEG. This may help to understand the pathophysiological mechanisms at the cortical level in schizophrenics. Copyright © 2024 Zhao, Feng, Wang, Wei, Tan, Li, Hu, Wang, Chen, Gao, Wei, Wang, Gao, Jiang, Zhou, Li, Wang, Pang and Yu.},
  affiliation             = {School of Medical Engineering, Xinxiang Medical University, Xinxiang, China; Engineering Technology Research Center of Neurosense and Control of Henan Province, Xinxiang, China; Henan International Joint Laboratory of Neural Information Analysis and Drug Intelligent Design, Xinxiang, China; Center of Image and Signal Processing, Faculty of Computer Science and Information Technology, Universiti Malaya, Kuala Lumpur, Malaysia},
  art_number              = {1392271},
  author_keywords         = {brain network; complexity; connectivity; electrocorticogram; schizophrenia},
  correspondence_address1 = {Yu, Y.; School of Medical Engineering, China; email: yuyi@xxmu.edu.cn},
  document_type           = {Article},
  doi                     = {10.3389/fninf.2024.1392271},
  groups                  = {Journals},
  keywords                = {erythromycin; isoflurane; penicillin derivative, adult; animal experiment; animal model; animal tissue; Article; brain cortex; brain dysfunction; brain region; controlled study; dynamics; electrocorticography; electroencephalogram; electroencephalography; entropy; frontal cortex; functional connectivity; impedance; male; nerve cell; nerve cell network; nonhuman; occipital cortex; parietal lobe; rat; schizophrenia},
  language                = {English},
  publisher               = {Frontiers Media SA},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85202731359&doi=10.3389%2ffninf.2024.1392271&partnerID=40&md5=f58180a3bba1e95ad842b164f92ef925},
}

@Conference{Gryazev2024a,
  author              = {Gryazev, V. and Ryabov, V. and Markesteijn, A. and Armani, U. and Toropov, V. and Karabasov, S.},
  title = {A Dynamical System Method for Finding Flow Structures from Jet LES Data},
  year                = {2024},
  note                = {cited By 0},
  publisher           = {American Institute of Aeronautics and Astronautics Inc, AIAA},
  abbrev_source_title = {AIAA/CEAS Aeroacoustics Conf.},
  abstract            = {The spatio-temporal dynamics of pressure fluctuations in a turbulent jet flow is examined by means of nonlinear dynamical system theory utilising the symbolic ordinal patterns approach. In comparison with many other methods such as acoustic analogy, resolvent analysis, wavelets, or proper orthogonal decomposition, the suggested approach is fully data-driven and free from any modelling assumptions such those based on linearisation. The symbolic ordinal pattern method is applied to analyse the jet Large Eddy Simulation (LES) data corresponding to conditions of the NASA SHJAR round and chevron jets at acoustic Mach numbers 0.5 and 0.9 (Set Point 3 and Set Point 7 experiments). The LES are based on solutions of the Compact Accurately Boundary-Adjusting high-REsolution Tech-nique (CABARET) accelerated on Graphics Processing Units (GPUs). The output of the symbolic analyses reveals spatial distributions of the jet flow structures with a high probability of organised non-random dynamics. To relate the obtained data-driven results with the aeroacoustic theory, comparisons of the obtained patterns with the distribution of the effective noise source density computed from the Goldstein Generalized Acoustic Analogy model are discussed. © 2024, American Institute of Aeronautics and Astronautics Inc, AIAA. All rights reserved.},
  affiliation         = {School of Engineering and Material Science, Queen Mary University of London, Mile End Rd, London, E1 4NS, United Kingdom; Department of Complex and Intelligent Systems, Future University Hakodate, Hokkaido, Hakodate041-0803, Japan},
  document_type       = {Conference Paper},
  doi                 = {10.2514/6.2024-3087},
  groups              = {Conference},
  isbn                = {9781624107207},
  journal             = {30th AIAA/CEAS Aeroacoustics Conference, 2024},
  keywords            = {Higher order statistics; Large eddy simulation; Photomapping; Principal component analysis, Acoustic analogy; Data driven; Jetflows; Large-eddy simulations; Ordinal pattern; Pressure fluctuation; Setpoints; Simulation data; Spatio-temporal dynamics; System methods, Dynamical systems},
  language            = {English},
  source              = {Scopus},
  url                 = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85202430053&doi=10.2514%2f6.2024-3087&partnerID=40&md5=07fac338ecf221496d14f26542696f85},
}

@Article{Wang2024m,
  author                  = {Wang, X. and Yu, L. and Wang, H. and Tsui, K.L. and Zhao, Y.},
  journal                 = {IEEE Journal of Biomedical and Health Informatics},
  title = {Sensor-Based Multifaceted Feature Extraction and Ensemble Elastic Net Approach for Assessing Fall Risk in Community-Dwelling Older Adults},
  year                    = {2024},
  issn                    = {21682194},
  note                    = {cited By 0},
  number                  = {11},
  pages = {6661--6673},
  volume                  = {28},
  abbrev_source_title = {IEEE J. Biomedical Health Informat.},
  abstract                = {Accurate identification of community-dwelling older adults at high fall risk can facilitate timely intervention and significantly reduce fall incidents. Analyzing gait and balance capabilities via feature extraction and modeling through sensor-based motion data has emerged as a viable approach for fall risk assessment. However, the existing approaches for extracting key features related to fall risk lack inclusiveness, with limited consideration of the non-linear characteristics of sensor signals, such as signal complexity, self-similarity, and local stability. In this study, we developed a multifaceted feature extraction scheme employing diverse feature types, including demographic, descriptive statistical, non-linear, spatiotemporal and spectral features, derived from three-axis accelerometers and gyroscope data. This study is the first attempt to investigate non-linear features related to fall risk in multi-task scenarios from a dynamic system perspective. Based on the extracted multifaceted features, we propose an ensemble elastic net (E-E-N) approach for handling imbalanced data and offering high model interpretability. The E-E-N utilizes bootstrap sampling to construct base classifiers and employs a weighting mechanism to aggregate the base classifiers. We conducted a set of validation experiments using real-world data for comprehensive comparative analysis. The results demonstrate that the E-E-N approach exhibits superior predictive performance on fall risk classification. Our proposed approach offers a cost-effective tool for accurately assessing fall risk and alleviating the burden of continuous health monitoring in the long term. © 2013 IEEE.},
  affiliation             = {Sun Yat-sen University, Intelligent Sensing and Proactive Health Research Center, School of Public Health (Shenzhen), Shenzhen, 518107, China; Lingnan University, School of Data Science, Hong Kong; Hong Kong Polytechnic University, School of Design, Hong Kong; Virginia Polytechnic Institute and State University, Grado Department of Industrial and Systems Engineering, Blacksburg, VA 24061, United States},
  author_keywords         = {elastic net; Fall risk assessment; feature selection; imbalanced data; machine learning; sensors},
  coden                   = {ITIBF},
  correspondence_address1 = {Zhao, Y.; Sun Yat-sen University, China; email: zhaoy393@mail.sysu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1109/JBHI.2024.3447705},
  groups                  = {Journals},
  keywords                = {Adversarial machine learning; Contrastive Learning; Electronic health record; Feature Selection; Health risks; Network security; Population statistics; Risk analysis; Risk assessment; Risk management; Risk perception, Elastic net; Fall risk; Fall risk assessment; Features extraction; Features selection; Imbalanced data; Legged locomotion; Machine-learning; Older adults; Risks assessments; Risks management; Stability analyze; Support vectors machine, Support vector machines, aged; Article; ataxia; bootstrapping; cerebellar ataxia; classification algorithm; clinical article; community; data processing; decision tree; demographics; electroencephalography; electromyography; entropy; ethics; fall risk; fall risk assessment; feature extraction; female; Fourier transform; gait; health survey; heart rate variability; hip replacement; human; knee; learning algorithm; locomotion; machine learning; male; Monte Carlo cross validation; Montreal cognitive assessment; motor dysfunction; pilot study; polyacrylamide gel electrophoresis; principal component analysis; rank sum test; software; statistical analysis; Student t test; time series analysis; timed up and go test; training; accelerometry; algorithm; ambulatory monitoring; falling; independent living; physiology; prevention and control; procedures; risk assessment; signal processing; very elderly, Accelerometry; Accidental Falls; Aged; Aged, 80 and over; Algorithms; Female; Gait; Humans; Independent Living; Male; Monitoring, Ambulatory; Risk Assessment; Signal Processing, Computer-Assisted},
  language                = {English},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
