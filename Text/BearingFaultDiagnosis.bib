  groups                  = {Journals},
  keywords                = {Brain computer interface; Electrodes; Electroencephalography; Entropy; Signal processing; Spatial variables measurement, Band frequencies; Brain state; EEG signals; Healthy subjects; Ordinal analysis; Permutation entropy; Resting state; Spatial permutations; Time-series analysis; Times series, Time series analysis},
  language                = {English},
