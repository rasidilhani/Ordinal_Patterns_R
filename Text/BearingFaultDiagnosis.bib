  journal                 = {Measurement: Journal of the International Measurement Confederation},
  title = {Structural damage identification under nonstationary excitations through recurrence plot and multi-label convolutional neural network},
  year                    = {2021},
  issn                    = {02632241},
  note                    = {cited By 34},
  volume                  = {186},
  abbrev_source_title = {Meas J Int Meas Confed},
  abstract                = {Civil engineering structures inevitably suffer from nonstationary ambient excitations in practice, which make conventional damage identification methods relying on the stationary assumption ineffective. This study presents a novel method based on unthresholded assembled recurrence distance matrix (UARDM) and multi-label convolutional neural network (CNN) for structural damage identification under nonstationary excitations. UARDM is a new type of recurrence plot (RP) that is proposed to integrate information of multiple channels and dispense with the artificially selected threshold. It reveals intrinsic dynamic characteristics of the structure using its vibration responses from the perspective of global probabilistic autocorrelation. After that, CNN is applied to automatically extract damage-sensitive features of UARDMs and classify them for the identification of damage cases. Instead of the traditional single-label CNN model that labels each combination of damage location and level as an objective class, the multi-label CNN model is developed to decouple the identification processes of damage locations and levels in order to improve the identification accuracy and computational efficiency. It evaluates the damage level at each location through a sub-branch with an independent set of labels and detects the damage locations by fusing information of all the sub-branches. A comprehensive comparison was conducted among single-label and multi-label CNN models input with raw accelerations, unthresholded multivariate recurrence plots (UMRPs), unthresholded recurrence plots (URPs) and UARDMs through numerical simulation and experimental test. It was demonstrated that the proposed structural damage identification method based on UARDM and multi-label CNN was able to identify multiple damage locations and levels under various stationary and nonstationary excitations with higher accuracy, efficiency and robustness, and even able to detect multiple-damage cases that were not measured beforehand and involved in the training dataset. © 2021 Elsevier Ltd},
  affiliation             = {School of Civil Engineering, Hefei University of Technology, Hefei, 230009, China; Anhui Engineering Laboratory for Infrastructural Safety Inspection and Monitoring, Hefei, 230009, China; College of Civil and Transportation Engineering, Shenzhen University, Shenzhen, 518060, China; Hefei General Machinery Research Institute Co., Ltd., Hefei, 230031, China},
  art_number              = {110101},
  author_keywords         = {Multi-label convolutional neural network; Nonstationary excitations; Recurrence plot; Structural damage identification; Unthresholded assembled recurrence distance matrix; Vibration signals},
  coden                   = {MSRMD},
  correspondence_address1 = {Ren, W.-X.; College of Civil and Transportation Engineering, China; email: renwx@szu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.measurement.2021.110101},
  groups                  = {Journals},
  keywords                = {Computational efficiency; Convolutional neural networks; Damage detection; Efficiency; Location; Structural analysis, Convolutional neural network; Damage location; Distance matrix; Multi-label convolutional neural network; Multi-labels; Non stationary excitations; Recurrence plot; Structural damage identification; Unthresholded assembled recurrence distance matrix; Vibration signal, Convolution},
  language                = {English},
  publisher               = {Elsevier B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85114474451&doi=10.1016%2fj.measurement.2021.110101&partnerID=40&md5=9515bd30c55e082f2c1cb2f6c9bead9c},
