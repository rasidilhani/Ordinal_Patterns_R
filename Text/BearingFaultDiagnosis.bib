  author                  = {Zhou, X. and Sun, K. and Liu, W. and Wang, H.},
  journal                 = {International Journal of Bifurcation and Chaos},
  title = {Design and Dynamics of Multicavity Hyperchaotic Maps with Cylinder Attractors},
  year                    = {2023},
  issn                    = {02181274},
