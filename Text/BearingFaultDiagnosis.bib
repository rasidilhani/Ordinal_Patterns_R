}

@Article{TianaAlsina2020,
  author                  = {Tiana-Alsina, J. and Garbin, B. and Barland, S. and Masoller, C.},
  journal                 = {Chaos},
  title = {Success rate analysis of the response of an excitable laser to periodic perturbations},
  year                    = {2020},
  issn                    = {10541500},
  note                    = {cited By 0},
  number                  = {8},
  volume                  = {30},
  abbrev_source_title = {Chaos},
  abstract                = {We use statistical tools to characterize the response of an excitable system to periodic perturbations. The system is an optically injected semiconductor laser under pulsed perturbations of the phase of the injected field. We characterize the laser response by counting the number of pulses emitted by the laser, within a time interval, Δ T, that starts when a perturbation is applied. The success rate, S R (Δ T), is then defined as the number of pulses emitted in the interval Δ T, relative to the number of perturbations. The analysis of the variation of S R with Δ T allows separating a constant lag of technical origin and a frequency-dependent lag of physical and dynamical origin. Once the lag is accounted for, the success rate clearly captures locked and unlocked regimes and the transitions between them. We anticipate that the success rate will be a practical tool for analyzing the output of periodically forced systems, particularly when very regular oscillations need to be generated via small periodic perturbations. © 2020 Author(s).},
  affiliation             = {Department of Physics, Universitat Politècnica de Catalunya, Rambla St. Nebridi 22, Terrassa, Barcelona, 08222, Spain; Centre de Nanosciences et de Nanotechnologies, Université Paris-Saclay, CNRS, Palaiseau, 91120, France; Institut de Physique de Nice, Université Côte d'Azur, CNRS UMR 7010, 1361 Route des Lucioles, Valbonne, F-06560, France},
  art_number              = {081101},
  correspondence_address1 = {Tiana-Alsina, J.; Department of Physics, Rambla St. Nebridi 22, Spain; email: jordi.tiana@upc.edu; Masoller, C.; Department of Physics, Rambla St. Nebridi 22, Spain; email: cristina.masoller@upc.edu},
  document_type           = {Article},
  doi                     = {10.1063/5.0017900},
  groups                  = {Journals},
  language                = {English},
  publisher               = {American Institute of Physics Inc.},
  pubmed_id               = {32872792},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85090180206&doi=10.1063%2f5.0017900&partnerID=40&md5=e5b0849863d96769006b98fac61576c8},
}

