  groups                  = {Journals},
  keywords                = {Power quality; Wavelet analysis, Adaptive noise; Detection methods; Disturbances detection; Empirical Mode Decomposition; Hilbert transform; Improved complete ensemble empirical mode decomposition with adaptive noise; Intrinsic Mode functions; Permutation entropy; Power quality disturbances; Wavelet packet transforms, Wavelet decomposition},
  language                = {English},
  publisher               = {Springer},
