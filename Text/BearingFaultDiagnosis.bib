  document_type           = {Article},
  doi                     = {10.3390/nu14245362},
  groups                  = {Journals},
  keywords                = {glucose; glucose, aged; Article; cardiovascular response; chronic kidney failure; clinical article; controlled study; diastolic blood pressure; entropy; female; glucose infusion; heart output; heart rate; heart stroke volume; heart ventricle ejection time; hemodialysis; hemodynamics; human; male; mean arterial pressure; non insulin dependent diabetes mellitus; systolic blood pressure; ultrafiltration; vascular resistance; adverse event; blood pressure; chronic kidney failure; entropy; hemodialysis; physiology, Blood Pressure; Entropy; Glucose; Hemodynamics; Humans; Kidney Failure, Chronic; Renal Dialysis},
