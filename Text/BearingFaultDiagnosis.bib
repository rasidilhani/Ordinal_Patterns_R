@Article{Li2023ac,
  author                  = {Li, X. and Cheng, C. and Zhang, G. and Peng, Z.},
  journal                 = {IEEE Transactions on Instrumentation and Measurement},
  title = {An Unsupervised Condition Monitoring Method for Rolling Bearings Based on Compound Feature Selection and Multistep-Aware BiGRU-VAE},
  year                    = {2023},
  issn                    = {00189456},
  note                    = {cited By 4},
  volume                  = {72},
  abbrev_source_title = {IEEE Trans. Instrum. Meas.},
  abstract                = {Establishing a health indicator (HI) is essential for monitoring the condition of rolling bearings and mitigating failure risks. Unsupervised learning, which eliminates the necessity for manual labeling, has gained considerable attention in constructing HIs. However, existing unsupervised methods mainly suffer from two limitations. First, redundancy analysis is generally disregarded in the feature selection process. Second, temporal dependencies between distinct instants are neglected due to single time-step samples. To address the issue, this article proposes an innovative unsupervised condition monitoring method based on compound feature selection (CFS) and a multistep-aware model. The major contributions are comprehensive feature selection and effective information extraction of continuous sampling instants. Specifically, in feature selection, a novel metric is designed to effectively capture abrupt changes in features proximate to failure. Utilizing this metric, a CFS algorithm is proposed to identify a superior feature subset with a high correlation to the degradation and low redundancy among features. Additionally, a bidirectional gated recurrent unit-based variational autoencoder (BiGRU-VAE) with multiple time-step inputs is constructed to leverage the information of different sampling instants. The BiGRU-VAE is trained exclusively on healthy features within the superior subset. The dissimilarity between the input sample and its reconstruction is employed as the HI to represent bearing degradation. Comparative experiments on two run-to-failure datasets validate the superiority of the HIs constructed by the proposed method in presenting the degradation process. Ablation experiments confirm the dominance of the CFS algorithm and the necessity of multiple time-step inputs. © 1963-2012 IEEE.},
  affiliation             = {Shanghai Jiao Tong University, State Key Laboratory of Mechanical System and Vibration, Shanghai, 200240, China; China Academy of Railway Sciences Corporation Ltd., Metals and Chemistry Research Institute, Beijing, 100081, China; Ningxia University, School of Mechanical Engineering, Yinchuan, 750021, China},
  art_number              = {3525512},
  author_keywords         = {Compound feature selection (CFS); condition monitoring; health indicator (HI); multiple time-step input; unsupervised learning},
  coden                   = {IEIMA},
  correspondence_address1 = {Cheng, C.; Shanghai Jiao Tong University, China; email: ccming@sjtu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1109/TIM.2023.3300435},
  groups                  = {Journals},
  keywords                = {Feature Selection; Health risks; Redundancy; Roller bearings; Unsupervised learning, Compound; Compound feature selection; Compound features; Correlation; Features extraction; Features selection; Health indicator; Health indicators; Multiple time step; Multiple time-step input; Termination of employment, Condition monitoring},
  language                = {English},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85166755625&doi=10.1109%2fTIM.2023.3300435&partnerID=40&md5=7c935f14c9185291e51dcb4f8b3b3b36},
}

@Article{Malik2023,
  author                  = {Malik, M.Z. and Dashti, M. and Fatima, Y. and Channanath, A. and John, S.E. and Singh, R.K.B. and Al-Mulla, F. and Thanaraj, T.A.},
  journal                 = {Frontiers in Molecular Neuroscience},
  title = {Disruption in the regulation of casein kinase 2 in circadian rhythm leads to pathological states: cancer, diabetes and neurodegenerative disorders},
  year                    = {2023},
  issn                    = {16625099},
  note                    = {cited By 0},
  volume                  = {16},
  abbrev_source_title = {Front. Mol. Neurosci.},
  abstract                = {Introduction: Circadian rhythm maintains the sleep–wake cycle in biological systems. Various biological activities are regulated and modulated by the circadian rhythm, disruption of which can result in onset of diseases. Robust rhythms of phosphorylation profiles and abundances of PERIOD (PER) proteins are thought to be the master keys that drive circadian clock functions. The role of casein kinase 2 (CK2) in circadian rhythm via its direct interactions with the PER protein has been extensively studied; however, the exact mechanism by which it affects circadian rhythms at the molecular level is not known. Methods: Here, we propose an extended circadian rhythm model in Drosophila that incorporates the crosstalk between the PER protein and CK2. We studied the regulatory role of CK2 in the dynamics of PER proteins involved in circadian rhythm using the stochastic simulation algorithm. Results: We observed that variations in the concentration of CK2 in the circadian rhythm model modulates the PER protein dynamics at different cellular states, namely, active, weakly active, and rhythmic death. These oscillatory states may correspond to distinct pathological cellular states of the living system. We find molecular noise at the expression level of CK2 to switch normal circadian rhythm to any of the three above-mentioned circadian oscillatory states. Our results suggest that the concentration levels of CK2 in the system has a strong impact on its dynamics, which is reflected in the time evolution of PER protein. Discussion: We believe that our findings can contribute towards understanding the molecular mechanisms of circadian dysregulation in pathways driven by the PER mutant genes and their pathological states, including cancer, obesity, diabetes, neurodegenerative disorders, and socio-psychological disease. Copyright © 2023 Malik, Dashti, Fatima, Channanath, John, Singh, Al-Mulla and Alphonse Thanaraj.},
  affiliation             = {Department of Genetics and Bioinformatics, Dasman Diabetes Institute, Kuwait City, Kuwait; Department of Computational Biology and Bioinformatics, Sam Higginbottom Institute of Agriculture, Technology and Sciences (Formerly Allahabad Agricultural Institute-Deemed University), Allahabad, India; School of Computational and Integrative Sciences, Jawaharlal Nehru University, New Delhi, India},
  art_number              = {1217992},
  author_keywords         = {cellular state; circadian rhythm; mathematical modeling; molecular noise; pathological states; PER protein},
  correspondence_address1 = {Al-Mulla, F.; Department of Genetics and Bioinformatics, Kuwait; email: fahd.almulla@dasmaninstitute.org; Thanaraj, T.A.; Department of Genetics and Bioinformatics, Kuwait; email: alphonse.thangavel@dasmaninstitute.org; Singh, R.K.B.; School of Computational and Integrative Sciences, India; email: brojen@jnu.ac.in},
  document_type           = {Article},
  doi                     = {10.3389/fnmol.2023.1217992},
  groups                  = {Journals},
  keywords                = {casein kinase II, algorithm; Article; blood pressure; cell cycle progression; cell proliferation; circadian rhythm; degenerative disease; diabetes mellitus; Drosophila; gene expression; genetic transcription; glucose homeostasis; human; hyperglycemia; insulin resistance; malignant neoplasm; metabolic syndrome X; non insulin dependent diabetes mellitus; prevalence; protein expression; rhythm; signal transduction; stochastic model},
  language                = {English},
  publisher               = {Frontiers Media SA},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85165160766&doi=10.3389%2ffnmol.2023.1217992&partnerID=40&md5=94002f1ea36d8f631882d4c070cc6d60},
}

@Conference{Raveendran2023,
  author                  = {Raveendran, S. and Kumar, S. and Kenchiah, R. and Farsana, M.K. and Choudary, R. and Bansal, S. and Binu, V.S. and Ramakrishnan, A.G. and Subasree, R. and Kala, S.},
  title = {Scalp {Eeg}-based Classification of Disorder of Consciousness States using Machine Learning Techniques},
  year                    = {2023},
  note                    = {cited By 1},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {Int. Symp. Electron. Syst. Devices Comput., ESDC},
  abstract                = {Disorders of consciousness (DOC) described by impaired wakefulness and awareness, can be categorized into Coma, Unresponsive Wakefulness Syndrome (UWS), and Minimally Conscious State (MCS). Resting-state EEG-based differentiation of these classes acts as a helping hand or even more to the conventional behavioral assessment methods in the diagnosis and prognosis of DOC patients. In this paper, multi-class classification of DOC patients using different machine learning models was performed and the results were analyzed using features like sample entropy, permutation entropy, and absolute and relative power extracted from resting state EEG data. The one-way ANOVA method determined the discriminative ability of the features with a post hoc Least Significant Difference (LSD) test. All four features showed significant differences (p < 0.05) in delta, alpha, and beta bands between the groups. The feature significance was also measured across the different brain regions as well. The classification results showed that the Random Forest classifier best classified the group with an accuracy of 78% and a precision of 88%. © 2023 IEEE.},
  affiliation             = {Indian Institute of Information Technology, Department of Ece, Kottayam, India; Nimhans, Department of Neurology, Bangalore, India; Nimhans, Department of Neuroanaesthesia and Neurocritical Care, Bangalore, India; Nimhans, Department of Biostatistics, Bangalore, India; Indian Institute of Science, Department of Electrical Engineering, Bangalore, India},
  author_keywords         = {Coma; Minimally Conscious State (MCS); resting-state EEG; sample entropy; Unresponsive Wakefulness Syndrome (UWS)},
  correspondence_address1 = {Subasree, R.; Nimhans, India},
  document_type           = {Conference Paper},
  doi                     = {10.1109/ESDC56251.2023.10149867},
  groups                  = {Conference},
  isbn                    = {9781665455725},
  journal                 = {2023 11th International Symposium on Electronic Systems Devices and Computing, ESDC 2023},
  keywords                = {Brain; Classification (of information); Computer aided diagnosis; Forestry; Machine learning, Behavioral assessment; Class act; Coma; Machine learning techniques; Minimally conscious state; Resting state; Resting-state EEG; Sample entropy; Unresponsive wakefulness syndrome, Entropy},
  language                = {English},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85164949324&doi=10.1109%2fESDC56251.2023.10149867&partnerID=40&md5=cf460dcac87badd5be1b21f0a2ef0bdf},
}

@Article{He2023a,
  author                  = {He, Y. and Li, S. and Zhang, C. and Wang, X.},
  journal                 = {SDHM Structural Durability and Health Monitoring},
  title = {A Fault Feature Extraction Model in Synchronous Generator under Stator Inter-Turn Short Circuit Based on ACMD and DEO3S},
  year                    = {2023},
  issn                    = {19302983},
  note                    = {cited By 1},
  number                  = {2},
  pages = {115--130},
  volume                  = {17},
  abbrev_source_title = {SDHM Struct. Durability Health Monit.},
  abstract                = {This paper proposed a new diagnosis model for the stator inter-turn short circuit fault in synchronous generators. Different from the past methods focused on the current or voltage signals to diagnose the electrical fault, the stator vibration signal analysis based on ACMD (adaptive chirp mode decomposition) and DEO3S (demodulation energy operator of symmetrical differencing) was adopted to extract the fault feature. Firstly, FT (Fourier transform) is applied to the vibration signal to obtain the instantaneous frequency, and PE (permutation entropy) is calculated to select the proper weighting coefficients. Then, the signal is decomposed by ACMD, with the instantaneous frequency and weighting coefficient acquired in the former step to obtain the optimal mode. Finally, DEO3S is operated to get the envelope spectrum which is able to strengthen the characteristic frequencies of the stator inter-turn short circuit fault. The study on the simulating signal and the real experiment data indicates the effectiveness of the proposed method for the stator inter-turn short circuit fault in synchronous generators. In addition, the comparison with other methods shows the superiority of the proposed model. © 2023 Tech Science Press. All rights reserved.},
  affiliation             = {Department of Mechanical Engineering, The Hebei Key Laboratory of Electric Machinery Health Maintenance and Failure Prevention, North China Electric Power University, Baoding, 071003, China},
  author_keywords         = {adaptive chirp mode decomposition; demodulation energy operator of symmetrical differencing; stator inter-turn short circuit; Synchronous generator; vibration signal processing},
  correspondence_address1 = {Zhang, C.; Department of Mechanical Engineering, China; email: lengyu9010@163.com},
  document_type           = {Article},
  doi                     = {10.32604/SDHM.2023.022317},
  groups                  = {Journals},
  keywords                = {Fault detection; Optical variables measurement; Stators; Synchronous generators; Timing circuits; Vibration analysis, Adaptive chirp mode decomposition; Demodulation energy operator of symmetrical differencing; Energy operators; Inter-turn short circuit; Inter-turn short circuit fault; Mode decomposition; Signal-processing; Stator inter-turn short circuit; Vibration signal; Vibration signal processing, Demodulation},
  language                = {English},
