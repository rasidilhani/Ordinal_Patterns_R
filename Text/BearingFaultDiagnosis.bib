}

@Article{Rosso2007a,
  author            = {Rosso, O.A. and Zunino, L. and Pérez, D.G. and Figliola, A. and Larrondo, H.A. and Garavaglia, M. and Martín, M.T. and Plastino, A.},
  journal           = {Physical Review E - Statistical, Nonlinear, and Soft Matter Physics},
  title = {Extracting features of Gaussian self-similar stochastic processes via the Bandt-Pompe approach},
  year              = {2007},
  note              = {Cited by: 57; All Open Access, Green Open Access},
  number            = {6},
  volume            = {76},
  abstract          = {By recourse to appropriate information theory quantifiers (normalized Shannon entropy and Martín-Plastino-Rosso intensive statistical complexity measure), we revisit the characterization of Gaussian self-similar stochastic processes from a Bandt-Pompe viewpoint. We show that the ensuing approach exhibits considerable advantages with respect to other treatments. In particular, clear quantifiers gaps are found in the transition between the continuous processes and their associated noises. © 2007 The American Physical Society.},
  doi               = {10.1103/PhysRevE.76.061114},
  groups            = {Journals},
  publication_stage = {Final},
  source            = {Scopus},
