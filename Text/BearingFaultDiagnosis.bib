  journal             = {Proceedings - Annual Reliability and Maintainability Symposium},
  keywords            = {Battery management systems; Embedded systems; Maintainability; Random processes; Stochastic systems; Support vector machines; Thermodynamics, Approximate entropy; Entropy based approach; Health management; Health monitoring; Operating condition; Permutation entropy; Safety requirements; Testing conditions, Lithium-ion batteries},
