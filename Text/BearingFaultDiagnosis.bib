  groups                  = {Journals},
  keywords                = {Entropy; Liquids; Signal analysis, Chaotic time series; Dynamic complexity; Dynamic nonlinearities; Dynamical complexity; Gas liquids; Gas–liquid two-phase slug flow; Permutation entropy; Rescaled range permutation entropy; Slug-flow; Two phase, Chaotic systems},
