  journal                 = {Communications in Computer and Information Science},
  title = {Date-Driven Approach for Identifying State of Hemodialysis Fistulas: Entropy-Complexity and Formal Concept Analysis},
  year                    = {2024},
  issn                    = {18650929},
  note                    = {cited By 0},
