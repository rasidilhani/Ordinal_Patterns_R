  groups                  = {Journals},
  keywords                = {Bandpass filters; Biomedical engineering; Biomedical signal processing; Classification (of information); Computer aided diagnosis; Entropy; Feature Selection; Learning systems; Time series analysis, Actigraphy; Correlation; Depression; Disorganization; Energy feature; Features extraction; Filter selection; Machine-learning; Mental disorders; Mental health; Psychomotors; Recording; Schizophrenia; Time-series analysis; Wrapper selection, Diseases},
  language                = {English},
