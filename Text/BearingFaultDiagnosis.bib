  groups                  = {Journals},
  keywords                = {Acoustic noise measurement; Diagnosis; Entropy; Scales (weighing instruments); Ships; Signal processing; Underwater acoustics, Classification methods; Classification performance; Comparative experiments; Comparative studies; K nearest neighbor (KNN); K-NN classifications; Nonlinear dynamic methods; Permutation entropy, Nearest neighbor search},
