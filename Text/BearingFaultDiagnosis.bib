  groups              = {Conference},
  isbn                = {9781728195391},
  issn                = {10915281},
  journal             = {Conference Record - IEEE Instrumentation and Measurement Technology Conference},
  keywords            = {Diesel engines; Entropy; Failure analysis; Scales (weighing instruments), Common rail injector; Experimental data analysis; Fault diagnosis method; High frequency components; High-frequency informations; Intelligent fault diagnosis; Permutation entropy; Simulation signals, Fault detection},
  language            = {English},
  source              = {Scopus},
  url                 = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85113709897&doi=10.1109%2fI2MTC50364.2021.9460083&partnerID=40&md5=168bb6914ee0a2f446cbeff226a447f3},
}

@Article{Ponta2021,
  author                  = {Ponta, L. and Murialdo, P. and Carbone, A.},
  journal                 = {Physica A: Statistical Mechanics and its Applications},
  title = {Information measure for long-range correlated time series: Quantifying horizon dependence in financial markets},
  year                    = {2021},
  issn                    = {03784371},
  note                    = {cited By 5},
  volume                  = {570},
  abbrev_source_title = {Phys A Stat Mech Appl},
  abstract                = {Market dynamics is quantified via the cluster entropy S(τ,n)=∑jPj(τ,n)logPj(τ,n), an information measure with Pjτ,n the probability for the clusters, defined by the intersection between the price series and its moving average with window n, to occur with duration τ. The cluster entropy S(τ,n) is estimated over a broad range of temporal horizons M, for raw and sampled highest-frequency data of US markets. A systematic dependence of S(τ,n) on M emerges in agreement with price dynamics and correlation involving short and long range horizon dependence over multiple temporal scales. A comparison with the price dynamics based on Kullback–Leibler entropy simulations with different representative agent models is also reported. © 2021 Elsevier B.V.},
  affiliation             = {Universitá Cattaneo LIUC, Castellanza, Italy; Politecnico di Torino, corso Duca degli Abruzzi 24, Torino, 10129, Italy},
  art_number              = {125777},
  author_keywords         = {Complex systems; Financial Markets; Information Measures; Long-range dependence},
  coden                   = {PHYAD},
