  author                  = {Zhao, L. and Liu, Y. and Shen, X. and Liu, D. and Lü, S.},
  journal                 = {Dianli Xitong Baohu yu Kongzhi/Power System Protection and Control},
  title = {Short-term wind power prediction model based on CEEMDAN and an improved time convolutional network [基于CEEMDAN和改进时间卷积网络的短期风电功率预测模型]},
  year                    = {2022},
  issn                    = {16743415},
