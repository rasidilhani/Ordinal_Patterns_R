  document_type           = {Article},
  doi                     = {10.1177/16878132221137419},
  groups                  = {Journals},
  language                = {English},
  publisher               = {SAGE Publications Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85142870419&doi=10.1177%2f16878132221137419&partnerID=40&md5=56636d9b2d514082f1fcc0d3b3ea37fa},
}

@Article{Wang2022e,
  author                  = {Wang, W. and Zhao, X. and Luo, L. and Zhang, P. and Mo, F. and Chen, F. and Chen, D. and Wu, F. and Wang, B.},
  journal                 = {Energies},
  title = {A Fault Diagnosis Method of Rolling Bearing Based on Attention Entropy and Adaptive Deep Kernel Extreme Learning Machine},
  year                    = {2022},
  issn                    = {19961073},
  note                    = {cited By 8},
  number                  = {22},
  volume                  = {15},
  abbrev_source_title = {Energies},
  abstract                = {To address the difficulty of early fault diagnosis of rolling bearings, this paper proposes a rolling bearing diagnosis method by combining the attention entropy and adaptive deep kernel extreme learning machine (ADKELM). Firstly, the wavelet threshold denoising method is employed to eliminate the noise in the vibration signal. Then, the empirical wavelet transform (EWT) is utilized to decompose the denoised signal, and extract the attention entropy of the intrinsic mode function (IMF) as the feature vector. Next, the hyperparameters of the deep kernel extreme learning machine (DKELM) are optimized using the marine predators algorithm (MPA), so as to achieve the adaptive changes in the DKELM parameters. By analyzing the fault diagnosis performances of the ADKELM model with different kernel functions and hidden layers, the optimal ADKELM model is determined. Compared with conventional machine learning models such as extreme learning machine (ELM), back propagation neural network (BPNN) and probabilistic neural network (PNN), the high efficiency of the method proposed in this paper is verified. © 2022 by the authors.},
  affiliation             = {Wuling Power Corporation Ltd., Changsha, 410004, China; Hydropower Industry Innovation Center of State Power Investment Corporation Limited, Changsha, 410004, China; Department of Power and Electrical Engineering, Northwest AF University, Xianyang, 712100, China},
  art_number              = {8423},
  author_keywords         = {attention entropy; deep kernel extreme learning machine; empirical wavelet transform; fault diagnosis; marine predators algorithm; rolling bearing},
  correspondence_address1 = {Chen, F.; Department of Power and Electrical Engineering, China; email: chenfei@nwafu.edu.cn; Wang, B.; Department of Power and Electrical Engineering, China; email: binwang@nwsuaf.edu.cn},
  document_type           = {Article},
  doi                     = {10.3390/en15228423},
  groups                  = {Journals},
  keywords                = {Backpropagation; Deep learning; Entropy; Failure analysis; Fault detection; Knowledge acquisition; Learning systems; Neural networks; Roller bearings; Signal denoising, Attention entropy; Deep kernel extreme learning machine; Empirical wavelet transform; Fault diagnosis method; Faults diagnosis; Learning machines; Machine modelling; Marine predator algorithm; Rolling bearings; Wavelets transform, Wavelet transforms},
  language                = {English},
  publisher               = {MDPI},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85142629614&doi=10.3390%2fen15228423&partnerID=40&md5=2ed49083ba0f9df5a2f010ed8ae455df},
}

@Article{Zhan2022,
  author                  = {Zhan, X. and Bai, H. and Yan, H. and Wang, R. and Guo, C. and Jia, X.},
  journal                 = {Processes},
  title = {Diesel Engine Fault Diagnosis Method Based on Optimized {Vmd} and Improved {Cnn}},
  year                    = {2022},
  issn                    = {22279717},
  note                    = {cited By 19},
  number                  = {11},
  volume                  = {10},
  abbrev_source_title = {Process.},
  abstract                = {The safe operation of diesel engines performs a vital function in industrial production and life. Because diesel engines often work in harsh environmental conditions, they are prone to failure. Therefore, this paper proposes a fault analysis method based on a combination of optimized variational mode decomposition (VMD) and improved convolutional neural networks (CNN) to address the necessary need for preventive maintenance of diesel engines. The authentic vibration sign is first decomposed by using the (VMD) algorithm, then the greatest range of decomposition layers is decided by using scattering entropy and the useful components are preferentially chosen for reconstruction. The continuous wavelet transform (CWT) records preprocessing method is then delivered to radically change the noise-reduced vibration sign into a time-frequency map, which is fed into the CNN for model coaching and extraction of fault features. Finally, fault classification is realized by support vector machine (SVM) with excellent classification performance. Through preset fault experiments on diesel engines, it is established that the technique proposed in this paper can successfully identify fault states, and the classification accuracy is higher than alternative methods. © 2022 by the authors.},
  affiliation             = {Army Engineering University of PLA, Shijiazhuang Campus, Shijiazhuang, 050003, China},
  art_number              = {2162},
  author_keywords         = {continuous wavelet transform; convolutional neural network; diesel engine fault diagnosis; support vector machine; variational mode decomposition},
  correspondence_address1 = {Jia, X.; Army Engineering University of PLA, Shijiazhuang Campus, China; email: xsjia123@sina.com},
  document_type           = {Article},
  doi                     = {10.3390/pr10112162},
  groups                  = {Journals},
  language                = {English},
  publisher               = {MDPI},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85141672296&doi=10.3390%2fpr10112162&partnerID=40&md5=417a33055da783cda26c2acb47d8203b},
}

@Article{Namdari2022,
  author                  = {Namdari, A. and Samani, M.A. and Durrani, T.S.},
  journal                 = {Algorithms},
  title = {Lithium-Ion Battery Prognostics through Reinforcement Learning Based on Entropy Measures},
  year                    = {2022},
  issn                    = {19994893},
  note                    = {cited By 27},
  number                  = {11},
  volume                  = {15},
  abbrev_source_title = {Algorithms},
  abstract                = {Lithium-ion is a progressive battery technology that has been used in vastly different electrical systems. Failure of the battery can lead to failure in the entire system where the battery is embedded and cause irreversible damage. To avoid probable damages, research is actively conducted, and data-driven methods are proposed, based on prognostics and health management (PHM) systems. PHM can use multiple time-scale data and stored information from battery capacities over several cycles to determine the battery state of health (SOH) and its remaining useful life (RUL). This results in battery safety, stability, reliability, and longer lifetime. In this paper, we propose different data-driven approaches to battery prognostics that rely on: Long Short-Term Memory (LSTM), Autoregressive Integrated Moving Average (ARIMA), and Reinforcement Learning (RL) based on the permutation entropy of battery voltage sequences at each cycle, since they take into account vital information from past data and result in high accuracy. © 2022 by the authors.},
