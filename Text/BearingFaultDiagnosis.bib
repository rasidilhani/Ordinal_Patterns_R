  groups                  = {Journals},
  keywords                = {Entropy; Failure analysis, Common rail injector; High frequency components; High-frequency informations; Intelligent fault diagnosis; Intelligent Manufacturing; Mechanical equipment fault; Permutation entropy; Simulation signals, Fault detection},
  language                = {English},
