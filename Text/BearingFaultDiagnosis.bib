@Book{Bora2024,
  author              = {Bora, P. and Saikia, A. and Deka, J. and Hazarika, A.},
  publisher           = {CRC Press},
  title = {FAWT-based advanced multiboost learning algorithm for driver fatigue detection using brain {Eeg} signals},
  year                = {2024},
  isbn                = {9781040027127; 9781032459516},
  note                = {cited By 0},
  abbrev_source_title = {Intell. Wirel. Sens. Networks and the Internet of Things: Algorithms, Methodologies, and Applications},
  abstract            = {The chapter addresses an advanced intelligent machine learning algorithm incorporating promising signal analysis technique, namely, flexible analytic wavelet transform (FAWT) approach to detect driver fatigue using neurophysiological brain electroencephalogram signal. As per global reports 14-20% of road accidents are mainly due to driver fatigue. Causes of fatigue are mainly due to instant sickness, travelling for long distance, boredom and lack of enough sleep, and so on. The advocated methods aim in classifying the two states of driver fatigue, namely FATIGUE and REST for providing the alarm to the driver at earliest possible. The FAWT first separates signals into low- and high-pass channels of undertaking study groups. It then extracts relevant sub-band frequency components with proper setting of tuning parameters. Afterwards, low-dimensional features sets are extracted from high-order input feature searched space using dimension reduction technique, which are statistically significant for p < 0:05. These features embed them to various ensemble methods under multiboost strategy. The performance of the proposed method is examined in terms of various parameters including accuracy, F-score, AUC, and kappa. It achieves optimum individual accuracies in the range of 96-98% in classifying the FATIGUE and REST states with F-score of 97.50%. The results and comparison study with various prior methods akin to this method ensures the effectiveness of the advocated method for real-world applications. © 2024 selection and editorial matter, Bhanu Chander, B. Anoop, Koppala Guravaiah and G. Kumaravelan; individual chapters, the contributors.},
  affiliation         = {Department of Physics, Mayang Anchalik College, Assam, Marigaon, India; Department of Physics, Cotton University, Guwahati, India; Department of Physics, Cotton University, Assam, Guwahati, India},
  document_type       = {Book Chapter},
  doi                 = {10.1201/9781003474524-10},
  groups              = {Books},
  journal             = {Intelligent Wireless Sensor Networks and the Internet of Things: Algorithms, Methodologies, and Applications},
  language            = {English},
  pages = {218--235},
  source              = {Scopus},
  url                 = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85195969848&doi=10.1201%2f9781003474524-10&partnerID=40&md5=041ab0a08d5ca43e3dce62e208fe2318},
}

