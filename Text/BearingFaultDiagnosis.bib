  journal                 = {IEEE/ASME International Conference on Advanced Intelligent Mechatronics, AIM},
  keywords                = {Brain computer interface; Electroencephalography; Entropy; Interface states; Support vector machines, Brain computer interfaces (BCIs); Electroencephalogram (EEG) datum; Feature vectors; In-buildings; Offline classification; Permutation entropy; Self regulation; SVM classifiers, Intelligent mechatronics},
