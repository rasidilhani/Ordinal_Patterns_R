  author_keywords         = {complexity; fractal dimension; heart rate asymmetry; heart rate variability (HRV); paced breathing; parameter tuning; permutation entropy; resonant breathing; software},
  correspondence_address1 = {Mayor, D.; School of Health and Social Work, United Kingdom; email: davidmayor@welwynacupuncture.co.uk},
  document_type           = {Article},
  doi                     = {10.3390/e25020301},
  groups                  = {Journals},
  language                = {English},
  publisher               = {MDPI},
  source                  = {Scopus},
