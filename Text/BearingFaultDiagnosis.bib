  document_type           = {Article},
  doi                     = {10.1016/j.eswa.2023.119923},
  groups                  = {Journals},
  keywords                = {Chaotic systems; Correlation methods; Cryptography; Image processing; Lyapunov methods; Stochastic systems, Color image encryptions; Hyperchaotic maps; Image encryption algorithm; Image security; Images encryptions; Largest Lyapunov's Exponent; Mathematical functions; Performance; Sample entropy; Two-dimensional, Color},
  language                = {English},
