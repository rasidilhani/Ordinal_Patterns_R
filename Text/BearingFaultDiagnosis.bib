@Article{Duan2024,
  author                  = {Duan, R. and Liao, Y.},
  journal                 = {IEEE Transactions on Industrial Electronics},
  title = {Morphological Analysis Based Adaptive Blind Deconvolution Approach for Bearing Fault Feature Extraction},
  year                    = {2024},
  issn                    = {02780046},
  note                    = {cited By 7},
  number                  = {7},
  pages = {7864--7875},
  volume                  = {71},
  abbrev_source_title = {IEEE Trans Ind Electron},
  abstract                = {How to accurately extract the fault related periodical impulses is the key to bearing fault diagnosis. The blind deconvolution (BD) method has been positively affirmed its ability in this field. However, the experience dependent parameter-setting and vulnerable to interference under complex working condition are two main problems that seriously limit its application. To address these issues, an improved BD method, named adaptive morphological BD, is proposed in this article. A new indicator, the morphological frequency negentropy, is first constructed through morphological analysis and adopted as the objective function for deconvolution. With its robustness to random impact and noise being verified, the optimal Morlet wavelet filter is selected with morphological frequency negentropy (MFN) and used as the initial filter. The sampling matrix is enhanced with varying morphological filtering and its size is adaptively determined by power spectral density. Through adaptive setting of the length of the filter, the dependence of prior knowledge for parameter setting is therefore reduced. Finally, the diagonal slice spectrum is applied on the filtered signal to remove in-band and residual noise. The effectiveness of the proposed method is validated by simulation signal and real datasets. Comparison analysis with other typical filter methods further shows its superiority. © 1982-2012 IEEE.},
  affiliation             = {Xi'an Jiaotong University, Key Laboratory of Education Ministry for Modern Design and Rotor-Bearing System, Xi'an, 710049, China; Xi'an Jiaotong University, Shaanxi Key Laboratory of Mechanical Product Quality Assurance and Diagnostics, Xi'an, 710049, China},
  author_keywords         = {Bearing fault diagnosis; blind deconvolution (BD); morphological analysis},
  coden                   = {ITIED},
  correspondence_address1 = {Liao, Y.; Xi'an Jiaotong University, China; email: yhliao@xjtu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1109/TIE.2023.3303652},
  groups                  = {Journals},
  keywords                = {Convolution; Extraction; Fault detection; Feature extraction; Linguistics; Morphology; Robustness (control systems); Spectral density; Vibration analysis, Bearing fault diagnosis; Blind deconvolution; Deconvolutions; Faults diagnosis; Features extraction; Interference; Morphological analysis; Optimisations; Robustness; Vibration, Failure analysis},
  language                = {English},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85168741098&doi=10.1109%2fTIE.2023.3303652&partnerID=40&md5=8b320c0644aafb2c07184bc4a9c63f44},
}

@Article{Shiozawa2024,
  author                  = {Shiozawa, K. and Tokuda, I.T.},
  journal                 = {Physics Letters, Section A: General, Atomic and Solid State Physics},
  title = {Estimating Kolmogorov–Sinai entropy from time series of high-dimensional complex systems},
  year                    = {2024},
  issn                    = {03759601},
  note                    = {cited By 1},
  volume                  = {510},
  abbrev_source_title = {Phys Lett Sect A Gen At Solid State Phys},
  abstract                = {A method is presented to estimate KS entropy from time series of a high-dimensional complex system. We focus on partitioned entropy, which measures the complexity of data points localized in a delay-coordinate space. By quantifying the time evolution of the partitioned entropy, we show that its growth rate gives a good estimate of the KS entropy. Our method is computationally efficient, since a time series is discretized into a coarse-grained symbolic sequence by a vector quantization technique. Using numerical data sets generated from prototypical models of chaotic systems, we showed that our approach works quite well for high-dimensional complex systems. Application to experimental data measured from physical models of the vocal membranes confirmed that our method is effective for characterizing the complexity of real-world systems. © 2024 The Author(s)},
  affiliation             = {Graduate School of Science and Engineering, Ritsumeikan University, 1-1-1 Noji-Higashi, Shiga, Kusatsu, 525-8577, Japan},
  art_number              = {129531},
