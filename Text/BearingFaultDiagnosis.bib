  journal                 = {Journal of Physics: Conference Series},
  keywords                = {Health risks, Bearing; Degradation time; Health condition; Improved diversity entropy; Property; Rolling bearings; Rolling Element Bearing; Start to degradation time determination; Time determination, Roller bearings},
  language                = {English},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85195584759&doi=10.1088%2f1742-6596%2f2762%2f1%2f012032&partnerID=40&md5=4890d5fa8bdc4be354015af7d14eb99b},
