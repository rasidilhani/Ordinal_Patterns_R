  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85186954130&doi=10.1016%2fj.cmpb.2024.108105&partnerID=40&md5=63edd5523f90c5f4e6845b0401c97948},
}

@Article{EyebeFouda2024,
  author                  = {Eyebe Fouda, J.S.A. and Koepf, W. and Marwan, N. and Kurths, J. and Penzel, T.},
  journal                 = {Chaos, Solitons and Fractals},
  title = {Complexity from ordinal pattern positioned slopes (COPPS)},
  year                    = {2024},
  issn                    = {09600779},
  note                    = {cited By 2},
  volume                  = {181},
  abbrev_source_title = {Chaos Solitons Fractals},
  abstract                = {Measuring complexity allows to characterize complex systems. Existing techniques are limited to simultaneously measure complexity from short length data sets, detect transitions and periodic dynamics. This paper presents an approach based on ordinal pattern positioned slopes (OPPS). It considers exclusively OPPS group occurrences to compute the complexity from OPPS (COPPS) as the average number of patterns and applies to short data series. The COPPS measure was successfully applied to simulation data for measuring complexity, detecting transition phases and regular dynamics, distinguishing between chaotic and stochastic dynamics; and to real-world data for detecting arrhythmia ECG beats. © 2024 Elsevier Ltd},
  affiliation             = {Department of Physics, Faculty of Science, University of Yaoundé I, P.O. Box 812, Yaoundé, Cameroon; Institute of Mathematics, University of Kassel, Kassel, Germany; Potsdam Institute for Climate Impact Research, Member of the Leibniz Association, P.O. Box 601203, Potsdam, D-14412, Germany; Department of Internal Medicine, Center of Sleep Medicine, Charité University of Medicine, Berlin, D-10117, Germany},
