  keywords                = {Biomedical signal processing; Electrophysiology; Frequency domain analysis; Machine learning; Neural networks, Arithmetic tasks; Electroencephalography; Ensemble approaches; Machine-learning; Mental arithmetic; Mental arithmetic task; Mental stress; Nonlinear features; Time frequency; Time frequency features, Electroencephalography},
  language                = {English},
