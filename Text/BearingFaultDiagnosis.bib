  coden                   = {MSRMD},
  correspondence_address1 = {Wang, H.; College of Automation Engineering, China; email: htwang2002@126.com},
  document_type           = {Article},
  doi                     = {10.1016/j.measurement.2024.116194},
  groups                  = {Journals},
  keywords                = {Image segmentation; Ultrasonic testing; Variational techniques; Wavelet decomposition, Continuous Wavelet Transform; Deep learning; Detection models; Internal defect detection; Internal defects; Laser ultra-sonics; Laser-ultrasonic; Mode decomposition; Permutation entropy; Test sets, Variational mode decomposition},
  language                = {English},
