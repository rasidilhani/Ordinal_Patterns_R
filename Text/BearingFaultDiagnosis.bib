@Article{Ying2021,
  author                  = {Ying, W. and Zheng, J. and Pan, H. and Liu, Q.},
  journal                 = {Digital Signal Processing: A Review Journal},
  title = {Permutation entropy-based improved uniform phase empirical mode decomposition for mechanical fault diagnosis},
  year                    = {2021},
  issn                    = {10512004},
  note                    = {cited By 48},
  volume                  = {117},
  abbrev_source_title = {Digital Signal Process Rev J},
  abstract                = {Uniform phase empirical mode decomposition (UPEMD) is an effective signal separation method, which is proposed to solve the mode mixing phenomenon of empirical mode decomposition (EMD) by adding uniform phase sinusoidal signal as masking signal. However, the decomposition effect of UPEMD depends on the selection of amplitude and phase number of masking signal. Besides, there are also some issues such as noise residue and incomplete decomposition that need to be solved. In this paper, a novel permutation entropy-based improved uniform phase empirical mode decomposition (PEUPEMD) method is proposed to address these problems. In PEUPEMD method, first of all, the sinusoidal signals with uniform phases are added to the raw signal as masking signals. Second, the superimposed signal is decomposed using EMD and the final intrinsic mode functions are obtained via an ensemble way. Third, the obtained IMFs with high-frequency are detected by permutation entropy algorithm. Finally, the residual signal containing low-frequency components is decomposed through EMD completely. Last, the simulated signal and tested data are applied to verify the feasibility of PEUPEMD via comparing it with EMD, UPEMD, CEEMDAN and ICEEMDAN methods. The results analysis indicated that PEUPEMD was superior to the comparative methods in decomposing accuracy and mode mixing suppression. © 2021 Elsevier Inc.},
  affiliation             = {School of Mechanical Engineering, Anhui University of Technology, Maanshan, 243032, China},
  art_number              = {103167},
  author_keywords         = {Fault diagnosis; Mode mixing; Permutation entropy; Rolling bearing; Uniform phase empirical mode decomposition},
  coden                   = {DSPRE},
  correspondence_address1 = {Zheng, J.; School of Mechanical Engineering, China; email: lqdlzheng@126.com},
  document_type           = {Article},
  doi                     = {10.1016/j.dsp.2021.103167},
  groups                  = {Journals},
  keywords                = {Entropy; Mixing, Comparative methods; Empirical Mode Decomposition; Intrinsic Mode functions; Low-frequency components; Mechanical fault diagnosis; Permutation entropy; Sinusoidal signals; Superimposed signal, Signal processing},
  language                = {English},
  publisher               = {Elsevier Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85111782821&doi=10.1016%2fj.dsp.2021.103167&partnerID=40&md5=def97137ea7872e69574c8b67c0edf14},
}

@Article{Morel2021,
  author                  = {Morel, C. and Humeau-Heurtier, A.},
  journal                 = {Pattern Recognition Letters},
  title = {Multiscale permutation entropy for two-dimensional patterns},
  year                    = {2021},
  issn                    = {01678655},
  note                    = {cited By 30},
  pages = {139--146},
  volume                  = {150},
  abbrev_source_title = {Pattern Recogn. Lett.},
  abstract                = {Complexity measures are important to understand and analyze systems with one dimensional data. However, extension of these methods to images (two dimensional data) are much less usual. Bidimensional multiscale sample entropy (MSE2D) has recently been proposed as a new complexity measure for texture evaluation. However, MSE2D leads to undefined or unreliable values for small-sized textures and requires a long computation time. This is why we herein propose the bidimensional multiscale permutation entropy (MPE2D) to evaluate the complexity of 2D patterns. MPE2D is applied to different synthesized textures, to softwood samples, and to study the texture of breast histopathology images. The results show that MPE2D is a valuable tool for texture analysis and that it is computationally noticeably faster than MSE2D. © 2021 Elsevier B.V.},
  affiliation             = {ESTACA - Campus Ouest, F-53061 Laval Cedex 9, France; Univ Angers, LARIS, SFR MATHSTIC, F-49000 Angers, France},
  author_keywords         = {Multi-scale analysis; Normalized permutation entropy; Texture images},
  correspondence_address1 = {Morel, C.; ESTACA - Campus Ouest, F-53061 Laval Cedex 9, France; email: Cristina.MOREL@estaca.fr},
  document_type           = {Article},
  doi                     = {10.1016/j.patrec.2021.06.028},
  groups                  = {Journals},
  keywords                = {Clustering algorithms; Image texture; Medical imaging; Textures, Complexity measures; Computation time; Multi scale analysis; Normalized permutation entropy; One-dimensional; Permutation entropy; Sample entropy; Texture image; Two-dimensional; Two-dimensional patterns, Entropy},
  language                = {English},
  publisher               = {Elsevier B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85111305379&doi=10.1016%2fj.patrec.2021.06.028&partnerID=40&md5=3d10fabc50af29106ff18a9f91d9a379},
}

@Article{TallaMbe2021,
  author              = {Talla Mbe, J.H. and Atchoffo, W.N. and Tchitnga, R. and Woafo, P.},
  journal             = {IEEE Journal of Quantum Electronics},
  title = {Dynamics of Time-Delayed Optoelectronic Oscillators with Nonlinear Amplifiers and Its Potential Application to Random Numbers Generation},
  year                = {2021},
  issn                = {00189197},
  note                = {cited By 12},
  number              = {5},
  volume              = {57},
  abbrev_source_title = {IEEE J. Quantum Electron.},
  abstract            = {Time-delayed dynamical systems generally feature smooth nonlinear transfer functions in the feedback loop, such as polynomial or sinusoidal functions. As a consequence, the complexity of their dynamical behavior mainly originates from the time-delay. In this paper, we explore the opposite case where the nonlinear transfer function is complex ( cos^{2}(sinh) ), and therefore, non-smooth. We perform a bifurcation analysis of the system, and evidence that this novel type of time-delayed system can display a chaotic behavior characterized by positive maximum Lyapunov exponent and quasi-maximal entropy. The high entropy behavior of the system combined with post-processing are used to generate random numbers for small values of the feedback gain with an overall bit rate up to 1.478 Gb/s. Our theoretical results are in excellent agreement with experimental measurements, performed with an optoelectronic oscillator involving a complex transfer function designed ad hoc. © 1965-2012 IEEE.},
  affiliation         = {Department of Physics, Laboratory of Condensed Matter Electronics and Signal Processing, University of Dschang, Dschang, Cameroon},
  art_number          = {9469882},
  author_keywords     = {nonlinear amplifier; optoelectronic oscillators; permutation entropy; random numbers generation; Time-delay systems},
  coden               = {IEJQA},
  document_type       = {Article},
  doi                 = {10.1109/JQE.2021.3093902},
  groups              = {Journals},
  keywords            = {Bifurcation (mathematics); Dynamical systems; Entropy; Feedback; Lyapunov methods; Optoelectronic devices; Random number generation; Time delay, Bifurcation analysis; Complex transfer functions; Dynamical behaviors; Maximum Lyapunov exponent; Nonlinear transfer functions; Opto-electronic oscillator; Sinusoidal functions; Time-delayed systems, Transfer functions},
  language            = {English},
  publisher           = {Institute of Electrical and Electronics Engineers Inc.},
  source              = {Scopus},
  url                 = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85110769879&doi=10.1109%2fJQE.2021.3093902&partnerID=40&md5=a127dd34af7414dd180fb305c97a31d5},
}

@Article{Smith2021,
  author                  = {Smith, R.J. and Hu, D.K. and Shrey, D.W. and Rajaraman, R. and Hussain, S.A. and Lopour, B.A.},
  journal                 = {Epilepsy Research},
  title = {Computational characteristics of interictal {Eeg} as objective markers of epileptic spasms},
  year                    = {2021},
  issn                    = {09201211},
  note                    = {cited By 25},
  volume                  = {176},
  abbrev_source_title = {Epilepsy Res.},
  abstract                = {Objective: Favorable neurodevelopmental outcomes in epileptic spasms (ES) are tied to early diagnosis and prompt treatment, but uncertainty in the identification of the disease can delay this process. Therefore, we investigated five categories of computational electroencephalographic (EEG) measures as markers of ES. Methods: We measured 1) amplitude, 2) power spectra, 3) Shannon entropy and permutation entropy, 4) long-range temporal correlations, via detrended fluctuation analysis (DFA) and 5) functional connectivity using cross-correlation and phase lag index (PLI). EEG data were analyzed from ES patients (n = 40 patients) and healthy controls (n = 20 subjects), with multiple blinded measurements during wakefulness and sleep for each patient. Results: In ES patients, EEG amplitude was significantly higher in all electrodes when compared to controls. Shannon and permutation entropy were lower in ES patients than control subjects. The DFA intercept values in ES patients were significantly higher than control subjects, while DFA exponent values were not significantly different between the groups. EEG functional connectivity networks in ES patients were significantly stronger than controls when based on both cross-correlation and PLI. Significance for all statistical tests was p < 0.05, adjusted for multiple comparisons using the Benjamini-Hochberg procedure as appropriate. Finally, using logistic regression, a multi-attribute classifier was derived that accurately distinguished cases from controls (area under curve of 0.96). Conclusions: Computational EEG features successfully distinguish ES patients from controls in a large, blinded study. Significance: These objective EEG markers, in combination with other clinical factors, may speed the diagnosis and treatment of the disease, thereby improving long-term outcomes. © 2021},
  affiliation             = {Department of Biomedical Engineering, University of California, Irvine, CA, United States; Division of Neurology, Children's Hospital of Orange County, Orange, CA, United States; Department of Pediatrics, University of California, Irvine, CA, United States; Division of Pediatric Neurology, University of California, Los Angeles, CA, United States},
  art_number              = {106704},
  author_keywords         = {Detrended fluctuation analysis; Entropy; Functional connectivity; Infantile spasms; Long-range temporal correlations; West syndrome},
  coden                   = {EPIRE},
  correspondence_address1 = {Lopour, B.A.; 3418 Engineering HallUnited States; email: beth.lopour@uci.edu},
  document_type           = {Article},
  doi                     = {10.1016/j.eplepsyres.2021.106704},
  groups                  = {Journals},
  keywords                = {area under the curve; Article; case control study; clinical article; controlled study; detrended fluctuation analysis; double blind procedure; early diagnosis; early intervention; electroencephalography; entropy; epilepsy; epileptic spasm; female; functional connectivity; human; infant; male; permutation entropy; phase lag index; Shannon entropy; sleep; wakefulness; electroencephalography; infantile spasm; muscle spasm; procedures, Electroencephalography; Humans; Sleep; Spasm; Spasms, Infantile; Wakefulness},
  language                = {English},
  publisher               = {Elsevier B.V.},
  pubmed_id               = {34218209},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85109201193&doi=10.1016%2fj.eplepsyres.2021.106704&partnerID=40&md5=c521ffdebde2edd5d690d78f62dae85b},
}

@Article{Sharma2021,
  author                  = {Sharma, V. and Raghuwanshi, N.K. and Jain, A.K.},
  journal                 = {Journal of Vibration Engineering and Technologies},
  title = {Sensitive Sub-band Selection Criteria for Empirical Wavelet Transform to Detect Bearing Fault Based on Vibration Signals},
  year                    = {2021},
  issn                    = {25233920},
  note                    = {cited By 20},
  number                  = {7},
  pages = {1603--1617},
  volume                  = {9},
  abbrev_source_title = {J. Vib. Eng. Technol.},
  abstract                = {Under varying speed, a bearing exhibits a severely modulated signal, to which the classical techniques of time and frequency domain fails to detect. An experimental investigation exhibiting detection of bearing faults at both constant and varying speed using empirical wavelet transform (EWT) is presented. EWT employs a filter bank to decompose a non-stationary signal into different sub-bands. The selection of sub-band influences fault detection because residual noises remain unfiltered. Therefore, identification of sensitive sub-band is crucial for a detailed investigation, which is done using correlated correlation and kurtosis. Upon selection of sensitive sub-band the envelope spectrum was used to detect the presence of fault based on the frequencies noticed. The results were validated by permutation entropy. Two case studies: in-house bearing vibration signal at a constant speed and, online available bearing data set at varying speed, were performed to exhibit the promising result of the proposed approach to detect the bearing fault. © 2021, Krishtel eMaging Solutions Private Limited.},
  affiliation             = {Department of Mechanical Mechatronics Engineering, The LNM Institute of Information and Technology, Jaipur, Rajasthan, India; Department of Mechanical Engineering, Malaviya National Institute of Technology, Jaipur, Rajasthan, India; Department of Engineering, Institute for Manufacturing, University of Cambridge, Cambridge, CB3 0FS, United Kingdom},
  author_keywords         = {Bearing; Decomposition; Empirical wavelet transform; Fault detection; Varying speed},
  correspondence_address1 = {Raghuwanshi, N.K.; Department of Mechanical Engineering, India; email: naresh.mech@mnit.ac.in},
  document_type           = {Article},
  doi                     = {10.1007/s42417-021-00316-8},
  groups                  = {Journals},
  language                = {English},
  publisher               = {Springer},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85106320906&doi=10.1007%2fs42417-021-00316-8&partnerID=40&md5=4aa383f4b3e6f226541dd86cfccfb912},
}

@Article{Peng2021,
  author                  = {Peng, B. and Wan, S. and Bi, Y. and Xue, B. and Zhang, M.},
  journal                 = {IEEE Transactions on Cybernetics},
  title = {Automatic Feature Extraction and Construction Using Genetic Programming for Rotating Machinery Fault Diagnosis},
  year                    = {2021},
  issn                    = {21682267},
  note                    = {cited By 68},
  number                  = {10},
  pages = {4909--4923},
  volume                  = {51},
  abbrev_source_title = {IEEE Trans. Cybern.},
  abstract                = {Feature extraction is an essential process in the intelligent fault diagnosis of rotating machinery. Although existing feature extraction methods can obtain representative features from the original signal, domain knowledge and expert experience are often required. In this article, a novel diagnosis approach based on evolutionary learning, namely, automatic feature extraction and construction using genetic programming (AFECGP), is proposed to automatically generate informative and discriminative features from original vibration signals for identifying different fault types of rotating machinery. To achieve this, a new program structure, a new function set, and a new terminal set are developed in AFECGP to allow it to detect important subband signals and extract and construct informative features, automatically and simultaneously. More important, AFECGP can produce a flexible number of features for classification. Having the generated features, $k$ -Nearest Neighbors is employed to perform fault diagnosis. The performance of the AFECGP-based fault diagnosis approach is evaluated on four fault diagnosis datasets of varying difficulty and compared with 14 baseline methods. The results show that the proposed approach achieves better fault diagnosis accuracy on all the datasets than the competitive methods and can effectively identify different fault conditions of rolling bearing, gear, and rotor. © 2013 IEEE.},
  affiliation             = {Hebei Key Laboratory of Electric Machinery Health Maintenance and Failure Prevention, North China Electric Power University, Baoding, China; School of Engineering and Computer Science, Victoria University of Wellington, Wellington, New Zealand},
  author_keywords         = {Fault diagnosis; feature construction; feature extraction; genetic programming (GP); rotating machinery},
  correspondence_address1 = {Bi, Y.; School of Engineering and Computer Science, New Zealand; email: ying.bi@ecs.vuw.ac.nz},
  document_type           = {Article},
  doi                     = {10.1109/TCYB.2020.3032945},
  groups                  = {Journals},
  keywords                = {Classification (of information); Extraction; Failure analysis; Feature extraction; Genetic algorithms; Genetic programming; Nearest neighbor search; Program diagnostics; Roller bearings; Rotating machinery; Signal processing, Automatic feature extraction; Discriminative features; Evolutionary Learning; Expert experience; Feature extraction methods; Intelligent fault diagnosis; K-nearest neighbors; Machinery fault diagnosis, Fault detection, algorithm; device failure analysis; vibration, Algorithms; Equipment Failure Analysis; Vibration},
  language                = {English},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
