  groups                  = {Journals},
  isbn                    = {9783031087509},
  keywords                = {Classification models; Dynamic classification; Incremental approach; Incremental learning; Modeling quality; Predictability; Prediction modelling; Quality metrices; Quality of predictions; Transactional data},
