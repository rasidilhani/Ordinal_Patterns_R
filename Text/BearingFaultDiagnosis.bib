@Article{Zhong2021,
  author                  = {Zhong, X. and Gao, X. and Mei, Q. and Huang, T. and Zhao, X.},
  journal                 = {Journal of Intelligent and Fuzzy Systems},
  title = {Fault feature extraction method of gear based on optimized minimum entropy deconvolution and accugram},
  year                    = {2021},
  issn                    = {10641246},
  note                    = {cited By 4},
  number                  = {6},
  pages = {12265--12282},
  volume                  = {40},
  abbrev_source_title = {J. Intelligent Fuzzy Syst.},
  abstract                = {Gear fault vibration signals are commonly non-stationary, and useful fault information is often buried in heavy noise, which makes it difficult to extract gear fault features. How to select the suitable fault frequency bands is the key to gear fault diagnosis. To address the above problems, a method combining the improved minimum entropy deconvolution (MED) and accugram, named IMEDA, is proposed for extracting gear fault features. Firstly, a selection index based on permutation entropy (PE) and correlation coefficient is defined. Then, the optimal filter length can be effectively selected by the step-length searching method using the proposed index as objective function, and the improved MED is employed to preprocess the gear vibration signals. Finally, the accugram analysis is performed for the preprocessed signals to obtain the optimal frequency band, and the fault characteristic frequencies are extracted from the square envelope spectrum of the signals in the optimal band. The method is validated by gear experimental data with gear wear-out failure. The analysis results demonstrate that the proposed method owns superior effect by comparing with the fast kurtogram (FK), MED combined with FK (MED-FK), accugram and infogram. © 2021 - IOS Press. All rights reserved.},
  affiliation             = {Hubei Key Laboratory of Hydroelectric Machinery Design Maintenance, China Three Gorges University, Yichang, China; School of Mechanical Engineering, Hubei University of Arts and Science, Xiangyang, China},
  author_keywords         = {accugram; fault feature extraction; frequency band selection; Minimum entropy deconvolution},
  correspondence_address1 = {Zhao, X.; School of Mechanical Engineering, China; email: zhaoxiao_wust@163.com},
  document_type           = {Article},
  doi                     = {10.3233/JIFS-210405},
  groups                  = {Journals},
  keywords                = {Vibrations (mechanical), Correlation coefficient; Fault characteristics; Fault feature extractions; Gear fault diagnosis; Minimum entropy deconvolution; Objective functions; Optimal frequency bands; Permutation entropy, Minimum entropy methods},
  language                = {English},
  publisher               = {IOS Press BV},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85111113687&doi=10.3233%2fJIFS-210405&partnerID=40&md5=8e913117cdc4910d57d768ec6fce4821},
}

@Article{Wen2021,
  author              = {Wen, C.-M. and Yao, Y.},
  journal             = {Computer Aided Chemical Engineering},
  title = {Symbolic transfer entropy for root cause analysis of process disturbances},
  year                = {2021},
  issn                = {15707946},
  note                = {cited By 0},
  pages = {1357--1362},
  volume              = {50},
  abbrev_source_title = {Comput. Aided Chem. Eng.},
  abstract            = {Root cause analysis is an important step in process monitoring for the disclosure of causes of process disturbances. In the past research and practice, transfer entropy has been widely adopted for its capability to handle process nonlinearity. However, the conventional transfer entropy is not robust to noise and computational inefficient, which affects its application performance. These problems can be solved by incorporating the technique of symbolization. To the best of our knowledge, symbolic transfer entropy (STE) has seldom been implemented in the field of process monitoring. In this work, the concepts of statistical process control (SPC) and STE are integrated to achieve satisfactory diagnosis results. As known, SPC charts, e.g. Shewhart charts, exponential weighted moving average charts, and cumulative sum charts, are useful tools for process monitoring, where the sample locations on the control chart indicate certain process status. Therefore, it is reasonable to symbolize process measurements according to such information. After symbolization, STE is conducted to reveal the causality among process variables which is then visualized with a signed directed graph. The case study on the Tennessee Eastman process shows that the control chart-based STE possesses a capability to understand the causes of disturbances and offers the convenience of root cause analysis. © 2021 Elsevier B.V.},
  affiliation         = {Department of Chemical Engineering, National Tsing Hua University, Hsinchu, 300044, Taiwan},
  author_keywords     = {causality analysis; diagnosis; process monitoring; root cause analysis; symbolic transfer entropy},
  document_type       = {Book Chapter},
  doi                 = {10.1016/B978-0-323-88506-5.50209-6},
  groups              = {Journals},
  language            = {English},
  publisher           = {Elsevier B.V.},
  source              = {Scopus},
  url                 = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85110393168&doi=10.1016%2fB978-0-323-88506-5.50209-6&partnerID=40&md5=9b3848f1ea4773cac687360d97727974},
}

@Article{Wang2021g,
  author                  = {Wang, X. and Wang, Y. and Yuan, P. and Wang, L. and Cheng, D.},
  journal                 = {Hydrological Sciences Journal},
  title = {An adaptive daily runoff forecast model using {Vmd}-LSTM-PSO hybrid approach},
  year                    = {2021},
  issn                    = {02626667},
  note                    = {cited By 56},
  number                  = {9},
  pages = {1488--1502},
  volume                  = {66},
  abbrev_source_title = {Hydrol. Sci. J.},
  abstract                = {To cope with the nonlinear and nonstationarity challenges faced by conventional runoff forecasting models and improve daily runoff prediction accuracy, a hybrid model-based “feature decomposition-component prediction-result reconstruction” named VMD-LSTM-PSO was proposed. First, variational mode decomposition (VMD) was used to decompose the original daily runoff series into a discrete number of intrinsic mode functions (IMFs) to produce clearer signals. Then, for each IMF, a long short-term memory (LSTM) network was applied to establish the prediction model, and a particle swarm optimization (PSO) algorithm was utilised to optimise the number of hidden layer nodes and the learning rate of the LSTM. The model was applied in three hydrologic stations in the main stream of the Yellow River of China and compared with the complementary ensemble empirical mode decomposition coupled long short-term memory and particle swarm optimization (CEEMD-LSTM-PSO), wavelet transform coupled long short-term memory and particle swarm optimization (WT-LSTM-PSO) and LSTM-PSO models. Based on its high predictive accuracy and stability, the novel model promises to be a preferred data-driven tool for hydrological forecasting in practice. © 2021 IAHS.},
  affiliation             = {State Key Laboratory of Hydraulic Engineering Simulation and Safety, Tianjin University, Tianjin, China; Production Management Department, Yangtze Ecology and Environment Co, Limited, Wuhan, China; Technology Research Institute, Beijing Urban Construction Design, Development Group Co., Limited, Beijing, China; College of Water Conservancy and Construction Engineering, Northwest AF University, Yangling, China},
  author_keywords         = {climate change; daily runoff forecasting; long short-term memory network; the Yellow River; variational mode decomposition},
  coden                   = {HSJOD},
  correspondence_address1 = {Yuan, P.; Beijing Urban Construction Design, China; email: ypx2017@tju.edu.cn},
  document_type           = {Article},
  doi                     = {10.1080/02626667.2021.1937631},
  groups                  = {Journals},
  keywords                = {Brain; Forecasting; Particle swarm optimization (PSO); Predictive analytics; Runoff; Signal processing; Wavelet decomposition, Ensemble empirical mode decomposition; Feature decomposition; Hydrologic stations; Hydrological forecasting; Intrinsic Mode functions; Mode decomposition; Non-stationarities; Predictive accuracy, Long short-term memory, climate change; forecasting method; hydrological modeling; nonlinearity; prediction; runoff},
  language                = {English},
