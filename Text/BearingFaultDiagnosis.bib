@Article{Du2021a,
  author                  = {Du, H. and Zhang, J. and Liu, H. and Gong, L. and Liu, F. and Wang, Y.},
  journal                 = {Shenzhen Daxue Xuebao (Ligong Ban)/Journal of Shenzhen University Science and Engineering},
  title = {Autonomous Boolean network and physical random number generator based on XOR gate [异或门自治布尔网络及物理随机数发生器]},
  year                    = {2021},
  issn                    = {10002618},
  note                    = {cited By 0},
  number                  = {1},
  pages = {103--109},
  volume                  = {38},
  abbrev_source_title = {Shenzhen Daxue Xuebao (Ligong Ban)},
  abstract                = {As a controllable nonlinear system, autonomous Boolean network which is easy to generate chaotic signals has become a hot research topic. We realize an 18-node autonomous Boolean network circuit which can generate high entropy chaos by using the nonlinear characteristics of two-input XOR gate, and establish an improved mathematical model for the circuit by introducing the filter coefficient. Through numerical simulation and circuit comparison experiment, we study the influence of filter coefficient and delay parameters on network dynamic characteristics of this model. The numerical simulation results are basically consistent with those of the experimental phenomena. When the transmission delay between nodes is not equal, the filter coefficient has a modulation effect on the generation of chaos, which well indicates that the introduction of the filter coefficient makes the improved mathematical model more objective to describe the physical phenomena in the circuit. In addition, using bifurcation diagram, Lyapunov exponent and permutation entropy, we further analyze the nonlinear characteristics and randomness of the autonomous Boolean network. The output chaotic sequence of the network has the characteristics of high bandwidth, high entropy and strong robustness, which is used to generate high speed physical random sequences and has passed the NIST SP 800-22 randomness tests of National Institute of Standards and Technology of America. © 2021, Science Press. All right reserved.},
  affiliation             = {Key Laboratory of Advanced Transducers and Intelligent Control System of Ministry of Education and Shanxi Province, Taiyuan University of Technology, Taiyuan, 030024, China; College of Physics and Optoelectronics, Taiyuan University of Technology, Taiyuan, 030024, China; College of Information and Engineering, Guangdong University of Technology, Guangzhou, 510006, China},
  author_keywords         = {Boolean network; Chaotic circuit; Nonlinear system; Physical electronics; Physical random number; Secure communications},
  coden                   = {SDXLE},
  correspondence_address1 = {Zhang, J.; Key Laboratory of Advanced Transducers and Intelligent Control System of Ministry of Education and Shanxi Province, China; email: zhangjianguo@tyut.edu.cn},
  document_type           = {Article},
  doi                     = {10.3724/SP.J.1249.2021.01103},
  groups                  = {Journals},
  language                = {Chinese},
  publisher               = {Editorial Office of Journal of Shenzhen University},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85099931049&doi=10.3724%2fSP.J.1249.2021.01103&partnerID=40&md5=bb1d138c150168200b331853da8fdded},
}

@Article{Zhang2021i,
  author              = {Zhang, L. and Wu, R.},
  journal             = {Zhendong yu Chongji/Journal of Vibration and Shock},
  title = {Performance degradation assessment of rolling bearings based on the entropy energy ratio of adaptive frequency band [滚动轴承性能退化评估的自适应频带熵能比指标]},
  year                = {2021},
  issn                = {10003835},
  note                = {cited By 13},
  number              = {2},
  pages               = {63-71 and 110},
  volume              = {40},
  abbrev_source_title = {J Vib Shock},
  abstract            = {For bearing performance degradation assessment (PDA), time-domain statistics and similarity-based methods using probability or distance measures are frequently used. However, time-domain statistics parameters like root mean square (RMS) are insensitive to early defect, while similarity-based methods are of complex models and time consuming. As such, permutation entropy (PE) which can detect slight mutations in time series and has high computational efficiency, was introduced to bearing PDA. Though PE has its advantages, it doesn't consider the absolute amplitude of vibrations and thus is unable to depict the signal's energy distribution over frequencies. In the present work, a new index named entropy energy rate (EER) was proposed. Artificially induced defects and run-to-failure data set from rolling bearings were processed to demonstrate the advantages of EER over RMS and PE in terms of the consistence between the indices and fault severity levels, as well as the sensitivity of the indices to early fault and the change of fault degrees. Furthermore, results on field data verify the effectiveness of the EER index in bearing PDA, which means in turn EER is a potential PDA tool. © 2021, Editorial Office of Journal of Vibration and Shock. All right reserved.},
  affiliation         = {School of Mechatronics & Vehicle Engineering, East China Jiaotong University, Nanchang, 330013, China},
  author_keywords     = {Performance degradation assessment(PDA); Permutation entropy(PE); Rolling bearing; Wavelet filtering},
  document_type       = {Article},
  doi                 = {10.13465/j.cnki.jvs.2021.02.009},
  groups              = {Journals},
  keywords            = {Computational efficiency; Entropy; Time domain analysis, Absolute amplitude; Adaptive frequency; Bearing performance; Energy distributions; Performance degradation assessment; Permutation entropy; Similarity-Based Methods; Using probabilities, Roller bearings},
  language            = {Chinese},
  publisher           = {Chinese Vibration Engineering Society},
  source              = {Scopus},
  url                 = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85100276299&doi=10.13465%2fj.cnki.jvs.2021.02.009&partnerID=40&md5=231ca1f99c9b5233e8d2a10325d957e9},
}

@Conference{Davalos2021a,
  author              = {Dávalos, A. and Jabloun, M. and Ravier, P. and Buttelli, O.},
  title = {On the deterministic estimaton of multiscale permutation entropy of high-order autoregressive-moving-average processes as a function of ARMA parameters},
  year                = {2021},
  note                = {cited By 2},
  pages = {2225--2229},
  publisher           = {European Signal Processing Conference, EUSIPCO},
  volume              = {2021-January},
  abbrev_source_title = {European Signal Proces. Conf.},
  abstract            = {Multiscale Permutation Entropy (MPE) is one of the most common techniques to assess the ordinal information content within a time series. In the present paper we propose an explicit, deterministic function of the MPE of a general ARMA process, as a function only of its parameters and time scale. We compare our theoretical results with the MPE of corresponding simulated signals, which further support our formulation. We also present an exploration of the effects of the ARMA parameters on the MPE curve, where we found a monotonic decrease of entropy for long-term time scales, and highly non-linear effects on short scales. With these results, we aim to provide a benchmark for the MPE of any real time series modelled as an ARMA process. © 2021 European Signal Processing Conference, EUSIPCO. All rights reserved.},
  affiliation         = {PRISME Laboratory Université d'Orléans, Orléans, France},
  art_number          = {9287394},
  author_keywords     = {ARMA Process; Coarse-graining; Multiscale Permutation Entropy},
  document_type       = {Conference Paper},
  doi                 = {10.23919/Eusipco47968.2020.9287394},
  groups              = {Conference},
  isbn                = {9789082797053},
  issn                = {22195491},
  journal             = {European Signal Processing Conference},
  keywords            = {Signal processing; Time series, ARMA process; Autoregressive moving average process; Coarse Graining; Deterministics; High-order; Higher-order; Multiscale permutation entropy; Ordinal information; Permutation entropy; Time-scales, Entropy},
  language            = {English},
  source              = {Scopus},
  url                 = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85099319638&doi=10.23919%2fEusipco47968.2020.9287394&partnerID=40&md5=6aa6ae8ecfd8ca8245c8be2e4bf678e9},
}

@Conference{Bielinskyi2021,
  author                  = {Bielinskyi, A.O. and Khvostina, I. and Mamanazarov, A. and Matviychuk, A. and Semerikov, S. and Serdyuk, O. and Solovieva, V. and Soloviev, V.N.},
  title = {Predictors of oil shocks. Econophysical approach in environmental science},
  year                    = {2021},
  note                    = {cited By 17},
  number                  = {1},
  publisher               = {IOP Publishing Ltd},
  volume                  = {628},
  abbrev_source_title = {IOP Conf. Ser. Earth Environ. Sci.},
  abstract                = {The instability of the price dynamics of the energy market from a theoretical point of view indicates the inadequacy of the dominant paradigm of the quantitative description of pricing processes, and from a practical point of view, it leads to abnormal shocks and crashes. A striking example is the COVID-stimulated spring drop of spot prices for crude oil by 305% to $36.73 a barrel. The theory of complex systems with the latest complex networking achievements using pragmatically verified econophysical approaches and models can become the basis of modern environmental science. In this case, it is possible to introduce certain measures of complexity, the change in the dynamics of which makes it possible to identify and prevent characteristic types of critical phenomena. In this paper, the possibility of using some econophysical approaches for quantitative assessment of complexity measures: (1) informational (Lempel-Ziv measure, various types of entropies (Shannon, Approximate, Permutation, Recurrence), (2) fractal and multifractal (Multifractal Detrended Fluctuation Analysis), (3) recurrent (Recurrence Plot and Recurrence Quantification Analysis), (4) Lévy’s stable distribution properties, (5) network (Visual Graph and Recurrence based) and (6) quantum (Heisenberg uncertainty principle) is investigated. Each of them detects patterns that are general for crisis states. We conclude that these measures make it possible to establish that the socially responsive exhibits characteristic patterns of complexity and the proposed measures of complexity allow us to build indicators-precursors of critical and crisis phenomena. Proposed quantitative measures of complexity classified and adapted for the crude oil market. Their behavior in the face of known market shocks and crashes has been analyzed. It has been shown that most of these measures behave characteristically in the periods preceding the critical event. Therefore, it is possible to build indicators-precursors of crisis phenomena in the crude oil market. © 2021 Institute of Physics Publishing. All rights reserved.},
  affiliation             = {Kryvyi Rih State Pedagogical University, 54 Gagarina Ave, Kryvyi Rih, 50086, Ukraine; Ivano-Frankivsk National Technical University of oil and gas, 15 Karpatska St.76019, Ukraine; Tashkent Branch of State University named after M. V. Lomonosov; Kyiv National Economic University named after Vadym Hetman, 54/1 Prospect Peremogy03057, Ukraine; Bohdan Khmelnitsky National University of Cherkasy, 81 Shevchenko Boulevard18000, Ukraine; State University of Economics and Technology, 16 Medychna St., Kryvyi Rih, 50000, Ukraine},
  art_number              = {012019},
  correspondence_address1 = {Khvostina, I.; Ivano-Frankivsk National Technical University of oil and gas, 15 Karpatska St., Ukraine; email: krivogame@gmail.com},
  document_type           = {Conference Paper},
  doi                     = {10.1088/1755-1315/628/1/012019},
  groups                  = {Conference},
  issn                    = {17551307},
  journal                 = {IOP Conference Series: Earth and Environmental Science},
  keywords                = {Commerce; Complex networks; Costs; Fractals; Recurrent neural networks; Sustainable development; Uncertainty analysis, Environmental science; Heisenberg uncertainty principle; Measures of complexity; Multifractal detrended fluctuation analysis; Quantitative assessments; Quantitative description; Quantitative measures; Recurrence quantification analysis, Crude oil price},
