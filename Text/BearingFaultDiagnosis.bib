  groups                  = {Conference},
  isbn                    = {9798350319545},
  issn                    = {10987584},
  journal                 = {IEEE International Conference on Fuzzy Systems},
  keywords                = {Chaos theory; Nonlinear analysis; Sleep research, Complexity; Determination of parameters; Embedding dimensions; Embedding method; Noise robust; Permutation entropy; Robust approaches; Sleep electroencephalogram; Sleep stage; Time-delays, Time delay},
