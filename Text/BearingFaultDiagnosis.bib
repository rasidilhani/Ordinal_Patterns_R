  groups                  = {Journals},
  keywords                = {Data handling; Deep learning; Failure analysis; Fault detection; Gears; Learning systems; Mathematical morphology; Vibrations (mechanical), Data driven; Deep learning; Fault recognition; Faults diagnosis; Gear fault diagnosis; Gear faults; Learning-based methods; Machine-learning; Vibration; Vibration signal, Mode decomposition},
