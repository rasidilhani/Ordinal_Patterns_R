  groups                  = {Journals},
  keywords                = {Cryptography, 2d LASM; Baker maps; Chaotic map; Chaotic sequence; Computing precision; Control methods; Dynamic degradation; Ergodicity; Logistic maps; Pseudorandom sequences, Chaotic systems},
  language                = {English},
  publisher               = {Springer Science and Business Media Deutschland GmbH},
  source                  = {Scopus},
