  author_keywords         = {Electroencephalography; Schizophrenia; Support vector machine; Wavelet transform},
  correspondence_address1 = {Huang, M.-W.; Department of Physical Therapy, No. 91, Xueshi Rd., North Dist., Taiwan; email: hminwei@gmail.com},
