  document_type           = {Article},
  doi                     = {10.3390/e24070853},
  groups                  = {Journals},
  language                = {English},
  publisher               = {MDPI},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85133187344&doi=10.3390%2fe24070853&partnerID=40&md5=0ebda1240d59dfb81b007e66edf906e1},
