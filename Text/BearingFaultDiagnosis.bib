  groups              = {Conference},
  isbn                = {9781728169477},
  journal             = {2020 9th Mediterranean Conference on Embedded Computing, MECO 2020},
  keywords            = {Data streams; Embedded systems; Information filtering; Weather forecasting, Business case; Cyber physical systems (CPSs); Fast growths; Filtering technique; High-resolution weather forecasts; Initial development, Data Analytics},
  language            = {English},
  source              = {Scopus},
  url                 = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85088533173&doi=10.1109%2fMECO49872.2020.9134351&partnerID=40&md5=eced7680cfd7f770e2501632085f42bd},
