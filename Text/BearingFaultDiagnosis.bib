@Article{Tan2022,
  author                  = {Tan, G. and Wang, J. and Liu, J. and Sheng, Y. and Xie, Q. and Liu, H.},
  journal                 = {Journal of Neural Engineering},
  title = {A framework for quantifying the effects of transcranial magnetic stimulation on motor recovery from hemiparesis: Corticomuscular network},
  year                    = {2022},
  issn                    = {17412560},
  note                    = {cited By 7},
  number                  = {2},
  volume                  = {19},
  abbrev_source_title = {J. Neural Eng.},
  abstract                = {Objective. Transcranial magnetic stimulation (TMS) is an experimental therapy for promoting motor recovery from hemiparesis. At present, hemiparesis patients' responses to TMS are variable. To maximize its therapeutic potential, we need an approach that relates the electrophysiology of motor recovery and TMS. To this end, we propose corticomuscular network (CMN) representing the holistic motor system, including the cortico-cortical pathway, corticospinal tract, and muscle co-activation. Approach. CMN is made up of coherence between pairs of electrode signals and spatial locations of the electrodes. We associated coherence and graph features of CMN with Fugl-Meyer Assessment (FMA) for the upper extremity. Besides, we compared CMN between 8 patients with hemiparesis and 6 healthy controls and contrasted CMN of patients before and after a 1 Hz TMS. Main results. Corticomuscular coherence (CMC) correlated positively with FMA. The regression model between FMA and CMC between five pairs of channels had 0.99 adjusted and a p-value less than 0.01. Compared to healthy controls, CMN of patients tended to be a small-world network and was more interconnected with higher CMC. CMC between cortex and triceps brachii long head was higher in patients. 15 min 1 Hz TMS protocol induced coherence changes beyond the stimulation side and had a limited impact on CMN parameters that are related to motor recovery. Significance. CMN is a potential clinical approach to quantify rehabilitating progress. It also sheds light on the desirable electrophysiological effects of TMS based on which rehabilitating strategies can be optimized. © 2022 IOP Publishing Ltd.},
  affiliation             = {State Key Laboratory of Mechanical System and Vibration, School of Mechanical Engineering, Shanghai Jiao Tong University, Shanghai, China; Department of Biomedical Engineering, Washington University in St. Louis, St Louis, MO, United States; Department of Rehabilitation Medicine, Ruijin Hospital, Shanghai Jiao Tong University, School of Medicine, Shanghai, China; Clinical Neuroscience Center, Ruijin Hospital, Shanghai Jiao Tong University, School of Medicine, Shanghai, China; State Key Laboratory of Robotics and System, School of Mechanical Engineering and Automation, Harbin Institute of Technology, Shenzhen, China},
  art_number              = {026053},
  author_keywords         = {electroencephalogram; electromyography; graph theory; hemiparesis; transcranial magnetic stimulation},
  coden                   = {JNEOB},
  correspondence_address1 = {Liu, H.; State Key Laboratory of Robotics and System, China; email: honghai.liu@icloud.com},
  document_type           = {Article},
  doi                     = {10.1088/1741-2552/ac636b},
  groups                  = {Journals},
  keywords                = {Computer system recovery; Electrodes; Electroencephalography; Electrophysiology; Functional electric stimulation; Magnetism; Recovery; Regression analysis; Small-world networks, Cortico-muscular coherences; Corticospinal tracts; Fugl-meyer assessments; Healthy controls; Hemiparesis; Motor recovery; Motor systems; Patient response; Therapeutic potentials; Transcranial magnetic stimulation, Graph theory, adult; aged; Article; clinical article; clinical outcome; controlled study; electrophysiology; female; Fugl-Meyer Assessment for Upper Extremity; hand grip; hemiparesis; human; male; middle aged; motor performance; motor system; muscle contraction; muscle isometric contraction; nerve cell network; occipital lobe; outcome assessment; pyramidal tract; quantitative analysis; scalp; somatosensory cortex; stroke patient; stroke rehabilitation; transcranial magnetic stimulation; upper limb; electromyography; motor cortex; paresis; physiology; procedures, Electromyography; Humans; Motor Cortex; Paresis; Pyramidal Tracts; Transcranial Magnetic Stimulation},
  language                = {English},
