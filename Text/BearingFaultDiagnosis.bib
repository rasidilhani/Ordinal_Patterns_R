  correspondence_address1 = {Stosic, B.; Departamento de Estatística e Informática, Rua Dom Manoel de Medeiros s/n, Dois Irmãos, PE, Brazil; email: Borkostosic@gmail.com},
  document_type           = {Article},
  doi                     = {10.1016/j.physa.2024.129548},
  groups                  = {Journals},
  keywords                = {Deforestation; Entropy; Fire hazards; Fires; Pixels; Time series analysis, Anthropogenics; Brazilian biomes; Entropy analysis; Generalized weighted permutation entropy; Hot pixels; Permutation entropy; Satellite data; Satellite hot-pixel; Small fluctuation; Times series, Satellites},
  language                = {English},
