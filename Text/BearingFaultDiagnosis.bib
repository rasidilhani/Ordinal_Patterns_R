  document_type           = {Article},
  doi                     = {10.1177/1077546320916628},
  groups                  = {Journals},
  keywords                = {Failure analysis; Fault detection; Feature extraction; Pantographs; Particle swarm optimization (PSO); Support vector machines; Vibration analysis, Approximate entropy; Effective measures; Ensemble empirical mode decomposition; Information entropy; Intrinsic Mode functions; Measurement points; Multiple features; Particle swarm optimization algorithm, Signal processing},
  language                = {English},
  publisher               = {SAGE Publications Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85082316294&doi=10.1177%2f1077546320916628&partnerID=40&md5=9b15368df7d36059f11d693aac2da945},
}

@Article{Yang2020,
  author                  = {Yang, G. and Xu, D. and Zhang, H.},
  journal                 = {International Journal of Computational Methods},
  title = {Catastrophe Pre-Warning of Multi-Modular Floating Platforms with Ordinal Partition Networks},
  year                    = {2020},
  issn                    = {02198762},
  note                    = {cited By 8},
  number                  = {10},
  volume                  = {17},
  abbrev_source_title = {Int. J. Comput. Methods},
  abstract                = {Use of artificial networks to signify the onset of dynamic catastrophes in engineering systems is a simple and efficient strategy. Here an ordinal partition network and its construction from time series are introduced. The selection of mapping parameter is discussed in detail, which may significantly enhance the performance of the proposed method. Topological properties of the resulting network can sensitively detect the dynamic changes of original underlying systems, making the strategy workable. A Catastrophe Prediction Index (CPI) is proposed to serve as a monitoring indicator for pre-warning catastrophe events. The numerical results verify the feasibility of the proposed method. © 2020 World Scientific Publishing Company.},
  affiliation             = {State Key Laboratory of Advanced Design and Manufacturing for Vehicle Body, Hunan University, Changsha, 410082, China},
  art_number              = {2050010},
  author_keywords         = {Catastrophe; complex networks; floating platform; pre-warning; symbolic sequence},
