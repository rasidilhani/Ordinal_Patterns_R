  isbn                    = {9789811673801},
  keywords                = {Entropy; Roller bearings, Bearing performance; Composite multi-scale slope entropy; Multi-scales; Noise interference; Performance state assessment; Performance States; Principal-component analysis; Rolling bearings; State assessment; Sudden change, Principal component analysis},
  language                = {English},
