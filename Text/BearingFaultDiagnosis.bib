  groups                  = {Journals},
  keywords                = {Condition monitoring; Epicyclic gears, Computation efficiency; Dynamical complexity; Entropy-based methods; Failure prevention; Feature representation; Multi scale analysis; Planetary gearboxes; Safety operations, Time series analysis},
  language                = {English},
  publisher               = {IEEE Computer Society},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85107236730&doi=10.1109%2fTII.2021.3082517&partnerID=40&md5=12e0f00a9f6dd59f3aa53cf7191109cb},
}

@Article{Ramaswamy2022,
  author                  = {Ramaswamy, S.M. and Kuizenga, M.H. and Weerink, M.A.S. and Vereecke, H.E.M. and Struys, M.M.R.F. and Belur Nagaraj, S.},
  journal                 = {Journal of Clinical Monitoring and Computing},
  title = {Frontal electroencephalogram based drug, sex, and age independent sedation level prediction using non-linear machine learning algorithms},
  year                    = {2022},
  issn                    = {13871307},
  note                    = {cited By 3},
  number                  = {1},
  pages = {121--130},
  volume                  = {36},
  abbrev_source_title = {J. Clin. Monit. Comput.},
  abstract                = {Brain monitors which track quantitative electroencephalogram (EEG) signatures to monitor sedation levels are drug and patient specific. There is a need for robust sedation level monitoring systems to accurately track sedation levels across all drug classes, sex and age groups. Forty-four quantitative features estimated from a pooled dataset of 204 EEG recordings from 66 healthy adult volunteers who received either propofol, dexmedetomidine, or sevoflurane (all with and without remifentanil) were used in a machine learning based automated system to estimate the depth of sedation. Model training and evaluation were performed using leave-one-out cross validation methodology. We trained four machine learning models to predict sedation levels and evaluated the influence of remifentanil, age, and sex on the prediction performance. The area under the receiver-operator characteristic curve (AUC) was used to assess the performance of the prediction model. The ensemble tree with bagging outperformed other machine learning models and predicted sedation levels with an AUC = 0.88 (0.81–0.90). There were significant differences in the prediction probability of the automated systems when trained and tested across different age groups and sex. The performance of the EEG based sedation level prediction system is drug, sex, and age specific. Nonlinear machine-learning models using quantitative EEG features can accurately predict sedation levels. The results obtained in this study may provide a useful reference for developing next generation EEG based sedation level prediction systems using advanced machine learning algorithms. Clinical trial registration: NCT 02043938 and NCT 03143972. © 2020, The Author(s).},
  affiliation             = {Department of Anaesthesiology, University of Groningen, University Medical Center Groningen, Groningen, Netherlands; Department of Clinical Pharmacy & Pharmacology, University of Groningen, University Medical Center Groningen, Groningen, Netherlands; Department of Anaesthesiology and Reanimation, AZ St.-Jan Brugge Oostende AV, Brugge, Belgium; Department of Basic and Applied Medical Sciences, Ghent University, Ghent, Belgium},
  author_keywords         = {Anaesthesia; Consciousness Monitors; Electroencephalogram; Machine learning; Medical informatics},
  coden                   = {JCMCF},
  correspondence_address1 = {Ramaswamy, S.M.; Department of Anaesthesiology, Netherlands; email: s.muchukunte.ramaswamy@umcg.nl},
