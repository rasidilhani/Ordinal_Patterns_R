@Article{Kowalski2010,
  author            = {Kowalski, A.M. and Martin, M.T. and Plastino, A. and Zunino, L.},
  journal           = {Physics Letters, Section A: General, Atomic and Solid State Physics},
  title = {Information flow during the quantum-classical transition},
