  document_type           = {Article},
  doi                     = {10.1007/s11071-021-06276-8},
  groups                  = {Journals},
  keywords                = {Bifurcation (mathematics); Chaotic systems; Timing circuits, Basin of attraction; Bifurcation parameter; Circuit implementation; Circuit realization; Co-existing attractors; Dynamical behaviors; Engineering applications; New chaotic systems, Electric network analysis},
  language                = {English},
