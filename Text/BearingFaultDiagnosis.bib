  title = {Features Extraction on Independent Component Analysis Computed on Interictal Magnetoencephalography to Characterize Epileptic Sources},
  year                    = {2023},
  note                    = {cited By 0},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {Int. Conf. Image Process. Theory, Tools Appl., IPTA},
  abstract                = {For pharmacoresistant patients in epilepsy one solution is to resect the brain area responsible for seizures, the epileptogenic zone (EZ). To define the location and the extension of the EZ, several neurophysiological techniques can be used, either non-invasive (magnetoencephalography, MEG, or electroencephalography, EEG) or invasive (stereoencephalography, SEEG). In particular, MEG has been shown to be a useful tool in presurgical diagnosis, but it allows almost only recording of interictal abnormalities which can bear complex relations to the EZ.We propose here a new approach based on the extraction of features from independent component analysis (ICA) computed on the MEG signals in 7 subjects. For each subject we computed 100 ICs on continuous MEG data. These components were labelled by an expert as epileptic or non-epileptic. We test whether different features could individually discriminate the epileptic components from other non-epileptic signals.We show in this preliminary study that some features were significantly separating epileptic from non-epileptic components. But we observed a strong inter-patient variability in feature performance. In particular, automatic extraction of spikes proved to be a difficult issue. © 2023 IEEE.},
  affiliation             = {Aix Marseille Université, Ins, Marseille, France; Aphm, Timone Hospital Epileptology and Cerebral Rhythmology, Marseille, France; Aix Marseille Université, INSERM, Ins, Marseille, France; Aix Marseille Université, CNRS, Centrale Marseille, I2M, Marseille, France},
  author_keywords         = {epilepsy; features extraction; ICA; MEG},
  correspondence_address1 = {Semeux-Bernier, A.; Aix Marseille Université, France; email: aurore.semeux-bernier@univ-amu.fr},
