  keywords                = {Classification (of information); Clustering algorithms; Entropy; Finance; Financial data processing; Nearest neighbor search; Time series, Adaptive noise; Classification methods; Complete ensemble empirical mode decomposition with adaptive noise; Empirical Mode Decomposition; Financial time series; Frequency information; Low-frequency approximate representation; Lower frequencies; Permutation entropy; Time series classifications, Empirical mode decomposition},
  language                = {English},
