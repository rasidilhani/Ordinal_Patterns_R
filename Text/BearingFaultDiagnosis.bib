  groups                  = {Journals},
  keywords                = {Complex networks; Network layers; Network security; Optical communication; Time delay, Additional chaotic phase-shift; Chaotic communication systems; Chaotic secure communications; Chaotic signal; Chaotics; Electro-optical; High complexity; High complexity chaos; Time delayed; Time-delay signature concealments, Timing circuits},
