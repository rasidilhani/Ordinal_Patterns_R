  journal                 = {IEEE Transactions on Neural Networks and Learning Systems},
  title = {Cumulative Permuted Fractional Entropy and its Applications},
  year                    = {2021},
  issn                    = {2162237X},
  note                    = {cited By 8},
  number                  = {11},
  pages = {4946--4955},
  volume                  = {32},
  abbrev_source_title = {IEEE Trans. Neural Networks Learn. Sys.},
  abstract                = {Fractional calculus and entropy are two essential mathematical tools, and their conceptions support a productive interplay in the study of system dynamics and machine learning. In this article, we modify the fractional entropy and propose the cumulative permuted fractional entropy (CPFE). A theoretical analysis is provided to prove that CPFE not only meets the basic properties of the Shannon entropy but also has unique characteristics of its own. We apply it to typical discrete distributions, simulated data, and real-world data to prove its efficiency in the application. This article demonstrates that CPFE can measure the complexity and uncertainty of complex systems so that it can perform reliable and accurate classification. Finally, we introduce CPFE to support vector machines (SVMs) and get CPFE-SVM. The CPFE can be used to process data to make the irregular data linearly separable. Compared with the other five state-of-the-art algorithms, CPFE-SVM has significantly higher accuracy and less computational burden. Therefore, the CPFE-SVM is especially suitable for the classification of irregular large-scale data sets. Also, it is insensitive to noise. Implications of the results and future research directions are also presented. © 2012 IEEE.},
  affiliation             = {Department of Mathematics, School of Science, Beijing Jiaotong University, Beijing, 100044, China},
  author_keywords         = {Complex system; entropy; fractional calculus; support vector machine (SVM)},
  correspondence_address1 = {Zhang, B.; Department of Mathematics, China; email: 19118020@bjtu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1109/TNNLS.2020.3026424},
  groups                  = {Journals},
  keywords                = {Calculations; Classification (of information), Computational burden; Discrete distribution; Fractional calculus; Future research directions; Large scale data sets; Linearly separable; Mathematical tools; Support vector machine (SVMs), Support vector machines, article; entropy; noise; simulation; support vector machine; uncertainty},
  language                = {English},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  pubmed_id               = {33021947},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85092942759&doi=10.1109%2fTNNLS.2020.3026424&partnerID=40&md5=f6fc58a8771ef2c3a1b16e844d2f8a69},
}

