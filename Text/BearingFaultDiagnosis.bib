  document_type           = {Article},
  doi                     = {10.1016/j.fuel.2021.122348},
  groups                  = {Journals},
  keywords                = {Embeddings; Entropy; Life cycle; Parameter estimation; Principal component analysis, Early fault; Early fault identification; Embedding algorithms; Fault identifications; Local Linear Embedding; Multi-scale weighted permutation entropy; Multi-scales; Permutation entropy; State degradation; Wind turbine bearing, Wind turbines},
  language                = {English},
  publisher               = {Elsevier Ltd},
  source                  = {Scopus},
