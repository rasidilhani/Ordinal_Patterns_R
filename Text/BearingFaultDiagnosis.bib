  groups                  = {Journals},
  keywords                = {Costs; Crude oil; Efficiency; K-means clustering; Potash; Potassium chloride, Commodity; Commodity prices; Complexity; Economic efficiency; Fisher information measures; Permutation entropy; Price time series; Shannon; Spot and futures prices; Times series, Time series, commodity; commodity market; complexity; prediction; time series analysis},
  language                = {English},
