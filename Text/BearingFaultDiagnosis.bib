  groups                  = {Journals},
  keywords                = {Chaotic systems; Optoelectronic devices; Time delay; Timing circuits, Autocorrelation functions; Chaotic outputs; Feedback strength; Optical feedback loop; Optimized parameter; Opto-electronic oscillator; Optoelectronic feedback; Permutation entropy, Optical feedback},
  language                = {English},
