}

@Article{Peng2021c,
  author                  = {Peng, Y. and He, S. and Sun, K.},
  journal                 = {Results in Physics},
  title = {Chaos in the discrete memristor-based system with fractional-order difference},
  year                    = {2021},
  issn                    = {22113797},
