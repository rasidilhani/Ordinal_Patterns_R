  groups                  = {Journals},
  keywords                = {Backpropagation; Entropy; Extraction; Failure (mechanical); Failure analysis; Feature extraction; Hoists; Roller bearings; Signal processing; Vibration analysis, BP (back-propagation) network; Empirical Mode Decomposition; Fault feature extractions; Mechanical equipment; Non-stationary vibration signals; Rotor-bearing system; Statistical characteristics; Statistical features, Fault detection},
