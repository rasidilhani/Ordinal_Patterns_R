  groups                  = {Journals},
  keywords                = {Empirical mode decomposition; Image coding; Image segmentation; Image thinning; Modal analysis; Signal denoising; Signal to noise ratio; Variational mode decomposition; Wavelet decomposition, Coordinate time series; De-noising; GNSS coordinate time series; Gray wolf optimization algorithm; Gray wolves; Modal decomposition; Mutual informations; Optimization algorithms; Permutation entropy; Sample entropy; Variational modal decomposition, Mean square error, algorithm; decomposition analysis; GNSS; signal processing; signal-to-noise ratio; time series analysis, China},
  language                = {Chinese},
