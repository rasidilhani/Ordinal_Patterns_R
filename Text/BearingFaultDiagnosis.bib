  correspondence_address1 = {Ding, Q.; Electrical Engineering College, China; email: qunding@aliyun.com},
  document_type           = {Article},
  doi                     = {10.1007/s11071-019-05015-4},
  groups                  = {Journals},
  keywords                = {Chaotic systems; Digital computers; Learning algorithms; Lyapunov methods, Chaotic map; Computational devices; Degree of degradation; Engineering applications; Finite precision; Functional graphs; Limit-cycle; Tree structures, Trees (mathematics)},
  language                = {English},
  publisher               = {Springer Netherlands},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85066906984&doi=10.1007%2fs11071-019-05015-4&partnerID=40&md5=715b48659250c9e76a70c1057979c408},
}

@Article{Gutjahr2019,
