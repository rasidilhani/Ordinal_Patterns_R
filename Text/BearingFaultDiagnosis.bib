  groups                  = {Journals},
  keywords                = {Commerce; Dispersions; Financial markets; Fisher information matrix, Complex dynamic systems; Dispersion entropy; Financial stock market; Fisher information measures; Fisher-disen plane; Times series, Entropy},
  language                = {English},
  publisher               = {Elsevier B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85083320497&doi=10.1016%2fj.cnsns.2020.105271&partnerID=40&md5=1ac88a3fb2fcc2ae89d61630ce6482d3},
