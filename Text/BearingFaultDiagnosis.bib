  groups                  = {Journals},
  keywords                = {Economic analysis; Functions; Information theory; Time series analysis, Economic efficiency; Economic growths; First derivative; Gross domestic products; Macroeconophysic; Mathematical functions; Paper analysis; Second derivatives; Shannon–fisher causality plane; Times series, Efficiency},
