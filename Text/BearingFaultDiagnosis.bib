  document_type           = {Article},
  doi                     = {10.1063/1.5121257},
  groups                  = {Journals},
  keywords                = {animal; biological model; computer simulation; human; metabolism; nerve cell; synapse; synaptic transmission, Animals; Computer Simulation; Humans; Models, Neurological; Neurons; Synapses; Synaptic Transmission},
  language                = {English},
  publisher               = {American Institute of Physics Inc.},
