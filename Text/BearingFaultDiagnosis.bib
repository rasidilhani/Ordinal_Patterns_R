  language                = {English},
  publisher               = {Elsevier Ltd},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85166339129&doi=10.1016%2fj.envsoft.2023.105780&partnerID=40&md5=0ef944239ac6f7ec89c479b4a18586d8},
