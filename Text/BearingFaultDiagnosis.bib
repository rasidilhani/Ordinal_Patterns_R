@Article{Sayyari2023,
  author                  = {Sayyari, Y. and Molaei, M.R. and Mehrpooya, A.},
  journal                 = {Journal of Applied Statistics},
  title = {Complexities of information sources},
  year                    = {2023},
  issn                    = {02664763},
