  year                    = {2020},
  issn                    = {08883270},
  note                    = {cited By 76},
  volume                  = {138},
  abbrev_source_title = {Mech Syst Signal Process},
  abstract                = {Online health monitoring of railway vehicle suspension systems is of critical importance to guarantee train running safety. The currently reported works on vehicle suspension health monitoring mainly adopt model-based approaches. However, detailed parameters of the vehicle suspension systems, usually, are complicated to be acquired. Moreover, an accurate model cannot be easily obtained due to the nonlinearities of vehicle components and the complexity of suspension systems. Considering the limitations of the model-based approaches, a data-driven method, which combines multiscale permutation entropy and linear local tangent space alignment (MPE-LLTSA), is proposed to diagnose the faults of vehicle suspension systems. To demonstrate the effectiveness and advantages of this method, an MBS model of the China CRH3 train is built to generate the bogie frame's lateral acceleration containing various secondary suspension faults, and the simulated signals are then introduced to evaluate the MPE-LLTSA method. The evaluation results show that the proposed data-driven approach can accurately identify different types of suspension faults. Finally, the MPE-LLTSA method is further validated using the tracking data of the CRH3 train running on a high-speed railway line in China, and the test results show that the proposed method has the potential to be applied to the field of railway engineering. © 2019 Elsevier Ltd},
  affiliation             = {Institute of Land and Sea Transport Systems, Technical University of Berlin, Berlin, 10587, Germany; School of Mechanical Engineering, Southwest Jiaotong University, Chengdu, 610031, China; School of Transportation and Logistics, Southwest Jiaotong University, Chengdu, 610031, China; State Key Laboratory of Traction Power, Southwest Jiaotong University, Chengdu, 610031, China; Saarland University, SaarBrücken, 66125, Germany; Beijing Municipal Institute of Labour Protection, Beijing, 100054, China},
  art_number              = {106565},
  author_keywords         = {Fault diagnosis; High-speed train; Linear local tangent space alignment; Multiscale permutation entropy; Suspension systems},
  coden                   = {MSSPE},
  correspondence_address1 = {Ye, Y.; Institute of Land and Sea Transport Systems, Germany; email: yunguang.ye@campus.tu-berlin.de},
  document_type           = {Article},
  doi                     = {10.1016/j.ymssp.2019.106565},
  groups                  = {Journals},
  keywords                = {Alignment; Automobile suspensions; Bogies (railroad rolling stock); Entropy; Failure analysis; Fault detection; Ground vehicle parts and equipment; Online systems; Railroad cars; Railroad transportation; Railroads, High speed railway lines; High speed train (HST); Local tangent space alignment; On-line health monitoring; Permutation entropy; Railway vehicle suspensions; Suspension system; Vehicle suspension systems, Suspensions (components)},
  language                = {English},
  publisher               = {Academic Press},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85076732742&doi=10.1016%2fj.ymssp.2019.106565&partnerID=40&md5=4074da8b9d2ce6b629340380bf43eb7e},
}

@Article{Chen2020e,
