  art_number              = {236},
  correspondence_address1 = {Garrett, D.D.; Max Planck UCL Centre for Computational Psychiatry and Ageing Research, Germany; email: garrett@mpib-berlin.mpg.de},
  document_type           = {Article},
  doi                     = {10.1038/s41467-024-55406-4},
  groups                  = {Journals},
  keywords                = {building stone; memory; neurology; sensory system; visual cue, adult; article; computer model; controlled study; hippocampus; human; memory; nerve cell; therapy; action potential; biological model; computer simulation; cytology; female; male; physiology; young adult, Action Potentials; Adult; Computer Simulation; Female; Hippocampus; Humans; Male; Memory; Models, Neurological; Neurons; Young Adult},
  language                = {English},
