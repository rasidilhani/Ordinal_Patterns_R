}

@Article{Schiepek2010,
  author            = {Schiepek, Günter and Strunk, Guido},
  journal           = {Biological Cybernetics},
  title = {The identification of critical fluctuations and phase transitions in short term and coarse-grained time series-a method for the real-time monitoring of human change processes},
  year              = {2010},
  note              = {Cited by: 93},
  number            = {3},
  pages             = {197 – 207},
  volume            = {102},
  abstract          = {We introduce two complementary measures for the identification of critical instabilities and fluctuations in natural time series: the degree of fluctuations F and the distribution parameter D. Both are valid measures even of short and coarse-grained data sets, as demonstrated by artificial data from the logistic map (Feigenbaum-Scenario). A comparison is made with the application of the positive Lyapunov exponent to time series and another recently developed complexity measure-the Permutation Entropy. The results justify the application of the measures within computer-based real-time monitoring systems of human change processes. Results from process-outcome research in psychotherapy and functional neuroimaging of psychotherapy processes are provided as examples for the practical and scientific applications of the proposed measures. © 2010 Springer-Verlag.},
  doi               = {10.1007/s00422-009-0362-1},
