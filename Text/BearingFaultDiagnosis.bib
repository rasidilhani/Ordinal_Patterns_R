  journal                 = {IEEE Access},
  title = {Dynamic Muscle Fatigue State Recognition Based on Deep Learning Fusion Model},
  year                    = {2023},
  issn                    = {21693536},
  note                    = {cited By 4},
  pages = {95079--95091},
  volume                  = {11},
  abbrev_source_title = {IEEE Access},
  abstract                = {The timely and accurate recognition of dynamic muscle fatigued states in rehabilitation training helped in tailoring more scientifically effective training plans for patients. In this study, a CNN-LSTM-Transformer (CLT) model based on surface electromyographic signals (sEMG) was proposed to address the limited classification and low identification accuracy observed in existing muscle fatigued state recognition methods. This model combined the traditional convolutional neural network (CNN), long short-term memory network (LSTM), and Transformer encoder to achieve accurate classification of dynamic muscle fatigued. First, elbow flexion-extension fatigued experiments were conducted on 20 healthy participants, who were divided into four fatigued states based on the degree of fatigued. Subsequently, the acquired sEMG signal data was preprocessed and two nonlinear features, approximate entropy (ApEn) and permutation entropy (PE), were extracted as input features for machine learning. Finally, a CLT fatigued recognition model was constructed using the preprocessed sEMG signal data and compared with CNN, LSTM, and random forest (RF) models. The results showed that the CLT model had higher accuracy in recognizing muscle fatigued states compared to CNN, LSTM, and RF models, with a respective increase of 4.1%, 5.06%, and 8.39%. This model had good classification performance and could be used to monitor muscle fatigued during upper limb rehabilitation processes. © 2013 IEEE.},
  affiliation             = {Xinjiang University, School of Mechanical Engineering, Ürümqi, 830017, China},
  author_keywords         = {convolutional neural network; dynamic muscle fatigued; long short-term memory; Surface electromyography signals; transformer encoder},
  correspondence_address1 = {Tao, Q.; Xinjiang University, China; email: xjutao@qq.com},
  document_type           = {Article},
  doi                     = {10.1109/ACCESS.2023.3309741},
  groups                  = {Journals},
  keywords                = {Biomedical signal processing; Brain; Convolution; Electromyography; Entropy; Feature extraction; Forestry; Long short-term memory; Patient rehabilitation; State estimation, Convolutional neural network; Dynamic muscle fatigued; Encodings; Features extraction; Memory network; Support vectors machine; Surface electromyography signals; Transformer; Transformer encoder, Muscle},
  language                = {English},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85169662486&doi=10.1109%2fACCESS.2023.3309741&partnerID=40&md5=1325f0b065ebcaefebdaa46dc56f3c0c},
}

@Conference{Jabloun2023,
  author                  = {Jabloun, M. and Ravier, P. and Buttelli, O.},
  title = {Improving of the interpretation of linear filtering preprocessing-based multiscale permutation entropy},
  year                    = {2023},
  note                    = {cited By 1},
  pages = {190--194},
  publisher               = {IEEE Computer Society},
  volume                  = {2023-July},
  abbrev_source_title = {IEEE Workshop Stat. Signal Process. Proc.},
  abstract                = {Multi-scale permutation entropy (MPE) is an interesting tool for analyzing signal internal structures and quantifying complexity. The most commonly used MPEs involve a linear preprocessing step applied to the original signal prior to the evaluation of the permutation entropy (PE). However, recent research done by Davalos et al has demonstrated that linear filtering preprocessing significantly modifies the PE of Gaussian processes.To build on this work, we conducted a study to investigate the MPE's behavior across a variety of signal generation models including sinusoidal signals, frequency modulated signals, and colored Gaussian noise. Our findings indicate that the MPE mainly reflects changes in the center frequency of the signal spectrum, independent of signal generation models. It's important to note that the linear preprocessing step used in MPE calculations can lead to misinterpretation of the results. Therefore, we suggest that a proper interpretation of the MPE values should be done in conjunction with a spectral analysis or a time-frequency representation. © 2023 IEEE.},
  affiliation             = {Orleans University-PRISME Laboratory, France},
  author_keywords         = {linear filtering preprocessing; Multi-scale permutation entropy; signal complexity},
  coden                   = {IWSSB},
  correspondence_address1 = {Jabloun, M.; Orleans University-PRISME LaboratoryFrance; email: meryem.jabloun@univ-Orleans.fr},
  document_type           = {Conference Paper},
  doi                     = {10.1109/SSP53291.2023.10208030},
  groups                  = {Conference},
  isbn                    = {9781665452458},
  journal                 = {IEEE Workshop on Statistical Signal Processing Proceedings},
  keywords                = {Entropy; Gaussian distribution; Gaussian noise (electronic); Signal generators, Internal structure; Linear filtering; Linear filtering preprocessing; Multi-scale permutation entropy; Multi-scales; Original signal; Permutation entropy; Pre-processing step; Signal complexity; Signal generation, Spectrum analysis},
  language                = {English},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85168904767&doi=10.1109%2fSSP53291.2023.10208030&partnerID=40&md5=8a6dbb3ef591aa2ef15e6ca93dd2e933},
}

@Conference{Sabatini2023,
  author                  = {Sabatini, A. and Bacco, L. and Lotini, L. and Palombo, G. and Tomaso, G.D. and Sabbadini, R. and Merone, M. and Vollero, L.},
  title = {Photoplethysmographic Signal Quality Assessment: a Comparative Study of Unsupervised and Supervised Neural Networks},
  year                    = {2023},
  note                    = {cited By 1},
  pages = {159--164},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {IEEE Int. Workshop Metrol. Ind. 4.0 IoT, MetroInd4.0 IoT - Proc.},
  abstract                = {We present algorithms to discriminate good quality PPG signals, i.e., free of artefacts and with suitable morphologies, which is fundamental for a correct medical diagnosis. We have investigated two different approaches of unsupervised and supervised learning. The first method is a Self Organizing Map (SOM), trained on entropic and morphological features extracted by BUT PPG signal windows. We then add three new features related to signal quality, namely the Kurtosis Index, Skewness Index and Signal to Noise Ratio (SNR), that we have shown to improve the performances. For the second approach, we have implemented a Multi Layer Perceptron (MLP) neural network. We have compared the results obtained with those in the literature showing superior performance, especially with the MLP approach, achieving an F_1 -score of 96.15%. © 2023 IEEE.},
  affiliation             = {University Campus Bio-Medico of Rome, Research Unit of Computer Systems and Bioinformatics, Department of Engineering, Via Alvaro del Portillo, Rome, 21 - 00128, Italy; IASI-CNR (National Research Council of Italy), Istituto di Analisi Dei Sistemi Ed Informatica 'A. Ruberti', Via dei Taurini, Rome, 19, 00185, Italy; Heremos Srl, Vicolo Mazzarino 14, Rome, 00184, Italy},
  author_keywords         = {Neural Networks; Photoplethysmography; Quality Assessment; Self Organizing Map; Signal Processing},
  correspondence_address1 = {Bacco, L.; University Campus Bio-Medico of Rome, Via Alvaro del Portillo, Italy; email: l.bacco@unicampus.it},
  document_type           = {Conference Paper},
  doi                     = {10.1109/MetroInd4.0IoT57462.2023.10180134},
  groups                  = {Conference},
  isbn                    = {9798350396577},
  journal                 = {2023 IEEE International Workshop on Metrology for Industry 4.0 and IoT, MetroInd4.0 and IoT 2023 - Proceedings},
  keywords                = {Biomedical signal processing; Conformal mapping; Higher order statistics; Photoplethysmography; Signal to noise ratio, Comparatives studies; Neural-networks; Performance; Photoplethysmographic signals; Quality assessment; Self-organizing-maps; Signal quality assessment; Signal-processing; Supervised neural networks; Unsupervised neural networks, Self organizing maps},
  language                = {English},
