@Article{Pessa2022,
  author                  = {Pessa, A.A.B. and Zola, R.S. and Perc, M. and Ribeiro, H.V.},
  journal                 = {Chaos, Solitons and Fractals},
  title = {Determining liquid crystal properties with ordinal networks and machine learning},
  year                    = {2022},
  issn                    = {09600779},
  note                    = {cited By 28},
  volume                  = {154},
  abbrev_source_title = {Chaos Solitons Fractals},
  abstract                = {Machine learning methods are becoming increasingly important for the development of materials science. In spite of this, the use of image analysis in the development of these systems is still recent and underexplored, especially in materials often studied via optical imaging techniques such as liquid crystals. Here we apply the recently proposed method of ordinal networks to map optical textures obtained from experimental samples of liquid crystals into complex networks and use this representation jointly with a simple statistical learning algorithm to investigate different physical properties of these materials. Our research demonstrates that ordinal networks formed by only 24 nodes encode crucial information about liquid crystal properties, thus allowing us to train simple machine learning models capable of identifying and classifying mesophase transitions, distinguishing among different doping concentrations used to induce chiral mesophases, and predicting sample temperatures with outstanding accuracy. The precision and scalability of our approach indicate it can be used to probe properties of different materials in situations involving large-scale datasets or real-time monitoring systems. © 2021 Elsevier Ltd},
  affiliation             = {Departamento de Física, Universidade Estadual de Maringá - MaringáPR 87020-900, Brazil; Departamento de Física, Universidade Tecnológica Federal do Paraná, Apucarana, PR 86812-460, Brazil; Faculty of Natural Sciences and Mathematics, University of Maribor, Koroška cesta 160, Maribor, 2000, Slovenia; Department of Medical Research, China Medical University Hospital, China Medical University, Taichung, Taiwan; Alma Mater Europaea, Slovenska ulica 17, Maribor, 2000, Slovenia; Complexity Science Hub Vienna, Josefstädterstraße 39, Vienna, 1080, Austria},
  art_number              = {111607},
  coden                   = {CSFOE},
  correspondence_address1 = {Perc, M.; Faculty of Natural Sciences and Mathematics, Koroška cesta 160, Slovenia; email: matjaz.perc@um.si},
  document_type           = {Article},
  doi                     = {10.1016/j.chaos.2021.111607},
  groups                  = {Journals},
  keywords                = {Classification (of information); Complex networks; Doping (additives); Large dataset; Learning algorithms; Machine learning; Real time systems; Textures, Crystal properties; Liquid-crystals; Machine learning methods; Machine learning models; Material science; Mesophase transition; Optical imaging technique; Optical texture; Simple++; Statistical learning, Liquid crystals},
  language                = {English},
  publisher               = {Elsevier Ltd},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85122518587&doi=10.1016%2fj.chaos.2021.111607&partnerID=40&md5=7013fa4b94a55e6727decb3afcaf8e2e},
}

@Article{Kreuzer2022,
  author                  = {Kreuzer, M. and Kiel, T. and Ernst, L. and Lipp, M. and Schneider, G. and Pilge, S.},
  journal                 = {Brain Sciences},
  title = {Evaluation of Anesthetic Specific {Eeg} Dynamics during State Transitions between Loss and Return of Responsiveness},
  year                    = {2022},
  issn                    = {20763425},
  note                    = {cited By 7},
  number                  = {1},
  volume                  = {12},
  abbrev_source_title = {Brain Sci.},
  abstract                = {Purpose: electroencephalographic (EEG) information is used to monitor the level of cortical depression of a patient undergoing surgical intervention under general anesthesia. The dynamic state transitions into and out of anesthetic-induced loss and return of responsiveness (LOR, ROR) present a possibility to evaluate the dynamics of the EEG induced by different substances. We evaluated changes in the EEG power spectrum during anesthesia emergence for three different anesthetic regimens. We also assessed the possible impact of these changes on processed EEG parameters such as the permutation entropy (PeEn) and the cerebral state index (CSI). Methods: we analyzed the EEG from 45 patients, equally assigned to three groups. All patients were induced with propofol and the groups differed by the maintenance anesthetic regimen, i.e., sevoflurane, isoflurane, or propofol. We evaluated the EEG and parameter dynamics during LOR and ROR. For the emergence period, we focused on possible differences in the EEG dynamics in the different groups. Results: depending on the substance, the EEG emergence patterns showed significant differences that led to a substance-specific early activation of higher frequencies as indicated by the “wake” CSI values that occurred minutes before ROR in the inhalational anesthetic groups. Conclusion: our results highlight substance-specific differences in the emergence from anesthesia that can influence the EEG-based monitoring that probably have to be considered in order to improve neuromonitoring during general anesthesia. © 2021 by the authors. Licensee MDPI, Basel, Switzerland.},
  affiliation             = {Department of Anesthesiology and Intensive Care, School of Medicine, Klinikum rechts der Isar, Technical University of Munich, Munich, 81675, Germany},
  art_number              = {37},
  author_keywords         = {anesthesia; Anesthesia emergence; Electroencephalogram; Monitoring},
  correspondence_address1 = {Pilge, S.; Department of Anesthesiology and Intensive Care, Germany; email: stefanie.pilge@tum.de},
  document_type           = {Article},
  doi                     = {10.3390/brainsci12010037},
  groups                  = {Journals},
  keywords                = {benzodiazepine; isoflurane; propofol; remifentanil; sevoflurane; sufentanil, adult; aged; anesthesia induction; Article; blood pressure; cerebral state index; conformational transition; electroencephalography; end tidal carbon dioxide tension; entropy; female; fuzzy system; general anesthesia; heart rate; human; human experiment; local field potential; loss of responsiveness; male; neuromonitoring; oxygen saturation; psychological aspect; software; spreading cortical depression},
  language                = {English},
  publisher               = {MDPI},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85122124741&doi=10.3390%2fbrainsci12010037&partnerID=40&md5=642bb4e6455eb0c67060b306657acc50},
}

@Article{Ricci2022a,
  author                  = {Ricci, L. and Politi, A.},
  journal                 = {Entropy},
  title = {Permutation entropy of weakly noise-affected signals},
  year                    = {2022},
  issn                    = {10994300},
  note                    = {cited By 3},
  number                  = {1},
  volume                  = {24},
  abbrev_source_title = {Entropy},
  abstract                = {We analyze the permutation entropy of deterministic chaotic signals affected by a weak observational noise. We investigate the scaling dependence of the entropy increase on both the noise amplitude and the window length used to encode the time series. In order to shed light on the scenario, we perform a multifractal analysis, which allows highlighting the emergence of many poorly populated symbolic sequences generated by the stochastic fluctuations. We finally make use of this information to reconstruct the noiseless permutation entropy. While this approach works quite well for Hénon and tent maps, it is much less effective in the case of hyperchaos. We argue about the underlying motivations. © 2021 by the authors. Licensee MDPI, Basel, Switzerland.},
  affiliation             = {Department of Physics, University of Trento, Trento, 38123, Italy; Center for Mind/Brain Sciences (CIMeC), University of Trento, Rovereto, 38068, Italy; Institute for Pure and Applied Mathematics and Department of Physics, University of Aberdeen, Aberdeen, AB24 3UE, United Kingdom},
