  coden                   = {POLNC},
  correspondence_address1 = {Tang, C.; School of Biomedical Engineering, China; email: tangchi@fmmu.edu.cn; Xie, K.; School of Biomedical Engineering, China; email: xiekangning@fmmu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1371/journal.pone.0305872},
  groups                  = {Journals},
  keywords                = {adult; algorithm; analysis of variance; anesthesia level; Article; electroencephalogram; electroencephalography; electromyography; entropy; female; filtration; flow cytometry; Fourier transform; heart rate; heart rate variability; histogram; human; male; mathematical model; mathematical parameters; mathematical phenomena; nerve cell network; noise; polysomnography; post hoc analysis; seizure; simulation; spectroscopy; computer simulation; procedures; signal noise ratio; signal processing, Algorithms; Computer Simulation; Electroencephalography; Entropy; Humans; Signal Processing, Computer-Assisted; Signal-To-Noise Ratio},
  language                = {English},
  publisher               = {Public Library of Science},
  pubmed_id               = {39074072},
