@Article{Miao2021,
  author                  = {Miao, Y. and Zakharov, Y.V. and Sun, H. and Li, J. and Wang, J.},
  journal                 = {IEEE Journal of Oceanic Engineering},
  title = {Underwater Acoustic Signal Classification Based on Sparse Time-Frequency Representation and Deep Learning},
  year                    = {2021},
  issn                    = {03649059},
  note                    = {cited By 43},
  number                  = {3},
  pages = {952--962},
  volume                  = {46},
  abbrev_source_title = {IEEE J Oceanic Eng},
  abstract                = {For classification of underwater acoustic signals, we propose a novel sparse anisotropic chirplet transform (ACT) to reveal fine time-frequency structures. The signal features in the form of a time-frequency map are fed into a deep convolutional neural network, referred to as a time-frequency feature network (TFFNet), which brings flexibility to signal classification. The TFFNet is based on a novel efficient feature pyramid enhancing feature (EFP) maps by aggregating the context information at different scales. To remove the gridding artifacts on enhanced feature maps, a form of aggregating transformation, a forward feature fusion, is utilized to merge the forward feature maps. Main contributions of this work are a novel sparse ACT, a TFFNet classifier, and an EFP with forward feature fusion. Experimental results demonstrate that the sparse ACT provides a high-resolution time-frequency representation of underwater signals and the TFFNet improves the classification performance compared to known networks and two machine learning methods (random forest and support vector machine with radial basis function kernel) on two real data sets, an underwater acoustic communication signal data set and whale sounds data set. © 1976-2012 IEEE.},
  affiliation             = {School of Informatics, Xiamen University, Xiamen, 361005, China; Department of Electronics, University of York, York, YO10 5DD, United Kingdom; Institute of Sound and Vibration Research, University of Southampton, Southampton, SO17 1BJ, United Kingdom; School of Electrical and Electronic Engineering, Tianjin University of Technology, 300384, Tianjin, China},
  art_number              = {9319209},
  author_keywords         = {Deep convolutional neural network (CNN); efficient feature pyramid (EFP); sparse anisotropic chirplet transform (ACT); time-frequency representation (TFR); underwater acoustic (UWA) signal classification},
  coden                   = {IJOED},
  correspondence_address1 = {Sun, H.; School of Informatics, China; email: hxsun@xmu.edu.cn; Li, J.; Institute of Sound and Vibration Research, United Kingdom; email: J.Li@soton.ac.uk},
  document_type           = {Article},
  doi                     = {10.1109/JOE.2020.3039037},
  groups                  = {Journals},
  keywords                = {Acoustic signal processing; Acoustic waves; Classification (of information); Convolutional neural networks; Decision trees; Deep learning; Deep neural networks; Learning systems; Marine communication; Random forests; Support vector machines, Chirplet transforms; Classification performance; Context information; Frequency structure; Radial basis function kernels; Signal classification; Underwater acoustic communications; Underwater acoustic signal, Underwater acoustics},
  language                = {English},
