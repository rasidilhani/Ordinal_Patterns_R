  groups                  = {Conference},
  isbn                    = {9798350325416},
  journal                 = {2023 12th International Conference on Image Processing Theory, Tools and Applications, IPTA 2023},
  keywords                = {Brain mapping; Electroencephalography; Electrophysiology; Extraction; Magnetoencephalography; Neurology, Automatic extraction; Brain areas; Epilepsy; Features extraction; Independent components analysis; MEG; New approaches; Performance, Independent component analysis},
  language                = {English},
