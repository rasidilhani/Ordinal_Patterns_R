  doi                     = {10.1155/2020/2791352},
  groups                  = {Journals},
  keywords                = {Efficiency; Entropy, Chinese cities; Formation mechanism; Living standards; Macroeconomic stability; Plane methods; Real estate market; Real estate prices; Weak efficiency, Commerce},
  language                = {English},
  publisher               = {Hindawi Limited},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85078663110&doi=10.1155%2f2020%2f2791352&partnerID=40&md5=0d39c0c7dc8970b03ecf536ac9b935d7},
