@Article{Sun2019,
  author                  = {Sun, Z. and Dang, P. and Xu, W.},
  journal                 = {Chaos, Solitons and Fractals},
  title = {Detecting and measuring stochastic resonance in fractional-order systems via statistical complexity},
  year                    = {2019},
  issn                    = {09600779},
  note                    = {cited By 12},
  pages = {34--40},
  volume                  = {125},
  abbrev_source_title = {Chaos Solitons Fractals},
  abstract                = {Fractional-order systems are utilized widely to model material or physical systems with the properties of memory, non-locality and history-dependent, thus massive studies have been drawn on their dynamics during the past decade. In this paper, we are motivated to study stochastic dynamics in a fractional-order system subjected to Gaussian noise. The statistical complexity measure (SCM), an approach of information theory, has been well defined and calculated in the fractional-order Langevin model based on its Shannon entropy, by which the stochastic resonance (SR)response has been detected and measured. To compare, we further derive the equivalent system by means of the minimum mean square error rule to estimate the signal-to-noise ratio (SNR). It has been found that the SCM and the SNR depict analogous profile and exhibit peaks almost at the same level of noise. Varying the signal frequency, the SCM even quantifies Multiple-SR that SNR does not measure in the fractional-order Langevin model. Thus, the SCM may be utilized as an alternative candidate to measure SR response in bistable fractional-order systems. © 2019 Elsevier Ltd},
  affiliation             = {Department of Applied Mathematics, Northwestern Polytechnical University, Xi'an, 710129, China},
  author_keywords         = {Fractional-order systems; Noise; Stochastic resonance (SR); The statistical complexity measure (SCM)},
  coden                   = {CSFOE},
  correspondence_address1 = {Sun, Z.; Department of Applied Mathematics, China; email: dynsun@126.com},
  document_type           = {Article},
  doi                     = {10.1016/j.chaos.2019.05.015},
  groups                  = {Journals},
  keywords                = {Algebra; Circuit resonance; Gaussian noise (electronic); Magnetic resonance; Mean square error; Stochastic models; Stochastic systems, Equivalent system; Fractional-order systems; Minimum mean square errors; Noise; Signal frequencies; Statistical complexity; Stochastic dynamics; Stochastic resonances, Signal to noise ratio},
  language                = {English},
  publisher               = {Elsevier Ltd},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85065859009&doi=10.1016%2fj.chaos.2019.05.015&partnerID=40&md5=71f7d3673e60da107a18b8f7f47b5c6f},
}

@Article{Ciarrocchi2019,
  author                  = {Ciarrocchi, N. and Quiróz, N. and Traversaro, F. and Roman, E.S. and Risk, M. and Goldemberg, F. and Redelico, F.O.},
  journal                 = {Communications in Nonlinear Science and Numerical Simulation},
  title = {The complexity of intracranial pressure as an indicator of cerebral autoregulation},
  year                    = {2019},
  issn                    = {10075704},
  note                    = {cited By 2},
  pages = {192--199},
  volume                  = {75},
  abbrev_source_title = {Comm. Nonlinear Sci. Numer. Simul.},
  abstract                = {Intracranial Pressure (ICP) is one of the main neuromonitories used today to guide the treatment of acute neurological patients in the Intensive Care Unit (ICU). Within this article the complexity of periods of intracranial hypertension is evaluated and compared with periods of stable intracranial tension. Using the multiparameter intelligent monitoring in intensive care III (MIMIC-III) database from the Beth Israel Deaconess Medical Center the complexity of periods of stable intracranial tension and high intracranial hypertension are evaluated using two quantifiers: the Permutation Entropy and their respective number of missing patterns. Both indicate a loss of complexity in hypertension signals. A physiological explanation of this loss of complexity is given using a dynamical model of the Cerebral Autoregulation and Cerebral Hemodynamics. © 2019 Elsevier B.V.},
