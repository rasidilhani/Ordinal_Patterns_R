}

@Article{Ding2023,
  author                  = {Ding, C. and Xue, R.},
  journal                 = {Nonlinear Dynamics},
  title = {Signal-sensing dynamic S-box image encryption with 2D Griewank–sin map},
  year                    = {2023},
  issn                    = {0924090X},
  note                    = {cited By 10},
  number                  = {24},
  pages = {22595--22620},
  volume                  = {111},
  abbrev_source_title = {Nonlinear Dyn},
  abstract                = {Chaos systems serve as crucial tools in information security, particularly in applications such as image encryption and multimedia encryption. However, existing chaos systems suffer from limitations in complexity and randomness. To address these challenges, inspired by the Griewank function and sin mapping, this study introduces a novel 2D discrete hyperchaotic system constructed through coupled substitution. Rigorous assessments using various chaos metrics confirm its exceptional chaotic properties. Furthermore, we propose an efficient scheme that combines the aforementioned mapping with cellular automata to generate static S-boxes. By establishing a connection between the frequency domain signal of an image and S-box construction, we develop a signal-aware dynamic S-box generation scheme that adaptively adjusts energy weighting in coefficient matrices. Finally, we employ the proposed chaos system and dynamic S-box generation scheme for image encryption. Comprehensive experimental results demonstrate that our proposed image encryption algorithm based on dynamic S-boxes achieves a high level of security and robustly withstands various common forms of attacks. © 2023, The Author(s), under exclusive licence to Springer Nature B.V.},
  affiliation             = {School of Information Engineering, Xizang Minzu University, Shaanxi, Xianyang, 712082, China; Key Laboratory of Optical Information Processing and Visualization Technology of Tibet Autonomous Region, Tibet, China},
  author_keywords         = {Hyperchaotic system; Image encryption; S-box; Signal-Sensing},
  coden                   = {NODYE},
  correspondence_address1 = {Xue, R.; School of Information Engineering, Shaanxi, China; email: rxue@xzmu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1007/s11071-023-08985-8},
  groups                  = {Journals},
  keywords                = {Chaotic systems; Cryptography; Frequency domain analysis; Image processing; Security of data, Chaos systems; Coupled substitution; Discrete hyperchaotic systems; Griewank; Griewank function; Hyper-chaotic systems; Images encryptions; Multimedia encryption; S-boxes; Signal-sensing, Mapping},
  language                = {English},
  publisher               = {Springer Science and Business Media B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85175981061&doi=10.1007%2fs11071-023-08985-8&partnerID=40&md5=4926fdf366625f4c22b6e3c004cb1ffc},
}

@Article{Sklenarova2023,
  author                  = {Sklenarova, B. and Chladek, J. and Macek, M. and Brazdil, M. and Chrastina, J. and Jurkova, T. and Burilova, P. and Plesinger, F. and Zatloukalova, E. and Dolezalova, I.},
  journal                 = {Scientific Reports},
  title = {Entropy in scalp {Eeg} can be used as a preimplantation marker for VNS efficacy},
  year                    = {2023},
  issn                    = {20452322},
  note                    = {cited By 5},
  number                  = {1},
  volume                  = {13},
  abbrev_source_title = {Sci. Rep.},
  abstract                = {Vagus nerve stimulation (VNS) is a therapeutic option in drug-resistant epilepsy. VNS leads to ≥ 50% seizure reduction in 50 to 60% of patients, termed "responders". The remaining 40 to 50% of patients, "non-responders", exhibit seizure reduction < 50%. Our work aims to differentiate between these two patient groups in preimplantation EEG analysis by employing several Entropy methods. We identified 59 drug-resistant epilepsy patients treated with VNS. We established their response to VNS in terms of responders and non-responders. A preimplantation EEG with eyes open/closed, photic stimulation, and hyperventilation was found for each patient. The EEG was segmented into eight time intervals within four standard frequency bands. In all, 32 EEG segments were obtained. Seven Entropy methods were calculated for all segments. Subsequently, VNS responders and non-responders were compared using individual Entropy methods. VNS responders and non-responders differed significantly in all Entropy methods except Approximate Entropy. Spectral Entropy revealed the highest number of EEG segments differentiating between responders and non-responders. The most useful frequency band distinguishing responders and non-responders was the alpha frequency, and the most helpful time interval was hyperventilation and rest 4 (the end of EEG recording). © 2023, The Author(s).},
  affiliation             = {Brno Epilepsy Center, First Department of Neurology, Member of ERN-Epicar, St. Anne’s University Hospital and Faculty of Medicine, Masaryk University, Pekařská 53, Brno, 602 00, Czech Republic; Institute of Scientific Instruments, Czech Academy of Sciences, Brno, Czech Republic; Behavioral and Social Neuroscience Research Group, CEITEC–Central European Institute of Technology, Masaryk University, Brno, Czech Republic; Brno Epilepsy Center, Department of Neurosurgery, St. Anne’s University Hospital and Masaryk University, Brno, Czech Republic; Institute of Biostatistics and Analyses, Faculty of Medicine, Masaryk University, Brno, Czech Republic; International Clinical Research Center, St. Anne’s University Hospital, Brno, Czech Republic; Department of Health Sciences, Faculty of Medicine, Masaryk University, Brno, Czech Republic},
  art_number              = {18849},
  correspondence_address1 = {Dolezalova, I.; Brno Epilepsy Center, Pekařská 53, Czech Republic; email: Irena.dolezalova@fnusa.cz},
  document_type           = {Article},
  doi                     = {10.1038/s41598-023-46113-z},
  groups                  = {Journals},
  keywords                = {electroencephalography; entropy; human; hyperventilation; procedures; refractory epilepsy; scalp; seizure; treatment outcome; vagus nerve; vagus nerve stimulation, Drug Resistant Epilepsy; Electroencephalography; Entropy; Humans; Hyperventilation; Scalp; Seizures; Treatment Outcome; Vagus Nerve; Vagus Nerve Stimulation},
  language                = {English},
  publisher               = {Nature Research},
  pubmed_id               = {37914788},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85175736015&doi=10.1038%2fs41598-023-46113-z&partnerID=40&md5=2924c2e3edec72cf065e6837245733ee},
}

@Article{Li2023a,
  author                  = {Li, Z. and Li, Y. and Zhang, K. and Guo, J.},
  journal                 = {Nonlinear Dynamics},
  title = {Hierarchical refined composite multiscale fluctuation-based dispersion entropy: application to feature extraction of underwater target signal},
  year                    = {2023},
  issn                    = {0924090X},
  note                    = {cited By 8},
  number                  = {24},
  pages = {22399--22417},
  volume                  = {111},
  abbrev_source_title = {Nonlinear Dyn},
  abstract                = {Due to the complex and variable marine environment and weak target echo signals, the difficulty of extract underwater target features increases. On the basis of analyze the nonlinear and non-stationary characteristics of underwater target signals, in order to improve the detection performance of active sonar, the hierarchical refined multi-scale fluctuation-based dispersion entropy (HRCMFDE) method is proposed and used to extract the features of underwater target signals. Firstly, the HRCMFDE method is used to extract features from underwater target signals, and the extracted HRCMFDE feature vectors are used to form the feature set. Secondly, genetic algorithm (GA) was used to optimize the input weights and hidden layer bias of extreme learning machine (ELM), and an improved ELM algorithm was proposed to establish the recognition model for underwater target signals. Finally, a sample library of five types of targets was constructed based on the measured underwater target signals, and feature extraction was performed. The performance of the extracted features was tested through improved ELM classification, and the classification results obtained verified the effectiveness of the proposed feature extraction method. © 2023, The Author(s), under exclusive licence to Springer Nature B.V.},
  affiliation             = {School of Digital Arts, Xi’an University of Posts and Telecommunications, Xi’an, China; School of Marine Science and Technology, Northwestern Polytechnical University, Xi’an, China; Department of Computer and Information of Science and Engineering, University of Florida, Gainesville, FL 32611, United States; School of Mathematics and Computer Science, Shaanxi University of Technology, Hanzhong, China},
  author_keywords         = {Feature extraction; Hierarchical refined composite multi-scale fluctuation-based dispersion entropy; Improved extreme learning machine; Multi-scale fluctuation-based dispersion entropy; Underwater target signal},
  coden                   = {NODYE},
  correspondence_address1 = {Li, Z.; School of Digital Arts, China; email: lizhaoxi@mail.nwpu.edu.cn; Li, Y.; School of Marine Science and Technology, China; email: liyaan@nwpu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1007/s11071-023-09026-0},
  groups                  = {Journals},
  keywords                = {Classification (of information); Dispersions; Extraction; Feature extraction; Genetic algorithms; Knowledge acquisition; Underwater acoustics, Entropy methods; Features extraction; Hierarchical refined composite multi-scale fluctuation-based dispersion entropy; Improved extreme learning machine; Learning machines; Multi-scale fluctuation-based dispersion entropy; Multi-scales; Target feature; Underwater target signal, Entropy},
  language                = {English},
  publisher               = {Springer Science and Business Media B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85175641189&doi=10.1007%2fs11071-023-09026-0&partnerID=40&md5=e831b8f0cd0303b95d5dbf5465101048},
