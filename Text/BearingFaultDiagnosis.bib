  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85083510090&doi=10.1016%2fj.compbiomed.2020.103769&partnerID=40&md5=2f96d68f92b4efd42b020fd69aa62503},
}

@Article{BidiasaMougoufan2020,
  author                  = {Bidias à Mougoufan, J.B. and Eyebe Fouda, J.S.A. and Tchuente, M. and Koepf, W.},
  journal                 = {Communications in Nonlinear Science and Numerical Simulation},
  title = {Adaptive {Ecg} beat classification by ordinal pattern based entropies},
