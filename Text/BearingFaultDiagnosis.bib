@Conference{Han2022,
  author                  = {Han, X. and Tu, E. and Yang, J.},
  title = {Multimodal 12-lead {Ecg} data classification using multi-label DenseNet for heart disease detection},
  year                    = {2022},
  note                    = {cited By 0},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {Int. Conf. Data Sci. Inf. Technol., DSIT - Proc.},
  abstract                = {Electrocardiogram(ECG) signal is one of the most effective diagnostic method for arrhythmia. Since cardiac dis-ease is a main cause of death and the allocation of medical resources is unbalanced, automatic recognition of arrhythmia by machine learning algorithm is of great significance. In this work, we develop a multimodal DenseNet to classify 12-lead ECG. Our method combines hand-crafted features with features from DenseNet. In addition, we propose to use softmax function and dynamic threshold optimization for our multi-level ECG classification task. We tested our model on the 2020 PhysioNet/CinC Challenge dataset. Using the official Challenge Score for evaluation, we achieve a Challenge Score of 0.602 on the validation set, which outperforms the champion model by an apparent margin. © 2022 IEEE.},
