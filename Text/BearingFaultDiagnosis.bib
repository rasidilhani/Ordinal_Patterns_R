  document_type           = {Conference Paper},
  groups                  = {Conference},
  isbn                    = {9781713871088},
  issn                    = {10495258},
  journal                 = {Advances in Neural Information Processing Systems},
  keywords                = {Forecasting; Network architecture; Neural networks; Time series, Down sampling; Modeling and forecasting; Neural network architecture; Novel neural network; Property; Temporal models; Temporal relation; Time series forecasting; Times series; Times series models, Convolution},
  language                = {English},
