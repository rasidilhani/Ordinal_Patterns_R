@Article{AmmyDriss2023,
  author                  = {Ammy-Driss, A. and Garcin, M.},
  journal                 = {Physica A: Statistical Mechanics and its Applications},
  title = {Efficiency of the financial markets during the COVID-19 crisis: Time-varying parameters of fractional stable dynamics},
  year                    = {2023},
  issn                    = {03784371},
  note                    = {cited By 17},
  volume                  = {609},
  abbrev_source_title = {Phys A Stat Mech Appl},
  abstract                = {This paper investigates the impact of COVID-19 on financial markets. It focuses on the evolution of the market efficiency, using two efficiency indicators: the Hurst exponent and the memory parameter of a fractional Lévy-stable motion. The second approach combines, in the same model of dynamic, an alpha-stable distribution and a dependence structure between price returns. We provide a dynamic estimation method for the two efficiency indicators. This method introduces a free parameter, the discount factor, which we select so as to get the best alpha-stable density forecasts for observed price returns. The application to stock indices during the COVID-19 crisis shows a strong loss of efficiency for US indices. On the opposite, Asian and Australian indices seem less affected and the inefficiency of these markets during the COVID-19 crisis is even questionable. © 2022 Elsevier B.V.},
  affiliation             = {ESILV, 92916 Paris La Défense, France; Léonard de Vinci Pôle Universitaire, Research center, Paris La Défense, 92916, France},
  art_number              = {128335},
  author_keywords         = {Alpha-stable distribution; Dynamic estimation; Efficient market hypothesis; Financial crisis; Hurst exponent},
  coden                   = {PHYAD},
  correspondence_address1 = {Garcin, M.; Léonard de Vinci Pôle Universitaire, France; email: matthieu.garcin@m4x.org},
  document_type           = {Article},
  doi                     = {10.1016/j.physa.2022.128335},
  groups                  = {Journals},
  keywords                = {Commerce; Efficiency; Financial markets, Alpha-stable distribution; Dynamic estimation; Efficiency indicators; Efficient market hypothesis; Financial crisis; Hurst exponents; It focus; Market efficiency; Price returns; Time varying parameter, COVID-19},
  language                = {English},
  publisher               = {Elsevier B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85143795759&doi=10.1016%2fj.physa.2022.128335&partnerID=40&md5=91408bb600d0f326c45b3d06d366fc61},
}

@Article{Shen2023b,
  author                  = {Shen, J. and Zhang, Y. and Liang, H. and Zhao, Z. and Dong, Q. and Qian, K. and Zhang, X. and Hu, B.},
  journal                 = {IEEE Transactions on Neural Systems and Rehabilitation Engineering},
  title = {Exploring the Intrinsic Features of {Eeg} Signals via Empirical Mode Decomposition for Depression Recognition},
  year                    = {2023},
  issn                    = {15344320},
  note                    = {cited By 37},
  pages = {356--365},
  volume                  = {31},
  abbrev_source_title = {IEEE Trans. Neural Syst. Rehabil. Eng.},
  abstract                = {Depression is a severe psychiatric illness that causes emotional and cognitive impairment and has a considerable impact on patients' thoughts, behaviors, feelings and well-being. Moreover, methods for recognizing and treating depression are lacking in clinical practice. Electroencephalogram (EEG) signals, which objectively reflect the internal workings of the brain, is a promising and objective tool for recognizing and diagnosing of depression and enhancing clinical effects. However, previous EEG feature extraction methods have not performed well when exploring the intrinsic characteristics of highly complex and nonstationary EEG signals. To address this issue, we propose a regularization parameter-based improved intrinsic feature extraction method of EEG signals via empirical mode decomposition (EMD), which mines the intrinsic patterns in EEG signals, for depression recognition. Furthermore, our method can effectively solve the problem that EMD fails to extract intrinsic features. In this method, we first select an appropriate regularization parameter to generate the regularization matrix. Next, we calculate the sum of the matrix products of the IMFs and the regularization matrix and leverage the inverse of this matrix to extract the intrinsic features. The classification results of our method on four EEG datasets reached 0.8750, 0.8850, 0.8485 and 0.7768, respectively. In addition, compared with the iEMD method, our method requires less computational costs. These results support our claim that our method can effectively strengthen the depression recognition performance, and our method outperforms state-of-the-art feature extraction approaches. © 2001-2011 IEEE.},
  affiliation             = {Beijing Institute of Technology, Brain Health Engineering Laboratory, School of Medical Technology, Beijing, 100081, China; Lanzhou University, School of Information Science and Engineering, Lanzhou, 730000, China},
  author_keywords         = {Depression recognition; EEG; empirical mode decomposition; intrinsic features},
  coden                   = {ITNSB},
  correspondence_address1 = {Hu, B.; Beijing Institute of Technology, China; email: bh@bit.edu.cn; Zhang, X.; Lanzhou University, China; email: zhangxw@lzu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1109/TNSRE.2022.3221962},
  groups                  = {Journals},
  keywords                = {Biomedical signal processing; Classification (of information); Data mining; Electroencephalography; Electrophysiology; Emotion Recognition; Extraction; Feature extraction; Inverse problems; Matrix algebra; Parameterization, Depression; Depression recognition; Electroencephalogram signals; Empirical Mode Decomposition; Feature extraction methods; Features extraction; Intrinsic features; matrix; Regularization parameters, Empirical mode decomposition, adult; Article; auditory stimulation; body movement; Childhood Trauma Questionnaire; clinical practice; cognitive defect; controlled study; depression; diagnostic test accuracy study; electrocardiogram; electroencephalogram; electromyogram; electrooculogram; electrophysiology; empirical mode decomposition; eye movement; eyelid reflex; feature extraction; female; human; intrinsic activity; male; mental disease; sensitivity and specificity; brain; depression; electroencephalography; procedures; signal processing, Brain; Depression; Electroencephalography; Humans; Recognition, Psychology; Signal Processing, Computer-Assisted},
  language                = {English},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  pubmed_id               = {36374871},
