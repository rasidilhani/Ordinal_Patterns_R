  groups                  = {Journals},
  keywords                = {Cryptography; Image enhancement, Chaotic map; Chaotic model; Compound-coupled chaotic model; Dynamics characteristic; Image encryption algorithm; Images encryptions; Logistic chaotic map; Logistic maps; Practical use; Scientific fields, Chaotic systems},
  language                = {English},
