  groups                  = {Journals},
  keywords                = {adolescent; adult; area under the curve; Article; child; clinical article; clinical effectiveness; clinical feature; disease duration; epilepsy; feature extraction; feature selection; female; high frequency oscillation; human; machine learning; male; nuclear magnetic resonance imaging; receiver operating characteristic; risk factor; school child; stereoelectroencephalography; young adult; brain; electroencephalogram; electroencephalography; focal epilepsy; machine learning; physiology; procedures, Brain; Brain Waves; Electroencephalography; Epilepsies, Partial; Humans; Machine Learning},
  language                = {English},
  publisher               = {W.B. Saunders Ltd},
