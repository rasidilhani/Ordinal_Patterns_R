}

@Article{Peng2025,
  author                  = {Peng, L. and Zhang, L. and Li, S. and Pan, W. and Jiang, L. and Yan, L. and Luo, B. and Zou, X.},
  journal                 = {Optics and Laser Technology},
  title = {Deep reservoir computing combined with heterogeneous driver layer to improve prediction performance},
  year                    = {2025},
  issn                    = {00303992},
  note                    = {cited By 0},
  volume                  = {183},
  abbrev_source_title = {Opt Laser Technol},
  abstract                = {Reservoir computing capitalizes on the high-dimensional responses of a nonlinear dynamical system, it creates a high-dimensional temporal expansion of the input signal. State space with higher dimensions can allow for the mapping of more complicated output functions. In this work, we propose a novel photonic deep reservoir computing (DRC) whose reservoir layer consists of two reservoirs where the state of the driver reservoir layer acts as driven data for the master layer. Each input signal is first mapped into the states of the driver layer through a high-dimensional mapping. Then the reservoir state for training in the master layer is consecutively driven by the states of the driver reservoir. It is shown that the prediction accuracy NMSE of proposed DRC is 1.2E−8 in chaotic time-series prediction of the Lorenz system, which is 100 times more accurate than traditional isolated time-delayed reservoir computing (TDRC) based on semiconductor laser (SL) and optoelectronic oscillator (OEO). Moreover, the prediction accuracy of DRC is an order of magnitude higher than a cascaded TDRC-SL with 10 layers. The performance of DRC is further validated in terms of memory capacity and the complexity of reservoir state. Furthermore, we introduce heterogeneity into the reservoir layers of DRC, where the driver layer is TDRC-SL, and the master layer is replaced with TDRC-OEO. We elucidate that combining DRC with different dynamics exhibits better performance compared to the homogeneous DRC, as it can map the input signal to more sophisticated state space. At last, the processing speed of heterogeneous DRC is further improved with parallel structure. Our findings provide a new insight into the miniaturization of RC and further improvement of reservoir computational performance, and suggest a new insight for the cooperation of heterogeneous miniaturized reservoirs. © 2024 Elsevier Ltd},
  affiliation             = {Center for Information Photonics and Communications, Southwest Jiaotong University, Chengdu, 611756, China},
  art_number              = {112256},
  author_keywords         = {Chaotic time series prediction task; Reservoir computing; Semiconductor laser},
  coden                   = {OLTCA},
  correspondence_address1 = {Zhang, L.; Center for Information Photonics and Communications, China; email: lyzhang@swjtu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.optlastec.2024.112256},
  groups                  = {Journals},
  keywords                = {Chaotic time series prediction; Chaotic time series prediction task; Deep reservoirs; High-dimensional; Higher-dimensional; Prediction accuracy; Prediction tasks; Reservoir Computing; State-space; Time delayed, Semiconductor lasers},
  language                = {English},
  publisher               = {Elsevier Ltd},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85212066032&doi=10.1016%2fj.optlastec.2024.112256&partnerID=40&md5=bcc05b869bf574d579e92720b03bdb41},
}

@Article{Li2025,
  author                  = {Li, Y. and Lou, Y. and Zhang, C.},
  journal                 = {Communications in Nonlinear Science and Numerical Simulation},
  title = {Multiscale grayscale dispersion entropy: A new nonlinear dynamics metric for time series analysis},
  year                    = {2025},
  issn                    = {10075704},
  note                    = {cited By 0},
  volume                  = {143},
  abbrev_source_title = {Comm. Nonlinear Sci. Numer. Simul.},
  abstract                = {Link dispersion entropy (LDE), as an improvement of dispersion entropy (DE), focuses on transition states between adjacent dispersion patterns. However, the transition states of dispersion patterns at different intervals are ignored and parameters of LDE have a significant impact on entropy value. To address these problems, grayscale dispersion entropy (GDE) is proposed, which introduces transition step size considering the transition states between dispersion patterns at different intervals, reflecting the state transition information comprehensively and uses a grayscale matrix instead of a transition probability matrix to weaken the effect of parameter on entropy value. Moreover, multiscale grayscale dispersion entropy (MGDE) is proposed as a multiscale version of GDE, which reflects the complexity at various time scales. Simulation experiments have confirmed that GDE possesses the capability to precisely detect dynamic changes in signal and accurately represent signal complexity. For two types of publicly available ship radiated noise datasets and rolling bearing dataset, MGDE has better classification performance than other four complexity metrics. © 2025 Elsevier B.V.},
  affiliation             = {School of Automation and Information Engineering, Xi'an University of Technology, Xi'an, 710048, China; Key Laboratory of Ocean Observation Technology, Ministry of Natural Resources, Tianjin, 300112, China},
