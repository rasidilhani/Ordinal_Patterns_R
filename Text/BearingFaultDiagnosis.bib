  document_type           = {Article},
  doi                     = {10.3788/OPE.20202803.0621},
  groups                  = {Journals},
  keywords                = {Decision trees; Entropy; Failure analysis; Fault detection; Random forests, Fault characteristics; Fault diagnosis method; Fault feature extractions; Fault type identification; Generalization ability; Impact characteristics; Intrinsic time-scale decompositions; Rolling bearing vibration, Roller bearings},
