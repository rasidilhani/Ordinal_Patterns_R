  art_number              = {021005},
  author_keywords         = {adjustment Mahalanobis-Taguchi system (AMTS); artificial intelligence; big data and analytics; data-driven engineering; deep neural networks (DNN); modified ensemble empirical mode decomposition (MEEMD); modified health index (MHI)},
  correspondence_address1 = {Lin, M.; Business School, China; email: envaitenetlin@outlook.com},
