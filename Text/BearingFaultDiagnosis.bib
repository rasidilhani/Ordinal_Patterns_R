  document_type           = {Article},
  doi                     = {10.1002/for.2849},
  groups                  = {Journals},
  keywords                = {Entropy; Testing, Classical modeling; High moment; Model points; Modelling and predictions; Ordinal pattern; Permutation entropy; Prediction accuracy; Serial dependence; Test accuracy; Underlying dynamics, Forecasting},
  language                = {English},
  publisher               = {John Wiley and Sons Ltd},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85122751581&doi=10.1002%2ffor.2849&partnerID=40&md5=ec042efda43841c82c4d6526303b6054},
}

@Article{LopezPerez2022,
  author                  = {López Pérez, M. and Mansilla Corona, R.},
  journal                 = {Physica A: Statistical Mechanics and its Applications},
  title = {Ordinal synchronization and typical states in high-frequency digital markets},
  year                    = {2022},
  issn                    = {03784371},
  note                    = {cited By 1},
  volume                  = {598},
  abbrev_source_title = {Phys A Stat Mech Appl},
  abstract                = {In this paper we study Algorithmic High-Frequency Financial Markets as dynamical networks. After an individual analysis of 24 stocks of the US market during a trading year of fully automated transactions by means of ordinal pattern series, we define an information-theoretic measure of pairwise synchronization for time series which allows us to study this subset of the US market as a dynamical network. We apply to the resulting network a couple of clustering algorithms in order to detect collective market states, characterized by their degree of centralized or decentralized synchronicity. This collective analysis has shown to reproduce, classify and explain the anomalous behavior previously observed at the individual level. We also find two whole coherent seasons of highly centralized and decentralized synchronicity, respectively. Finally, we model these states dynamics through a simple Markov model. © 2022 Elsevier B.V.},
  affiliation             = {Facultad de Ciencias, Universidad Nacional Autónoma de Mexico, Ciudad Universitaria, Mexico City, 04510, Mexico; Centro de Investigaciones Interdisciplinarias en Ciencias y Humanidades, Universidad Nacional Autónoma de Mexico, Ciudad Universitaria, Mexico City, 04510, Mexico},
