@Article{Yin2019a,
  author                  = {Yin, Y. and Wang, X. and Li, Q. and Shang, P. and Hou, F.},
  journal                 = {Chaos},
  title = {Quantifying interdependence using the missing joint ordinal patterns},
  year                    = {2019},
  issn                    = {10541500},
  note                    = {cited By 2},
  number                  = {7},
  volume                  = {29},
  abbrev_source_title = {Chaos},
  abstract                = {In this paper, we develop the concept of forbidden/missing ordinal patterns into the forbidden/missing joint ordinal patterns and propose the ratio of the number of missing joint ordinal patterns (RMJPs) as a sign of interdependence. RMJP in a surrogate analysis can be used to differentiate the forbidden joint ordinal patterns from the missing joint ordinal patterns due to small sample effects. We first apply RMJP to the simulated time series: a two-component autoregressive fractionally integrated moving average process, the Hénon map, and the Rössler system using active control and discuss the effect of the length of the time series, embedding dimension, and noise contamination. RMJP has been proven to be capable of measuring the interdependence in the numerical simulation. Then, RMJP is further used on the electroencephalogram (EEG) time series for empirical analysis to explore the interdependence of brain waves. With results by RMJP obtained from a widely used open dataset of the sleep EEG time series from healthy subjects, we find that RMJP can be used to quantify the brain wave interdependence under different sleep/wake stages, reveal the overall sleep architecture, and indicate a higher level of interdependence as sleep gets deeper. The findings are consistent with existing knowledge in sleep medicine. The proposed RMJP method has shown its validity and applicability and may assist automatic sleep quantification or bring insight into the understanding of the brain activity during sleep. Furthermore, RMJP can be used on sleep EEG under various pathological conditions and in large-scale sleep studies, helping to investigate the mechanisms of the sleep process and neuron synchronization. © 2019 Author(s).},
  affiliation             = {School of Mechanical Electronic and Control Engineering, Beijing Jiaotong University, Beijing, 100044, China; School of Science, Beijing Jiaotong University, Beijing, 100044, China; Key Laboratory of Biomedical Functional Materials, China Pharmaceutical University, Nanjing, 211198, China},
  art_number              = {073114},
  correspondence_address1 = {Yin, Y.; School of Mechanical Electronic and Control Engineering, China; email: 09271087@bjtu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1063/1.5084034},
  groups                  = {Journals},
  keywords                = {adult; article; computer simulation; contamination; controlled study; electroencephalogram; embedding; female; human; human experiment; joint; male; nerve cell; noise; quantitative analysis; sleep medicine; time series analysis; validity},
  language                = {English},
  publisher               = {American Institute of Physics Inc.},
  pubmed_id               = {31370405},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85070946043&doi=10.1063%2f1.5084034&partnerID=40&md5=df303d93004082921a3f6f79835e6723},
}

@Article{Radhakrishnan2019,
  author                  = {Radhakrishnan, S. and Lee, Y.-T.T. and Rachuri, S. and Kamarthi, S.},
  journal                 = {PLoS ONE},
  title = {Complexity and entropy representation for machine component diagnostics},
  year                    = {2019},
  issn                    = {19326203},
  note                    = {cited By 2},
  number                  = {7},
  volume                  = {14},
  abbrev_source_title = {PLoS ONE},
  abstract                = {The Complexity-entropy causality plane (CECP) is a parsimonious representation space for time series. It has only two dimensions: normalized permutation entropy (HS) and Jensen-Shannon complexity (CJS) of a time series. This two-dimensional representation allows for detection of slow or rapid drifts in the condition of mechanical components monitored through sensor measurements. The CECP representation can be used for both predictive analytics and visual monitoring of changes in component condition. This method requires minimal pre-processing of raw signals. Furthermore, it is insensitive to noise, stationarity, and trends. These desirable properties make CECP a good candidate for machine condition monitoring and fault diagnostics. In this work we study the effectiveness of CECP on three rotary component condition assessment applications. We use CECP representation of vibration signals to differentiate various machine component health conditions for rotary machine components, namely roller bearing and gears. The results confirm that the CECP representation is able to detect, with high accuracy, changes in underlying dynamics of machine component degradation states. From class separability perspective, the CECP representation is able to generate linearly separable classes for the classification of different fault states. This classification performance improves with increasing signal length. For signal length of 16,384 data points, the fault classification accuracy varies from 90% to 100% for bearing applications, and from 85% to 100% for gear applications. We observed that the optimum parameter for CECP representatino depends on the application. For bearing applications we found that embedding dimension D = 4, 5, 6, and embedding delay τ = 1, 2, 3 are suitable for good fault classification. For gear applications we find that embedding dimension D = 4, 5, and embedding delay τ = 1, 5 are suitable for fault classification. This is an open access article, free of all copyright, and may be freely reproduced, distributed, transmitted, modified, built upon, or otherwise used by anyone for any lawful purpose. The work is made available under the Creative Commons CC0 public domain dedication.},
  affiliation             = {Mechanical and Industrial Engineering, Northeastern University, Boston, MA, United States; Systems Integration Division, NIST, Gaithersburg, MD, United States; Advanced Manufacturing Office, EERE, Department of Energy, Washington, DC, United States},
  art_number              = {e0217919},
  coden                   = {POLNC},
  correspondence_address1 = {Kamarthi, S.; Mechanical and Industrial Engineering, United States; email: sagar@coe.neu.edu},
  document_type           = {Article},
  doi                     = {10.1371/journal.pone.0217919},
  groups                  = {Journals},
  keywords                = {article; causality; embedding; entropy; machine; monitoring; noise; vibration; biological model; computer assisted diagnosis; entropy; human; support vector machine, Diagnosis, Computer-Assisted; Entropy; Humans; Models, Biological; Support Vector Machine},
  language                = {English},
  publisher               = {Public Library of Science},
  pubmed_id               = {31287818},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85069314510&doi=10.1371%2fjournal.pone.0217919&partnerID=40&md5=bea300ced1ce299cbfa4185b78df4b05},
}

