  journal             = {Gaoya Dianqi/High Voltage Apparatus},
  title = {Propagation Characteristics Analysis of Source Side Interference Signal in Symmetrical Voltage Application Test Circuit of Converter Transformer [电源侧干扰信号在换流变压器对称加压试验回路中的传播特性分析]},
  year                = {2023},
  issn                = {10011609},
  note                = {cited By 1},
  number              = {1},
  pages               = {109-116+125},
  volume              = {59},
  abbrev_source_title = {Gaoya Dianqi},
  abstract            = {During the induced voltage withstand and partial discharge detection test of converter transformer，it is susceptible to interference of various factors due to relatively weak partial discharge signal at early stage of defect. It is therefore necessary to understand the propagation characteristics of interference signal in order to take corresponding suppression measures. In this paper，the induced withstanding voltage test circuit of the converter transformer under symmetrical voltage application is taken as the study object，the corresponding Simulink simulation model is proposed. The mathematical relationship between the equivalent lump capacitance parameters and those of nameplate of converter transformer in the simulation model is derived on the basis of capacitive current distribution in the winding distributed capacitance. On this basis，the propagation characteristics of source side interference signal in the test circuit is studied. The study results show that the PWM carrier frequency of variable frequency power source has a big impact in detecting harmonic contents of impedance detection signal. The circuit exists obvious resonance point. The frequency of the resonance point is related to the winding inductance of the converter transformer.The study in this paper can provide reference for formulation of interference suppression measures during the induced voltage withstand and partial discharge detection test of converter transformer. © 2023 Xi'an High Voltage Apparatus Research Institute. All rights reserved.},
  affiliation         = {Engineering Research Center for Safety Monitoring of New Energy and Power Grid Equipment, Hubei University of Technology, Wuhan, 430068, China; Technology Training Center, State Grid Hubei Electric Power Co.，Ltd., Wuhan, 430079, China},
  author_keywords     = {converter transformer; interference signal; propagation characteristics; symmetrical voltage test},
  coden               = {GADIE},
  document_type       = {Article},
  doi                 = {10.13296/j.1001-1609.hva.2023.01.016},
  groups              = {Journals},
  language            = {Chinese},
  publisher           = {Xi'an High Voltage Apparatus Research Institute},
  source              = {Scopus},
  url                 = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85171190581&doi=10.13296%2fj.1001-1609.hva.2023.01.016&partnerID=40&md5=00789d1b69d5ad7b7f4ddc19f7e10618},
}

@Article{Gu2023b,
  author              = {Gu, Z. and Ma, H. and Zhang, Y. and Chen, B. and Li, Y.},
  journal             = {Gaoya Dianqi/High Voltage Apparatus},
  title = {Vibration Signal Diagnosis Method of Transformer Winding Looseness Defect Based on {Vmd} and Optimized {Svm} [基于 {Vmd} 与优化 {Svm} 的变压器绕组松动缺陷振动信号诊断方法]},
  year                = {2023},
  issn                = {10011609},
  note                = {cited By 6},
  number              = {1},
  pages = {117--125},
  volume              = {59},
  abbrev_source_title = {Gaoya Dianqi},
  abstract            = {With the continuous increase of transformer capacity in power system, the influence due to looseness defect of transformer winding is becoming more and more serious, and it is therefore necessary to perform fault diagnosis. In view of looseness defect diagnosis of transformer winding by the use of vibration signal, the feature extraction method of transformer vibration signal based on variational mode decomposition (VMD) permutation entropy (PE) and transformer winding looseness defect diagnosis method based on support vector machine (SVM) optimized by beetle antennae search(BAS)are proposed. Firstly, one set of practical 110 kV transformer is set with different looseness states to collect vibration signals under normal and different degrees of looseness；Then, the variational mode decomposition combined with permutation entropy is used for feature extraction of looseness defects of transformer winding. After that, the support vector machine optimized by beetle antennae search algorithm is used for pattern recognition of winding looseness. Finally, the method is compared with the the traditional method. The results show that VMD decomposition effect is better than presently mainly-used empirical mode decomposition, and the permutation entropy fault feature effect is better than the time series complexity calculation index of multi-scale permutation entropy and approximate entropy. The BAS-SVM operation time and diagnosis accuracy rate are better than such optimization algorithms as grid search optimization SVM and genetic algorithm optimization SVM. The accuracy of the fault diagnosis of the transformer winding looseness tested at 60%~110% rated current by the proposed method is above 98.7%. © 2023 Xi'an High Voltage Apparatus Research Institute. All rights reserved.},
  affiliation         = {College of Energy and Electrical Engineering, Hohai University, Nanjing, 211100, China; State Grid Jiangsu Electric Power Company, Nanjing Power Supply Company, Nanjing, 210008, China},
  author_keywords     = {beetle antennae search; permutation entropy; transformer; variational mode decomposition; vibration signal; winding looseness},
  coden               = {GADIE},
  document_type       = {Article},
  doi                 = {10.13296/j.1001-1609.hva.2023.01.017},
  groups              = {Journals},
  language            = {Chinese},
  publisher           = {Xi'an High Voltage Apparatus Research Institute},
  source              = {Scopus},
  url                 = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85162774461&doi=10.13296%2fj.1001-1609.hva.2023.01.017&partnerID=40&md5=e46bfc0e0a2bb36e15f300c5acb42971},
}

