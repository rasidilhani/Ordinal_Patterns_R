@Article{Valensise2021,
  author                  = {Valensise, C.M. and Serra, A. and Galeazzi, A. and Etta, G. and Cinelli, M. and Quattrociocchi, W.},
  journal                 = {Scientific Reports},
  title = {Entropy and complexity unveil the landscape of memes evolution},
  year                    = {2021},
  issn                    = {20452322},
  note                    = {cited By 16},
  number                  = {1},
  volume                  = {11},
  abbrev_source_title = {Sci. Rep.},
  abstract                = {On the Internet, information circulates fast and widely, and the form of content adapts to comply with users’ cognitive abilities. Memes are an emerging aspect of the internet system of signification, and their visual schemes evolve by adapting to a heterogeneous context. A fundamental question is whether they present culturally and temporally transcendent characteristics in their organizing principles. In this work, we study the evolution of 2 million visual memes published on Reddit over ten years, from 2011 to 2020, in terms of their statistical complexity and entropy. A combination of a deep neural network and a clustering algorithm is used to group memes according to the underlying templates. The grouping of memes is the cornerstone to trace the growth curve of these objects. We observe an exponential growth of the number of new created templates with a doubling time of approximately 6 months, and find that long-lasting templates are associated with strong early adoption. Notably, the creation of new memes is accompanied with an increased visual complexity of memes content, in a continuous effort to represent social trends and attitudes, that parallels a trend observed also in painting art. © 2021, The Author(s).},
  affiliation             = {Enrico Fermi Research Center, Piazza del Viminale, 1, Roma, 00184, Italy; Tuscia University - DISTU Department of Modern Languages and Literatures, History, Philosophy and Law Studies, Via S. Carlo, 32, Viterbo, 01100, Italy; Department of Environmental Sciences, Informatics and Statistics, Ca’ Foscari, University of Venice, Via Torino 155, Mestre, 30172, Italy; Institute for Complex Systems, Italian National Research Council, Via dei Taurini 19, Roma, 00185, Italy; Department of Computer Science, Sapienza University of Rome, Viale Regina Elena, 295, Roma, 00161, Italy; University of Brescia, Via Branze, 59, Brescia, 25123, Italy},
  art_number              = {20022},
  correspondence_address1 = {Valensise, C.M.; Enrico Fermi Research Center, Piazza del Viminale, 1, Italy; email: carlo.valensise@cref.it},
  document_type           = {Article},
  doi                     = {10.1038/s41598-021-99468-6},
  groups                  = {Journals},
  keywords                = {adoption; article; clustering algorithm; deep neural network; entropy; growth curve; human; human experiment; painting; social media; information dissemination; language; social media; social network, Humans; Information Dissemination; Language; Social Media; Social Networking},
  language                = {English},
