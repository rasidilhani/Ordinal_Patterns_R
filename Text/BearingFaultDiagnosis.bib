@Conference{Torregrosa2022,
  author                  = {Torregrosa, A. and Jacobi, A.B. and Garćia-Tiscar, J. and Pastor, M.R.},
  title = {NONLINEAR DYNAMIC ANALYSIS OF THE PRESSURE SIGNALS ON A SWIRL-STABILIZED ATMOSPHERIC LDI BURNER ACROSS DIFFERENT OPERATING CONDITIONS},
  year                    = {2022},
  note                    = {cited By 0},
  publisher               = {American Society of Mechanical Engineers (ASME)},
  volume                  = {3-B},
  abbrev_source_title = {Proc. ASME Turbo Expo},
  abstract                = {Lean Direct Injection (LDI) burners are a promising technology aimed at reducing NOx emissions in new generation aeroengines. However, one of the main drawbacks of this technology is the appearance of combustion instabilities at certain operating conditions. In order to investigate these issues, a confined, atmospheric, swirl-stabilized LDI burner has been set up at the Institute CMT-Motores Termicos. In this configuration, air mass flow, temperature, and fuel mass flow rate, which is controlled by the injection pressure, can be independently modified to reach different combustion states. In this paper, a parametric study of the equivalence ratio (0.3 ≤ Φ ≤ 0.8), air temperature (50, 100, 150 oC) and fuel mass flow rate (200, 250, 300, 335, 370 mg/s) has been performed to assess their influence on the dynamics of the system through the evaluation of the pressure signals inside the chamber. These signals have been acquired with two piezoresistive sensors flush-mounted to the combustor wall at the same axial distance but in opposite sides of the chamber. Large-amplitude unsteady oscillations are detected for some combinations of the variables of interest. Equivalence ratio variations are shown to affect deeply the dynamic features of the pressure signal, obtaining more stable configurations either close to the lean limit (Φ = 0.3) or at the richest condition tested (Φ = 0.8). Mid-range equivalence ratio values (0.4≤Φ≤0.7) are shown to display the most unstable behavior, featuring large pressure oscillations that remain nearly constant over time (quasi-periodic states) or signals that experience sudden variations in their amplitude (intermittent states). Since turbulent swirl-stabilized spray flame combustors may experience complex flow-flame interactions that could lead to nonlinear behavior of these combustion regimes, several signal processing techniques such as three-dimensional phase space reconstruction or recurrence plots have been applied to the experimental data in order to obtain better insight into these highly dynamic features. Copyright © 2022 by ASME.},
  affiliation             = {CMT - Motores T´ ermicos, Universitat Polit `ecnica de Val ` encia, Valencia, 46022, Spain},
  art_number              = {V03BT04A031},
  author_keywords         = {Acoustics; Burners; Combustion instability; Combustion thermoacoustics; Low-emission combustor},
  correspondence_address1 = {Garćia-Tiscar, J.; CMT - Motores T´ ermicos, Spain; email: jorgarti@mot.upv.es},
  document_type           = {Conference Paper},
  doi                     = {10.1115/GT2022-82665},
  groups                  = {Conference},
  isbn                    = {9780791886007},
  journal                 = {Proceedings of the ASME Turbo Expo},
  keywords                = {Combustors; Direct injection; Mass transfer; Phase space methods; Signal processing; Thermoacoustics, Combustion instabilities; Combustion thermoacoustic; Emission combustors; Equivalence ratios; Fuel mass flow rates; Lean direct injections; Low emission; Low-emission combustor; Pressure signal; Thermoacoustic, Combustion},
  language                = {English},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85141377177&doi=10.1115%2fGT2022-82665&partnerID=40&md5=0e7d40df3c60cb3b8562d38fd68dd558},
}

@Conference{FabilaCarrasco2022,
  author              = {Fabila-Carrasco, J.S. and Tan, C. and Escudero, J.},
  title = {Multivariate permutation entropy, a Cartesian graph product approach},
  year                = {2022},
  note                = {cited By 1},
  pages = {2081--2085},
  publisher           = {European Signal Processing Conference, EUSIPCO},
  volume              = {2022-August},
  abbrev_source_title = {European Signal Proces. Conf.},
  abstract            = {Entropy metrics are nonlinear measures to quantify the complexity of time series. Among them, permutation entropy is a commonly used metric due to its robustness and fast computation. Multivariate entropy metrics techniques are needed to analyse data consisting of more than one time series. To this end, we present a multivariate permutation entropy, MPEG, using a graph-based approach. Given a multivariate signal, the algorithm to compute MPEG involves two main steps: 1) we construct an underlying graph G as the Cartesian product of two graphs G1 and G2, where G1 preserves temporal information of each times series and G2 models the relations between different channels; and 2) we consider the multivariate signal as samples defined on the regular graph G and apply the recently introduced permutation entropy for graphs. Our graph-based approach gives the flexibility to consider diverse types of cross channel relationships and signals, and it overcomes with the limitations of current multivariate permutation entropy. © 2022 European Signal Processing Conference, EUSIPCO. All rights reserved.},
  affiliation         = {School of Engineering, Institute for Digital Communications, University of Edinburgh, Edinburgh, EH9 3FB, United Kingdom; School of Electrical and Information Engineering, Tianjin University, Tianjin, 300072, China},
  author_keywords     = {complexity; entropy metrics; graph signals; multivariate time series; permutation entropy},
  document_type       = {Conference Paper},
  doi                 = {10.23919/eusipco55093.2022.9909930},
  groups              = {Conference},
  isbn                = {9789082797091},
  issn                = {22195491},
  journal             = {European Signal Processing Conference},
  keywords            = {Entropy; Graph theory; Graphic methods; Set theory; Signal processing, Cartesians; Complexity; Entropy metrics; Graph G; Graph signal; Graph-based; Multivariate signals; Multivariate time series; Permutation entropy; Times series, Time series},
  language            = {English},
  source              = {Scopus},
  url                 = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85140742768&doi=10.23919%2feusipco55093.2022.9909930&partnerID=40&md5=3477a9d2d07adf1edeeb798f2f7488c7},
}

@Conference{Wen2022b,
  author                  = {Wen, X. and Wang, D. and Fan, L. and Lv, Z. and Zhang, C. and Liang, Z.},
  title = {Tracking propofol-related brain states with UKF-based neural mass model},
  year                    = {2022},
  editor                  = {Li Z., Sun J.},
  note                    = {cited By 1},
  pages = {5962--5966},
  publisher               = {IEEE Computer Society},
  volume                  = {2022-July},
  abbrev_source_title = {Chinese Control Conf., CCC},
  abstract                = {Neural mass model has been widely used to fit electroencephalographic signal and track brain states. In this study, unscented Kalman filter was applied to estimate parameters of Jansen-Rit (JR) neural mass model and track the real electroencephalogram (EEG) recordings. The power spectral and the Permutation Entropy (PeEn) demonstrated its good performance in tracking EEG signals from the perspectives of frequency domain and complexity respectively. The parameter estimates indicated that propofol caused a decrease in the rate constant of inhibitory post-synaptic potential (p < 0.001, repeated measures ANOVA) as is generally observed in physiology. Moreover, it was found that there were significant differences between awake state and anesthetized state in estimated parameters. The results suggest that the combination of neural mass model and unscented Kalman filter is a powerful tool for inferring underlying physiological information of brain state. © 2022 Technical Committee on Control Theory, Chinese Association of Automation.},
