@Article{Yan2019,
  author                  = {Yan, S.-F. and Ma, B. and Zheng, C.-S. and Chen, M.},
  journal                 = {International Journal of Automotive Technology},
  title = {Weighted Evidential Fusion Method for Fault Diagnosis of Mechanical Transmission Based on Oil Analysis Data},
  year                    = {2019},
  issn                    = {12299138},
  note                    = {cited By 18},
  number                  = {5},
  pages = {989--996},
  volume                  = {20},
  abbrev_source_title = {Int. J. Automot. Technol.},
  abstract                = {Condition monitoring (CM) and fault diagnosis are critical for the stable and reliable operation of mechanical transmissions. Mechanical transmission wear, which leads to changes in the physicochemical properties of the lubrication oil and thus severe wear, is a slow degradation process that can be monitored by oil analysis, but the actual degradation degree is difficult to evaluate. To solve this problem, we propose a new weighted evidential data fusion method to better characterize the degradation degree of the mechanical transmission through the fusion of multiple CM datasets from oil analysis. This method includes weight allocation and data fusion steps that lead to a more accurate data-based fault diagnostic result for CM. First, the weight of each evidence is modeled with a weighted average function by measuring the relative scale of the permutation entropy from each CM dataset. Then, the multiple CM datasets are fused by the Dempster combination rule. Compared with other evidential data fusion methods, the proposed method using the new weight allocation function seems more reasonable. The rationality and superiority of the proposed method were evaluated through a case study involving an oilbased CM dataset from a power-shift steering transmission. © 2019, KSAE.},
  affiliation             = {School of Mechanical Engineering, Beijing Institute of Technology, Beijing, 100081, China},
  author_keywords         = {Data fusion; Dempster-Shafter evidence theory; Fault diagnosis; Mechanical transmission; Oil analysis; Weight allocation},
  correspondence_address1 = {Zheng, C.-S.; School of Mechanical Engineering, China; email: zhengchangsong@bit.edu.cn},
  document_type           = {Article},
  doi                     = {10.1007/s12239-019-0093-9},
  groups                  = {Journals},
  keywords                = {Condition monitoring; Data fusion; Failure analysis; Fault detection; Physicochemical properties; Scales (weighing instruments); Wear of materials, Data fusion methods; Dempster-Shafter evidence theory; Evidential fusions; Mechanical transmission; Oil analysis; Permutation entropy; Reliable operation; Weight allocation, Transmissions},
  language                = {English},
