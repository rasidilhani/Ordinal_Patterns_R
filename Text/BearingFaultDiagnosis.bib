@Article{Bernardi2023,
  author                  = {Bernardi, D. and Shannahoff-Khalsa, D. and Sale, J. and Wright, J.A. and Fadiga, L. and Papo, D.},
  journal                 = {Frontiers in Psychiatry},
  title = {The time scales of irreversibility in spontaneous brain activity are altered in obsessive compulsive disorder},
  year                    = {2023},
  issn                    = {16640640},
  note                    = {cited By 5},
  volume                  = {14},
  abbrev_source_title = {Front. Psychiatry},
  abstract                = {We study how obsessive-compulsive disorder (OCD) affects the complexity and time-reversal symmetry-breaking (irreversibility) of the brain resting-state activity as measured by magnetoencephalography (MEG). Comparing MEG recordings from OCD patients and age/sex matched control subjects, we find that irreversibility is more concentrated at faster time scales and more uniformly distributed across different channels of the same hemisphere in OCD patients than in control subjects. Furthermore, the interhemispheric asymmetry between homologous areas of OCD patients and controls is also markedly different. Some of these differences were reduced by 1-year of Kundalini Yoga meditation treatment. Taken together, these results suggest that OCD alters the dynamic attractor of the brain's resting state and hint at a possible novel neurophysiological characterization of this psychiatric disorder and how this therapy can possibly modulate brain function. Copyright © 2023 Bernardi, Shannahoff-Khalsa, Sale, Wright, Fadiga and Papo.},
  affiliation             = {Center for Translational Neurophysiology of Speech and Communication, Fondazione Istituto Italiano di Tecnologia, Ferrara, Italy; BioCircuits Institute, University of California, San Diego, La Jolla, CA, United States; Center for Integrative Medicine, University of California, San Diego, La JollaCA, United States; The Khalsa Foundation for Medical Science, Del Mar, CA, United States; San Diego Supercomputer Center, University of California, San Diego, La JollaCA, United States; Department of Neuroscience and Rehabilitation, Section of Physiology, University of Ferrara, Ferrara, Italy},
  art_number              = {1158404},
  author_keywords         = {dynamical disease; Kundalini Yoga; meditation; obsessive-compulsive disorder; permutation entropy; spontaneous brain activity; time scales; time-reversal symmetry},
  correspondence_address1 = {Bernardi, D.; Center for Translational Neurophysiology of Speech and Communication, Italy; email: davide.bernardi@iit.it; Fadiga, L.; Center for Translational Neurophysiology of Speech and Communication, Italy; email: fdl@unife.it; Papo, D.; Center for Translational Neurophysiology of Speech and Communication, Italy; email: davide.bernardi@iit.it; Shannahoff-Khalsa, D.; BioCircuits Institute, La Jolla, CA, United States; email: davide.bernardi@iit.it},
  document_type           = {Article},
  doi                     = {10.3389/fpsyt.2023.1158404},
  groups                  = {Journals},
  keywords                = {adult; Article; brain asymmetry; brain function; clinical article; controlled study; electroencephalogram; entropy; female; human; Kundalini yoga; left hemisphere; magnetoencephalography; male; meditation; middle aged; neurophysiology; obsessive compulsive disorder; permutation entropy; right hemisphere; spatial analysis; spontaneous brain activity; time factor; time reversal symmetry; time scale; yoga; young adult},
