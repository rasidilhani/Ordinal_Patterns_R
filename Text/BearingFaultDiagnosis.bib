  correspondence_address1 = {Yang, L.; College of Physics and Optoelectronics, Shanxi, China; email: office-science@tyut.edu.cn},
  document_type           = {Note},
  doi                     = {10.1016/j.rinp.2024.107866},
  groups                  = {Journals},
  language                = {English},
  publisher               = {Elsevier B.V.},
