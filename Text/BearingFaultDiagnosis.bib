  journal                 = {Chaos, Solitons and Fractals},
  title = {A memristive Ikeda map and its application in image encryption},
  year                    = {2025},
  issn                    = {09600779},
  note                    = {cited By 0},
  volume                  = {190},
  abbrev_source_title = {Chaos Solitons Fractals},
  abstract                = {Existing research indicates that discrete-time chaotic systems are more likely to achieve hyperchaotic states in lower dimensions compared to continuous-time chaotic systems. Recently, introducing discrete memristors into chaotic map to enhance system dynamics performance has become a hot topic in the field of chaos research. In this paper, a memristive Ikeda map (MIKM) based on discrete memristors is proposed and the system dynamics behavior is analyzed in depth by chaotic attractor phase diagrams, Lyapunov exponent spectrum, bifurcation diagrams, spectral entropy (SE), distributional properties and fractal dimensions. Numerical simulation results indicate that the introduction of discrete memristor enriches the dynamic characteristics of the Ikeda map, such as expanding the range of chaos, enhancing the ergodicity, and prompting the transition from chaotic to hyperchaotic states. We further studied the influence of coupling strength K on the dynamic behavior of the system. We explored the use of the discrete memristor as internal perturbations to achieve parameter-controlled symmetric attractors and the introduction of constant controllers to achieve signal polarity adjustment. At the same time, we implemented the improved Ikead map on the STM32 hardware platform and developed a pseudo-random number generator (PRNG). Finally, an image encryption algorithm was designed based on the proposed improved Ikeda map. The experimental results show that the proposed algorithm is robust. © 2024 Elsevier Ltd},
  affiliation             = {School of Automation and Electronic Information, Xiangtan University, Xiangtan, 411105, China},
  art_number              = {115740},
  author_keywords         = {Chaos; Discrete memristor; Hyperchaotic map; Image encryption; Polarity control; PRNG},
  coden                   = {CSFOE},
  correspondence_address1 = {Wang, M.; School of Automation and Electronic Information, China; email: wangmj@xtu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.chaos.2024.115740},
  groups                  = {Journals},
  keywords                = {Chaotic systems; Fractal dimension, Chaotics; Discrete memristor; Dynamic behaviors; Hyperchaotic; Hyperchaotic maps; Ikeda maps; Images encryptions; Memristor; Polarity control; Pseudorandom number generators, Continuous time systems},
  language                = {English},
  publisher               = {Elsevier Ltd},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85209371482&doi=10.1016%2fj.chaos.2024.115740&partnerID=40&md5=6914adb006564120530c2082dc52b48e},
}

@Article{Wang2025b,
  author                  = {Wang, S. and Chen, S. and Wang, H. and Yang, X. and Tang, P. and Chu, J. and Zheng, K.},
  journal                 = {Measurement: Journal of the International Measurement Confederation},
  title = {Internal defect detection model based on laser ultrasonic signal decomposition and deep learning},
  year                    = {2025},
  issn                    = {02632241},
  note                    = {cited By 0},
  volume                  = {242},
  abbrev_source_title = {Meas J Int Meas Confed},
  abstract                = {It is essential to accurately detect the internal defects of metal equipment. The accuracy of traditional detection methods is affected by noise. This paper proposes an innovative genetic algorithm-weighted permutation entropy (GA-WPE) optimized Variational mode Decomposition (VMD), continuous wavelet transform (CWT) and deep learning fusion model, which aims to achieve efficient automatic defect detection. Firstly, the laser ultrasonic experimental system was built, and the hole defects with different diameters and depths were prepared. The GA-WPE-VMD was used to decompose and reconstruct the ultrasound signal, and CWT converted the reconstructed signal into a time–frequency scalogram. Three deep learning models were used for defect detection. ViT model achieved 99.88%, 97.01%, and 91.7% accuracy on the training, validation, and test set, respectively, significantly better than DenseNet121 and ResNet50. The AUC of ViT on the test set was close to 100%. The results verify the feasibility and effectiveness of the proposed method. © 2024},
