  document_type           = {Article},
  doi                     = {10.1007/s11042-021-10807-1},
  groups                  = {Journals},
  keywords                = {Chaotic systems; Image enhancement; State feedback, Encryption algorithms; Experimental simulations; Feedback functions; Image encryption algorithm; Image encryption scheme; Information entropy; Selection methods; Suppression method, Cryptography},
  language                = {English},
