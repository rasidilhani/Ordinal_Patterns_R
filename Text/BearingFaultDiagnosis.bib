  author                  = {Shen, Y. and Xie, J. and Liang, W. and Yuan, X. and Sun, S.},
  journal                 = {Dianli Xitong Baohu yu Kongzhi/Power System Protection and Control},
  title = {Electric vehicle hybrid energy storage system {Ceemd}-{Pe} energy management strategy [电动汽车混合储能系统 {Ceemd}-{Pe} 能量管理策略]},
  year                    = {2023},
  issn                    = {16743415},
  note                    = {cited By 6},
  number                  = {13},
  pages = {122--131},
  volume                  = {51},
  abbrev_source_title = {Dianli Xitong Baohu yu Kongzhi},
  abstract                = {There is a problem of the life attenuation of lithium-ion batteries caused by high-frequency demand power components during electric vehicle driving. Thus a complete ensemble empirical mode decomposition-permutation entropy (CEEMD-PE) energy management strategy is proposed. The electric vehicle power demand is decomposed into a finite number of intrinsic mode functions (IMFs), and each component is reconstructed into low- and high frequency components according to the data complexity of each IMF measured by PE. Finally, the high-frequency components containing transient power and fast changes are assigned to the ultracapacitor, while the low-frequency components are assigned to the battery. The experimental results show that, compared with the Haar wavelet strategy, the root mean square (RMS) value of the lithium-ion battery current in the medium-speed and high-speed regions is reduced by 5.91% and 4.17%, respectively, and the current peak value is reduced by 14.70% and 5.77%, respectively. The proposed strategy helps to suppress the high-frequency power demand endured by lithium-ion batteries and reduce the impact of large currents on lithium-ion batteries. © 2023 Power System Protection and Control Press. All rights reserved.},
  affiliation             = {Zhengzhou University of Light Industry, Zhengzhou, 450002, China; National Engineering Laboratory for Robot Visua Perception and Control Technology, Hunan University, Changsha, 410082, China; Hunan University, Changsha, 410082, China},
  author_keywords         = {CEEMD; electric vehicle; energy management; hybrid energy storage system; PE},
  correspondence_address1 = {Liang, W.; Zhengzhou University of Light IndustryChina; email: weihualiang@163.com; Yuan, X.; National Engineering Laboratory for Robot Visua Perception and Control Technology, China},
  document_type           = {Article},
  doi                     = {10.19783/j.cnki.pspc.221497},
  groups                  = {Journals},
  keywords                = {Digital storage; Electric power system protection; Electric power utilization; Energy management; Ions; Signal processing, CEEMD; Empirical Mode Decomposition; High frequency components; High frequency HF; Higher-frequency components; Hybrid energy storage systems; Intrinsic Mode functions; Lower frequency components; Management strategies; Permutation entropy, Lithium-ion batteries},
  language                = {Chinese},
  publisher               = {Power System Protection and Control Press},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85171591700&doi=10.19783%2fj.cnki.pspc.221497&partnerID=40&md5=8f977cea365025a972d92ca85624b06e},
}

@Article{Buccellato2023,
  author                  = {Buccellato, A. and Çatal, Y. and Bisiacchi, P. and Zang, D. and Zilio, F. and Wang, Z. and Qi, Z. and Zheng, R. and Xu, Z. and Wu, X. and Del Felice, A. and Mao, Y. and Northoff, G.},
  journal                 = {Entropy},
  title = {Probing Intrinsic Neural Timescales in {Eeg} with an Information-Theory Inspired Approach: Permutation Entropy Time Delay Estimation ({Pe}-TD)},
  year                    = {2023},
  issn                    = {10994300},
