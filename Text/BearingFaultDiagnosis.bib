  author                  = {Li, Y. and Mu, L. and Gao, P.},
  journal                 = {Fractal and Fractional},
  title = {Particle Swarm Optimization Fractional Slope Entropy: A New Time Series Complexity Indicator for Bearing Fault Diagnosis},
  year                    = {2022},
  issn                    = {25043110},
