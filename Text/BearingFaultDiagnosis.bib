  groups                  = {Journals},
  keywords                = {Acoustic noise; Dispersions; Extraction; Feature extraction; Ships, Classification and recognition; Eight node; Features extraction; Permutation entropy; Ship radiated noise; Ship's radiated noise; Underwater acoustic signal, Entropy},
