  author_keywords         = {Hierarchical multi-variate amplitude-aware permutation entropy; Machine learning; Rotating machinery fault diagnosis; T-SNE; VNWOA-KELM},
  coden                   = {APITE},
  correspondence_address1 = {Han, J.; The First Scientific Research Institute of Wuxi, Jiangsu, China; email: hanjun2002@msn.com},
  document_type           = {Article},
  doi                     = {10.1007/s10489-022-03505-4},
  groups                  = {Journals},
  keywords                = {Decomposition methods; Entropy; Extraction; Fault detection; Feature extraction, Automatic fault detection; Detection methods; Feature extraction methods; Hierarchical multi-variate amplitude-aware permutation entropy; Machine-learning; Machinery fault diagnosis; Permutation entropy; Rotating machinery fault diagnose; T-SNE; VNWOA-KELM, Rotating machinery},
