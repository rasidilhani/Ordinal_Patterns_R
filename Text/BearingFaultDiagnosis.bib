  groups                  = {Journals},
  keywords                = {Blood; Entropy; Hemodynamics; Noninvasive medical procedures; Oximeters; Photoplethysmography; Signal processing; Spectrum analysis, Blood volume pulse; Convolution neural network; Empirical Mode Decomposition; Heart-rate detection; Intrinsic Mode functions; Permutation entropy; Skin-color information; Subspace rotations, Heart, algorithm; Article; CHROM algorithm; complementary ensemble empirical mode decomposition; controlled study; convolutional neural network; empirical mode decomposition; Fourier transform; heart rate measurement; human; human experiment; intermethod comparison; multi task convolution neural network; permutation entropy; priority journal; robust independent component analysis; spatial subspace rotation; statistical analysis},
