@Article{Wu2024,
  author                  = {Wu, T. and Pan, L. and An, X.},
  journal                 = {Shuili Fadian Xuebao/Journal of Hydroelectric Engineering},
  title = {Noise reduction method of vibration signals from hydroelectric generators based on HO-{Vmd} [融合 HO-{Vmd} 的水电机组摆度信号消噪方法]},
