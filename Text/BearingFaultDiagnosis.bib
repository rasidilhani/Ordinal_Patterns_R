  author_keywords         = {Area-preserving map; Extreme multistability; Initial condition; Quasi-periodic route},
  correspondence_address1 = {Bao, B.; School of Microelectronics and Control Engineering, China; email: mervinbao@126.com},
  document_type           = {Article},
  doi                     = {10.1109/ACCESS.2020.3026676},
  groups                  = {Journals},
  keywords                = {Continuous dynamical system; Discrete iterative map; Hardware platform; Initial conditions; Microcontroller-based; Multi stabilities; Numerical results; Quasi-periodic orbits, Dynamical systems},
  language                = {English},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85102178263&doi=10.1109%2fACCESS.2020.3026676&partnerID=40&md5=c7cda6daf4a2276edc648cbf21b675b1},
