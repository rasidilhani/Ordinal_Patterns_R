  groups                  = {Journals},
  keywords                = {Entropy; Extraction; Feature extraction; Laplace transforms; Support vector machines, Feature extraction methods; Fly optimization algorithms; Intelligent recognition; Laplacians; Permutation entropy; Shearer; State recognition; Support vector machine classification, State estimation},
