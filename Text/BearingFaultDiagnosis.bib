  groups                  = {Journals},
  keywords                = {Control charts; Flowcharting; Statistical process control, Causality analysis; Entropy methods; In-process monitoring; Performance; Process disturbances; Research fields; Root cause analysis; Statistical process-control; Symbolic transfer entropy; Transfer entropy, Process monitoring},
  language                = {English},
