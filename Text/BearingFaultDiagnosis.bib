  groups                  = {Journals},
  keywords                = {Commerce; Financial data processing; Investments; Time series, Financial time series; Generalized entropies; Information entropy; Multiscale; Multivariate; Multivariate data; Multivariate time series; Nonlinear time series, White noise},
  language                = {English},
  publisher               = {Elsevier B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85064246200&doi=10.1016%2fj.physa.2019.04.029&partnerID=40&md5=c8f722f46800aad084963235818dc78b},
