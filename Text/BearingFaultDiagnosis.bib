@Conference{Cornejo2020,
  author                  = {Cornejo, D. and Rodriguez, M. and Diaz, L. and Alvarez, E. and Vizcardo, M.},
  title = {Application of Permutation Entropy in the Stratification of Patients with Chagas Disease},
  year                    = {2020},
  note                    = {cited By 3},
  publisher               = {IEEE Computer Society},
  volume                  = {2020-September},
  abbrev_source_title = {Comput. Cardiol.},
  abstract                = {Chagas disease is an endemic disease that in recent decades has ceased to be a rural disease to become mainly an urban disease, becoming a public health problem because it is a life-threatening disease and because 70 million people are at risk of infection. This disease, which has cardiac involvement in its chronic phase, can often be silent and asymptomatic, because of this the establishment of early markers in this type of patients is of great interest. To achieve this goal this study proposes the use of the permutation entropy (PE) which has been shown satisfactory results in the analysis of hearth rhythm and the differentiation between healthy people and people who suffered of congestive heart failure, also known as heart failure. This study analyzes three groups: 83 volunteers (Con-trol), 102 patients with positive serology and no cardiac involvement diagnosed by conventional non-invasive methods (CH1) and 107 patients with positive serology and mild to moderate incipient heart failure (CH2). The used data comes from the 24-hour ECG record, the RR intervals from each of the three groups are shown in 288 frames of 5 minutes. The analysis performed shows significant differences between the three groups, with 90% to 100% specificity and sensitivity, making this study a promising precedent for the development of a low-cost, non-invasive method for detecting possible heart failure in asymptomatic patients. © 2020 Creative Commons; the authors hold their copyright.},
  affiliation             = {Escuela Profesional de Física, Universidad Nacional de San Agustín de Arequipa, Av. Independencia sn, Arequipa, Peru; Escuela Profesional de Física, Universidad Nacional de San Agustín de Arequipa, Peru; Escuela de Física, Universidad Central de Venezuela, Venezuela},
  art_number              = {9344232},
  correspondence_address1 = {Cornejo, D.; Escuela Profesional de Física, Av. Independencia sn, Arequipa, Peru; email: mvizcardocunsa@edu.pe},
  document_type           = {Conference Paper},
  doi                     = {10.22489/CinC.2020.270},
  groups                  = {Conference},
  isbn                    = {9781728173825},
  issn                    = {23258861},
  journal                 = {Computing in Cardiology},
  keywords                = {Artificial life; Entropy; Health risks; Heart; Immunology; Noninvasive medical procedures, Asymptomatic patients; Chagas disease; Congestive heart failures; Healthy people; Heart failure; Hearth rhythms; Noninvasive methods; Permutation entropy, Cardiology},
  language                = {English},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85100916050&doi=10.22489%2fCinC.2020.270&partnerID=40&md5=ff719c948be2b263ff3da6d976df3b07},
}

@Conference{Han2020,
  author              = {Han, R. and Du, W. and Wang, W. and Li, F. and Jiang, P. and Liu, S.},
  title = {Research on online diagnosis method of transformer winding deformation based on correlation mining of operating voltage and current},
  year                = {2020},
  note                = {cited By 1},
  publisher           = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {IEEE Int. Conf. High Volt. Eng. Appl., ICHVE - Proc.},
  abstract            = {Transformer is one of the main equipment of power system, winding deformation will lay a hidden danger for the operation of transformer. Most of the existing winding deformation diagnosis methods belong to off-line diagnosis, which has the disadvantages of power cut and long interval period. In this paper, an on-line diagnosis method of transformer winding deformation based on the correlation mining of operating voltage and current is proposed. Through collecting practical cases, the monitoring data before and after transformer winding deformation are compared longitudinally by using the logic regression method, and it is found that only the monitoring data of voltage and current are significantly related to the deformation among the four monitoring indexes of current, voltage, power and oil temperature. Combined with the algorithm of permutation entropy, the data before and after transformer deformation are compared crosswise, it is found that the permutation entropy of many indexes of transformer with winding deformation before and after short circuit is obviously different, while the permutation entropy of each index of transformer without winding deformation is basically the same before and after short circuit. And the on-line diagnosis of winding deformation can be realized by analyzing the actual state of permutation entropy of key indexes of transformer. In this study, a total of 29 transformer winding deformation diagnosis was completed, 27 transformers were correctly identified, and the diagnostic accuracy rate was 93.10%, which verified the effectiveness of the method and its popularization among different types of transformers. © 2020 IEEE.},
  affiliation         = {Electric Power Research Institute, State Grid Zhejiang Electric Power Co. LTD., Hangzhou, China},
  art_number          = {9279788},
  author_keywords     = {data mining; online diagnosis; permutation entropy; transformer; winding deformation},
  document_type       = {Conference Paper},
  doi                 = {10.1109/ICHVE49031.2020.9279788},
  groups              = {Conference},
  isbn                = {9781728155111},
  journal             = {7th IEEE International Conference on High Voltage Engineering and Application, ICHVE 2020 - Proceedings},
  keywords            = {Entropy; Monitoring; Oil filled transformers; Regression analysis; Transformer windings; Winding, Correlation mining; Diagnostic accuracy; On-line diagnosis; Operating voltage; Permutation entropy; Regression method; Transformer winding deformations; Winding deformations, Deformation},
  language            = {English},
  source              = {Scopus},
  url                 = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85099344396&doi=10.1109%2fICHVE49031.2020.9279788&partnerID=40&md5=3da909abda499191a4a7c56facdd97bb},
}

@Conference{Bian2020,
  author                  = {Bian, S. and Zhuo, J. and Zhu, L.},
  title = {Strain Prediction of Bridge SHM Based on CEEMDAN-ARIMA Model},
  year                    = {2020},
