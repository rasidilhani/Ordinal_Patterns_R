  author_keywords         = {Hard c-means clustering algorithm; Multivariate time series; Nonlinear dynamics; Transition network},
  coden                   = {NODYE},
  correspondence_address1 = {Yang, G.; College of Electronic Information and Electrical Engineering, China; email: gyyang@hzu.edu.cn},
  document_type           = {Article},
