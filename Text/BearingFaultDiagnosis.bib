  groups                  = {Journals},
  keywords                = {Entropy; Flow patterns; Flow structure; Gases; Liquids; Multivariant analysis; Time series analysis, Churn flow; Cross recurrences; Flow pattern transition; Industrial processs; Multivariate signals; Multivariate time series; Permutation entropy; Transition mechanism, Two phase flow},
  language                = {English},
