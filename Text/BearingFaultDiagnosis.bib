  author                  = {Qidi, Z. and Junhong, Z. and Guangjian, N. and Tianyi, Z. and Jiewei, L.},
  title = {An improved acoustic signal decomposition approach and its application to noise source separation},
  year                    = {2021},
  editor                  = {Carletti E., Crocker M., Pawelczyk M., Tuma J.},
  note                    = {cited By 0},
  publisher               = {Silesian University Press},
  abbrev_source_title = {"Adv. Acoust., Noise Vib. - " Proc. Int. Congr. Sound Vib., ICSV},
  abstract                = {Characteristic extraction of non-stationary noise signal is the key for addressing acoustic sources of power machinery. In this paper, weighted permutation entropy (PE) is used to optimise the variational mode decomposition (VMD) by means of searching algorithm parameter combination adaptively. For a given signal, the mean weighted PE of decomposed IMFs is minimised to achieve the optimal mode number and quadratic penalty factor through a hybrid algorithm of particle swarm optimisation and simulated annealing. A case study on the noise source identification of a diesel engine is conducted. Vibration and noise data are measured on a test rig under working and motored conditions in a semi-anechoic chamber. Three out of seven decomposed components from the self-adaptive decomposition are further transformed into the time-frequency domain to extract features. Combustion, piston slapping, and fuel injection pump are found for the above three noise components. Since the noise features obtained by the proposed approach are quite clear, the independent component analysis (ICA) that usually used after the traditional feature extraction, is saved off from the noise source identification process. Moreover, the proposed scheme is not limited to noise source recognition but also can be implemented to other signal decomposition and feature extraction problems, such as fault diagnosis. © "Advances in Acoustics, Noise and Vibration - 2021" Proceedings of the 27th International Congress on Sound and Vibration, ICSV 2021. All rights reserved.},
  affiliation             = {State Key Laboratory of Engines, Tianjin University, Tianjin, China; Lab of Neural Engineering and Rehabilitation, Department of Biomedical Engineering, College of Precision Instruments and Optoelectronics Engineering, Tianjin University, Tianjin, China; Academy of Medical Engineering and Translational Medicine, Tianjin University, Tianjin, China},
  author_keywords         = {Feature extraction; Signal decomposition; Time-frequency characteristics; Weighted permutation entropy},
  correspondence_address1 = {Jiewei, L.; State Key Laboratory of Engines, China; email: linjiewei@tju.edu.cn},
  document_type           = {Conference Paper},
  groups                  = {Conference},
  isbn                    = {9788378807995},
  issn                    = {23293675},
  journal                 = {"Advances in Acoustics, Noise and Vibration - 2021" Proceedings of the 27th International Congress on Sound and Vibration, ICSV 2021},
  keywords                = {Acoustic noise; Entropy; Extraction; Frequency domain analysis; Independent component analysis; Particle swarm optimization (PSO); Simulated annealing; Variational mode decomposition, Acoustic signals; Decomposition approach; Features extraction; ITS applications; Noise source; Noise sources identification; Permutation entropy; Signal decomposition; Time-frequency characteristics; Weighted permutation entropy, Feature extraction},
  language                = {English},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85117482649&partnerID=40&md5=481840cd7d401d0036c00e395b675aec},
}

@Article{Bakheet2021,
  author                  = {Bakheet, D. and Alotaibi, N. and Konn, D. and Vollmer, B. and Maharatna, K.},
  journal                 = {IEEE Access},
  title = {Prediction of Cerebral Palsy in Newborns with Hypoxic-Ischemic Encephalopathy Using Multivariate {Eeg} Analysis and Machine Learning},
