}

@Article{Pietruszka2021,
  author                  = {Pietruszka, M.A.},
  journal                 = {Scientific Reports},
  title = {Non-equilibrium phase transition at a critical point of human blood},
  year                    = {2021},
  issn                    = {20452322},
  note                    = {cited By 11},
  number                  = {1},
  volume                  = {11},
  abbrev_source_title = {Sci. Rep.},
  abstract                = {Blood is the basic medium in the existence, evolution and physiological balance of animals and represents the biochemical “Internet” of the body; at least human blood exhibit the presence of an emergent phase that is highly unusual. Homeostasis, the state of the optimal functioning of the body, is maintained in living organisms by many chemical and physical conditions, particularly temperature. However, no regulatory mechanism has been identified that has led to a predetermined (molecularly encoded) optimal, individually variable, very specific temperature of around 36 °C. Additionally, the homeostatic temperature range, which is kept within predetermined limits, is merely an empirical fact. In the following, I will show that the reference temperature that is necessary to achieve homeostasis can be established, and a preset homeostatic range can be determined, using an original experimental method and refined tools of mathematical physics related to the nonlinear measures of the complexity of human blood. Moreover, signatures of a macroscopic coherent state in a non-equilibrium system at a critical temperature are obtained. © 2021, The Author(s).},
  affiliation             = {Faculty of Natural Sciences, Institute of Biology, Biotechnology and Environmental Protection, University of Silesia, 28 Jagiellońska St., Katowice, 40032, Poland},
  art_number              = {22398},
  correspondence_address1 = {Pietruszka, M.A.; Faculty of Natural Sciences, 28 Jagiellońska St., Poland; email: mariusz.pietruszka@us.edu.pl},
  document_type           = {Article},
  doi                     = {10.1038/s41598-021-01909-9},
  groups                  = {Journals},
  keywords                = {article; critical temperature; homeostasis; human; Internet; phase transition; physics; regulatory mechanism; functions of the hemic, lymphatic and reticuloendothelial systems; temperature; theoretical model; thermodynamics; time factor, ion, Blood Physiological Phenomena; Humans; Ions; Models, Theoretical; Phase Transition; Temperature; Thermodynamics; Time Factors},
  language                = {English},
  publisher               = {Nature Research},
  pubmed_id               = {34789814},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85119290501&doi=10.1038%2fs41598-021-01909-9&partnerID=40&md5=c3c924a19d27e101d2936d1f440cbb21},
}

@Article{Yao2021,
  author                  = {Yao, W. and Yao, W. and Wang, J.},
  journal                 = {Chaos, Solitons and Fractals},
  title = {A novel parameter for nonequilibrium analysis in reconstructed state spaces},
  year                    = {2021},
  issn                    = {09600779},
  note                    = {cited By 3},
  volume                  = {153},
  abbrev_source_title = {Chaos Solitons Fractals},
  abstract                = {Kernel methods are widely used for probability estimation by measuring the distribution of low-passed vector distances in reconstructed state spaces. However, the information conveyed by the vector distances that are greater than the threshold has received little attention. In this paper, we consider the probabilistic difference of the kernel transformation in reconstructed state spaces, and derive a novel nonequilibrium descriptor by measuring the fluctuations of the vector distance with respect to the tolerance. We verify the effectiveness of the proposed kernel probabilistic difference using three chaotic series (logistic, Henon, and Lorenz) and a first-order autoregressive series according to the surrogate theory, and we use the kernel parameter to analyze real-world heartbeat data. In the heartbeat analysis, the kernel probabilistic difference, particularly that based on the Kullback–Leibler divergence, effectively characterizes the physiological complexity loss related to reduced cardiac dynamics in the elderly and diseased heartbeats. Overall, the kernel probabilistic difference provides a novel method for the quantification of nonequilibria by characterizing the fluctuation theorem in reconstructed state spaces, and enables reliable detection of cardiac physiological and pathological information from heart rates. © 2021 Elsevier Ltd},
  affiliation             = {School of Geographic and Biologic Information, Smart Health Big Data Analysis and Location Services Engineering Lab of Jiangsu Province, Nanjing University of Posts and Telecommunications, Nanjing, Jiangsu 210023, China; School of Life Science and Technology, University of Electronic Science and Technology of China, Chengdu, 611731, China; Department of hydraulic engineering, School of civil engineering, Tsinghua University, Beijing, 100084, China},
  art_number              = {111568},
  author_keywords         = {Fluctuation theorem; Heaviside kernel; Nonequilibrium; Probability estimation; Reconstructed state spaces},
  coden                   = {CSFOE},
  correspondence_address1 = {Yao, W.; School of Geographic and Biologic Information, China; email: yaowp@njupt.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.chaos.2021.111568},
  groups                  = {Journals},
  keywords                = {Physiology; Probability distributions, Fluctuations theorems; Heaviside; Heaviside kernel; Kernel-methods; Non equilibrium; Nonequilibrium analysis; Probabilistics; Probability estimation; Reconstructed state space; Vector distance, Vector spaces},
  language                = {English},
  publisher               = {Elsevier Ltd},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85118596050&doi=10.1016%2fj.chaos.2021.111568&partnerID=40&md5=ac18df81152c08d20035964afe78ff56},
}

@Article{Xu2021a,
  author                  = {Xu, M. and Shang, P. and Zhang, S.},
  journal                 = {Chaos, Solitons and Fractals},
  title = {A novel and effective method to characterize complex systems},
  year                    = {2021},
  issn                    = {09600779},
