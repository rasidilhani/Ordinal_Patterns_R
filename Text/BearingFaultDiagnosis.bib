  title = {Multi-dimensional wind power prediction based on time-series characterization analysis and {Vmd}-{Emd} quadratic decomposition},
  year                    = {2023},
  note                    = {cited By 0},
  pages = {55--66},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {Proc. - Asia Conf. Power, Energy Eng. Comput. Technol., PEECT},
  abstract                = {Wind power data receive wind volatility and have strong non-smoothness, making it difficult to achieve high accuracy in wind power prediction. To address this challenge, this paper proposes a wind power multi-step prediction model combining VMD (Variational Modal Decomposition), EMD (Empirical Modal Modal Decomposition), Hurst analysis and temporal entropy values. Firstly, the first decomposition of the historical wind power data is carried out by VMD decomposition ; then Hurst analysis is performed on the components of the first decomposition, and the components with low regularity are decomposed twice using EMD decomposition; then the components of the second decomposition are further filtered using permutation entropy, and the components with high entropy values are compared with the high The components with high entropy, high Hurst and low entropy of the secondary decomposition are formed into high randomness irregular component, regular component and low randomness low regularity component; for the three types of components, BP neural network is used to predict them respectively, and they are reorganized into wind power prediction values. The experiments prove that the model proposed in this paper has higher prediction accuracy and faster running time than the current mainstream models, and can achieve more efficient wind power prediction. © 2023 IEEE.},
  affiliation             = {Inner Mongolia University of Technology, School of Data Science and Application, Hohhot, China; Inner Mongolia Agricultural University, School of Computer and Information, Hohhot, China; Inner Mongolia DongRun Energy Technology, Co., Ltd, Hohhot, China},
  author_keywords         = {component; Hurst analysis; multi-step forecasting; permutation entropy; quadratic decomposition; signal decomposition; Wind power forecasting},
  correspondence_address1 = {Zhang, Z.; Inner Mongolia University of Technology, China; email: 1684229325@qq.com},
  document_type           = {Conference Paper},
  doi                     = {10.1109/PEECT59566.2023.00018},
  groups                  = {Conference},
  isbn                    = {9798350313376},
  journal                 = {Proceedings - 2023 Asia Conference on Power, Energy Engineering and Computer Technology, PEECT 2023},
  keywords                = {Entropy; Neural networks; Random processes; Signal processing; Time series analysis; Wavelet decomposition; Weather forecasting, Component; Hurst analysis; Modal decomposition; Multi-step forecasting; Permutation entropy; Power data; Quadratic decomposition; Signal decomposition; Wind power forecasting; Wind power predictions, Wind power},
  language                = {English},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85190664374&doi=10.1109%2fPEECT59566.2023.00018&partnerID=40&md5=135462a1ca11f32ab903dbfee4a7eb9e},
}

@Conference{Minh2023,
  author                  = {Minh, H.B. and Minh, C.B. and An, N.H. and Van Tan, B.},
  title = {Multi-Step Ahead Time Series Prediction Process Based on CEEMDAN Decomposition and Recursive Update Strategy},
  year                    = {2023},
  editor                  = {Bao V.N.Q., Chau L.H.},
