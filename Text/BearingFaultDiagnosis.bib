@Article{Gu2023a,
  author                  = {Gu, Y. and Bao, H. and Xu, Q. and Zhang, X. and Bao, B.},
  journal                 = {IEEE Transactions on Circuits and Systems II: Express Briefs},
  title = {Cascaded Bi-Memristor Hyperchaotic Map},
  year                    = {2023},
  issn                    = {15497747},
  note                    = {cited By 25},
  number                  = {8},
  pages = {3109--3113},
  volume                  = {70},
  abbrev_source_title = {IEEE Trans. Circuits Syst. Express Briefs},
  abstract                = {In order to study the dynamical effects of cascaded memristors, this brief presents a cascaded bi-memristor (CBM) hyperchaotic map by cascading two memristors with identical memristance. The CBM map possesses a plane set of fixed points whose stability closely depends on the memristor initial states. Complex dynamics relied on the control parameters and initial states is revealed using numerical tools. The findings indicate that the CBM map can exhibit the quasi-periodic bifurcation and hyperchaos dependent on the control parameters, especially the bi-stability relied to the memristor initial states and dynamical effects of the non-memristor initial state. Besides, an FPGA implementation is made and its experimentally acquired results well verify the numerical ones. © 2004-2012 IEEE.},
  affiliation             = {Changzhou University, School of Microelectronics and Control Engineering, Changzhou, 213159, China},
  author_keywords         = {cascaded bi-memristor (CBM) map; fixed point; FPGA implementation; hyperchaos; Memristor},
