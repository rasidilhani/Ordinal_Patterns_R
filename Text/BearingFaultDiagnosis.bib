  groups                  = {Journals},
  keywords                = {Chaotic systems; Digital devices; Field programmable gate arrays (FPGA); Lyapunov methods; Number theory; Numerical methods; Perturbation techniques; Random number generation, Chaotic communications; Computational modelling; Dynamic xorshift; Dynamical degradation; Filed-programmable gate array; Number generator; Perturbation method; Programmable gate array; Psedorandom number generator; Security, Numerical models},
  language                = {English},
