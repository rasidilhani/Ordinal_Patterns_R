  document_type           = {Article},
  doi                     = {10.1016/j.physa.2019.123089},
  groups                  = {Journals},
  keywords                = {Commerce; Financial data processing; Financial markets; Scales (weighing instruments); Time series, Amplitude information; Chinese stock market; Cumulative residual entropies; Financial time series; Multiple scale; Nonlinear time series; Permutation entropy; Weight, Entropy},
  language                = {English},
  publisher               = {Elsevier B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85073753752&doi=10.1016%2fj.physa.2019.123089&partnerID=40&md5=a2eda51807bf804e335964b9caa3dac2},
