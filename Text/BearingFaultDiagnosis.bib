  document_type           = {Article},
  doi                     = {10.1177/10775463221134166},
  groups                  = {Journals},
  keywords                = {Decision trees; Embeddings; Entropy; Extraction; Failure analysis; Fault detection; Random forests; Roller bearings; Signal processing, Fault feature; Faults diagnosis; Features extraction; Hierarchical permutation entropy; Intelligent method; Inter-shaft bearing; Locally linear embedding; Permutation entropy; Random forests; Shaft bearing, Feature extraction},
  language                = {English},
