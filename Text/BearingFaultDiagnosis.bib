  note                    = {cited By 0},
  number                  = {2},
  pages = {3948--3953},
  publisher               = {Elsevier B.V.},
  volume                  = {56},
  abbrev_source_title = {IFAC-PapersOnLine},
  abstract                = {This paper proposes a data-driven approach to identify the communication network topology of dynamic multi-agent systems using information transfer. In particular, we focus on the discrete-time phase-coupled oscillators which have a directed tree structure. Our proposed approach is a protocol that adjusts the agents' feedback gain due to synchronization while identifying the communication network topology, which is unknown in advance by an operator outside the network, by using the difference of two transfer entropy values based on the limited state information under transition. After revealing that the steady-state phase allocation is determined by the natural frequencies of the oscillators, we show that oscillations are reduced and fast synchronization is achieved by appropriately adjusting the feedback gain based on the network topology obtained by the proposed method through numerical examples using simple network structures. We also discuss the limitations of the proposed approach. Copyright © 2023 The Authors. This is an open access article under the CC BY-NC-ND license (https://creativecommons.org/licenses/by-nc-nd/4.0/)},
  affiliation             = {Waseda University, Tokyo, 169-8555, Japan; National Institute of Informatics, Tokyo, 101-8430, Japan},
  author_keywords         = {dynamic multi-agent systems; information transfer; mutual information; Network topology identification; phase-coupled oscillation},
  correspondence_address1 = {Koizumi, T.; Waseda UniversityJapan; Wasa, Y.; Waseda UniversityJapan; email: wasa@waseda.jp; Kishida, M.; National Institute of InformaticsJapan; email: kishida@nii.ac.jp},
  document_type           = {Conference Paper},
  doi                     = {10.1016/j.ifacol.2023.10.1333},
  groups                  = {Conference},
  isbn                    = {9781713872344},
  issn                    = {24058963},
  journal                 = {IFAC-PapersOnLine},
  keywords                = {Data communication systems; Information dissemination; Information services; Multi agent systems; Numerical methods; Trees (mathematics), Communication network topology; Coupled oscillations; Dynamic multi-agent system; Feedback gain; Information transfers; Mutual informations; Network topology; Network topology identification; Phase-coupled oscillation; Topology identification, Network topology},
  language                = {English},
