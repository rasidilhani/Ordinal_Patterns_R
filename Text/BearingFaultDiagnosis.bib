  groups                  = {Journals},
  keywords                = {Big data; Deep neural networks; Fault detection; Health; Roller bearings; Signal processing; Vibration analysis, Adjustment mahalanobi-taguchi system; Big data and analytic; Data driven; Data-driven engineering; Deep neural network; Health indices; Mahalanobis-taguchi systems; Modified ensemble empirical mode decomposition; Modified ensemble empirical mode decompositions; Modified health index, Failure analysis},
