@Article{Zhang2022g,
  author                  = {Zhang, Y. and Wang, K. and Wei, Y. and Guo, X. and Wen, J. and Luo, Y.},
  journal                 = {Computers in Biology and Medicine},
  title = {Minimal {Eeg} channel selection for depression detection with connectivity features during sleep},
  year                    = {2022},
  issn                    = {00104825},
  note                    = {cited By 36},
  volume                  = {147},
  abbrev_source_title = {Comput. Biol. Med.},
  abstract                = {Background and objectives: Sleeping cortical electroencephalogram (EEG) has the potential for depression detection, for different sleep structure and cortical connection have been proved in depressed patients. However, the operation of multi-channel sleep EEG recording is cumbersome and requires laboratory equipment and professional sleep technician. Here, we focus on the depression detection using minimal sleep EEG channels. Methods: Sixteen channels of EEG data of 30 patients with depression and 30 age-matched normal controls were recorded during sleep. Power spectral density of each single EEG channel was calculated, followed by measuring the symbolic transfer entropy (STE) and weighed phase lag index (WPLI) between EEG channel pairs in various frequency bands. Thereafter, these features were evaluated by F-score in the two-way classification (depression vs. control) of 30-s sleep EEG segments. Based on the F-score, entropy method was introduced to calculate the weight which could further assess the classification ability of various EEG channels or channel pairs. Finally, machine learning was implemented to verify the important EEG channels or channel pairs in depression diagnosis. Results: The features characterizing the inter-hemispheric connectivity in the posterior lobe, especially in the temporal lobe, showed high classification capacity. The classification accuracy of using two and four EEG channels in the temporal lobe were 97.96% and 99.61%, respectively. Conclusions: This study showed the possibility of using only a few sleep EEG channels for depression screening, which may greatly facilitate the diagnosis of depression outside the hospital. © 2022 Elsevier Ltd},
  affiliation             = {School of Biomedical Engineering, Sun Yat-sen University, Guangzhou, China; Psychology Department, Guangdong 999 Brain Hospital, Guangzhou, China; Key Laboratory of Sensing Technology and Biomedical Instrument of Guangdong Province, Sun Yat-sen University, China},
  art_number              = {105690},
  author_keywords         = {Depression detection; EEG channel Selection; Network connectivity; Sleep EEG; Temporal region},
  coden                   = {CBMDA},
  correspondence_address1 = {Luo, Y.; School of Biomedical Engineering, China; email: luoyuc@163.com; Wen, J.; Psychology Department, China; email: jfwen2000@126.com},
  document_type           = {Article},
  doi                     = {10.1016/j.compbiomed.2022.105690},
  groups                  = {Journals},
  keywords                = {Laboratories; Sleep research; Spectral density, Channel selection; Depression detection; Electroencephalogram channel selection; F-score; Multi channel; Network connectivity; OR channels; Sleep electroencephalogram; Temporal lobes; Temporal region, Electroencephalography, adult; article; clinical article; controlled study; electroencephalogram; entropy; female; human; machine learning; male; nonREM sleep; spectroscopy; temporal lobe; depression; electroencephalography; procedures; sleep, Depression; Electroencephalography; Entropy; Humans; Machine Learning; Sleep},
  language                = {English},
  publisher               = {Elsevier Ltd},
  pubmed_id               = {35687927},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85131717915&doi=10.1016%2fj.compbiomed.2022.105690&partnerID=40&md5=aed2f6ff196e6ee71e0ecb7f13e386d6},
}

@Article{Xu2022b,
  author                  = {Xu, W. and Shen, Y. and Jiang, Q. and Zhu, Q. and Xu, F.},
  journal                 = {Measurement Science and Technology},
  title = {Rolling bearing fault feature extraction via improved SSD and a singular-value energy autocorrelation coefficient spectrum},
  year                    = {2022},
  issn                    = {09570233},
  note                    = {cited By 6},
  number                  = {8},
  volume                  = {33},
  abbrev_source_title = {Meas. Sci. Technol.},
  abstract                = {It is usually difficult to extract weak fault features from rolling bearing vibration signals under noise pollution. To address this problem, a fault feature extraction approach for rolling bearings using improved singular spectrum decomposition (SSD) and a singular-value energy autocorrelation coefficient spectrum (SVEACS) is proposed. Firstly, to facilitate the determination of the optimal modal parameters in the SSD algorithm, the number of SSD layers is adaptively determined using an improved SSD algorithm based on permutation entropy. Then, the optimal modal components are selected, and the proposed SVEACS is used to determine the order of singular-value noise reduction. Finally, envelope analysis is used to extract the accurate shock characteristics of the denoised signal. The results of the experiments on simulated and real signals indicate that the proposed method can effectively extract the weak characteristics of the vibration signal under strong noise, and accurately diagnose the fault of a rolling bearing. © 2022 IOP Publishing Ltd.},
  affiliation             = {School of Mechanical Engineering, Suzhou University of Science and Technology, Suzhou, 215009, China; College of Automation, Nanjing University of Posts and Telecommunications, Nanjing, 210003, China},
  art_number              = {085112},
  author_keywords         = {feature extraction; improved singular spectrum decomposition; rolling bearing; singular value energy autocorrelation coefficient spectrum},
  coden                   = {MSTCE},
  correspondence_address1 = {Jiang, Q.; School of Mechanical Engineering, China; email: qschiang@163.com},
  document_type           = {Article},
  doi                     = {10.1088/1361-6501/ac66c3},
  groups                  = {Journals},
  keywords                = {Autocorrelation; Extraction; Modal analysis; Roller bearings, Autocorrelation coefficient; Energy autocorrelation; Features extraction; Improved singular spectrum decomposition; Rolling bearings; Singular spectrum; Singular value energy autocorrelation coefficient spectrum; Singular values; Spectra's; Spectrum decomposition, Feature extraction},
  language                = {English},
  publisher               = {Institute of Physics},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85131359573&doi=10.1088%2f1361-6501%2fac66c3&partnerID=40&md5=35a4aca86be6152989a9993e0cf05507},
}

@Article{Zhu2022a,
  author                  = {Zhu, M. and Yang, H.F. and Liu, C. and Pu, Z. and Wang, Y.},
  journal                 = {Accident Analysis and Prevention},
  title = {Real-time crash identification using connected electric vehicle operation data},
  year                    = {2022},
  issn                    = {00014575},
  note                    = {cited By 11},
  volume                  = {173},
  abbrev_source_title = {Accid. Anal. Prev.},
  abstract                = {As the automobile market gradually develops towards intelligence, networking, and information-orientated, intelligent identification based on connected vehicle data becomes a key technology. Specifically, real-time crash identification using vehicle operation data can enable automotive companies to obtain timely information on the safety of user vehicle usage so that timely customer service and roadside rescue can be provided. In this paper, an accurate vehicle crash identification algorithm is developed based on machine learning techniques using electric vehicles’ operation data provided by SAIC-GM-Wuling. The point of battery disconnection is identified as a potential crash event. Data before and after the battery disconnection is retrieved for feature extraction. Two different feature extraction methods are used: one directly extracts the descriptive statistical features of various variables, and the other directly unfolds the multivariate time series data. The AdaBoost algorithm is used to classify whether a potential crash event is a real crash using the constructed features. Models trained with the two different features are fused for the final outputs. The results show that the final model is simple, effective, and has a fast inference speed. The model has an F1 score of 0.98 on testing data for crash classification, and the identified crash times are all within 10 s around the true crash times. All data and code are available at https://github.com/MeixinZhu/vehicle-crash-identification. © 2022 Elsevier Ltd},
  affiliation             = {Department of Civil and Environmental Engineering, University of Washington, United States; School of Engineering, Monash University, Australia},
  art_number              = {106708},
  author_keywords         = {Anomaly detection; Connected vehicle; Crash recognition; Electric vehicles; Intelligent transportation},
  coden                   = {AAPVB},
  correspondence_address1 = {Wang, Y.; Department of Civil and Environmental Engineering, United States; email: yinhai@uw.edu},
  document_type           = {Article},
  doi                     = {10.1016/j.aap.2022.106708},
  groups                  = {Journals},
  keywords                = {Accidents; Adaptive boosting; Classification (of information); Electric vehicles; Extraction; Machine learning; Secondary batteries, Anomaly detection; Automotive companies; Connected vehicle; Crash recognition; Customer-service; Intelligent identification; Intelligent transportation; Key technologies; Real- time; Vehicle operations, Anomaly detection, algorithm; car; car driving; human; prevention and control; technology; traffic accident, Accidents, Traffic; Algorithms; Automobile Driving; Automobiles; Humans; Technology},
  language                = {English},
  publisher               = {Elsevier Ltd},
  pubmed_id               = {35640365},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85131059951&doi=10.1016%2fj.aap.2022.106708&partnerID=40&md5=7a5d1dfc0d14f00a61d4bebbbece338e},
}

@Article{Gandhi2022,
  author                  = {Gandhi, C.P. and Kumar, A. and Vashist, G. and Tang, H. and Rai, A. and Xiang, J.},
  journal                 = {Measurement Science and Technology},
  title = {Maximal overlap discrete wavelet packet transforms and variants of neutrosophic cubic cross-entropy-based identification of rotor defects},
  year                    = {2022},
  issn                    = {09570233},
  note                    = {cited By 5},
  number                  = {8},
  volume                  = {33},
  abbrev_source_title = {Meas. Sci. Technol.},
  abstract                = {The present study proposes a novel procedure for automated testimony of rotor defects through maximal overlap discrete wavelet packet transform (MODWPT) and the proposed neutrosophic cubic cross-entropy, fuzzy cross-entropy and single-valued neutrosophic cross-entropy (NCE) measures consecutively. Discrete wavelet transform is an efficient data decomposition technique, but the technical barrier with this technique is that it can decompose only low-frequency (approximate) signals and also it does not possess the shift invariance property. MODWPT possesses the shift invariance property and is highly capable of decomposing both approximate and detailed signals in time-frequency analysis. After the decomposition of raw signals through MODWPT, the lower and upper bounds of normalized energy readings of various rotor defect conditions (familiar and unfamiliar) are extracted and converted into the forms of fuzzy sets, single-valued neutrosophic sets and neutrosophic cubic sets respectively. The minimum neutrosophic cubic cross-entropy measure as well as fuzzy and single-valued NCE measure values between each rotor defect condition (familiar and unfamiliar) are computed and then utilized to identify various rotor defect conditions, such as parallel and angular misalignment of 7 Mils, rub, unbalance and defect-free respectively. The proposed variants of cross-entropy measure are intelligent in identifying the rotor defect conditions in comparison with the existing cosine similarity measure which exhibits unjustified and meaningless results during mathematical treatments. © 2022 IOP Publishing Ltd.},
  affiliation             = {Department of Mathematics, Rayat Bahra University, Mohali, 140 104, India; College of Mechanical and Electrical Engineering, Wenzhou University, Wenzhou, 325 035, China; Sant Longowal Institute of Engineering and Technology, Longowal, 148 106, India; School of Engineering and Applied Science, Ahmedabad University, Ahmedabad, 380 009, India},
  art_number              = {085107},
  author_keywords         = {maximal overlap discrete wavelet packet transforms; neutrosophic cubic cross-entropy; rotor defects},
  coden                   = {MSTCE},
  correspondence_address1 = {Kumar, A.; College of Mechanical and Electrical Engineering, China; email: anil_taneja86@yahoo.com},
  document_type           = {Article},
  doi                     = {10.1088/1361-6501/ac6001},
  groups                  = {Journals},
  keywords                = {Discrete wavelet transforms; Entropy; Signal reconstruction; Wavelet analysis; Wavelet decomposition, Condition; Cross entropy; Discrete wavelet packet transforms; Entropy measure; Entropy-based; Identification of rotors; Maximal overlap discrete wavelet packet transform; Neutrosophic cubic cross-entropy; Rotor defect; Shift-invariance properties, Defects},
  language                = {English},
  publisher               = {Institute of Physics},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85130457929&doi=10.1088%2f1361-6501%2fac6001&partnerID=40&md5=587e8ddb5e09a8f1f589eb50f68dbe3f},
}

@Article{Sun2022a,
  author                  = {Sun, J. and Zhao, P. and Sun, S.},
  journal                 = {Resources Policy},
  title = {A new secondary decomposition-reconstruction-ensemble approach for crude oil price forecasting},
  year                    = {2022},
  issn                    = {03014207},
  note                    = {cited By 41},
  volume                  = {77},
  abbrev_source_title = {Resour. Policy},
  abstract                = {This study proposes a new method for crude oil future price forecasting. The original crude oil futures price series is decomposed into a series of sub-sequences using the improved complete ensemble empirical mode decomposition with adaptive noise (ICEEMDAN) method, and the permutation entropy (PE) method is employed to reconstruct these sub-sequences into high-frequency, low-frequency, and trend components. Using the kernel extreme learning machine (KELM) optimised by the chaotic sparrow search algorithm (CSSA), the low-frequency component and trend component are predicted. However, the high-frequency component is decomposed secondary to the empirical mode decomposition (EMD) method, and the PE and CSSA-KELM models are employed again to obtain the linear integrating prediction result for the high-frequency component. Finally, the forecasting results of the high-frequency, low-frequency, and trend components are nonlinearly integrated with the CSSA-KELM model, and the final forecasting value for crude oil futures prices is obtained. To verify the effectiveness of the proposed model, we empirically forecast the Brent and WTI crude oil futures prices. The empirical results show that the approach proposed in this study improves forecasting accuracy compared to other benchmark models and has good robustness. © 2022 Elsevier Ltd},
  affiliation             = {School of Statistics, Lanzhou University of Finance and Economics, Lanzhou, 730020, China; Center for Quantitative Analysis of Gansu Economic Development, Lanzhou, 730020, China; School of Management, Xi'an Jiaotong University, Xi'an, 710049, China},
  art_number              = {102762},
  author_keywords         = {Chaotic sparrow search algorithm; Crude oil forecasting; Kernel extreme learning machine; Permutation entropy; Secondary decomposition},
  correspondence_address1 = {Sun, S.; School of Management, China; email: sunshaolong@xjtu.edu.cn},
  document_type           = {Article},
