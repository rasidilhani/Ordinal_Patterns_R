}

@Article{Song2017,
  author            = {Song, Wei and Wang, Zhiguang and Zhang, Fan and Ye, Yangdong and Fan, Ming},
  journal           = {Intelligent Data Analysis},
  title = {Empirical study of symbolic aggregate approximation for time series classification},
  year              = {2017},
  note              = {Cited by: 12},
  number            = {1},
  pages             = {135 – 150},
  volume            = {21},
  abstract          = {Symbolic Aggregate approximation (SAX) has been the de facto standard representation methods for knowledge discovery in time series on a number of tasks and applications. So far, very little work has been done in empirically investigating the intrinsic properties and statistical mechanics in SAX words. In this paper, we applied several statistical measurements and proposed a new statistical measurement, i.e. information embedding cost (IEC) to analyze the statistical behaviors of the symbolic dynamics. Our experiments on the benchmark datasets and the clinical signals demonstrate that SAX can always reduce the complexity while preserving the core information embedded in the original time series with significant embedding efficiency, as well as robust to missing values and noise. Our proposed IEC score provide a priori to determine if SAX is adequate for specific dataset, which can be generalized to evaluate other symbolic representations. Our work provides an analytical framework with several statistical tools to analyze, evaluate and further improve the symbolic dynamics for knowledge discovery in time series. © 2017 - IOS Press and the authors. All rights reserved.},
  doi               = {10.3233/IDA-150351},
  groups            = {Journals},
  publication_stage = {Final},
  source            = {Scopus},
  type              = {Conference paper},
  url               = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85009841557&doi=10.3233%2fIDA-150351&partnerID=40&md5=f299805e609ad0c47af63dc100c9cc6c},
}

@Article{Mihailovic2017,
  author            = {Mihailović, D.T. and Balaž, I. and Kapor, D.},
  journal           = {Developments in Environmental Modelling},
  title = {Logistic difference equation on extended domain},
  year              = {2017},
  note              = {Cited by: 0},
  pages             = {77 – 83},
  volume            = {29},
  abstract          = {This chapter is devoted to the logistic difference equation on the extended domain. First, we extend the domain [0, 4] in which the logistic parameter of the classical logistic equation is defined, to the domain [−2, 4]. We discuss and analyze properties of the parameter of difference equation, which is ranged in this domain, using bifurcation diagram, Lyapunov exponent, sample entropy, and permutation entropy. Thereafter we perform a dynamical analysis of coupled maps serving the combined coupling that includes the logistic equation on extended domain. In that analysis we use Lyapunov exponent and cross-sample entropy. © 2016 Elsevier B.V.},
  doi               = {10.1016/B978-0-444-63918-9.00009-0},
  groups            = {Journals},
  publication_stage = {Final},
  source            = {Scopus},
