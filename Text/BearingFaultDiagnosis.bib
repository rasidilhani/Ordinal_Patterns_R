  journal                 = {Fractal and Fractional},
  title = {Multifractal Properties of Human Chromosome Sequences},
  year                    = {2024},
  issn                    = {25043110},
  note                    = {cited By 0},
  number                  = {6},
  volume                  = {8},
  abbrev_source_title = {Fractal Fract.},
  abstract                = {The intricacy and fractal properties of human DNA sequences are examined in this work. The core of this study is to discern whether complete DNA sequences present distinct complexity and fractal attributes compared with sequences containing exclusively exon regions. In this regard, the entire base pair sequences of DNA are extracted from the NCBI (National Center for Biotechnology Information) database. In order to create a time series representation for the base pair sequence (Formula presented.), we use the Chaos Game Representation (CGR) approach and a mapping rule f, which enables us to apply the metric known as the Complexity–Entropy Plane (CEP) and multifractal detrended fluctuation analysis (MF-DFA). To carry out our investigation, we divided human DNA into two groups: the first is composed of the 24 chromosomes, which comprises all the base pairs that form the DNA sequence, and another group that also includes the 24 chromosomes, but the DNA sequences rely only on the exons’ presence. The results show that both sets provide fractal patterns in their structure, as obtained by the CGR approach. Complete DNA sequences show a sharper visual fractal pattern than sequences composed only of exons. Moreover, the sequences occupy distinct areas of the complexity–entropy plane, and the complete DNA sequences lead to greater statistical complexity and lower entropy than the exon sequences. Also, we observed that different fractal parameters between chromosomes indicate diversity in genomic sequences. All these results occur in different scales for all chromosomes. © 2024 by the authors.},
  affiliation             = {Departamento de Física, Universidade Federal do Rio Grande do Norte, Natal, 59072-970, Brazil; Departamento de Física, Universidade do Estado do Rio Grande do Norte, Mossoró, 59610-210, Brazil; National Institute of Science and Technology of Complex Systems, Centro Brasileiro de Pesquisas Físicas, Rio de Janeiro, 22290-180, Brazil},
  art_number              = {312},
  author_keywords         = {chaotic dynamics; complexity; DNA; entropy; multifractal},
  correspondence_address1 = {Silva, R.; Departamento de Física, Brazil; email: raimundosilva@fisica.ufrn.br},
  document_type           = {Review},
  doi                     = {10.3390/fractalfract8060312},
  groups                  = {Journals},
