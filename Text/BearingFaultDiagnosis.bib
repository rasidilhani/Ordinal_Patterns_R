}

@Article{Wu2023c,
  author                  = {Wu, Y. and Guo, X. and Du, S. and Ju, H. and Zhao, Y. and Wu, J. and Jia, X.},
  journal                 = {Jixie Qiangdu/Journal of Mechanical Strength},
  title = {ROTOR FAULT FEATURE EXTRACTION METHOD USING MVMD AND IEDPE [MVMD 与 IEDPE 结合的转子故障特征提取方法]},
