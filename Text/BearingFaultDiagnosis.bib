  author                  = {Xue, X. and Yan, H. and Yi, X.},
  journal                 = {Shenzhen Daxue Xuebao (Ligong Ban)/Journal of Shenzhen University Science and Engineering},
  title = {Fiber fault detection based on communication signal [基于通信信号本身实现光纤故障检测]},
