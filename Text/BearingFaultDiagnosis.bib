  journal                 = {Entropy},
  title = {Performance Baseline of Phase Transfer Entropy Methods for Detecting Animal Brain Area Interactions},
  year                    = {2023},
  issn                    = {10994300},
  note                    = {cited By 2},
  number                  = {7},
  volume                  = {25},
  abbrev_source_title = {Entropy},
  abstract                = {Objective: Phase transfer entropy (Formula presented.) methods perform well in animal sensory–spatial associative learning. However, their advantages and disadvantages remain unclear, constraining their usage. Method: This paper proposes the performance baseline of the (Formula presented.) methods. Specifically, four (Formula presented.) methods are applied to the simulated signals generated by a neural mass model and the actual neural data from ferrets with known interaction properties to investigate the accuracy, stability, and computational complexity of the (Formula presented.) methods in identifying the directional coupling. Then, the most suitable method is selected based on the performance baseline and used on the local field potential recorded from pigeons to detect the interaction between the hippocampus (Hp) and nidopallium caudolaterale (NCL) in visual–spatial associative learning. Results: (1) This paper obtains a performance baseline table that contains the most suitable method for different scenarios. (2) The (Formula presented.) method identifies an information flow preferentially from Hp to NCL of pigeons at the (Formula presented.) band (4–12 Hz) in visual–spatial associative learning. Significance: These outcomes provide a reference for the (Formula presented.) methods in detecting the interactions between brain areas. © 2023 by the authors.},
  affiliation             = {School of Electrical and Information Engineering, Zhengzhou University, Zhengzhou, 450001, China; Henan Key Laboratory of Brain Science and Brain-Computer Interface Technology, Zhengzhou, 450001, China},
  art_number              = {994},
  author_keywords         = {hippocampus; interaction; nidopallium caudolaterale; phase transfer entropy; pigeon; visual–spatial associative learning},
  correspondence_address1 = {Liu, G.; School of Electrical and Information Engineering, China; email: gangliu_@zzu.edu.cn; Wan, H.; School of Electrical and Information Engineering, China; email: wanhong@zzu.edu.cn},
  document_type           = {Article},
