  groups                  = {Conference},
  issn                    = {23987340},
  journal                 = {EPiC Series in Computing},
  keywords                = {Bioinformatics; Convolution; Diagnosis; Entropy; Neurology, Automatic diagnosis; Automatic diagnostics; Classification accuracy; Clinical practices; Multiple feature fusion; Short time Fourier transforms; Time frequency features; Visual recognition, Convolutional neural networks},
  language                = {English},
