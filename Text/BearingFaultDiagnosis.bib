@InProceedings{WOS:000452819600235,
  author                     = {Bai Lin and Xi Wei and Yan Yuchan and Ye Zhen},
  booktitle = {TENTH INTERNATIONAL CONFERENCE ON DIGITAL IMAGE PROCESSING (ICDIP 2018)},
  title = {Early Fault Diagnosis of Bearing Using Empirical Wavelet Transform with Energy Entropy},
  year                       = {2018},
  address                    = {1000 20TH ST, PO BOX 10, BELLINGHAM, WA 98227-0010 USA},
  editor                     = {Jiang, X and Hwang, JN},
  note                       = {10th International Conference on Digital Image Processing (ICDIP), E China Normal Univ, Shanghai, PEOPLES R CHINA, MAY 11-14, 2018},
  organization               = {Shanghai Key Lab Multidimens Informat Proc; Int Assoc Comp Sci \& Informat Technol},
  publisher                  = {SPIE-INT SOC OPTICAL ENGINEERING},
  series                     = {Proceedings of SPIE},
  volume                     = {10806},
  abstract                   = {A novel bearing fault diagnosis method is proposed in this paper, which
   is based on Empirical Wavelet Transform (EWT) with energy entropy. In
   this method, first the vibration signal of rolling bearing is decomposed
   by the EWT, and several AM-FM components are obtained. Then calculated
   the energy entropy of each IMFs respectively and the sensitive IMF is
   selected according to the value of energy entropy. Finally, the Hilbert
   transform to the sensitive IMF and using the envelope spectrum to detect
   bearing fault characteristic frequency. The experiment results show that
   the proposed method is accurate and can provide a good performance in
   the outer race, inner race and rolling element faults detection.},
  affiliation                = {Bai, L (Corresponding Author), Changan Univ, Sch Elect \& Control Engn, Xian, Shaanxi, Peoples R China. Bai Lin; Xi Wei; Yan Yuchan; Ye Zhen, Changan Univ, Sch Elect \& Control Engn, Xian, Shaanxi, Peoples R China.},
  affiliations               = {Chang'an University},
