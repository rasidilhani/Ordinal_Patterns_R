  author                  = {Feng, T. and Liu, C.-S. and Xu, A. and Wang, C.-H. and Wang, F.-M. and Liu, X. and Su, S.-T.},
  title = {Research on Transformer Partial Discharge Feature Extraction Based on Empirical Wavelet Transform and Multiscale Permutation Entropy},
  year                    = {2023},
  note                    = {cited By 2},
