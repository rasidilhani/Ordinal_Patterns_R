}

@Article{Li2022k,
  author                  = {Li, S. and Shang, P.},
  journal                 = {Chaos, Solitons and Fractals},
  title = {A new complexity measure: Modified discrete generalized past entropy based on grain exponent},
  year                    = {2022},
  issn                    = {09600779},
  note                    = {cited By 4},
  volume                  = {157},
  abbrev_source_title = {Chaos Solitons Fractals},
  abstract                = {In this paper, we propose the modified discrete generalized past entropy based on grain exponent (GE-MDGPE), to analyze complex dynamical systems. Gao et al. proposed discrete generalized past entropy based on oscillation-based grain exponent (O-DGPE) method in 2019, which has been proved to be a good measure of uncertainty of time series. Whereas, it still has some drawbacks, such as the effectiveness of O-DGPE is not good when characterizing some special systems. In order to solve these drawbacks, we therefore generalize O-DGPE method to put forward GE-MDGPE which can better characterize complex systems. While using two artificial model (logistic map, Hénon map) to qualify the proposed method, we find that the method can characterize the system more accurately than O-DPGE, and can distinguish the periodic system and chaotic system effectively and sensitively. Moreover, we discuss the influence of parameters β and j on the proposed method. At last, we apply the proposed method to analyze the financial series which are extracting from six indices: three U.S. stock indices and three Chinese stock indices. The results show that the method can clearly distinguish the stock markets of different levels of development, and the U.S. market and the Hong Kong market are more mature than the Chinese mainland market. © 2022 Elsevier Ltd},
  affiliation             = {Department of Mathematics, Beijing Jiaotong University, Beijing, 100044, China},
  art_number              = {111928},
  author_keywords         = {Discrete generalized past entropy; Financial series; Grain exponent; Hénon map; Logistic map},
  coden                   = {CSFOE},
  correspondence_address1 = {Li, S.; Department of Mathematics, China; email: 18118017@bjtu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.chaos.2022.111928},
  groups                  = {Journals},
  keywords                = {Chaotic systems; Commerce; Financial markets, Complex dynamical systems; Complexity measures; Discrete generalized past entropy; Entropy-based; Financial series; Grain exponent; Henon map; Logistic maps; Measure of uncertainty; Stock indices, Entropy},
  language                = {English},
  publisher               = {Elsevier Ltd},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85125230038&doi=10.1016%2fj.chaos.2022.111928&partnerID=40&md5=85ad2744848a47cd82cfb3a75d4f35aa},
}

@Article{Wang2022k,
  author                  = {Wang, X. and Si, S. and Li, Y.},
