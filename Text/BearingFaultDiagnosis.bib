  keywords                = {Brain computer interface; Electroencephalography; Markov processes; Reinforcement learning, Channel classification; Channel selection; Deep neural network; Deep Q-network; Deep reinforcement learning; EEG channel classification; Model training; Optimal channels; Reinforcement learnings; Speed up, Deep neural networks},
