  groups                  = {Journals},
  keywords                = {Clusterings; Dynamic correction; Error dynamic correction; Error dynamics; Improved clustering distance; Learnable graph deviation attention network structure; Load peak and valley characteristic; Mode decomposition; Network structures; Power predictions; Successive variational mode decomposition; Ultra-short-term power prediction, Wind forecasting, artificial neural network; error correction; graphical method; prediction; wind farm; wind power},
  language                = {English},
  publisher               = {Elsevier Ltd},
  source                  = {Scopus},
