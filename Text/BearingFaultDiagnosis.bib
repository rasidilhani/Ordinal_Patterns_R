@Article{Zheng2020,
  author                  = {Zheng, J. and Pan, H. and Liu, Q. and Ding, K.},
  journal                 = {Physica A: Statistical Mechanics and its Applications},
  title = {Refined time-shift multiscale normalised dispersion entropy and its application to fault diagnosis of rolling bearing},
  year                    = {2020},
  issn                    = {03784371},
  note                    = {cited By 33},
  volume                  = {545},
  abbrev_source_title = {Phys A Stat Mech Appl},
  abstract                = {Multiscale entropy (MSE) and multiscale permutation entropy (MPE) are two effective nonlinear dynamic complexity measurement methods of time series that have been applied to many areas for complexity feature extraction in recent years. To overcome the inherent defects of sample entropy and permutation entropy, together with the coarse graining process used in MSE and MPE, based on the recently proposed dispersion entropy (DisEn), the refined time-shift multiscale normalised dispersion entropy (RTSMNDE) is proposed here for the complexity measurement of time series. In the RTSMNDE method, first, to expand DisEn to the multiscale framework, the time-shift multiscale method is used to replace the traditional coarse graining multiscale method. The refining approach is adopted to alleviate the fluctuation of DisEns in larger scale factors, and a normalisation operation is implemented on all entropies to restrain the influence of the parameters on RTSMNDE values. Furthermore, the RTSMNDE is compared with the multiscale dispersion entropy (MDE) by analysing synthetic simulation signals to verify its effectiveness. Based on that, an intelligent fault diagnosis method for rolling bearings is proposed by combining the RTSMNDE for fault feature extraction with the particle swarm optimisation support vector machine for feature classification. Finally, the proposed method is applied to rolling bearing experimental data analysis, and the analysis results show that the proposed method can effectively diagnose the locations and degrees of rolling bearing failures and obtain a higher recognition rate than those of the MPE and MDE-based methods. © 2019 Elsevier B.V.},
  affiliation             = {School of Mechanical Engineering, Anhui University of Technology, Maanshan, Anhui, 243032, China; School of Mechanical and Manufacturing Engineering, UNSW Sydney, NSW 2052, Australia; China Special Equipment Inspection and Research Institute, Beijing, 100029, China},
  art_number              = {123641},
  author_keywords         = {Dispersion entropy; Fault diagnosis; Multiscale entropy; Multiscale permutation entropy; Refined time-shift multiscale dispersion entropy; Rolling bearing},
  coden                   = {PHYAD},
  correspondence_address1 = {Zheng, J.; School of Mechanical Engineering, China; email: jdzheng@ahut.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.physa.2019.123641},
  groups                  = {Journals},
  keywords                = {Computer aided diagnosis; Dispersions; Entropy; Extraction; Failure analysis; Fault detection; Feature extraction; Particle swarm optimization (PSO); Support vector machines; Time series, Experimental data analysis; Intelligent fault diagnosis; Multi-scale entropies; Multiscale permutation entropies (MPE); Particle swarm optimisation; Permutation entropy; Rolling bearings; Time shifts, Roller bearings},
  language                = {English},
  publisher               = {Elsevier B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85076218879&doi=10.1016%2fj.physa.2019.123641&partnerID=40&md5=29813b89388b4e64d012e1b37a7e599c},
}

@Article{Zhou2020b,
  author                  = {Zhou, G. and Pan, Y. and Yang, J. and Zhang, X. and Guo, X. and Luo, Y.},
  journal                 = {Frontiers in Neuroscience},
  title = {Sleep Electroencephalographic Response to Respiratory Events in Patients With Moderate Sleep Apnea–Hypopnea Syndrome},
  year                    = {2020},
  issn                    = {16624548},
  note                    = {cited By 15},
  volume                  = {14},
  abbrev_source_title = {Front. Neurosci.},
  abstract                = {Sleep apnea–hypopnea syndrome is a common breathing disorder that can lead to organic brain injury, prevent memory consolidation, and cause other adverse mental-related complications. Brain activity while sleeping during respiratory events is related to these dysfunctions. In this study, we analyzed variations in electroencephalography (EEG) signals before, during, and after such events. Absolute and relative powers, as well as symbolic transfer entropy (STE) of scalp EEG signals, were calculated to unveil the activity of brain regions and information interactions between them, respectively. During the respiratory events, only low-frequency power increased during rapid eye movement (REM) stage (δ-band absolute and relative power) and N1 (δ- and θ-band absolute power, δ-band relative power) sleep. But absolute power increased in low- and medium-frequency bands (δ, θ, α, and σ bands), and relative power increased mainly in the medium-frequency band (α and σ bands) during stage N2 sleep. After the respiratory events, absolute power increased in all frequency bands and sleep stages, but relative power increased in medium and high frequencies. Regarding information interactions, the β-band STE decreased during and after events. In the γ band, the intrahemispheric STE increased during events and decreased afterward. Moreover, the interhemisphere STE increased after events during REM and stage N1 sleep. The EEG changes throughout respiratory events are supporting evidence for previous EEG knowledge of the impact of sleep apnea on the brain. These findings may provide insights into the influence of the sleep apnea–hypopnea syndrome on cognitive function and neuropsychiatric defects. © Copyright © 2020 Zhou, Pan, Yang, Zhang, Guo and Luo.},
  affiliation             = {School of Biomedical Engineering, Sun Yat-sen University, Guangzhou, China; Sleep-Disordered Breathing Center, The Sixth Affiliated Hospital, Sun Yat-sen University, Guangzhou, China; Department of Psychology, Guangdong 999 Brain Hospital, Guangzhou, China; Guangdong Provincial Key Laboratory of Sensing Technology and Biomedical Instruments, Sun Yat-sen University, Guangzhou, China},
  art_number              = {310},
  author_keywords         = {effective connectivity; electroencephalography; respiratory events; sleep apnea–hypopnea syndrome; symbolic transfer entropy},
  correspondence_address1 = {Luo, Y.; School of Biomedical Engineering, China; email: luoyuc@163.com},
  document_type           = {Article},
  doi                     = {10.3389/fnins.2020.00310},
  groups                  = {Journals},
  keywords                = {adult; Article; brain function; brain region; electroencephalography; female; human; interhemispheric transfer; major clinical study; male; middle aged; REM sleep; sleep disordered breathing; sleep stage; symbolic transfer entropy},
  language                = {English},
  publisher               = {Frontiers Media S.A.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85084258952&doi=10.3389%2ffnins.2020.00310&partnerID=40&md5=37a053cf3d5c49a7bd429123be2ebaa6},
}

@Conference{Tavabi2020,
  author              = {Tavabi, N. and Abeliuk, A. and Mokhberian, N. and Abramson, J. and Lerman, K.},
  title = {Challenges in Forecasting Malicious Events from Incomplete Data},
  year                = {2020},
  note                = {cited By 4},
  pages = {603--610},
  publisher           = {Association for Computing Machinery},
  abbrev_source_title = {Web Conf. - Companion World Wide Web Conf., WWW},
  abstract            = {The ability to accurately predict cyber-attacks would enable organizations to mitigate their growing threat and avert the financial losses and disruptions they cause. But how predictable are cyber-attacks Researchers have attempted to combine external data - ranging from vulnerability disclosures to discussions on Twitter and the darkweb - with machine learning algorithms to learn indicators of impending cyber-attacks. However, successful cyber-attacks represent a tiny fraction of all attempted attacks: the vast majority are stopped, or filtered by the security appliances deployed at the target. As we show in this paper, the process of filtering reduces the predictability of cyber-attacks. The small number of attacks that do penetrate the target's defenses follow a different generative process compared to the whole data which is much harder to learn for predictive models. This could be caused by the fact that the resulting time series also depends on the filtering process in addition to all the different factors that the original time series depended on. We empirically quantify the loss of predictability due to filtering using real-world data from two organizations. Our work identifies the limits to forecasting cyber-attacks from highly filtered data. © 2020 ACM.},
  affiliation         = {University of Southern California, Information Sciences Institute, United States},
  author_keywords     = {cyber-attack; forecasting; permutation entropy; predictability; time-series},
  document_type       = {Conference Paper},
  doi                 = {10.1145/3366424.3385774},
  groups              = {Conference},
  isbn                = {9781450370240},
  journal             = {The Web Conference 2020 - Companion of the World Wide Web Conference, WWW 2020},
  keywords            = {Crime; Forecasting; Learning algorithms; Losses; Machine learning; Network security; Predictive analytics; Time series; World Wide Web, Cyber-attacks; Filtering process; Financial loss; Generative process; Incomplete data; Predictive models; Security appliances; Vulnerability disclosure, Computer crime},
  language            = {English},
  source              = {Scopus},
  url                 = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85091699080&doi=10.1145%2f3366424.3385774&partnerID=40&md5=d6c3c42fcff720980a1589920bad113b},
}

@Article{Raad2020,
  author                  = {Raad, J. and Stegmayer, G. and Milone, D.H.},
  journal                 = {Bioinformatics},
  title = {Complexity measures of the mature miRNA for improving pre-miRNAs prediction},
  year                    = {2020},
  issn                    = {13674803},
  note                    = {cited By 8},
  number                  = {8},
  pages = {2319--2327},
  volume                  = {36},
  abbrev_source_title = {Bioinformatics},
  abstract                = {Motivation: The discovery of microRNA (miRNA) in the last decade has certainly changed the understanding of gene regulation in the cell. Although a large number of algorithms with different features have been proposed, they still predict an impractical amount of false positives. Most of the proposed features are based on the structure of precursors of the miRNA only, not considering the important and relevant information contained in the mature miRNA. Such new kind of features could certainly improve the performance of the predictors of new miRNAs. Results: This paper presents three new features that are based on the sequence information contained in the mature miRNA. We will show how these new features, when used by a classical supervised machine learning approach as well as by more recent proposals based on deep learning, improve the prediction performance in a significant way. Moreover, several experimental conditions were defined and tested to evaluate the novel features impact in situations close to genome-wide analysis. The results show that the incorporation of new features based on the mature miRNA allows to improve the detection of new miRNAs independently of the classifier used. © 2020 The Author(s) 2019. Published by Oxford University Press. All rights reserved. For permissions, please e-mail: journals.permissions@oup.com.},
  affiliation             = {Research Institute for Signals, Systems and Computational Intelligence Sinc(i) (FICH-UNL/CONICET), Ciudad Universitaria, Santa Fe, Argentina},
  coden                   = {BOINF},
  correspondence_address1 = {Raad, J.; Research Institute for Signals, Argentina; email: jraad@sinc.unl.edu.ar},
  document_type           = {Article},
  doi                     = {10.1093/bioinformatics/btz940},
  groups                  = {Journals},
  keywords                = {microRNA, algorithm; biology; genetics; genome; supervised machine learning, Algorithms; Computational Biology; Genome; MicroRNAs; Supervised Machine Learning},
  language                = {English},
  publisher               = {Oxford University Press},
  pubmed_id               = {31860057},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85084027763&doi=10.1093%2fbioinformatics%2fbtz940&partnerID=40&md5=212e1dd980fa363ef4b70e2ec1abfe86},
}

@Article{Wang2020g,
  author                  = {Wang, D. and Jin, N. and Zhai, L. and Ren, Y.},
  journal                 = {Chemical Engineering Journal},
  title = {Characterizing flow instability in oil-gas-water three-phase flow using multi-channel conductance sensor signals},
  year                    = {2020},
  issn                    = {13858947},
  note                    = {cited By 14},
  volume                  = {386},
  abbrev_source_title = {Chem. Eng. J.},
  abstract                = {In the present study, a multi-channel conductance sensor is utilized to capture detailed flow structure information in 20 mm inner diameter pipe from different positions of pipe cross section, and multivariate weighted multi-scale permutation entropy (MWMPE) is employed to investigate flow instability in oil-gas-water flows. Then, we decompose the multi-channel conductance sensor signals into different frequency components and reconstruct the multi-scale signals corresponding to different scale flow structures using the multi-resolution analysis (MRA) of wavelet transformation. Following that, the nonlinear dynamic behavior of different scale structures in different flow conditions is investigated by calculating the normalized energy and MWMPE of multi-scale signals. The results suggest that MWMPE of multi-channel conductance sensor signals can effectively reveal the evolution behavior of flow instability in the three-phase flow. The MRA of wavelet transformation can resolve the original signals into multi-scale signals corresponding to different scale flow structures, combined with the MWMPE and normalized energy distribution, the nonlinear dynamic behavior of different scale structures and its internal relations with the flow instability are first uncovered. This paper provides a novel way to fully reveal the flow instability of oil-gas-water three-phase flow from the perspectives of multi-position, multi-scale and multi-structure. © 2019 Elsevier B.V.},
  affiliation             = {School of Electrical and Information Engineering, Tianjin University, Tianjin, 300072, China},
  art_number              = {121237},
  author_keywords         = {Dynamic instability; MRA of wavelet transformation; Multi-channel conductance signals; MWMPE; Oil-gas-water three-phase flow},
  coden                   = {CMEJA},
  correspondence_address1 = {Jin, N.; School of Electrical and Information Engineering, China; email: ndjin@tju.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.cej.2019.03.113},
  groups                  = {Journals},
  keywords                = {Flow structure; Scales (weighing instruments); Stability; Wavelet transforms, Dynamic instability; Multi channel; MWMPE; Three-phase flow; Wavelet transformations, Multiresolution analysis},
  language                = {English},
  publisher               = {Elsevier B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85062834377&doi=10.1016%2fj.cej.2019.03.113&partnerID=40&md5=3436751fe9bf748b61612061dbda85ca},
}

@Article{Zheng2020a,
  author                  = {Zheng, H. and Onoda, K. and Nagai, A. and Yamaguchi, S.},
  journal                 = {Frontiers in Aging Neuroscience},
  title = {Reduced Dynamic Complexity of BOLD Signals Differentiates Mild Cognitive Impairment From Normal Aging},
  year                    = {2020},
  issn                    = {16634365},
  note                    = {cited By 14},
  volume                  = {12},
  abbrev_source_title = {Front. Aging Neurosci.},
  abstract                = {Mild cognitive impairment (MCI) is characterized as a transitional phase between cognitive decline associated with normal aging and Alzheimer’s disease (AD). Resting-state functional magnetic resonance imaging (fMRI) measuring blood oxygenation level-dependent (BOLD) signals provides complementary information considered essential for understanding disease progression. Previous studies suggested that multi-scale entropy (MSE) analysis quantifying the complexity of BOLD signals is a novel and promising method for investigating neurodegeneration associated with cognitive decline in different stages of MCI. Therefore, the current study used MSE to explore the changes in the complexity of resting-state brain BOLD signals in patients with early MCI (EMCI) and late MCI (LMCI). We recruited 345 participants’ data from the Alzheimer’s Disease Neuroimaging Initiative database, including 176 normal control (NC) subjects, 87 patients with EMCI and 82 patients with LMCI. We observed a significant reduction of brain signal complexity toward regularity in the left fusiform gyrus region in the EMCI group and in the rostral anterior cingulate cortex in the LMCI group. Our results extend prior work by revealing that significant reductions of brain BOLD signal complexity can be detected in different stages of MCI independent of age, sex and regional atrophy. Notably, the reduction of BOLD signal complexity in the rostral anterior cingulate cortex was significantly associated with greater risk of progression to AD. The present study thus identified MSE as a potential imaging biomarker for the early diagnosis of pre-clinical Alzheimer’s disease and provides further insights into the neuropathology of cognitive decline in prodromal AD. © Copyright © 2020 Zheng, Onoda, Nagai and Yamaguchi.},
  affiliation             = {Laureate Institute for Brain Research, Tulsa, OK, United States; Department of Neurology, Faculty of Medicine, Shimane University, Izumo, Japan},
  art_number              = {90},
  author_keywords         = {BOLD complexity; imaging biomarker; mild cognitive impairment; multi-scale entropy; resting-state fMRI},
  correspondence_address1 = {Zheng, H.; Laureate Institute for Brain ResearchUnited States; email: hzheng@laureateinstitute.org},
  document_type           = {Article},
  doi                     = {10.3389/fnagi.2020.00090},
  groups                  = {Journals},
  keywords                = {age distribution; aged; aging; anterior cingulate; Article; BOLD signal; brain atrophy; cognitive defect; controlled study; disease exacerbation; disease marker; echo planar imaging; female; functional magnetic resonance imaging; fusiform gyrus; human; image analysis; major clinical study; male; mental deterioration; Mini Mental State Examination; multi scale entropy analysis; neurologic examination; proportional hazards model; resting state network; sex difference},
  language                = {English},
  publisher               = {Frontiers Media S.A.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85083487336&doi=10.3389%2ffnagi.2020.00090&partnerID=40&md5=c18a0c95d35bb238f66cd71e621a4bb8},
}

@Article{Luo2020,
  author                  = {Luo, S. and Yang, W. and Luo, Y.},
  journal                 = {Entropy},
  title = {Fault diagnosis of a rolling bearing based on adaptive sparest narrow-band decomposition and refined composite multiscale dispersion entropy},
  year                    = {2020},
