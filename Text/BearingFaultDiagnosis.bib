  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85193555736&doi=10.1088%2f1741-2552%2fad4914&partnerID=40&md5=8c3ecd8e7a58c3e16fda6dfb4372cab7},
}

@Article{Zhang2024f,
  author                  = {Zhang, S. and Zhu, K. and Sun, X. and Li, D. and Gao, M. and Han, X.},
  journal                 = {Journal of Hydrology: Regional Studies},
  title = {The role of matching pursuit algorithm and multi-scale daily rainfall data obtained from decomposition in runoff prediction},
  year                    = {2024},
  issn                    = {22145818},
  note                    = {cited By 0},
  volume                  = {53},
  abbrev_source_title = {J. Hydrol. Reg. Stud.},
  abstract                = {Study Region: Huai River Basin, China Study Focus: Runoff data preprocessing and strongly correlated influencing factors are vital to predicting runoff by machine learning methods due to the impact of human activities and changing climate. To address the issue of noise interference in the runoff components post-decomposition. This study introduces a novel denoising technique that integrates the matching pursuit algorithm with permutation entropy. Furthermore, to enhance the correlation of the input factors, multi-scale daily rainfall data obtained through decomposition is utilized as input to the model for the first time. The aim of preprocessing the original runoff is to diminish noise interference and reduce the complexity of the subsequences. This method effectively increases the prediction accuracy. New hydrological insights for the region: The matching pursuit algorithm considerably decreases the noise interference and the complexity of the runoff. The effectiveness of the proposed method is shown through comparison with typical denoising methods. Meanwhile, multi-scale daily rainfall data acquired through rainfall data decomposition have stronger correlation with runoff components. Through data preprocessing methods and strongly correlated factors, despite the significant fluctuations and severe seasonal variations observed at the three selected test hydrological stations in the Huaihe River basin, the proposed model still achieves accurate prediction results. This offers new viewpoints on forecasting runoff in basins characterized by significant flow variations. © 2024 The Authors},
  affiliation             = {School of Resources and Earth Sciences, China University of Mining and Technology, Xuzhou, 221116, China; School of Geology and Mining Engineering, Xinjiang University, Urumqi, 830047, China},
  art_number              = {101836},
  author_keywords         = {Denoising; Fully stepwise variational mode decomposition (FSVMD); Matching pursuit (MP); Multi-scale daily rainfall data; Permutation entropy (PE); Runoff prediction},
  correspondence_address1 = {Zhu, K.; School of Resources and Earth Sciences, China; email: kzhu@cumt.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.ejrh.2024.101836},
  groups                  = {Journals},
  language                = {English},
  publisher               = {Elsevier B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85193453089&doi=10.1016%2fj.ejrh.2024.101836&partnerID=40&md5=ad30f4b7263af0726cecd7a56db75167},
}

@Article{Ren2024,
  author                  = {Ren, Y. and Yang, M. and Pan, H. and Farhat, M. and Enis Cetin, A. and Chen, P.Y.},
  journal                 = {IEEE Transactions on Antennas and Propagation},
  title = {PT Symmetry-Enabled Physically Unclonable Functions for Anti-Counterfeiting RF Tags},
  year                    = {2024},
  issn                    = {0018926X},
  note                    = {cited By 1},
  number                  = {6},
  pages = {5129--5140},
  volume                  = {72},
  abbrev_source_title = {IEEE Trans Antennas Propag},
  abstract                = {We present the concept and design of physically unclonable function (PUF)-based cryptographic key generation, which exploits the uniqueness of electromagnetic signatures of radio frequency (RF)-transponder tags derived from random physical variations during manufacturing. When the RF tag is inductively coupled to a designated readout circuitry, forming the higher-order parity-time (PT) symmetry, high sensitivity, and high entropy near the system's divergent exceptional point (DEP) can maximize the difference in temporal/spectral responses among tags. Our results show that due to the DEP singularity, PUF keys generated by converting the temporal response into binary sequences can exhibit excellent encryption performance in terms of randomness, uniqueness, encoding capacity, and resilience to machine learning (ML)-based modeling attacks. This RF PUF technique may pave the way toward ultra-lightweight, low-cost, and efficient hardware security solutions for wireless identification and authentication in various applications, including but not limited to the security of near-field connectivity and telematics infrastructure, wireless access control, authentication protocols for Internet-of-Things (IoTs), and anti-counterfeiting labels for goods, foods, and drugs. © 1963-2012 IEEE.},
  affiliation             = {University of Illinois Chicago, Department of Electrical and Computer Engineering, Chicago, IL 60607, United States; Northwestern University, Feinberg School of Medicine, Chicago, IL 60611, United States; King Abdullah University of Science and Technology, Computer, Electrical, and Mathematical Science and Engineering Division, Thuwal, 23955, Saudi Arabia},
  author_keywords         = {Electromagnetic signatures; exceptional points (EPs); hardware security; parity-time (PT) symmetry; physically unclonable function (PUF); radio frequency identifi- cation (RFID)},
  coden                   = {IETPA},
  correspondence_address1 = {Chen, P.-Y.; University of Illinois Chicago, United States; email: pychen@uic.edu},
  document_type           = {Article},
  doi                     = {10.1109/TAP.2024.3396693},
  groups                  = {Journals},
  keywords                = {Binary sequences; Electromagnetic induction; Hardware security; Learning systems; Network security; Radio frequency identification (RFID); Radio waves; Telematics, Anti-counterfeiting; Cryptographic key; Divergents; Electromagnetic signatures; Exceptional points; Paritytime symmetries; Physically unclonable functions; Radio frequency tags; Radio-frequency-identification; Radiofrequencies, Authentication},
  language                = {English},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85192723102&doi=10.1109%2fTAP.2024.3396693&partnerID=40&md5=7f043dc9ef7b0ff342885212dce0eb8b},
}

