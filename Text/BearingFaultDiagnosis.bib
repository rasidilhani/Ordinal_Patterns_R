  groups                  = {Journals},
  keywords                = {Biomedical signal processing; Brain; Brain computer interface; Electroencephalography; Electrophysiology; Entropy; Extraction; Interface states; Speech recognition, Brain wave; Electrical activities; Emotion recognition; Emotional state; Entropy measure; Features extraction; Human emotion; Human emotion recognition; Physiological signals; Signal-processing, Feature extraction, brain function; electroencephalogram; electroencephalography; emotion; entropy; feature extraction; human; human experiment; nonlinear system; review; signal processing},
