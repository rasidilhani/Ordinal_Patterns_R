  groups                  = {Journals},
  keywords                = {Electric power transmission networks; Singular value decomposition; Vibration analysis; Wavelet decomposition, Analysis method; Continuous Wavelet Transform; Information entropy; Numerical range; Singular entropy; State identification; Time frequency; Vibration signal, DC transformers},
