  author_keywords         = {decision fusion; derivative multi-scale permutation entropy; fault diagnosis; railway point machines; vibration signal},
  coden                   = {MSTCE},
  correspondence_address1 = {Cao, Y.; National Engineering Research Center of Rail Transportation Operation and Control System, China; email: ycao@bjtu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1088/1361-6501/ad6784},
  groups                  = {Journals},
  keywords                = {Failure rate; Fault detection; Railroads; Safety engineering; Support vector machines, Decisions fusion; Derivative multi-scale permutation entropy; Diagnosis methods; Faults diagnosis; Multi-scales; Permutation entropy; Point machines; Railway point machine; Railway points; Vibration signal, Entropy},
  language                = {English},
