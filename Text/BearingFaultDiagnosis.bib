  groups                  = {Journals},
  keywords                = {Dispersions; Electrophysiology; Entropy; Nonlinear analysis; Pattern recognition, Dispersion patterns; Distress; Distress detection; Electroencephalographic signals; Negative stress; Ordinal pattern; Permutation entropy; Physiological signals; Sample entropy; Stress detection, Electroencephalography},
  language                = {English},
