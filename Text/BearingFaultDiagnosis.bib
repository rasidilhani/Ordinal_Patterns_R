  keywords                = {Empirical mode decomposition; Fault detection; Higher order statistics; Roller bearings, Deconvolutions; Empirical Mode Decomposition; Faults diagnosis; Maximum correlation kurtosis deconvolution; Maximum correlations; Optimal parameter; Rolling bearings; Singular spectral decomposition; Spectral decomposition; Teager energy operators, Failure analysis},
