@Article{Zheng2023c,
  author                  = {Zheng, J. and Chen, Y. and Pan, H. and Tong, J.},
  journal                 = {Nonlinear Dynamics},
  title = {Composite multi-scale phase reverse permutation entropy and its application to fault diagnosis of rolling bearing},
  year                    = {2023},
  issn                    = {0924090X},
  note                    = {cited By 17},
  number                  = {1},
  pages = {459--479},
  volume                  = {111},
  abbrev_source_title = {Nonlinear Dyn},
  abstract                = {Permutation entropy has been used as a powerful nonlinear dynamic tool for randomness measurement of time series and has been used in the area of condition monitoring and early failure fault detection of rolling bearing. However, the detail size relationship between adjacent amplitudes of signal is ignored in the calculation process of the original permutation entropy algorithms. The reverse permutation entropy was developed as a new nonlinear dynamic parameter through introducing distance information to time series with different lengths to improve the performance and stability of permutation entropy. Since the single-scale permutation entropy or reverse permutation entropy cannot completely reflect the complexity features of time series, in this paper, the phase reverse permutation entropy is proposed by introducing phase information into reverse permutation entropy to improve the detection ability of signal dynamic changes as much as possible. Based on phase reverse permutation entropy, the composite multi-scale phase reverse permutation entropy is proposed to extract the complexity information hidden in different time scales and overcome the defects of traditional coarse-grained multi-scale. Also, phase reverse permutation entropy is compared with reverse permutation entropy through simulation data and the result shows that the introduced phase information can increase the sensitivity of phase reverse permutation entropy in mutation characteristics detection of signal. After that, a new fault diagnosis method of rolling bearing was proposed based on composite multi-scale phase reverse permutation entropy for fault feature extraction and the whale optimization algorithm support vector machine for failure mode identification. Finally, the proposed fault diagnosis method was applied to the experimental data analysis of rolling bearing by comparing it with the composite multi-scale permutation entropy, the multi-scale permutation entropy, as well as multi-scale phase reverse permutation entropy based fault diagnosis approaches. The comparison results shows that the proposed method can effectively the fault location and severity of rolling bearings and reaches the highest fault recognition rate among the mentioned methods above. © 2022, The Author(s), under exclusive licence to Springer Nature B.V.},
  affiliation             = {School of Mechanical Engineering, Anhui University of Technology, Anhui, Maanshan, 243032, China},
  author_keywords         = {Composite multi-scale phase reverse permutation entropy; Fault diagnosis; Permutation entropy; Reverse permutation entropy; Rolling bearing},
  coden                   = {NODYE},
  correspondence_address1 = {Tong, J.; School of Mechanical Engineering, Anhui, China; email: pantc2006@163.com},
  document_type           = {Article},
  doi                     = {10.1007/s11071-022-07847-z},
  groups                  = {Journals},
  keywords                = {Condition monitoring; Entropy; Failure analysis; Fault detection; Feature extraction; Signal detection; Support vector machines; Time series, Composite multi-scale phase reverse permutation entropy; Faults diagnosis; Multi-scales; Permutation entropy; Phase information; Reverse permutation entropy; Rolling bearings; Times series, Roller bearings},
  language                = {English},
  publisher               = {Springer Science and Business Media B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85137910928&doi=10.1007%2fs11071-022-07847-z&partnerID=40&md5=fd5969900d89a8c3ca7dfab8544119bc},
}

@Article{Jiao2023,
  author                  = {Jiao, Y. and Wang, X. and Liu, C. and Du, G. and Zhao, L. and Dong, H. and Zhao, S. and Liu, Y.},
  journal                 = {Biomedical Signal Processing and Control},
  title = {Feasibility study for detection of mental stress and depression using pulse rate variability metrics via various durations},
  year                    = {2023},
  issn                    = {17468094},
  note                    = {cited By 15},
  volume                  = {79},
  abbrev_source_title = {Biomed. Signal Process. Control},
  abstract                = {Background and Objective: In modern society, people are exposed to various kinds of stress for a long time, which can lead to psychological or physical problems such as depression. This study aims to develop a pulse rate variability (PRV) detection model that can be used to assess mental states in real time, and to explore the differences and associations between acute mental stress and depression at the level of PRV features. Methods: Pulse wave data were collected from 32 healthy college students during a mental arithmetic task and from 33 major depressive disorder patients in a resting state. 64 PRV features in the time, frequency, nonlinear and time–frequency domain from different data lengths (i.e., 1 min, 3 min and 5 min) were extracted, and the statistical analysis was used to investigate the significant difference of each feature under different time lengths. Three feature selection methods (i.e., mutual information, recursive feature elimination and random forest) combined with support vector machine were adopted to identify mental stress and depression. Results: After feature selection, the highest accuracy for 1 min, 3 min, and 5 min were 90.77 %, 95.26 %, and 95.26 % when identifying mental stress, all 98.46 % when identifying depression, as well as 98.46 %, 98.46 %, and 100 % when differentiating between mental stress and depression. Conclusions: This model provides a strong basis for effectively distinguishing between the three psychological states of health, mental stress, and depression, which can be applied to real-time monitoring and analysis of wearable devices. © 2022 Elsevier Ltd},
  affiliation             = {Department of Biomedical Engineering, School of Control Science and Engineering, Shandong University, Shandong, Jinan, 250061, China},
  art_number              = {104145},
  author_keywords         = {Distribution entropy; Major depressive disorder; Mental stress; Multi-domain features; Pulse rate variability},
