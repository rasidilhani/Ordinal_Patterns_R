  groups                  = {Journals},
  keywords                = {Additive noise; Gaussian distribution; Gaussian noise (electronic); Neurons, Different effects; Dynamical complexity; Gaussian white noise; Multiplicative noise; Noise intensities; Potential function; Statistical complexity; Total residence time, White noise},
