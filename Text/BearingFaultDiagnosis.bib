  document_type           = {Article},
  doi                     = {10.1016/j.physa.2020.125686},
  groups                  = {Journals},
  keywords                = {Embeddings; Signal processing; Time series, Analytical tool; Complexity measures; Detection effect; Embedding dimensions; Logistic maps; Nonlinear time series; Permutation entropy; Phase information, Entropy},
  language                = {English},
  publisher               = {Elsevier B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85099361695&doi=10.1016%2fj.physa.2020.125686&partnerID=40&md5=e556c03f6c45e53817eec43dc4023d24},
