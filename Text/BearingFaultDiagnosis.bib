@Article{Smigiel2021a,
  author                  = {Śmigiel, S. and Pałczyński, K. and Ledziński, D.},
  journal                 = {Entropy},
  title = {{Ecg} signalclassification using deep learningtechniques based on the PTB-XL dataset},
  year                    = {2021},
  issn                    = {10994300},
