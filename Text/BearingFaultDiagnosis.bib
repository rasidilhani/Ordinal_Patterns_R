  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85201014102&doi=10.1177%2f01423312241267043&partnerID=40&md5=e7938aa844f9532d1d93babb11f7a807},
}

@Article{Gromov2024,
