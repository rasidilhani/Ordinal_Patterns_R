  doi                 = {10.1109/EITCE47263.2019.9095187},
  groups              = {Conference},
  isbn                = {9781728135847},
  journal             = {2019 IEEE 3rd International Conference on Electronic Information Technology and Computer Engineering, EITCE 2019},
  keywords            = {Decision trees; Entropy; Failure analysis; Fault detection; Rotating machinery; Signal processing, Fault diagnosis method; Fault feature; Nonstationary; Permutation entropy; Rolling bearing vibration; Rolling bearings; Vibration signal, Roller bearings},
  language            = {English},
  source              = {Scopus},
  url                 = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85085702372&doi=10.1109%2fEITCE47263.2019.9095187&partnerID=40&md5=3bc6be0391c476f896c85975be15faf1},
