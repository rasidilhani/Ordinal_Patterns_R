@Article{Chen2024i,
  author                  = {Chen, S. and Liang, Q. and Gao, X. and Wang, J. and Cheng, M.},
  journal                 = {Nonlinear Dynamics},
  title = {Dynamics-inversion-based optical chaos communication systems with simplified structures and enhanced security},
  year                    = {2024},
  issn                    = {0924090X},
  note                    = {cited By 0},
  abbrev_source_title = {Nonlinear Dyn},
  abstract                = {Chaos communication can provide high-level physical layer security for data transmission. One major issue in application is that it’s difficult to give consideration to both security and practicability. In this paper, we propose an information loading strategy. The information signal and chaotic carrier are nonlinearly mixed instead of linearly superimposed in the traditional chaos masking communication. The nonlinear interplay between them can result in efficient mutual concealment, thereby preventing plaintext information leakage and key parameters extraction. Furthermore, based on dynamics reconstruction, a demodulation scheme is designed using the powerful nonlinear fitting ability of neural networks. Not only can it achieve desired demodulation, but it can also markedly simplify the system structure. The effectiveness of the proposed scheme has been demonstrated in the application of optical chaotic secure communication. Corresponding simulation results show that our chaos communication system allows for Gb/s data transmission, even under low signal-to-noise ratio conditions. We believe the proposed chaotic secure communication mechanism could be research seed that balances high security and low implementation complexity. © The Author(s), under exclusive licence to Springer Nature B.V. 2024.},
  affiliation             = {School of Computer Science, China University of Geosciences, Wuhan, 430074, China; Bishan District Emergency Management Bureau, Chongqing, 402760, China; National Engineering Research Center for Next Generation Internet Access System, School of Optical and Electronic Information, Huazhong University of Science and Technology (HUST), Wuhan, 430074, China; Jinyinhu Laboratory, Wuhan, 430040, China},
  author_keywords         = {Chaos communication; Dynamics reverse reconstruction; Enhanced security; Neural networks; Simplified system structure; Time delayed feedback},
  coden                   = {NODYE},
  correspondence_address1 = {Gao, X.; School of Computer Science, China; email: gaoxj@cug.edu.cn},
  document_type           = {Article},
  doi                     = {10.1007/s11071-024-10488-z},
  groups                  = {Journals},
  keywords                = {Network security; Optical communication; Secure communication, Chaos communications; Chaotic secure communications; Communications systems; Data-transmission; Dynamic reverse reconstruction; Enhanced security; Neural-networks; Simplified system structure; Systems Structure; Time-delayed feedback, Information leakage},
  language                = {English},
