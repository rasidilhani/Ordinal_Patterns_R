  document_type           = {Article},
  doi                     = {10.3390/machines10121155},
  groups                  = {Journals},
  language                = {English},
  publisher               = {MDPI},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85144715030&doi=10.3390%2fmachines10121155&partnerID=40&md5=a333fab4c6b4393a466486bd1d84e957},
}

@Article{Nguyen2022,
  author                  = {Nguyen, N.V. and Pattanayak, A.K. and Aragoneses, A.},
  journal                 = {Photonics},
  title = {TARDYS Quantifiers: Extracting Temporal and Reversible DYnamical Symmetries},
  year                    = {2022},
  issn                    = {23046732},
  note                    = {cited By 4},
  number                  = {12},
  volume                  = {9},
  abbrev_source_title = {Photonics},
  abstract                = {One of the great challenges in complex and chaotic dynamics is to reveal the details of its underlying determinism. This can be manifest in the form of temporal correlations or structured patterns in the dynamics of a measurable variable. These temporal dynamical structures are sometimes a consequence of hidden global symmetries. Here, we identify the temporal (approximate) symmetries of a semiconductor laser with external optical feedback, based on which we define the Temporal And Reversible DYnamical Symmetry (TARDYS) quantifiers to evaluate the relevance of specific temporal correlations in a time series. We show that these symmetries are also present in other complex dynamical systems, letting us extrapolate one system’s symmetries to characterize and distinguish chaotic regimes in other dynamical systems. These symmetries, natural of the dynamics of the laser with feedback, can also be used as indicators in forecasting regular-to-chaos transitions in mathematical iterative maps. We envision that this can be a useful tool in experimental data, as it can extract key features of the deterministic laws that govern the dynamics of a system despite the lack of knowledge of those specific quantitative descriptions. © 2022 by the authors.},
  affiliation             = {Department of Physics, Eastern Washington University, Cheney, WA 99004, United States; Department of Phyiscs and Astronomy, Carleton College, Northfield, MN 55057, United States},
  art_number              = {938},
  author_keywords         = {chaos; complex dynamics; complexity quantifiers; diode laser; laser dynamics; permutation entropy; semiconductor laser},
  correspondence_address1 = {Aragoneses, A.; Department of Physics, United States; email: aaragoneses@ewu.edu},
  document_type           = {Article},
  doi                     = {10.3390/photonics9120938},
  groups                  = {Journals},
  language                = {English},
  publisher               = {MDPI},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85144710931&doi=10.3390%2fphotonics9120938&partnerID=40&md5=084b3365198425447592affec3619f72},
}

