  journal                 = {International Journal of Spray and Combustion Dynamics},
  title = {Effect of colored noise on precursors of thermoacoustic instability in model gas turbine combustors},
  year                    = {2024},
  issn                    = {17568277},
  note                    = {cited By 2},
  number                  = {3},
  pages = {80--92},
  volume                  = {16},
  abbrev_source_title = {Int. J. Spray Combust. Dyn.},
  abstract                = {In this work, we numerically investigate the dynamics of a prototypical thermoacoustic system, the generalized Van der Pol oscillator, in the presence of additive noise of varying color (correlation time) and intensity while the system undergoes supercritical and subcritical Hopf bifurcation. We specifically investigate the influence of noise color on trends in the coherence factor and the Hurst exponent in the subthreshold region to assess their reliability as instability precursors. The Hurst exponent is found reliable only for correlation times much larger than the time scale of the instability while the coherence factor is found to be reliable for the entire range of noise color investigated. These inferences are found to hold for both supercritical and subcritical bifurcation cases. © The Author(s) 2024.},
  affiliation             = {Indian Institute of Technology Ropar, Punjab, Rupnagar, India; Southern University of Science and Technology, Guangdong, Shenzhen, China; Indian Institute of Technology Kanpur, Uttar Pradesh, Kanpur, India},
  author_keywords         = {Coherence resonance; Colored noise; Gas turbine combustors; Hopf bifurcation; Hurst exponent; Precursors; Thermoacoustic instability; Van der Pol oscillator},
  correspondence_address1 = {Vishnoi, N.; Indian Institute of Technology Ropar, Punjab, India; email: 2018mez0019@iitrpr.ac.in; Kabiraj, L.; Indian Institute of Technology Ropar, Punjab, India; email: lipika.kabiraj@iitrpr.ac.in},
  document_type           = {Article},
  doi                     = {10.1177/17568277241262168},
  groups                  = {Journals},
  keywords                = {Additive noise; Color; Gas turbines; Hopf bifurcation; Lyapunov methods; Oscillators (mechanical); Thermoacoustics, Coherence factors; Coherence resonance; Colored noise; Correlation time; Gas turbine combustor; Hurst exponents; Precursor; Thermoacoustic instability; Thermoacoustic systems; Van der Pol's oscillators, Combustors},
  language                = {English},
  publisher               = {SAGE Publications Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85199429444&doi=10.1177%2f17568277241262168&partnerID=40&md5=0c8ad9fe0b4fc1cc86cfca4dad013935},
}

@Article{Zhu2024b,
  author                  = {Zhu, W. and Sun, K. and Wang, H. and Fu, L. and Minati, L.},
  journal                 = {Chaos, Solitons and Fractals},
  title = {Dynamics, synchronization and analog circuit implementation of a discrete neuron-like map with pulsating spiral dynamics},
  year                    = {2024},
  issn                    = {09600779},
  note                    = {cited By 3},
  volume                  = {186},
  abbrev_source_title = {Chaos Solitons Fractals},
  abstract                = {Owing to their computational efficiency and generative potential, discrete neural models have been gaining interest, both theoretically and towards engineering applications. In this paper, we propose a discrete map endowed with neuron-like dynamics and two distinguishing properties. Namely, the attractor has a spiral topology, and it has a cavity. The size of this cavity shows a non-monotonic relationship to a control parameter, delineating a pulsating behavior. The map shows a multitude of qualitatively-different periodic, chaotic, and hyperchaotic behaviors as a function of the control parameter settings, and its jump points restrict the internal and external size of the attractor. The oscillation frequency is also controllable and also shows a non-monotonic effect. In preparation for future work realizing neural-like networks, we demonstrate the synchronizability by coupling two nodes through a quadratic discrete memristor as the synapse. Finally, the analog circuit realizing this map is implemented and its dynamics are studied experimentally via a comprehensive set of measurements. As the control parameter is varied, the dynamic contraction and expansion of the attractor are observed alongside its well-developed spiral structure. © 2024 Elsevier Ltd},
  affiliation             = {School of Electronic Information, Central South University, Changsha, 410083, China; School of Physics, Central South University, Changsha, 410083, China; School of Life Science and Technology, University of Electronic Science and Technology of China, Chengdu, 611731, China; Center for Mind/Brain Sciences (CIMeC), University of Trento, Trento, 38123, Italy},
  art_number              = {115281},
  author_keywords         = {Analog electronic circuit; Discrete dynamics; Memristive synapse; Neural model; Pulsating attractor; Spiral; Synchronization},
  coden                   = {CSFOE},
  correspondence_address1 = {Sun, K.; School of Physics, China; email: kehui@csu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.chaos.2024.115281},
  groups                  = {Journals},
  keywords                = {Analog circuits; Computational efficiency; Synchronization; Timing circuits, Analog circuit implementation; Analog electronic circuit; Control parameters; Discrete dynamics; Memristive synapse; Monotonics; Neural modelling; Pulsating attractor; Spiral; Spiral dynamics, Dynamics},
  language                = {English},
  publisher               = {Elsevier Ltd},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85199161260&doi=10.1016%2fj.chaos.2024.115281&partnerID=40&md5=bf5148c340bc86d2019ff52c5337f6bd},
}

@Article{Vishnoi2024b,
  author                  = {Vishnoi, N. and Gupta, V. and Saurabh, A. and Kabiraj, L.},
  journal                 = {Nonlinear Dynamics},
  title = {Reliability of early warning indicators of critical transition in stochastic Van der Pol oscillators with additive correlated noise},
  year                    = {2024},
  issn                    = {0924090X},
  note                    = {cited By 2},
  number                  = {17},
  pages = {15193--15217},
  volume                  = {112},
  abbrev_source_title = {Nonlinear Dyn},
  abstract                = {We conduct a numerical investigation to assess the effect of noise characteristics on early warning indicators (EWIs) of critical transition in Van der Pol oscillators undergoing supercritical and subcritical Hopf bifurcation. Our study primarily focuses on the effects of additive correlated noise modeled by the OU process in the stable (subthreshold) region and corresponding trends in EWIs based on signal amplitude distribution, frequency spectra, fractal, and complexity measures as the system is brought closer to bifurcation, as a function of noise color and intensity. Our results indicate that the coherence factor is a reliable indicator for the entire range of investigated noise color, while variance and decay rates of the autocorrelation function are reliable when noise correlation times are either much smaller or larger than the system time scale. Kurtosis, permutation entropy and Jensen-Shannon complexity can be effectively employed in systems where noise exhibits minimal correlation time (resembling white noise). While the Hurst exponent proves a reliable indicator in systems where noise has correlation times much larger than the time scale of the system, multi-fractal spectrum width and skewness are deemed unsuitable as EWIs. These insights enhance our understanding of the effectiveness and limitations of various EWIs in forecasting critical transitions within dynamical systems. © The Author(s), under exclusive licence to Springer Nature B.V. 2024.},
  affiliation             = {Department of Mechanical Engineering, Indian Institute of Technology Ropar, Punjab, Rupnagar, 140001, India; Department of Mechanics and Aerospace Engineering, Southern University of Science and Technology, Guangdong, Shenzhen, 518055, China; Department of Mechanical Engineering, Indian Institute of Technology Kanpur, Uttar Pradesh, Kanpur, 208016, India},
  author_keywords         = {Early warning indicators; Hopf bifurcation; Noise correlation time; Ornstein-Uhlenbeck process; Van der Pol oscillator},
  coden                   = {NODYE},
  correspondence_address1 = {Vishnoi, N.; Department of Mechanical Engineering, Punjab, India; email: 2018mez0019@iitrpr.ac.in; Kabiraj, L.; Department of Mechanical Engineering, Rupnagar, India; email: lipika.kabiraj@iitrpr.ac.in},
  document_type           = {Article},
  doi                     = {10.1007/s11071-024-09831-1},
  groups                  = {Journals},
  keywords                = {Additive noise; Additives; Circuit oscillations; Decay (organic); Dynamical systems; Fractals; Higher order statistics; Lyapunov methods; Microwave oscillators; Oscillators (mechanical); Stochastic systems; White noise, Correlated noise; Correlation time; Early warning indicators; Noise correlation; Noise correlation time; Numerical investigations; Ornstein-Uhlenbeck process; Stochastics; Time-scales; Van der Pol's oscillators, Hopf bifurcation},
  language                = {English},
  publisher               = {Springer Science and Business Media B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85196653456&doi=10.1007%2fs11071-024-09831-1&partnerID=40&md5=7b32790be0c3a0a8f6211e328e72b287},
}

@Article{Sun2024a,
  author                  = {Sun, Y. and Wang, Z.},
  journal                 = {Engineering Applications of Artificial Intelligence},
  title = {Remaining useful life prediction of rolling bearing via composite multiscale permutation entropy and Elman neural network},
  year                    = {2024},
  issn                    = {09521976},
  note                    = {cited By 3},
  volume                  = {135},
  abbrev_source_title = {Eng Appl Artif Intell},
  abstract                = {Accurate prediction of remaining useful life (RUL) is very important for the maintenance of mechanical equipment. With the latest development in sensor technology and artificial intelligence, the data-driven prediction method of mechanical equipment RUL has been widely concerned. However, in the past, the research on data mining was not sufficient, and the method of extracting degradation features was single. In order to solve this problem, this paper proposes a new method to extract the degradation features of bearings. This method creatively combines image with entropy methods and uses the Symmetrized Dot Pattern (SDP) method and Composite Multiscale Permutation Entropy (CMPE) to extract degradation features. Through five evaluation indexes, the degradation feature extracted by the SDP-CMPE method is compared with five common degradation features in time domain. Finally, a simple Elman neural network is used to predict RUL. Through the case study of bearing data set, it is verified that the degradation features extracted by the SDP-CMPE method are superior in prediction accuracy and conservatism. © 2024},
  affiliation             = {School of Electrical Engineering, University of Jinan, Shandong, Jinan, China},
  art_number              = {108852},
  author_keywords         = {Elman neural network; Entropy; Feature extraction; Remaining useful life; Rolling bearing},
  coden                   = {EAAIE},
  correspondence_address1 = {Sun, Y.; School of Electrical Engineering, Shandong, China; email: sunyongjian2006@163.com},
  document_type           = {Article},
  doi                     = {10.1016/j.engappai.2024.108852},
  groups                  = {Journals},
  keywords                = {Data mining; Forecasting; Roller bearings; Time domain analysis, Accurate prediction; Entropy methods; Features extraction; Latest development; Mechanical equipment; Permutation entropy; Remaining useful life predictions; Remaining useful lives; Rolling bearings; Symmetrized dot patterns, Elman neural networks},
  language                = {English},
  publisher               = {Elsevier Ltd},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85196418040&doi=10.1016%2fj.engappai.2024.108852&partnerID=40&md5=165fbb79cba4d09395e00266a7b816d6},
}

@Article{Silbernagel2024,
  author                  = {Silbernagel, A. and Schnurr, A.},
  journal                 = {Journal of Multivariate Analysis},
  title = {Ordinal pattern dependence and multivariate measures of dependence},
  year                    = {2024},
  issn                    = {0047259X},
  note                    = {cited By 0},
  volume                  = {203},
  abbrev_source_title = {J. Multivariate Anal.},
  abstract                = {Ordinal pattern dependence has been introduced in order to capture co-monotonic behavior between two time series. This concept has several features one would intuitively demand from a dependence measure. It was believed that ordinal pattern dependence satisfies the axioms which Grothe et al. (2014) proclaimed for a multivariate measure of dependence. In the present article we show that this is not true and that there is a mistake in the article by Betken et al. (2021). Furthermore, we show that ordinal pattern dependence satisfies a slightly modified set of axioms. © 2024 The Author(s)},
  affiliation             = {Department of Mathematics, University of Siegen, Siegen, 57072, Germany},
  art_number              = {105337},
  author_keywords         = {Dependence measures; Ordinal patterns; Time series},
