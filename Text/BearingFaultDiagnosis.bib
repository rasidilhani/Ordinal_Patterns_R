@Article{Guo2010,
  author            = {Guo, Jing and Wang, Yue and Shan, Xiu-Ming and Ren, Yong},
  journal           = {Wuli Xuebao/Acta Physica Sinica},
  title = {Order patterns of spatiotemporal chaos},
