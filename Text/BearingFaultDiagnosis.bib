  document_type           = {Article},
  doi                     = {10.1016/j.biosystems.2022.104739},
  groups                  = {Journals},
  keywords                = {chaotic dynamics; neurology, article; connectome; nerve cell; spike; biological model; connectome; nerve cell network; nonlinear system; physiology, Connectome; Models, Neurological; Nerve Net; Neurons; Nonlinear Dynamics},
  language                = {English},
