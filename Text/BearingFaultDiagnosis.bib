}

@Article{Xuan2025,
  author                  = {Xuan, L. and Shen, A. and Hong, W.},
  journal                 = {Proceedings of the Institution of Mechanical Engineers, Part C: Journal of Mechanical Engineering Science},
  title = {Research on noise reduction method of vibration signal based on CEEMDAN-{Pe}-Wavelet Packet},
  year                    = {2025},
  issn                    = {09544062},
  note                    = {cited By 0},
  abbrev_source_title = {Proc. Inst. Mech. Eng. Part C J. Mech. Eng. Sci.},
  abstract                = {The operational health status of the gearbox determines the performance efficiency and precision of industrial robots, significantly impacting long-term stability. Therefore, it is highly significant to analyze the impact of various component vibration factors on the dynamic response generated by the gearbox transmission. This paper focuses on the non-stationary vibration signals of RV reducers. Based on empirical mode decomposition, it proposes a denoising technique based on CEEMDAN-PE-Wavelet Packet vibration signals. This technique aims to address the noise issue of RV reducer vibration signals that interfere with subsequent studies. Through comprehensive comparisons of various denoising algorithms via simulation experiments, this paper presents a vibration signal denoising method with a Signal-to-Noise Ratio (SNR) of 9.0037 and a Root Mean Square Error (RMSE) of 0.38, both of which outperform other denoising techniques. The analysis demonstrates that this method can enhance both the SNR and computational accuracy when applied to the vibration signals of RV reducers. The feasibility of the technique applied to RV reducer vibration signals is proved by building a vibration test bench, collecting vibration acceleration signals, and de-manipulating them using the noise reduction method proposed in the paper. © IMechE 2024.},
  affiliation             = {State Key Laboratory of Precision Blasting, Jianghan University, Wuhan, China; School of Smart Manufacturing, Jianghan University, Wuhan, China},
  author_keywords         = {CEEMDAN decomposition; signal cancelation; vibration testing},
  coden                   = {PMCSE},
  correspondence_address1 = {Xuan, L.; School of Smart Manufacturing, Hubei Province, Wuhan City, Wuhan EconomicTechnological Development Zone, 8 Sanjiahu Road, Wuhan 430056, China; email: xuanl@jhun.edu.cn},
  document_type           = {Article},
  doi                     = {10.1177/09544062241308351},
  groups                  = {Journals},
