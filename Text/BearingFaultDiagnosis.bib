  document_type           = {Article},
  doi                     = {10.1016/j.bspc.2024.106159},
  groups                  = {Journals},
  keywords                = {Brain; Neurology; Time series analysis, Condition; Epilepsy classification; Nonlinear time-series analysis; Ordinal partition transition network; Riemann similarity measure; Scatter plots; Second orders; Second-order difference scatterplot; Similarity measure; Time-series data, Classification (of information), algorithm; Article; chaotic dynamics; comparative study; controlled study; data processing; disease classification; electroencephalogram; entropy; epilepsy; human; multidimensional scaling; sensitivity and specificity; stochastic model; time series analysis},
  language                = {English},
