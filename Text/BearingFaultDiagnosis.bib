  art_number              = {105320},
  author_keywords         = {Entropy; Intracranial compliance; Intracranial pressure monitoring},
  correspondence_address1 = {Redelico, F.O.; Instituto de Medicina Translacional e Ingeniería Biomédica, Potosi 4265, Argentina; email: francisco.redelico@hospitalitaliano.org.ar},
  document_type           = {Article},
  doi                     = {10.1016/j.bspc.2023.105320},
  groups                  = {Journals},
  keywords                = {Animals; Mercury compounds; Neurology, Animal experiments; Animal model; Intensive care; Intracranial compliance; Intracranial hypertension; Intracranial pressure; Intracranial pressure monitoring; Pressure monitoring; Property; Wavelet entropies, Entropy, fentanyl; ketamine; pancuronium; propofol; remifentanil; rocuronium; xylazine, Article; comparative effectiveness; entropy; human; intracranial hypertension; intracranial pressure monitoring; nonhuman; permutation entropy; sample; wavelet entropy},
  language                = {English},
  publisher               = {Elsevier Ltd},
  source                  = {Scopus},
