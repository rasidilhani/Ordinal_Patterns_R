@Article{Ye2023,
  author                  = {Ye, Y. and Wei, L. and Li, F. and Zeng, J. and Hecht, M.},
  journal                 = {Measurement: Journal of the International Measurement Confederation},
  title = {Multislice Time-Frequency image Entropy as a feature for railway wheel fault diagnosis},
