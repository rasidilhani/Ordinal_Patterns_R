@Article{Fan2022,
  author                  = {Fan, C. and Ding, Q.},
  journal                 = {Digital Signal Processing: A Review Journal},
  title = {Counteracting the dynamic degradation of high-dimensional digital chaotic systems via a stochastic jump mechanism},
  year                    = {2022},
  issn                    = {10512004},
  note                    = {cited By 20},
  volume                  = {129},
  abbrev_source_title = {Digital Signal Process Rev J},
  abstract                = {To analyze the periodic distribution and state-mapping structures of high-dimensional digital chaotic systems in fixed-point arithmetic domain. A chaotic cycle-finding algorithm (CCFA) can be designed to precisely calculate the period length of the orbit of digital chaos under different finite calculation accuracy. Furthermore, to test the versatility and effectiveness of our proposed algorithm, the periodic distribution and security of the digital Sprott D system are analyzed in detail. Numerical simulation results show that the chaotic system have potential security risks, such as short period and low sequence complexity. In addition, we put forward a new resistance method based on automatic cycle detection and random jump of chaotic trajectories for the objective of enhancing the dynamical properties of high-dimensional digital chaotic systems. This scheme can construct a new chaotic model with many desirable properties, such as long period, high state-space utilization, low autocorrelation, and good ergodicity. © 2022 Elsevier Inc.},
  affiliation             = {Electrical Engineering College, Heilongjiang University, Harbin, 150080, China},
  art_number              = {103651},
  author_keywords         = {Chaotic cycle detection; Dynamic degradation; Keywords digital chaos; Resistance method},
  coden                   = {DSPRE},
  correspondence_address1 = {Fan, C.; Electrical Engineering College, China; email: 2020021@hlju.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.dsp.2022.103651},
  groups                  = {Journals},
  keywords                = {Fixed point arithmetic; Stochastic systems, Chaotic cycle detection; Chaotic cycles; Cycle detection; Digital chaos; Dynamic degradation; High-dimensional; Higher-dimensional; Keyword digital chaos; Periodic distribution; Resistance method, Chaotic systems},
  language                = {English},
  publisher               = {Elsevier Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85134883657&doi=10.1016%2fj.dsp.2022.103651&partnerID=40&md5=343f4114f07ab3dccfdaca05f075a977},
}

@Article{Zhuang2022,
  author                  = {Zhuang, Z. and Wang, F. and Yang, X. and Zhang, L. and Fu, C.-H. and Xu, J. and Li, C. and Hong, H.},
  journal                 = {Methods},
  title = {Accurate contactless sleep apnea detection framework with signal processing and machine learning methods},
  year                    = {2022},
  issn                    = {10462023},
  note                    = {cited By 18},
  pages = {167--178},
  volume                  = {205},
  abbrev_source_title = {Methods},
  abstract                = {The detection of sleep apnea is critical for assessing sleep quality. It is also a proven biometric in diagnosing cardiovascular and other diseases. Recent studies have shown that radar-based non-contact vital sign monitoring system can effectively detect sleep apnea. However, the detection accuracy in the current study still needs to be improved. In this paper, we propose a sleep apnea detection framework based on FMCW radar. First, the radar system is employed to record the sleep data throughout the night with polysomnography (PSG) comparison. Then, in order to extract more accurate respiratory signal from the raw radar data, the signal processing methods are investigated to solve the observed discontinuity phenomenon. Finally, machine learning methods are adopted. The apneic and not-apneic events are classified accurately by selecting effective features of respiratory signal. As shown in the experimental results, the proposed system could achieve a good classification performance with an accuracy of 95.53%, a sensitivity of 72.60%, a specificity of 97.32%, a Kappa of 0.68, and an F-score of 0.84. © 2022 Elsevier Inc.},
  affiliation             = {Nanjing University of Science and Technology, Nanjing, China; Huai'an First People's Hospital, Huai'an, China; Texas Tech University, Texas, United States},
  author_keywords         = {FMCW Radar; Machine learning; Sleep apnea},
  coden                   = {MTHDE},
  correspondence_address1 = {Fu, C.-H.; Nanjing University of Science and TechnologyChina; email: enchfu@njust.edu.cn},
  document_type           = {Article},
