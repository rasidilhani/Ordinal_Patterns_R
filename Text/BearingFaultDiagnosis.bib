  doi                     = {10.1016/j.physa.2020.125081},
  groups                  = {Journals},
  keywords                = {Entropy, Entropic measures; Experimental application; Fractional brownian motion; Multi-scale dynamics; Multiscaling; Permutation entropy; Scale-dependent dynamics; Time lag, Dynamics},
  language                = {English},
  publisher               = {Elsevier B.V.},
