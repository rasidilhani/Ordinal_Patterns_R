  keywords                = {Deep neural networks; Entropy; Forecasting; Multilayer neural networks; Network layers; Parameter estimation; Particle swarm optimization (PSO); Process control, Coupling monitor; Coupling permutation entropy; Multi-layer residual network and deep neural network; Multi-layers; Permutation entropy; Prediction modelling; Process optimisation; Process parameters; Quality–efficiency coupling; T-square statistic, Efficiency},
