}

@Article{Pompe2013,
  author            = {Pompe, B.},
  journal           = {European Physical Journal: Special Topics},
  title = {The LE-statistic: A quantity useful for nonparametric independence tests and as a complexity measure of time series},
  year              = {2013},
  note              = {Cited by: 2},
  number            = {2},
  pages             = {333 – 351},
  volume            = {222},
  abstract          = {We introduce a quantity called LE-statistic. It is an easily computable functional of ordinal data with versatile applications. We demonstrate its usefulness as a statistic in a nonparametric independence test of paired samples, and as a complexity measure of a scalar time series. For chaotic orbits of one-dimensional dynamical systems it is related to the Lyapunov characteristic exponent. © 2013 EDP Sciences and Springer.},
