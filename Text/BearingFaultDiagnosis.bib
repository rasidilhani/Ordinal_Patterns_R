  document_type           = {Article},
  doi                     = {10.1155/2021/7718074},
  groups                  = {Journals},
  keywords                = {Entropy; Failure analysis; Feature extraction; Vibration analysis, Condition based maintenance; Early fault; Entropy methods; Fault diagnosis technology; Feature extraction methods; Mechanical systems; Multiscale entropy; Permutation entropy; Signal features; Vibration signal, Fault detection},
  language                = {English},
  publisher               = {Hindawi Limited},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85118983736&doi=10.1155%2f2021%2f7718074&partnerID=40&md5=df920fb8cddd8e6a5ca157ca29907196},
