  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85187358851&doi=10.1109%2fTVT.2024.3371676&partnerID=40&md5=ec5b923fb81ed12e46900b565b0477c0},
}

@Article{Sun2024e,
  author                  = {Sun, Z. and Zheng, J. and Pan, H. and Feng, K.},
  journal                 = {JVC/Journal of Vibration and Control},
  title = {Multichannel multiscale increment entropy and its application in roller bearing fault diagnosis},
  year                    = {2024},
  issn                    = {10775463},
  note                    = {cited By 1},
  abbrev_source_title = {JVC/J Vib Control},
  abstract                = {As a new index to measure the complexity of time series, increment entropy, which takes into account the fluctuation directions and amplitude of time series, has better performance than the traditional entropy analysis methods such as sample entropy and permutation entropy. However, the increment entropy value of time series at single scale cannot completely reflect the dynamic change of time series. In this paper, the multichannel multiscale increment entropy (MMIE) is proposed by introducing the coarse-graining and multichannel analysis tools of time series to explore the complexity of multichannel time series over multiple different scales. MMIE considers the dynamic relationships between multichannel data and the relevant cross-channel variations that are often overlooked in single-channel analysis, thus achieving a full utilization of state information. Finally, an MMIE-based fault diagnosis method is proposed for roller bearing. The analysis results of the simulation signals and the measured data of roller bearings indicate that MMIE performs better than MMDE, MMPE, and MMSE approaches in time costing and fault identification rates. © The Author(s) 2024.},
  affiliation             = {School of Mechanical Engineering, Anhui University of Technology, Maanshan, China; The State Key Laboratory of Mechanical Transmissions, Chongqing University, Maanshan, China; School of Engineering, The University of British Columbia, Vancouver, BC, Canada},
  author_keywords         = {fault diagnosis; Increment entropy; multichannel multiscale increment entropy; multiscale increment entropy; roller bearing},
  coden                   = {JVCOF},
  correspondence_address1 = {Zheng, J.; School of Mechanical Engineering, China; email: lqdlzheng@126.com},
  document_type           = {Article},
  doi                     = {10.1177/10775463241227473},
  groups                  = {Journals},
  keywords                = {Failure analysis; Fault detection; Roller bearings; Rollers (machine components); Time series; Time series analysis, Bearing fault diagnosis; Faults diagnosis; Increment entropy; ITS applications; Multi channel; Multichannel multiscale increment entropy; Multiscale increment entropy; Performance; Roller bearing fault; Times series, Entropy},
  language                = {English},
