  author_keywords         = {Chaos; Kolmogorov complexity and its spectrum; Lyapunov time (time horizon); Natural fluid flow systems; Permutation entropy; Predictability},
  coden                   = {JHYDA},
  correspondence_address1 = {Mihailović, D.T.; Department of Physics, Serbia; email: guto@df.uns.ac.rs},
  document_type           = {Article},
  doi                     = {10.1016/j.jhydrol.2024.131103},
  groups                  = {Journals},
  keywords                = {Computational complexity; Entropy; Lyapunov methods; Stream flow; Turbulence, Flow systems; Fluid-flow; Kolmogorov complexity; Kolmogorov complexity and its spectrum; Lyapunov time (time horizon); Natural fluid flow system; Permutation entropy; Predictability; Spectra's; Time horizons, Rivers, complexity; fluid flow; streamflow; turbulence, Argentina; Bosnia and Herzegovina; United States},
  language                = {English},
