  document_type           = {Article},
  doi                     = {10.1088/1741-2552/ab98da},
  groups                  = {Journals},
  keywords                = {Amines; Anesthetics; Drug interactions; Electroencephalography; Machine learning; Nearest neighbor search, Automated approach; Electro-encephalogram (EEG); General anesthesias; K-nearest neighbors; Machine learning models; State monitoring; State prediction; True positive rates, Genetic algorithms, ketamine; sevoflurane; drug; inhalation anesthetic agent; sevoflurane, adult; algorithm; anesthesia induction; anesthesia level; Article; automation; concentration at steady-state; concentration process; conscious sedation; drug monitoring; electroencephalogram; feature selection; female; general anesthesia; hidden Markov model; human; human experiment; k nearest neighbor; machine learning; male; normal human; priority journal; wakefulness; electroencephalography; machine learning, Anesthetics, Inhalation; Electroencephalography; Machine Learning; Pharmaceutical Preparations; Sevoflurane},
  language                = {English},
  publisher               = {IOP Publishing Ltd},
