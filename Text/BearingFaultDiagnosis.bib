@Article{Zhang2020j,
  author                  = {Zhang, Z. and Xiang, Z. and Chen, Y. and Xu, J.},
  journal                 = {AIMS Mathematics},
  title = {Fuzzy permutation entropy derived from a novel distance between segments of time series},
  year                    = {2020},
  issn                    = {24736988},
