  correspondence_address1 = {XIANG, S.; State Key Laboratory of Integrated Service Networks, China; email: jxxsy@126.com},
  document_type           = {Article},
  doi                     = {10.1364/PRJ.403319},
  groups                  = {Journals},
  keywords                = {Decision making; Reinforcement learning; Time delay; Timing circuits; Ultrafast lasers, Changing environment; Coupled semiconductor lasers; Coupling strengths; Multi armed bandit; Mutual correlations; Simplified algorithms; Time-delay signature concealments; Ultra-fast photonics, Semiconductor lasers},
  language                = {English},
