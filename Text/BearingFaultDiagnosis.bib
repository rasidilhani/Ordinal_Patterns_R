  author                  = {Sun, G. and Li, K.},
  journal                 = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
  title = {EMG Denoising Based on CEEMDAN-{Pe}-WT Algorithm},
  year                    = {2023},
  issn                    = {03029743},
  note                    = {cited By 0},
  pages = {137--146},
  volume                  = {14268 LNAI},
  abbrev_source_title = {Lect. Notes Comput. Sci.},
  abstract                = {Raw Surface Electromyography (sEMG) generally contains baseline noise, random noise, power line interference and other noises. The performance of signal denoising is a prerequisite for sEMG feature extraction and recognition. However, traditional filtering methods may sacrifice some effective sEMG signals during denoising process. For improving the denoising effect and eliminate the modal aliasing problem in the Empirical Mode Decomposition (EMD) decomposition process, this paper proposes a hybrid denoising algorithm based on complete ensemble empirical mode decomposition with Adaptive Noise (CEEMDAN) and permutation entropy (PE) combined with wavelet threshold (WT). Firstly, CEEMDAN decomposition is performed on raw sEMG signals to calculate the PE value of each Intrinsic Mode Functions (IMF). Then, high-frequency (H-F) IMF components dominated by random noise is identified and wavelet threshold denoising is applied. Results show that EMG signals denoised by the proposed CEEMDAN-PE-WT algorithm perform a higher signal-to-noise ratio (SNR) and lower root mean square error (RMSE) compared with WT, EMD and CEEMDAN denoising methods. © The Author(s), under exclusive license to Springer Nature Singapore Pte Ltd. 2023.},
  affiliation             = {Shenyang University of Technology, Liaoning, 110870, China},
  author_keywords         = {CEEMDAN; PE; sEMG signal denoising; Wavelet Threshold},
  correspondence_address1 = {Li, K.; Shenyang University of TechnologyChina; email: Kairu.Li@sut.edu.cn},
  document_type           = {Conference Paper},
  doi                     = {10.1007/978-981-99-6486-4_12},
  editor                  = {Yang H., Zou J., Yang G., Ouyang X., Liu H., Yin Z., Liu L., Wang Z.},
  groups                  = {Journals},
  isbn                    = {9789819964857},
  keywords                = {Biomedical signal processing; Mean square error; Signal denoising; Signal to noise ratio; Wavelet decomposition, Adaptive noise; Complete ensemble empirical mode decomposition with adaptive noise; De-noising; Empirical Mode Decomposition; Permutation entropy; Surface electromyography; Surface electromyography signal denoising; Surface electromyography signals; Threshold algorithms; Wavelet threshold, Empirical mode decomposition},
  language                = {English},
