  journal                 = {IEEE International Ultrasonics Symposium, IUS},
  keywords                = {Biological organs; Classification (of information); Diagnosis; Parameter estimation; Ultrasonics, Bayes Classifier; Characteristics parameters; Decision tree classifiers; In-vivo; Information entropy; Lung lesions; Lung ultrasound; Permutation entropy; RF data; Subjective judgement, Decision trees},
  language                = {English},
