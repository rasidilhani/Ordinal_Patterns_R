  journal                 = {Zhendong yu Chongji/Journal of Vibration and Shock},
  title = {Application of refined composite multiscale fluctuation dispersion entropy in hydraulic pumps fault diagnosis [精细复合多尺度波动散布熵在液压泵故障诊断中的应用]},
  year                    = {2022},
  issn                    = {10003835},
  note                    = {cited By 8},
  number                  = {8},
  pages = {7--16},
  volume                  = {41},
  abbrev_source_title = {J Vib Shock},
  abstract                = {The vibration signal of hydraulic pump has the characteristics of non-linearity and non-stationarity. Entropy algorithms have a unique advantage in this kind of signal analysis. However, the traditional entropy algorithms still have shortcomings of slow calculation speed, inaccurate entropy value and unstable entropy value in hydraulic pump vibration signal feature extraction. To extract fault feature information more effectively and improve fault diagnosis accuracy, the refined composite multiscale fluctuation dispersion entropy (RCMFDE) was introduced into the fault feature extraction of hydraulic pumps. A hydraulic pump fault diagnosis method based on RCMFDE and the particle swarm optimization support vector machine (PSO-SVM) algorithm was proposed. Firstly, the RCMFDE values of different fault vibration signals were calculated and the multi-RCMFDE values were selected at appropriate scales as feature vectors to form feature samples. Then the feature samples were input to PSO-SVM for fault diagnosis. Through analyzing the simulation signals and hydraulic pump experiments signals, the proposed method was compared with the fault diagnosis methods based on multiscale sample entropy(MSE), multiscale permutation entropy(MPE), multiscale symbolic dynamic entropy(MSDE), multiscale dispersion entropy(MDE), refined composite multiscale dispersion entropy (RCMDE), and multiscale fluctuation dispersion entropy(MFDE). Experimental results show that the proposed method can accurately identify multiple types of hydraulic pump faults and effectively evaluate the performance degradation degree of hydraulic pump. © 2022, Editorial Office of Journal of Vibration and Shock. All right reserved.},
  affiliation             = {Hebei Provincial Key Laboratory of Heavy Machinery Fluid Power Transmission and Control, Yanshan University, Qinhuangdao, 066004, China; Key Laboratory of Advanced Forging & Stamping Technology and Science, Ministry of Education of China, Yanshan University, Qinhuangdao, 066004, China; Institute of Electrical Engineering, Yanshan University, Qinhuangdao, 066004, China},
  author_keywords         = {Fault diagnosis; Fluctuation dispersion entropy; Hydraulic pump; Particle warm optimization support vector machine; Refined composite multiscale fluctuation dispersion entropy(RCMFDE)},
  correspondence_address1 = {Zhao, Y.; Hebei Provincial Key Laboratory of Heavy Machinery Fluid Power Transmission and Control, China; Zhao, Y.; Key Laboratory of Advanced Forging & Stamping Technology and Science, China},
  document_type           = {Article},
  doi                     = {10.13465/j.cnki.jvs.2022.08.002},
  groups                  = {Journals},
  keywords                = {Dispersions; Entropy; Extraction; Failure analysis; Fault detection; Feature extraction; Particle swarm optimization (PSO); Pumps, Entropy algorithms; Entropy value; Faults diagnosis; Fluctuation dispersion entropy; Hydraulic pump; Optimisations; Particle warm optimization support vector machine; Refined composite multiscale fluctuation dispersion entropy; Support vectors machine; Vibration signal, Support vector machines},
  language                = {Chinese},
