@Article{Hongwei2021,
  author                  = {Hongwei, Z. and Haiyan, W. and Haiyang, Y. and Haitao, D. and Xiaohong, S.},
  journal                 = {JASA Express Letters},
  title = {Phase trajectory entropy: A promising tool for passive diver detection},
