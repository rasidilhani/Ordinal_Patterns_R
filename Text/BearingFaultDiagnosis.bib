  groups                  = {Journals},
  keywords                = {Bioinformatics; Dispersions; Entropy; Extraction; Heuristic algorithms; Multivariant analysis; Signal analysis; Time series; Time series analysis, Biomedical monitoring; Complexity theory; Dispersion entropy; Dynamic scheduling; Heterogeneous systems; Heuristics algorithm; Multiscale; Multivariate signals; Non linear; Stratified entropy, Physiology, article; computer heuristics; entropy; extraction; time series analysis; waveform; algorithm; entropy; time factor, Algorithms; Entropy; Time Factors},
  language                = {English},
