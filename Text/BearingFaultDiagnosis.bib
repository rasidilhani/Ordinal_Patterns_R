  volume              = {32},
  abbrev_source_title = {Opt. Express},
  abstract            = {Aiming at the difficulty of traditional chaotic-shift-keying (CSK) systems in resisting return map attacks, we propose an optical chaotic communication system based on time-delayed shift keying and common-signal-induced synchronization. This scheme combines amplified spontaneous emission (ASE) noise, phase modulator (PM), and fiber Bragg grating (FBG) to achieve dual masking in both intensity and phase fields, achieving 10Gb/s information transmission. A common-signal-induced method is used to achieve the synchronization of the system. Moreover, by shifting the time delay as the message-feeding method, the return map attack is effectively resisted, to prevent the amplitude and frequency information of the chaotic attractor from being exposed. In terms of confidentiality and communication performance, this scheme demonstrates good performance of time delay signatures (TDSs) concealment and long-distance transmission capability. In addition, this scheme maintains high sensitivity to key parameters and achieves better confidentiality while increasing the key space. © 2024 Optica Publishing Group (formerly OSA). All rights reserved.},
  affiliation         = {School of Communication Engineering, Hangzhou Dianzi University, Hangzhou, 310018, China; School of Cyberspace Security, Hangzhou Dianzi University, Hangzhou, 310018, China},
  document_type       = {Article},
  doi                 = {10.1364/OE.519254},
  groups              = {Journals},
  keywords            = {Chaotic systems; Fiber Bragg gratings; Optical communication; Time delay, Amplified spontaneous emission noise; Chaotic communication systems; Chaotic shift keying; Keying systems; Optical-; Phase fields; Phase modulator; Return map; Shift keying; Time delayed, Synchronization, article; communication aid; feeding; grating; human; male; masking; noise; optics},
  language            = {English},
  publisher           = {Optica Publishing Group (formerly OSA)},
  pubmed_id           = {38859261},
