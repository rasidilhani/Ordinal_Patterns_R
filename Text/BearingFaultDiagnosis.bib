  groups                  = {Journals},
  keywords                = {Article; cerebrovascular accident; classification; controlled study; data analysis; data base; data processing; electroencephalogram; electromyogram; graph neural network; measurement accuracy; motor performance; movement (physiology); nerve cell network; neurofeedback; prediction; quality control; scoring system; sequence learning; stroke rehabilitation; treatment response},
  language                = {English},
