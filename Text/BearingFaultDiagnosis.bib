  isbn                = {9781624105982},
  journal             = {AIAA AVIATION 2020 FORUM},
  keywords            = {Aviation; Flow fields, Causal relations; Causal relationships; Combustion instabilities; Data-driven methods; Heat Release Rate (HRR); Physical quantities; Pressure oscillation; Transfer entropy, Entropy},
  language            = {English},
  source              = {Scopus},
  url                 = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85092943118&doi=10.2514%2f6.2020-2945&partnerID=40&md5=36c055ff253a606b1e565b0715f4f31e},
}

