  groups                  = {Journals},
  keywords                = {Bayesian networks; Deep neural networks; Magnetoplasma; Uncertainty analysis, Bayesian; Bayesian neural networks; Data driven; Deep learning; Disruption; Disruption predictions; Probabilistic Learning; Tokamak; Uncertainty; Uncertainty estimation, Forecasting},
  language                = {English},
