  art_number              = {045310},
  correspondence_address1 = {Zunino, L.; Centro de Investigaciones Ópticas (CONICET la Plata-CIC-UNLP), Gonnet, Argentina; email: lucianoz@ciop.unlp.edu.ar},
  document_type           = {Article},
  doi                     = {10.1103/PhysRevE.105.045310},
  groups                  = {Journals},
  keywords                = {Time series analysis, Arbitrary time; Data series; Degree of similarity; Encoding schemes; Jensen-Shannon divergence; Numerical applications; Sequential ordering; Shannon; Symbolic distance; Times series, Harmonic analysis, article; artifact; big data; motivation; time series analysis},
  language                = {English},
