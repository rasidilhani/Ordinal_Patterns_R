  doi                     = {10.1155/2022/6808641},
  groups                  = {Journals},
  keywords                = {Dispersions; Extraction; Feature extraction; Nearest neighbor search, Bearing fault; Comparative methods; Fault signal; Feature extraction methods; Features extraction; Nearest-neighbor algorithms; Permutation entropy, Entropy},
  language                = {English},
  publisher               = {Hindawi Limited},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85132102131&doi=10.1155%2f2022%2f6808641&partnerID=40&md5=2ef5adf0fcc21f236dabf641a0b50598},
