@Conference{Wang2021f,
  author                  = {Wang, T. and Zhang, W. and Tao, T. and Zhang, F.},
  title = {De-noising Method for Fiber Optic Gyroscope Based on {Vmd}-{Pe}-CMSE},
  year                    = {2021},
  note                    = {cited By 0},
  pages = {210--215},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {Int. Conf. Control, Autom. Inf. Sci., ICCAIS - Proc.},
  abstract                = {To improve the short-term precision of inertial navigation system(INS), the noise of the inertial measurement(IMU) should be de-noised. In order to reduce the noise of the Fiber Optic Gyroscope, variational mode decomposition(VMD) combined with permutation entropy(PE) and Consecutive Mean Square Error(CMSE) is utilized in the de-noise method. The raw signal is decomposed into the intrinsic mode functions(IMFs) by VMD, the noise of IMF can be identified by PE, and the IMF is de-noised by CMSE. The reconstructed signal is composed of de-noised IMFs. The result of the experiments show that VMD combined with PE can identify the noise of the signal, and CMSE can de-noise the signal effectively. The static test show that the de-noising method can improve the short-term precision of INS. © 2021 IEEE.},
