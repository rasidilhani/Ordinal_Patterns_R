@Article{Gui2022,
  author                  = {Gui, X. and Huang, J. and Li, L. and Li, S. and Cao, J.},
  journal                 = {Multimedia Tools and Applications},
  title = {A novel hyperchaotic image encryption algorithm with simultaneous shuffling and diffusion},
  year                    = {2022},
  issn                    = {13807501},
  note                    = {cited By 10},
  number                  = {15},
  pages = {21975--21994},
  volume                  = {81},
  abbrev_source_title = {Multimedia Tools Appl},
  abstract                = {The performance of an image encryption algorithm based on chaos is largely determined by the nonlinear characteristics of the underlying chaotic system. This paper proposes a mixed one- and two-dimensional chaotic map (MOTDCM) that has a wider hyperchaotic interval, a larger maximum Lyapunov exponent, and more complex nonlinear dynamics than most existing chaotic systems. Using the hyperchaotic sequences generated by the MOTDCM, a novel image encryption algorithm with different structures is proposed, in which shuffling and diffusion are carried out simultaneously from the perspective of the whole input image. Simulation results and a comparative analysis show that the proposed encryption algorithm has a large key space, high sensitivity to the secret key, and good statistical ciphertext properties. It has a better diffusion effect than existing algorithms and meets the imposed security requirements within only one round of operation, with a reduction in algorithm complexity and an improvement in encryption efficiency. Experimental results demonstrate that this encryption algorithm has good performance and can resist chosen-plaintext attacks and known-plaintext attacks effectively. © 2022, The Author(s), under exclusive licence to Springer Science+Business Media, LLC, part of Springer Nature.},
  affiliation             = {School of Computer and Communication, Lanzhou University of Technology, Lanzhou, 730050, China; School of Information Science and Engineering, Lanzhou University, Lanzhou, 730000, China},
  author_keywords         = {Hyperchaotic map; Image encryption; Simultaneous shuffling and diffusion},
  coden                   = {MTAPF},
  correspondence_address1 = {Huang, J.; School of Computer and Communication, China; email: brioal@foxmail.com},
  document_type           = {Article},
  doi                     = {10.1007/s11042-022-12239-x},
  groups                  = {Journals},
  keywords                = {Computational complexity; Cryptography; Diffusion; Image processing; Lyapunov methods, Chaotic map; Encryption algorithms; Hyperchaotic; Hyperchaotic maps; Image encryption algorithm; Images encryptions; One-dimensional; Performance; Simultaneous shuffling and diffusion; Two-dimensional, Chaotic systems},
