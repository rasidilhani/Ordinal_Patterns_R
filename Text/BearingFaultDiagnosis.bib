  keywords                = {Empirical mode decomposition; Entropy; Extraction; Fault detection; Frequency domain analysis; Partial discharges; Power transformers; Support vector machines; Wavelet decomposition, Discharge features; Empirical Mode Decomposition; Fault feature; Faults diagnosis; Features extraction; Partial discharge pulse; Permutation entropy; Pulse signal; Wavelet multiscales; Wavelets transform, Feature extraction},
  language                = {English},
