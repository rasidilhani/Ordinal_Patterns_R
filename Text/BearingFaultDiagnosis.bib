  groups                  = {Journals},
  keywords                = {Entropy; Failure analysis; Fault detection; Particle size analysis; Particle swarm optimization (PSO); Support vector machines; Vibration analysis, Characteristic vectors; Feature information; Mechanical systems; Permutation entropy; Rolling bearing vibration; Rolling bearings; Time series decomposition; Vibration signal, Roller bearings},
