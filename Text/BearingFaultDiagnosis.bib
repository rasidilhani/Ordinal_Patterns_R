@Article{Li2023h,
  author                  = {Li, Y. and Tang, B. and Jiao, S.},
  journal                 = {Ocean Engineering},
  title = {SO-slope entropy coupled with SVMD: A novel adaptive feature extraction method for ship-radiated noise},
  year                    = {2023},
  issn                    = {00298018},
  note                    = {cited By 64},
  volume                  = {280},
  abbrev_source_title = {Ocean Eng.},
  abstract                = {Slope entropy (SloEn) has been applied as a powerful nonlinear dynamic tool for signal complexity measurement and is widely used for ship-radiated noise signal (S-RNS) feature extraction. However, the thresholds of SloEn affect the entropy value, which influences the effect of feature extraction. Aimed at addressing the problem, this paper uses the snake optimizer (SO) to optimize SloEn and proposes a new entropy indicator, named SO SloEn (SO-SloEn), and then a novel adaptive S-RNS feature extraction method is put forward in combination with the successive variational mode decomposition (SVMD) and SO-SloEn, which solves the parameter selection problem of variational mode decomposition (VMD). First, SVMD is employed to decompose the S-RNS into several intrinsic mode functions (IMFs); after that, the SO-SloEn of IMFs is calculated to obtain the feature matrix dataset; finally, optimal IMF combinations are obtained through feature selection. The effectiveness of the proposed method is verified by two S-RNS cases, and the results indicate that the recognition rate of the proposed method is always the highest compared with other decomposition algorithms and other entropy indicators under the condition of extracting different numbers of IMFs; moreover, the highest recognition rate can reach more than 92% in both cases. © 2023 Elsevier Ltd},
  affiliation             = {School of Automation and Information Engineering, Xi'an University of Technology, Xi'an, 710048, China; Shaanxi Key Laboratory of Complex System Control and Intelligent Information Processing, Xi'an University of Technology, Xi'an, 710048, China},
  art_number              = {114677},
  author_keywords         = {Feature extraction; Ship-radiated noise; Slope entropy; Snake optimization; Successive variational mode decomposition},
  correspondence_address1 = {Li, Y.; School of Automation and Information Engineering, China; email: liyuxing@xaut.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.oceaneng.2023.114677},
  groups                  = {Journals},
  keywords                = {Acoustic noise measurement; Entropy; Extraction; Feature extraction; Ships, Features extraction; Intrinsic Mode functions; Noise signals; Optimisations; Optimizers; Ship radiated noise; Ship's radiated noise; Slope entropy; Snake optimization; Successive variational mode decomposition, Variational mode decomposition, entropy; extraction method; noise; optimization; shipping; slope},
  language                = {English},
  publisher               = {Elsevier Ltd},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85153867023&doi=10.1016%2fj.oceaneng.2023.114677&partnerID=40&md5=31cb6dc7126ddcf3bd1117edd5512877},
}

@Book{Chakrabarty2023,
  author                  = {Chakrabarty, D.},
  publisher               = {Springer International Publishing},
  title = {Learning in the absence of training data},
  year                    = {2023},
  isbn                    = {9783031310119; 9783031310102},
  note                    = {cited By 1},
  abbrev_source_title = {Learn. in the Absence of Train. Data},
  abstract                = {This book introduces the concept of "bespoke learning", a new mechanistic approach that makes it possible to generate values of an output variable at each designated value of an associated input variable. Here the output variable generally provides information about the system's behaviour/structure, and the aim is to learn the input-output relationship, even though little to no information on the output is available, as in multiple real-world problems. Once the output values have been bespoke-learnt, the originally-absent training set of input-output pairs becomes available, so that (supervised) learning of the sought inter-variable relation is then possible. Three ways of undertaking such bespoke learning are offered: by tapping into system dynamics in generic dynamical systems, to learn the function that causes the system's evolution; by comparing realisations of a random graph variable, given multivariate time series datasets of disparate temporal coverage; and by designing maximally information-availing likelihoods in static systems. These methodologies are applied to four different real-world problems: forecasting daily COVID-19 infection numbers; learning the gravitational mass density in a real galaxy; learning a sub-surface material density function; and predicting the risk of onset of a disease following bone marrow transplants. Primarily aimed at graduate and postgraduate students studying a field which includes facets of statistical learning, the book will also benefit experts working in a wide range of applications. The prerequisites are undergraduate level probability and stochastic processes, and preliminary ideas on Bayesian statistics. © Springer Nature Switzerland AG 2023. All rights reserved.},
  affiliation             = {Department of Mathematics, Brunel University London, Uxbridge, Middlesex, United Kingdom},
  author_keywords         = {Bayesian methods; Choosing priors on unknown parameters; Generating the originally-absent training data; Prediction given test data; Supervised learning; Training data},
  correspondence_address1 = {Chakrabarty, D.; Department of Mathematics, United Kingdom},
  document_type           = {Book},
  doi                     = {10.1007/978-3-031-31011-9},
  groups                  = {Books},
  journal                 = {Learning in the Absence of Training Data},
  language                = {English},
  pages = {1--227},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85194017031&doi=10.1007%2f978-3-031-31011-9&partnerID=40&md5=21392c86dbb6dfdcf3c77de24c30417d},
}

@Article{DeAraujo2023,
  author                  = {De Araujo, F.H.A. and Fernandes, L.H.S. and Silva, J.W.L. and Sobrinho, K.E.S. and Tabak, B.M.},
  journal                 = {Fractals},
  title = {ASSESSMENT THE PREDICTABILITY IN THE PRICE DYNAMICS FOR THE TOP 10 CRYPTOCURRENCIES: THE IMPACTS OF RUSSIA-UKRAINE WAR},
  year                    = {2023},
  issn                    = {0218348X},
  note                    = {cited By 1},
  number                  = {5},
  volume                  = {31},
  abbrev_source_title = {Fractals},
  abstract                = {This paper has investigated the predictability of the top 10 cryptocurrencies' price dynamics, ranked by their daily market capitalization and trade volume, via the information theory quantifiers. Our analysis considers the Complexity-entropy causality plane to study the temporal evolution of the price of these cryptocurrencies and their respective locations along this 2D map, bearing in mind after and during the Russia-Ukraine war. Moreover, we apply the permutation entropy and the Jensen-Shannon statistical complexity measure to rank these cryptocurrencies similarly to a complexity hierarchy. Our findings reflect that the Russian-Ukraine war affects the informational efficiency of cryptocurrency dynamics. Specifically, the cryptocurrencies notably showed a decrease in informational inefficiency (USD-coin, Binance-USD, BNB, Dogecoin, and XRP). At the same time, the cryptocurrencies with more expressiveness for the financial market, considering the volume traded and the capitalized market, were strongly impacted, presenting an increase in informational inefficiency (Tether, Cardano, Ethereum, and Bitcoin). It clarifies the potential of cryptocurrencies to mitigate exogenous shocks and their capability to use with portfolio selection, risk diversification and herding behavior. © 2023 World Scientific Publishing Company.},
  affiliation             = {Federal Institute of Education, Science and Technology of Paraíba, Campus Patos, PB. Acesso rodovia PB 110, S/N Alto Tubiba, PB, PatosCEP 58700-030, Brazil; Department of Economics and Informatics, Federal Rural University of Pernambuco, PE, Serra Talhada, 56909-535, Brazil; Department of Statistics and Informatics, Federal Rural University of Pernambuco, PE, Recife, 52171-900, Brazil; School of Public Policy and Government, Getulio Vargas Foundation, SGAN 602 Módulos A, B e C, Asa Norte, DF, Brasília, 70830-020, Brazil},
  art_number              = {2350042},
  author_keywords         = {Complexity; Cryptocurrency; Inefficiency; Information Theory Quantifiers; Russia-Ukraine War},
  correspondence_address1 = {De Araujo, F.H.A.; Federal Institute of Education, Campus Patos, PB. Acesso rodovia PB 110, S/N Alto Tubiba, PB, Patos, Brazil; email: fernando.araujo@ifpb.edu.br},
  document_type           = {Article},
  doi                     = {10.1142/S0218348X23500421},
  groups                  = {Journals},
  keywords                = {Dynamics; Electronic money; Entropy, Complexity; Inefficiency; Information theory quantifier; Market capitalization; Permutation entropy; Price dynamics; Russia-ukraine war; Temporal evolution; Trade volume; Ukraine, Information theory},
  language                = {English},
  publisher               = {World Scientific},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85165208485&doi=10.1142%2fS0218348X23500421&partnerID=40&md5=0fa6c2f23d8ba05f3d28f7a635da162b},
}

@Article{Wang2023g,
