@Article{Ricci2022,
  author                  = {Ricci, L. and Perinelli, A.},
  journal                 = {Entropy},
  title = {Estimating Permutation Entropy Variability via Surrogate Time Series},
  year                    = {2022},
  issn                    = {10994300},
  note                    = {cited By 5},
  number                  = {7},
  volume                  = {24},
  abbrev_source_title = {Entropy},
  abstract                = {In the last decade permutation entropy (PE) has become a popular tool to analyze the degree of randomness within a time series. In typical applications, changes in the dynamics of a source are inferred by observing changes of PE computed on different time series generated by that source. However, most works neglect the crucial question related to the statistical significance of these changes. The main reason probably lies in the difficulty of assessing, out of a single time series, not only the PE value, but also its uncertainty. In this paper we propose a method to overcome this issue by using generation of surrogate time series. The analysis conducted on both synthetic and experimental time series shows the reliability of the approach, which can be promptly implemented by means of widely available numerical tools. The method is computationally affordable for a broad range of users. © 2022 by the authors. Licensee MDPI, Basel, Switzerland.},
