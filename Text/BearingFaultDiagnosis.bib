  document_type           = {Article},
  doi                     = {10.1186/s40623-021-01399-z},
  groups                  = {Journals},
  keywords                = {accuracy assessment; algorithm; computer simulation; data inversion; data processing; efficiency measurement; magnetotelluric method; numerical model; reliability analysis; signal-to-noise ratio; time series; transfer function},
  language                = {English},
