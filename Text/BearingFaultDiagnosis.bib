  keywords                = {Anesthesiology, Cortical activity; Electroencephalogram; Electroencephalogram signals; General anesthesia; General anesthesias; Long duration; Long-duration anesthesia; Power spectral; Signal complexity; Spectra's, Electroencephalography},
  language                = {English},
