  document_type           = {Article},
  doi                     = {10.1109/ACCESS.2020.2964050},
  groups                  = {Journals},
  keywords                = {Electroencephalography; Electrophysiology; Laser tissue interaction; Patient treatment; Physical therapy; Topography; Wavelet transforms, Electroencephalograpy; Fuzzy entropy; Lumbar disc herniation; Marginal spectrum; Massage therapy; Permutation entropy; Sample entropy; Wavelet entropies, Entropy},
  language                = {English},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85078260010&doi=10.1109%2fACCESS.2020.2964050&partnerID=40&md5=6c6ead67c22c970200d31f6f5daf8639},
