  title = {Reduction of the Computational Cost of Tuning Methodology of a Simulator of a Physical System},
  year                    = {2023},
  issn                    = {03029743},
  note                    = {cited By 0},
  pages = {641--651},
  volume                  = {14075 LNCS},
  abbrev_source_title = {Lect. Notes Comput. Sci.},
  abstract                = {We propose a methodology for calibrating a physical system simulator and whose computational model represents its events in time series. The method ology reduces the search space of the fit parameters by exploring a database that contains stored historical events and their corresponding simulator fit parameters. We carry out the symbolic representation of the time series using ordinal pat terns to classify the series, which allows us to search and compare by similarity on the stored data of the series represented. This classification strategy allows us to speed up the parameter search process, reduce the computational cost of the adjustment process and consequently improve energy cost savings. The experiences showed a reduction in the computational cost of 29% compared with our tuning methodology proposed in previous research. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2023.},
  affiliation             = {Facultad de Ingeniería y Ciencias Agrarias, Pontificia Universidad Católica Argentina, Ciudad Autónoma de Buenos Aires, Argentina; Instituto de Ciencias, Universidad Nacional de General Sarmiento, Buenos Aires, Argentina; Departamento de Arquitectura de Computadores y Sistemas Operativos, Universidad Autònoma de Barcelona, Bellaterra (Barcelona), 08193, Spain},
  author_keywords         = {Data driven; Ordinal pattern; Parametric simulation; Time series classification; Tuning methodology},
  correspondence_address1 = {Trigila, M.; Facultad de Ingeniería y Ciencias Agrarias, Argentina; email: mariano_trigila@uca.edu.ar},
  document_type           = {Conference Paper},
  doi                     = {10.1007/978-3-031-36024-4_49},
  editor                  = {Mikyska J., de Mulatier C., Paszynski M., Krzhizhanovskaya V.V., Dongarra J.J., Sloot P.M.},
  groups                  = {Journals},
  isbn                    = {9783031360237},
  keywords                = {Costs, % reductions; Computational costs; Data driven; Fit parameters; Ordinal pattern; Parametric simulations; Physical systems; Time series classifications; Times series; Tuning methodology, Computational cost},
  language                = {English},
  publisher               = {Springer Science and Business Media Deutschland GmbH},
