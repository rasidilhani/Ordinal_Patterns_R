  keywords                = {Bioinformatics; Computational efficiency; Entropy; Evolutionary algorithms; Harmonic analysis; Medical applications, Biomedical applications; Biomedical signals processing; Entropy algorithms; Literature reviews; Quality recognition; Signal quality; Slope entropy; Time series classifications; Time-series analysis; Time-series data, Time series analysis},
