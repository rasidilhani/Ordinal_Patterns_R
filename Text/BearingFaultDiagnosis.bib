@Article{Zhou2024f,
  author                  = {Zhou, Y. and Jiang, J. and Yang, S.-H. and He, L. and Ding, Y. and Liu, K. and Zhu, G. and Qing, Y.},
  journal                 = {IEEE Internet of Things Journal},
  title = {A Data-Distillation-Enhanced Autoencoder for Detecting Anomalous Gas Consumption},
  year                    = {2024},
  issn                    = {23274662},
  note                    = {cited By 1},
  number                  = {2},
  pages = {3473--3483},
  volume                  = {11},
  abbrev_source_title = {IEEE Internet Things J.},
  abstract                = {The number of natural gas users has been growing rapidly in China due to the promotion of clean energy and the economic benefits of natural gas, especially in businesses and industries. Though the infrastructures for gas supplies have been highly improved, gas providers are still suffering from various problems, such as malfunctioning gas meters, gas leakage, gas theft, etc. With the development of the Internet of Things, smart gas meters have been widely adopted by gas providers to collect real-time gas consumption data for billing purposes which can also serve as a basis for anomaly detection. One challenge of using such data for anomaly detection is that it is difficult to obtain sufficient labeled data for model training. To address this challenge, we propose D2AE, a data-distillation-enhanced autoencoder for detecting anomalous gas consumption, which consists of three modules. The first module preprocesses the raw meter readings and carries out a rule-based anomaly detection. The second module extracts the normal gas usage patterns via an integration of correlation and clustering-based consistency evaluation methods. The extracted normal usage patterns are then used in the third module to train an autoencoder for anomaly detection. D2AE intends to provide a method to detect anomalous gas consumption induced by various causes such that manual inspection can be largely reduced. Moreover, D2AE does not require user-specific information and can be applied to different types of gas users. Based on a real-world gas consumption data set, we carry out a set of experiments and show that D2AE outperforms the existing anomaly detection methods in the literature and improves the $F_{1}$ score by an average of 7.4% for restaurant users and 5.7% for canteen users. © 2014 IEEE.},
  affiliation             = {Yunnan University, National Pilot School of Software, Kunming, 650091, China; China University of Petroleum - Beijing, College of Artificial Intelligence, Beijing, 102249, China; Southern University of Science and Technology, Shenzhen Key Laboratory of Safety and Security for Next Generation of Industrial Internet, Shenzhen, 518000, China; University of Reading, Department of Computer Science, Reading, RG6 6UR, United Kingdom; University of Warwick, Department of Computer Science, Coventry, CV4 7AL, United Kingdom; Southern University of Science and Technology, Shenzhen Key Lab. of Safety and Secty. for Next Generation of Indust. Internet and the Dept. of Comp. Sci. and Eng., Shenzhen, 518000, China; Gas Technology Research Institute, Shenzhen Gas, Shenzhen, 518000, China},
  author_keywords         = {Anomaly detection; gas consumption; time series; unsupervised learning; urban computing},
  correspondence_address1 = {Jiang, J.; China University of Petroleum - Beijing, China; email: jiangjie@cup.edu.cn; Yang, S.-H.; Southern University of Science and Technology, China; email: yangsh@sustech.edu.cn},
  document_type           = {Article},
  doi                     = {10.1109/JIOT.2023.3296538},
  groups                  = {Journals},
  keywords                = {Anomaly detection; Distillation; Gases; Learning systems; Natural gas; Unsupervised learning, Anomaly detection; Auto encoders; Clean energy; Correlation; Gas consumption; Time-series analysis; Times series; Urban computing; Usage patterns, Time series analysis},
  language                = {English},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85165240138&doi=10.1109%2fJIOT.2023.3296538&partnerID=40&md5=1d18a99c4e7b96df776acefec1c745d6},
}

@Conference{Maarouf2024,
  author              = {Maarouf, K. and Abo Alzahab, N. and Saad, G.},
  title = {The Effect of {Eeg} Segment's Length on Mental Workload Detection},
  year                = {2024},
  note                = {cited By 0},
  pages = {271--276},
  publisher           = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {IEEE Int. Conf. Metrol. Ext. Real., Artif. Intell. Neural Eng., MetroXRAINE - Proc.},
  abstract            = {The rapid advancements in neurotechnology and neuroergonomics have propelled the field of passive brain-computer interfaces (pBCIs) to the forefront of human-computer interaction. One critical aspect of pBCIs is the detection of mental workload (MWL), which plays a pivotal role in optimising cognitive performance and preventing cognitive overload. This study looks into the best length of an electroencephalography (EEG) segment for detecting mental workload (MWL) with passive brain-computer interfaces (pBCIs). We used the STEW dataset, which has EEG data from 48 people doing different cognitive tasks, to look at three different feature sets and five machine learning models to see how segment duration affected the accuracy of detection. We observed a rapid initial increase in accuracy with increasing segment duration, followed by a plateau that resulted in minimal improvement. Using gradient analysis and the Kneedle algorithm, the best segment length was found to be 2.43 seconds on average. This was the best balance between information content and computational efficiency. These results go against what most people think and give us a way to measure how to improve MWL detection in pBCIs, which could lead to better interactions between people and computers. We need to conduct further research to investigate the generalizability of these findings to different datasets and task paradigms, and to examine the influence of specific feature sets and classification algorithms on the ideal segment duration for MWL detection. © 2024 IEEE.},
  affiliation         = {Università Politecnica delle Marche, Department of Information Engineering, Ancona, 60131, Italy; Tishreen University, Faculty of Mechanical and Electrical Engineering, Department of Biomedical Engineering, Syrian Arab Republic; Al Andalus University for Medical Sciences, Syria, Syrian Arab Republic},
  author_keywords     = {Electroencephalography; human-computer interaction; Kneedle algorithm; machine learning; mental workload; optimal segment duration; passive Brain-Computer Interfaces},
  document_type       = {Conference Paper},
  doi                 = {10.1109/MetroXRAINE62247.2024.10795942},
  groups              = {Conference},
  isbn                = {9798350378009},
  journal             = {2024 IEEE International Conference on Metrology for eXtended Reality, Artificial Intelligence and Neural Engineering, MetroXRAINE 2024 - Proceedings},
  keywords            = {Computational neuroscience; Machine learning, Computer interaction; Features sets; Kneedle algorithm; Machine-learning; Mental workload; Neurotechnology; Optimal segment duration; Passive brain-computer interface; Segment duration; Segment lengths, Brain computer interface},
  language            = {English},
  source              = {Scopus},
  url                 = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85216111471&doi=10.1109%2fMetroXRAINE62247.2024.10795942&partnerID=40&md5=14aef35c185dcfbd7514ca12c18c0289},
}

@Article{Ge2024,
  author                  = {Ge, Y. and Yin, J. and Chen, C. and Yang, S. and Han, Y. and Ding, C. and Zheng, J. and Zheng, Y. and Zhang, J.},
  journal                 = {Frontiers in Aging Neuroscience},
  title = {An {Eeg}-based framework for automated discrimination of conversion to Alzheimer’s disease in patients with amnestic mild cognitive impairment: an 18-month longitudinal study},
  year                    = {2024},
  issn                    = {16634365},
  note                    = {cited By 0},
  volume                  = {16},
  abbrev_source_title = {Front. Aging Neurosci.},
  abstract                = {Background: As a clinical precursor to Alzheimer’s disease (AD), amnestic mild cognitive impairment (aMCI) bears a considerably heightened risk of transitioning to AD compared to cognitively normal elders. Early prediction of whether aMCI will progress to AD is of paramount importance, as it can provide pivotal guidance for subsequent clinical interventions in an early and effective manner. Methods: A total of 107 aMCI cases were enrolled and their electroencephalogram (EEG) data were collected at the time of the initial diagnosis. During 18-month follow-up period, 42 individuals progressed to AD (PMCI), while 65 remained in the aMCI stage (SMCI). Spectral, nonlinear, and functional connectivity features were extracted from the EEG data, subjected to feature selection and dimensionality reduction, and then fed into various machine learning classifiers for discrimination. The performance of each model was assessed using 10-fold cross-validation and evaluated in terms of accuracy (ACC), area under the curve (AUC), sensitivity (SEN), specificity (SPE), positive predictive value (PPV), and F1-score. Results: Compared to SMCI patients, PMCI patients exhibit a trend of “high to low” frequency shift, decreased complexity, and a disconnection phenomenon in EEG signals. An epoch-based classification procedure, utilizing the extracted EEG features and k-nearest neighbor (KNN) classifier, achieved the ACC of 99.96%, AUC of 99.97%, SEN of 99.98%, SPE of 99.95%, PPV of 99.93%, and F1-score of 99.96%. Meanwhile, the subject-based classification procedure also demonstrated commendable performance, achieving an ACC of 78.37%, an AUC of 83.89%, SEN of 77.68%, SPE of 76.24%, PPV of 82.55%, and F1-score of 78.47%. Conclusion: Aiming to explore the EEG biomarkers with predictive value for AD in the early stages of aMCI, the proposed discriminant framework provided robust longitudinal evidence for the trajectory of the aMCI cases, aiding in the achievement of early diagnosis and proactive intervention. Copyright © 2025 Ge, Yin, Chen, Yang, Han, Ding, Zheng, Zheng and Zhang.},
  affiliation             = {Department of Medical Statistics, School of Public Health, Sun Yat-sen University, Guangzhou, China; Department of Clinical Medicine, Zhongshan School of Medicine, Sun Yat-sen University, Guangzhou, China; Department of Neurology, The First Affiliated Hospital, Sun Yat-sen University, Guangzhou, China},
  art_number              = {1470836},
  author_keywords         = {amnestic mild cognitive impairment; discrimination; EEG; longitudinal study; machine learning},
  correspondence_address1 = {Zhang, J.; Department of Medical Statistics, China; email: zhjinx@mail.sysu.edu; Zheng, Y.; Department of Neurology, China; email: zhengyifan123@163.com},
  document_type           = {Article},
  doi                     = {10.3389/fnagi.2024.1470836},
  groups                  = {Journals},
  keywords                = {accuracy; aged; Alzheimer disease; amnesia; area under the curve; Article; classifier; cognition; controlled study; cross validation; decision tree; diagnostic test accuracy study; discrimination learning; disease exacerbation; education; electroencephalogram; electroencephalography; entropy; feature extraction; feature selection; female; follow up; functional connectivity; human; k nearest neighbor; longitudinal study; machine learning; major clinical study; male; mild cognitive impairment; Mini Mental State Examination; Montreal cognitive assessment; predictive value; random forest; receiver operating characteristic; sensitivity and specificity; support vector machine; validation process},
  language                = {English},
  publisher               = {Frontiers Media SA},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85215305967&doi=10.3389%2ffnagi.2024.1470836&partnerID=40&md5=a43f34cd0eff45d061e89e23c00793ac},
}

@Conference{Yazhou2024,
  author                  = {Yazhou, L. and Shuang, Y. and Wei, D.},
  title = {Zero-shot Concurrent Control Chart Pattern Recognition based on Ordinal Pattern Feature Analysis},
  year                    = {2024},
  note                    = {cited By 0},
  pages = {481--486},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {Int. Conf. Syst Reliab. Saf. Eng., SRSE},
  abstract                = {As the manufacturing process becomes increasingly complex, the occurrence of concurrent abnormal control chart pattern (CCP) is becoming more common. However, collecting and labeling abnormal concurrent CCP samples in real industrial settings is challenging. Due to the lack of training samples of concurrent CCP, the existing CCPR methods are difficult to accurately identify concurrent CCP. In this paper, the idea of zero-shot learning (ZSL) is introduced into process control, and an intelligent recognition method for zero-shot concurrent CCP is proposed. An attribute description space (ADS) of CCP is established to realize the reasoning from single CCP to concurrent CCP. Additionally, the ordinal pattern (OP) feature considering the sequential relationship between CCP data is extracted. The ADS is embedded between the OP features and the sample labels. The attribute classifier associates OP features with CCP attributes. The results show that the proposed method can achieve zerosample concurrent CCPR without their samples. © 2024 IEEE.},
  affiliation             = {Beihang University, School of Reliability and Systems Engineering, Beijing, China; Systems Engineering Research Center Aero Engine Academy of China, Beijing, China},
  author_keywords         = {concurrent CCP; control chart pattern recognition; ordinal pattern; zero-shot learning component},
