  groups                  = {Journals},
  keywords                = {Dynamic response; Dynamics; Structural dynamics; Structural health monitoring, Attention mechanisms; Deep bidirectional gated recurrent unit; Dynamic response reconstruction; Health monitoring; Sequence generation; Sequence modeling; Structural dynamic response; Structural health; Uncertainty quantifications; Virtual sensing, Uncertainty analysis},
  language                = {English},
