@Article{Santos2022,
  author                  = {Santos, Y.A.C. and Rêgo, L.C. and Ospina, R.},
  journal                 = {Physica A: Statistical Mechanics and its Applications},
  title = {Online handwritten signature verification via network analysis},
  year                    = {2022},
  issn                    = {03784371},
  note                    = {cited By 7},
  volume                  = {600},
  abbrev_source_title = {Phys A Stat Mech Appl},
  abstract                = {In this paper, a model for online handwritten signature verification via networks analysis is proposed, in which centrality metrics are used as predictive characteristics. Supervised learning methods were used to classify the veracity of the signatures. The study uses the MCYT-100 and SVC2004 task2 signature databases, which are widely used in signature verification problems. In the framework, signatures were considered as nodes of a complex network in which the existing connection relationship between two signatures is measured through Pearson correlations between time series of signature coordinates that exceed a threshold of comparison. The attributes for the model were topological measures of centralities of the networks and the entropy of the time series signature. Some metrics are used to measure classification errors, including the False Rejection Rate (FRR) which identifies the percentage of true signatures that are rejected by the model, the False Acceptance Rate (FAR) as the percentage of false signatures that are accepted by the learning engine and the Average Error Rate (AER) as the average error. In this framework, we obtained a false positive rate of 6.19%, a false negative rate of 6.39% and an average error of approximately 6.28%. This result is close to ones obtained by state-of-the-art models for this problem, showing that the use of complex networks for online handwritten signature verification is a promising venue of research. © 2022 Elsevier B.V.},
  affiliation             = {Departamento de Engenharia de Produção, Universidade Federal de Pernambuco, Avenida da Arquitetura, Recife, PE, Brazil; Departamento de Estatística e Matemática Aplicada, Universidade Federal do Ceará, Campus do Pici, Fortaleza, CE, Brazil; Graduate Programs in Statistics and Production Engineering, Universidade Federal de Pernambuco, Recife, PE, Brazil; Departamento de Estatística, CASTLab, Universidade Federal de Pernambuco, Recife, PE, Brazil},
  art_number              = {127582},
  author_keywords         = {Centrality metrics; Complex network analysis; Machine learning; Signature verification; Time series entropy},
  coden                   = {PHYAD},
  correspondence_address1 = {Ospina, R.; Departamento de Estatística, Brazil; email: raydonal@de.ufpe.br},
  document_type           = {Article},
  doi                     = {10.1016/j.physa.2022.127582},
  groups                  = {Journals},
  keywords                = {Complex networks; E-learning; Errors; Machine learning; Time series; Time series analysis; Topology, Average errors; Centrality metric; Complex network analysis; Handwritten signature verification; Signature database; Signature verification; Supervised learning methods; Time series entropy; Times series; Verification problems, Entropy},
  language                = {English},
  publisher               = {Elsevier B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85131401260&doi=10.1016%2fj.physa.2022.127582&partnerID=40&md5=224577b5c0a131465495138070856f00},
}

