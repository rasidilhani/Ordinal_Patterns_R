  journal                 = {Proceedings - 2021 4th International Conference on Electron Device and Mechanical Engineering, ICEDME 2021},
  keywords                = {Electron devices; Entropy; Failure analysis; Fault detection, Bearing fault diagnosis; Classification accuracy; Fault signal; Nearest neighbor method; Neighborhood preserving embedding; Noise interference; Rolling bearings; Sudden change, Roller bearings},
  language                = {English},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85107608962&doi=10.1109%2fICEDME52809.2021.00044&partnerID=40&md5=a5a94e46f846ece649e98635eca3ac20},
