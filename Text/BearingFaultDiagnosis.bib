  groups                  = {Journals},
  keywords                = {Entropy; Intrinsic mode functions; Mean square error; Signal denoising; Signal reconstruction; Signal to noise ratio; Singular value decomposition; Vibration analysis, Adaptive noise; De-noising; Denoising methods; Empirical Mode Decomposition; Entropy value; Hydroelectric units; Improved complementary ensemble empirical mode decomposition with adaptive noise; Intrinsic Mode functions; Permutation entropy; Vibration signal, Empirical mode decomposition, article; case study; empirical mode decomposition; entropy; hydropower; intrinsic mode function; noise; noise reduction; root mean squared error; signal noise ratio; simulation; singular value decomposition; vibration},
