  groups                  = {Journals},
  keywords                = {adult; Article; blindness; brain function; clustering algorithm; consciousness; controlled study; correlation coefficient; data analysis software; dream; dreaming; electroencephalogram; electroencephalography; electromyogram; electromyography; electrooculogram; electrooculography; evidence accumulation clustering; experience; female; human; human experiment; male; Monte Carlo method; nonREM sleep; normal human; polysomnography; power spectrum; sleep; unsupervised machine learning},
  language                = {English},
  publisher               = {Oxford University Press},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85098460152&doi=10.1093%2fnc%2fniaa006&partnerID=40&md5=7602c40b5caeb67f1a37885d334fc7c5},
}

