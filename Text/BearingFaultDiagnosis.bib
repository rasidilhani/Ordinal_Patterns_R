}

@Article{Zhang2022l,
  author              = {Zhang, J. and Ren, C.},
  journal             = {Zhendong Ceshi Yu Zhenduan/Journal of Vibration, Measurement and Diagnosis},
  title = {Feature Transferring Diagnosis of Rolling Bearing Based on Deep Belief Network [基于深度信念网络的滚动轴承特征迁移诊断]},
  year                = {2022},
  issn                = {10046801},
  note                = {cited By 4},
  number              = {2},
  pages = {277--284},
  volume              = {42},
  abbrev_source_title = {Zhendong Ceshi Yu Zhenduan},
  abstract            = {Fault intelligent diagnosis of rolling bearing is mostly based on the same data source. Due to the differ-ence of time and frequency characteristics and the influence of background noise, the accuracy of identifying dif-ferent models and different working conditions of rolling bearing is low. In order to solve this problem, two kinds of deep groove ball bearings, 6307 and 6205, are taken as the research objects in this paper. A transfer di-agnosis model with deep belief network(DBN)as the core is established, and the characteristic identification pa-rameters represented by waveform index, kurtosis index, approximate entropy and dispersion entropy are con-structed. The maximum correlated kurtosis deconvolution(MCKD)method is introduced to suppress the influ-ence of signal transmission path(resonance band difference)and background noise. Results show that the accu-racy of the transfer diagnosis model, which is composed of MCKD and DBN, is more than 95% among the three different kinds of data, providing a feasible way for the transfer diagnosis of rolling bearing. © 2022, Editorial Department of JVMD. All right reserved.},
  affiliation         = {Key Laboratory of Advanced Manufacturing Technology of Beijing, Beijing University of Technology, Beijing, 100124, China; Beijing Engineering Research Center of Precision Measurement Technology and Instruments, Beijing, 100124, China},
  author_keywords     = {Adaptive maximum correlated kurtosis deconvolution (MCKD); Deep belief network(DBN); Intelligent diagnosis; Rolling bearing; Transferring feature},
  coden               = {ZCZHF},
  document_type       = {Article},
  doi                 = {10.16450/j.cnki.issn.1004-6801.2022.02.011},
