  correspondence_address1 = {Peng, S.; Tianjin Research Institute for Water Transport Engineering, China; email: pengshitao@tiwte.ac.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.envpol.2024.124053},
  groups                  = {Journals},
  keywords                = {Data handling; Deep learning; Digital storage; Dust; Forecasting; Materials handling; Risk assessment; Time series, 'Dry' [; Coastal cities; Data decomposition; Deep learning; Dry bulk port; Dust pollution; Hybrid approach; Operational data; Relevant features; Time series prediction, Air quality, air quality; atmospheric pollution; decomposition analysis; dust; machine learning; port; prediction; time series analysis, adverse event; air quality; Article; decomposition; deep learning; dust; genetic algorithm; mean squared error; meteorology; pollution; prediction; risk; seashore; temperature; air pollutant; air pollution; China; city; environmental monitoring; procedures, China, Air Pollutants; Air Pollution; China; Cities; Deep Learning; Dust; Environmental Monitoring},
