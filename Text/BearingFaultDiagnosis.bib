  journal                 = {Vibroengineering Procedia},
  keywords                = {Cranes; Entropy; Failure analysis; Fault detection; Particle swarm optimization (PSO); Rope; Support vector machines, Empirical Mode Decomposition; Ensemble empirical mode decomposition; Faults diagnosis; Hoisting system; Particle swarm; Particle swarm optimization-support vector machine; Permutation entropy; Rope tension; Support vectors machine; Swarm optimization, Empirical mode decomposition},
  language                = {English},
