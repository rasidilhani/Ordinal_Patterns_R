  correspondence_address1 = {Lin, A.; School of Mathematics and Statistics, China; email: ajlin@bjtu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.cnsns.2022.106294},
  groups                  = {Journals},
  keywords                = {Brain; Frequency domain analysis; Neurology; Signal analysis; Spectrum analysis; Time domain analysis, Bubble entropy; Causal relationships; EEG signal of epilepsy; EEG signals; ITS applications; Physiological signal analyse; Physiological signals; Signals analysis; Spectral entropy; Transfer spectral entropy, Entropy},
  language                = {English},
  publisher               = {Elsevier B.V.},
