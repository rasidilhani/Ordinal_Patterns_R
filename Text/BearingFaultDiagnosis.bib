  groups                  = {Journals},
  keywords                = {Chaotic systems; Digital signal processing; Lyapunov methods; Number theory; Random number generation, Design and dynamics; DSP; Dynamical analysis; Elliptical cylinder; Elliptical cylinder attractor; Hyper-chaotic systems; Hyperchaotic maps; Multi-cavity; Multicavity hyperchaotic map; Pseudorandom number generators, Cylinders (shapes)},
  language                = {English},
  publisher               = {World Scientific},
