  correspondence_address1 = {Lin, A.; School of Mathematics and Statistics, China; email: ajlin@bjtu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.cnsns.2024.108555},
  groups                  = {Journals},
  keywords                = {Accurate quantifications; Bivariate time series; Diversity entropy; Internal structure; Multiple time scale; Multiscale; Parameters variations; Sample entropy; Synchrony; Times series},
  language                = {English},
  publisher               = {Elsevier B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85213008884&doi=10.1016%2fj.cnsns.2024.108555&partnerID=40&md5=b5a05ab2bdce15e94193c9a0f6679853},
