@Article{Dai2024,
  author                  = {Dai, Q. and Ren, W. and Zhang, J. and Jin, N.},
  journal                 = {IEEE Sensors Journal},
  title = {Identifying Flow Pattern of Horizontal Oil-Water Two-Phase Flow Based on Multiscale Ordinal Transition Entropy},
  year                    = {2024},
  issn                    = {1530437X},
  note                    = {cited By 0},
  abbrev_source_title = {IEEE Sensors J.},
  abstract                = {To comprehend the complex flow structure and elucidate the dynamic evolution mechanism of horizontal oil-water two-phase flow, a more precise and effective method for identifying and analyzing flow patterns is urgently required. In this study, we conduct the experimental simulations under various flow conditions using a small-diameter acrylic glass pipe to gather data. Tap water and 3# industrial oil are used in these simulations. Utilizing a high-speed camera along with the signal response from mini-conductance probes, we classify the standard flow patterns under different conditions. Four typical flow patterns were observed: ST, ST&MI, D O/W&W, and D W/O&O/W. Employing an ordinal network, we calculated the entropy index of ultrasonic velocity signals. The mean value and slope of entropy at different scales were combined to construct a joint plane, which yielded satisfactory results in the flow pattern map. Multiscale entropy effectively captures the complex characteristics of two-phase flow and aids in explaining the transition mechanism between flow patterns. Experimental applications confirm the practical utility of this approach. The ordinal transition entropy provides insights into fluid flow characteristics and aids in understanding the flow pattern evolution process. © 2001-2012 IEEE.},
  affiliation             = {Tianjin University, School of Electrical and Information Engineering, Tianjin, 300072, China; Peking University, Institute of Energy, Beijing, 100871, China},
  author_keywords         = {Flow pattern; horizontal oil-water two-phase flows; ordinal transition entropy; ultrasonic sensor},
  correspondence_address1 = {Ren, W.; Tianjin University, China},
  document_type           = {Article},
  doi                     = {10.1109/JSEN.2024.3509976},
  groups                  = {Journals},
  keywords                = {Flow patterns; Flow structure; Image segmentation; Image thinning; Ultrasonic applications; Ultrasonic sensors; Ultrasonic velocity, Complex flow structures; Dynamic evolution; Evolution mechanism; Experimental simulations; Flow based; Flow condition; Horizontal oil-water two-phase flow; Oil-water two phase flows; Ordinal transition entropy; Transition entropies, Two phase flow},
  language                = {English},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85211981249&doi=10.1109%2fJSEN.2024.3509976&partnerID=40&md5=8f2b7d59b947edfed4c4f460d83a5d69},
}

@Conference{Khilnani2024,
  author              = {Khilnani, A. and Kirar, J.S.},
  title = {Multi Domain Feature Fusion from a combination of Empirical Wavelet Transform and Boruta feature selection for Improved Sleep Stage Classification},
  year                = {2024},
  note                = {cited By 0},
  publisher           = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {IEEE Reg. 10 Symp., TENSYMP},
  abstract            = {The potential of machine learning can be significant in revolutionizing clinical studies on human sleep. Enabling a machine to diagnose the sleep stages could alleviate the workload for clinicians. Here, we revisit the task of classifying sleep stages by applying machine learning algorithms. We have proposed a combination of Empirical wavelet transformation (EWT) based feature extraction and Boruta feature selection approach for automated classification of sleep stages. Various multi-domain features were extracted from intrinsic mode functions(IMF) of EWT. We have used two publicly available datasets in this research work. The proposed work performed better as compared to existing works in terms of classification accuracy. © 2024 IEEE.},
