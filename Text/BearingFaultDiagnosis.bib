  art_number              = {107865},
  author_keywords         = {Classification; Feature extraction; Multi-scale dispersion entropy; Multi-scale permutation entropy; Multi-scale reverse dispersion entropy; Ship-radiated noise},
  coden                   = {AACOB},
  correspondence_address1 = {Jiao, S.; School of Automation and Information Engineering, China; email: jiaoshangbin@xaut.edu.cn},
  document_type           = {Article},
  doi                     = {10.1016/j.apacoust.2020.107865},
  groups                  = {Journals},
  keywords                = {Acoustic noise measurement; Dispersions; Entropy; Scales (weighing instruments); Ships, Classification methods; Classification performance; Comparative studies; Grey relational degree; Multi-scale entropies; Permutation entropy; Ship radiated noise, Vehicle performance},
  language                = {English},
