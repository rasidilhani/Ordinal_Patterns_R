  groups                  = {Journals},
  keywords                = {Bandt & pompe method; Chinese sectoral index; Complexity hierarchies; Complexity–entropy causality plane; Coronaviruses; COVID-19; Economic sectors; Heterogeneous effects; Inefficiency, Entropy},
  language                = {English},
