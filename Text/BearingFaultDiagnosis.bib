  groups                  = {Journals},
  keywords                = {Extraction; Pattern recognition; Quality control; Signal processing; Support vector machines; Time domain analysis, Bearing vibrations; Instrinsic mode functions; Mode decomposition; Pattern recognition method; Permutation entropy; Quality evaluation; Rolling bearings; Time domain characteristics, Roller bearings},
