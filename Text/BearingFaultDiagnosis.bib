@Article{Zhang2020a,
  author                  = {Zhang, J. and Wu, J. and Hu, B. and Tang, J.},
  journal                 = {JVC/Journal of Vibration and Control},
  title = {Intelligent fault diagnosis of rolling bearings using variational mode decomposition and self-organizing feature map},
  year                    = {2020},
  issn                    = {10775463},
  note                    = {cited By 29},
  number                  = {21-22},
  pages = {1886--1897},
  volume                  = {26},
  abbrev_source_title = {JVC/J Vib Control},
  abstract                = {Rotating machinery contains numerous rolling bearings, which are critical for ensuring the normal working position and accurate operation of individual shaft systems. However, damage to rolling bearings can change their damping, stiffness, and elastic force. As a result, fault signals appear nonlinear and nonstationary. Vibration signals thus become difficult to diagnose clearly, especially in the incipient fault stage. To solve this problem, this article proposes an intelligent approach based on variational mode decomposition and the self-organizing feature map for rolling bearing fault diagnosis. First, the intrinsic mode function components of rolling bearing vibration signals are effectively separated by variational mode decomposition. Then, permutation entropy is used to extract feature vectors, which are used as training and testing data for the self-organizing feature map network. Finally, the various fault types of states are clustered on an intuitive visualization map. Clustering results of the experimental signal and the measured signal prove that the proposed method can successfully extract and cluster the rolling bearing faults in engineering applications. The proposed method improves the fault recognition rate to some extent over traditional methods. © The Author(s) 2020.},
  affiliation             = {School of Mechanical and Precision Instrument Engineering, Xi’an University of Technology, China; Faculty of Printing, Packaging and Digital Media Technology, Xi’an University of Technology, China},
  author_keywords         = {cluster analysis; intelligent fault diagnosis; rolling bearings; self-organizing feature map; Variational mode decomposition},
  coden                   = {JVCOF},
  correspondence_address1 = {Zhang, J.; School of Mechanical and Precision Instrument Engineering, China; email: wujimei1@163.com},
  document_type           = {Review},
  doi                     = {10.1177/1077546320911484},
  groups                  = {Journals},
  keywords                = {Classifiers; Cluster analysis; Clustering algorithms; Conformal mapping; Failure analysis; Fault detection; Self organizing maps; Signal processing, Engineering applications; Intelligent fault diagnosis; Intrinsic Mode functions; Mode decomposition; Rolling bearing vibration; Rolling bearings; Self-organizing feature map networks; Training and testing, Roller bearings},
  language                = {English},
  publisher               = {SAGE Publications Inc.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85081928794&doi=10.1177%2f1077546320911484&partnerID=40&md5=af404b502778c921668c169375115101},
}

