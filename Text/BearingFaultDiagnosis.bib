@Conference{Koyama2024,
  author                  = {Koyama, K. and Sakaguchi, M. and Ohnishi, T.},
  title = {A Noise-Robust Approach to Estimate Dimension of Sleep {Eeg} in Mice Using Permutation Entropy},
  year                    = {2024},
  note                    = {cited By 0},
  publisher               = {Institute of Electrical and Electronics Engineers Inc.},
  abbrev_source_title = {IEEE Int Conf Fuzzy Syst},
  abstract                = {Generally, an electroencephalogram (EEG) follows nonlinear dynamics because it shows complex regularities. The analysis of nonlinear dynamics using the 'embedding' method requires the determination of parameters such as embedding dimension and time delay. However, we cannot obtain correct parameters from a conventional method, such as correlation integration, due to noise. Therefore, we use permutation entropy as a robust method against noise. This paper estimates the EEG parameters of mice during different sleep stages by using permutation entropy. The study results suggest that the embedding dimension and time delay are 5 and 8 ms, respectively, regardless of the sleep stage. Furthermore, we analyze the EEG of a sleeping mouse from the nonlinear dynamics. Permutation entropy can distinguish between rapid eye movement sleep and wakefulness, unlike linear methods such as power spectrum density. © 2024 IEEE.},
  affiliation             = {Graduate School of Artificial Intelligence and Science, Rikkyo University, Tokyo, Japan; International Institute for Integrative Sleep Medicine (WPI-IIIS), University of Tsukuba, Ibaraki, Japan},
  author_keywords         = {chaos; complexity; EEG; nonlinear dynamics; permutation entropy},
