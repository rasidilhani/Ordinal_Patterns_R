  groups                  = {Journals},
  keywords                = {Brain mapping; Clinical research; Electrophysiology; Mapping; Sleep research, Classification results; Clinical practices; Feature mapping; Hybrid intelligence; Interpretability; Multitask learning; Sleep assessments; Sleep disorders; Sleep stages classifications; Sleep staging, Electroencephalography, placebo; temazepam, accuracy; Article; clinical feature; clinical practice; controlled study; deep learning; electrocardiogram; electroencephalogram; electroencephalography; electromyogram; electrooculogram; electrooculography; embedding; empirical mode decomposition; entropy; evaluation study; feature extraction; female; human; hybrid; image segmentation; intelligence; intrinsic mode function; knowledge; learning; machine learning; major clinical study; male; monitoring; noise reduction; performance; practice guideline; prediction; prediction error; singular value decomposition; sleep; sleep depth; sleep disorder; sleep quality; sleep stage; sleep study; staging; telemetry; temporal masking; polysomnography; procedures; sleep, Electroencephalography; Electrooculography; Polysomnography; Sleep; Sleep Stages},
