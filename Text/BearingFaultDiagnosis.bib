  coden                   = {IEERA},
  correspondence_address1 = {Si, S.; School of Mechanical Engineering, China; email: sisb@nwpu.edu.cn},
  document_type           = {Article},
  doi                     = {10.1109/TR.2019.2896240},
  groups                  = {Journals},
  keywords                = {Computer aided diagnosis; Entropy; Extraction; Failure analysis; Fault detection; Feature extraction; Iron; Support vector machines; Time series analysis, Benchmark analysis; Benchmark testing; Case Western Reserve University; Fault classification; Fault feature extractions, Classification (of information)},
