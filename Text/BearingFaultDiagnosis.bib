  isbn                    = {9783030869922},
  keywords                = {Data handling; Electroencephalography; Entropy; Granular computing; Information analysis; Information granules; Mathematical transformations, Data uncertainty; Discriminate patterns; Electroencephalogram signals; Experimental activities; Fuzzy C-mean algorithm; Lefthanded; Multi channel; Permutation entropy; Signal discrimination; Times series, Granulation},
