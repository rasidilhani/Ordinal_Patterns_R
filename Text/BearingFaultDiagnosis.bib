  groups                  = {Journals},
  keywords                = {Fault detection; Feature extraction; Learning systems; Roller bearings; Support vector machines, Dynamic-entropy; Faults diagnosis; Features extraction; Multi-scales; Rolling bearings; Scale transfer; Support vectors machine; Symbolic dynamic entropy; Symbolic Dynamics; Transfer learning, Failure analysis},
  language                = {Chinese},
  publisher               = {Northwestern Polytechnical University},
