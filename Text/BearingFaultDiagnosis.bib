}

@Article{Shafizadeh2024,
  author                  = {Shafizadeh, M. and Davids, K.},
  journal                 = {Sensors},
  title = {Wearable System Applications in Performance Analysis of RaceRunning Athletes with Disabilities},
  year                    = {2024},
  issn                    = {14248220},
  note                    = {cited By 0},
  number                  = {24},
  volume                  = {24},
  abbrev_source_title = {Sensors},
  abstract                = {RaceRunning is a sport for disabled people and successful performance depends on reducing the amount of time spent travelling a specific distance. Performance analysis in RaceRunning athletes is based on traditional methods such as recording race time, distances travelled and frequency (sets and reps) that are not sufficient for monitoring training loads. The aims of this study were to monitor training loads in typical training sessions and evaluate technical adaptations in RaceRunning performance by acquiring sensor metrics. Five elite and competitive RaceRunning athletes (18.2 ± 2.3 yrs) at RR2 and RR3 levels were monitored for 8 weeks, performing in their usual training sessions while wearing unobtrusive motion sensors. The motion sensors were attached to the waist and lower leg in all training sessions, each lasting between 80 and 90 min. Performance metrics data collected from the motion sensors included player loads, race loads, work/rest ratio and impact shock directions, along with training factors (duration, frequency, distance, race time and rest time). Results showed that weekly training loads (player and race loads) followed acceptable threshold levels, according to assessment criteria (smallest worthwhile change, acute/chronic work ratio). The relationship between race velocity (performance index) and race load was non-linear and statistically significant, which led to different performance efficiency groups. Wearable motion sensor metrics revealed small to moderate technical adaptations following repeated sprint attempts in temporal running performance, variability and consistency. In conclusion, using a wearable-based system is an effective feedback tool to monitor training quality, revealing important insights into adaptations to training volumes in disabled athletes. © 2024 by the authors.},
  affiliation             = {School of Sport and Physical Activity, College of Health, Wellbeing and Life Sciences, Sheffield Hallam University, S10, Sheffield, 2BP, United Kingdom},
  art_number              = {7923},
  author_keywords         = {adaptations; feedback; performance efficiency; RaceRunning; training loads; wearable-motion sensors},
  correspondence_address1 = {Shafizadeh, M.; School of Sport and Physical Activity, S10, United Kingdom; email: m.shafizadeh@shu.ac.uk},
  document_type           = {Article},
  doi                     = {10.3390/s24247923},
  groups                  = {Journals},
  keywords                = {Disabled persons; Wearable sensors, Adaptation; Motion sensors; Performance; Performance efficiency; Performances analysis; Racerunning; Training load; Training sessions; Wearable systems; Wearable-motion sensor, Motion sensors, adolescent; athlete; athletic performance; disabled person; female; human; male; physiology; running; wearable computer; young adult, Adolescent; Athletes; Athletic Performance; Disabled Persons; Female; Humans; Male; Running; Wearable Electronic Devices; Young Adult},
