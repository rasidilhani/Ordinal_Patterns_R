  journal                 = {Nonlinear Dynamics},
  title = {Nonlinear autocorrelation function of functional time series},
  year                    = {2023},
  issn                    = {0924090X},
  note                    = {cited By 3},
  number                  = {3},
  pages = {2537--2554},
  volume                  = {111},
  abbrev_source_title = {Nonlinear Dyn},
  abstract                = {In functional time series analysis, the functional autocorrelation function (fACF) plays an important role in revealing the temporal dependence structures underlying the dynamics and identifying the lags at which substantial correlation exists. However, akin to its counterpart in the univariate case, the fACF is restricted by linear structure and can be misleading in reflecting nonlinear temporal dependence. This paper proposes a nonlinear alternative to the fACF for analyzing the temporal dependence in functional time series. We consider linear and nonlinear data generating processes: a functional autoregressive process and a functional generalized autoregressive conditional heteroskedasticity process. We demonstrate that when the process exhibits linear temporal structures, the inference obtained from our proposed nonlinear fACF is consistent with that from the fACF. When the underlying process exhibits nonlinear temporal dependence, our nonlinear fACF has a superior capability in uncovering the nonlinear structure that the fACF misleads. An empirical data analysis highlights its applications in unveiling nonlinear temporal structures in the daily curves of the intraday volatility dynamics of the foreign exchange rate. © 2022, The Author(s).},
  affiliation             = {Department of Actuarial Studies and Business Analytics, Macquarie University, Level 7, 4 Eastern Road, Sydney, NSW 2109, Australia},
  author_keywords         = {Financial time series; Forex rates; Functional autoregressive model; Functional GARCH model; Nonlinear temporal dependence},
  coden                   = {NODYE},
  correspondence_address1 = {Huang, X.; Department of Actuarial Studies and Business Analytics, Level 7, 4 Eastern Road, Australia; email: xin.huang1@students.mq.edu.au},
  document_type           = {Article},
  doi                     = {10.1007/s11071-022-07927-0},
  groups                  = {Journals},
  keywords                = {Autocorrelation; Financial data processing; Financial markets; Nonlinear analysis, Autocorrelation functions; Financial time series; Forex rate; Functional autoregressive models; Functional GARCH model; Functional time series; Garch modelling; Nonlinear temporal dependence; Temporal dependence; Temporal structures, Time series analysis},
  language                = {English},
  publisher               = {Springer Science and Business Media B.V.},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85139483321&doi=10.1007%2fs11071-022-07927-0&partnerID=40&md5=b75055a865ab455e77e2dd23787c9843},
}

@Article{Liu2023h,
  author                  = {Liu, L. and Wang, J.},
