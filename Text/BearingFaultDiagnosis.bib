  author                  = {Han, E. and Kim, D. and Lee, J. and Kim, Y. and Yi, M. and Lee, M.},
  journal                 = {Journal of the Korean Society for Aeronautical and Space Sciences},
  title = {Analysis of the Hall-Effect Thruster Discharge Blowoff Using Complexity-Entropy Causality Plane [복잡도-엔트로피 인과 평면을 활용한 홀 추력기 방전 중단 해석]},
  year                    = {2023},
  issn                    = {12251348},
  note                    = {cited By 4},
  number                  = {4},
  pages = {263--271},
  volume                  = {51},
  abbrev_source_title = {J. Korean. Soc. Aeronaut. Space. Sci.},
  abstract                = {The discharge blowoff phenomenon occurring in Hall-effect thrusters characterized by a sudden halt of the plasma discharge is a key challenge in the development, testing, and operation of a satellite propulsion system. Unlike the conventional heuristic method, we use a systematic data-driven approach to analyze the discharge blowoff phenomenon in this study. In particular, we use the complexity-entropy causality plane built by combining the permutation entropy and the Jensen-Shannon statistical complexity to distinguish the characteristics of the discharge blowoff, enabling the determination of a stable operating status and condition of the Hall thruster. The framework used in this study provides a theoretical background for a randomly occurring discharge blowoff phenomenon, enabling the quantitative analysis of discharge instabilities. © 2023 The Korean Society for Aeronautical and Space Sciences.},
  affiliation             = {Department of Mechanical Engineering, Hanbat National University, Daejeon, South Korea; Satrec Initiative, Daejeon, South Korea; Advanced Defense Science & Technology Research Institute, Agency for Defense Development, Daejeon, South Korea},
  author_keywords         = {Complexity-Entropy Causality Plane; Data-driven Method; Discharge Blowoff; Discharge Instability; Hall Thruster},
  correspondence_address1 = {Lee, M.; Department of Mechanical Engineering, South Korea; email: mwlee@hanbat.ac.kr},
  document_type           = {Article},
  doi                     = {10.5139/JKSAS.2023.51.4.263},
  groups                  = {Journals},
  language                = {Korean},
  publisher               = {Korean Society for Aeronautical and Space Sciences},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85165051500&doi=10.5139%2fJKSAS.2023.51.4.263&partnerID=40&md5=6fc335c2d39d218e277d8ebf28a0e054},
}

