  keywords            = {Electronic warfare; Entropy; Radar; Radar transmitters; Signal processing; Support vector machines, Intrinsic Mode functions; Low signal-to-noise ratio; Mode decomposition; Permutation entropy; Radar emitter signals; Radiation emitters; Recognition methods; Urgent problems, Signal to noise ratio},
  language            = {Chinese},
