  author_keywords         = {CEEMD; Envelope spectrum; Fault diagnosis; Intrinsic mode function; Permutation entropy},
  coden                   = {DSPRE},
  correspondence_address1 = {Gu, J.; School of Mechatronic Engineering, China; email: gujuncumt@163.com},
  document_type           = {Article},
  doi                     = {10.1016/j.dsp.2021.103050},
  groups                  = {Journals},
  keywords                = {Entropy; Failure analysis; Fault detection; Modal analysis; Signal processing; Spectrum analysis; White noise, Abnormal components; Bearing fault diagnosis; Correlation coefficient; Ensemble empirical mode decomposition; Ensemble empirical mode decompositions (EEMD); Intrinsic Mode functions; Permutation entropy; Reconstruction error, Roller bearings},
  language                = {English},
