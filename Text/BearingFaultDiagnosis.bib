  groups                  = {Journals},
  keywords                = {Hash functions; Image processing; Stars; Synchronization, Chaotic semiconductor lasers; Communication application; Control parameters; Differential attacks; Image encryption algorithm; Information reconciliation; Multi-user; Random bits, Semiconductor lasers},
  language                = {English},
