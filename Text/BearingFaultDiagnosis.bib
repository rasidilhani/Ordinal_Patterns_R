  correspondence_address1 = {Chang, W.; School of Electronic and Information Engineering, China; email: changww2013@126.com},
  document_type           = {Article},
  doi                     = {10.1109/TCDS.2020.2991359},
  groups                  = {Journals},
  keywords                = {Behavioral research; Classification (of information); Complex networks; Entropy; Pattern recognition, Brain connectivity; Eventrelated potential (ERPs); Functional connectivity; Functional network; Neuronal activities; Pattern recognition method; Quantum neural networks; Temporal dimensions, Brain},
  language                = {English},
