}

@Article{Chagas2022a,
  author                  = {Chagas, E.T.C. and Queiroz-Oliveira, M. and Rosso, O.A. and Ramos, H.S. and Freitas, C.G.S. and Frery, A.C.},
  journal                 = {International Statistical Review},
  title = {White Noise Test from Ordinal Patterns in the Entropy–Complexity Plane},
  year                    = {2022},
  issn                    = {03067734},
  note                    = {cited By 6},
  number                  = {2},
  pages = {374--396},
  volume                  = {90},
  abbrev_source_title = {Int. Stat. Rev.},
  abstract                = {This article serves two purposes. Firstly, it surveys the Bandt and Pompe methodology for the statistical community, stressing topics that are open for research. Secondly, it contributes towards a better understanding of the statistical properties of that approach for time series analysis. The Bandt and Pompe methodology consists of computing information theory descriptors from the histogram of ordinal patterns. Such descriptors lie in a 2D manifold: the entropy–complexity plane. This article provides the first proposal of a test in the entropy–complexity plane for the white noise hypothesis. Our test is based on true white noise sequences obtained from physical devices. The proposed methodology provides consistent results: It assesses sequences of true random samples as random (adequate test size), rejects correlated and contaminated sequences (sound test power) and captures the randomness of generators previously analysed in the literature. © 2022 International Statistical Institute.},
  affiliation             = {Departamento de Ciência da Computação, Universidade Federal de Minas Gerais, Belo Horizonte, Brazil; Laboratório de Computação Científica e Análise Numérica, Universidade Federal de Alagoas, Maceió, Brazil; Coordenação de Informática, Instituto Federal de Alagoas, Maceió, Brazil; Instituto de Física, Universidade Federal de Alagoas, Maceió, Brazil; School of Mathematics and Statistics, Victoria University of Wellington, Wellington, New Zealand},
  author_keywords         = {Bandt–Pompe approach; entropy–complexity plane; information theory; ordinal patterns; random number generators; time series},
  correspondence_address1 = {Chagas, E.T.C.; Departamento de Ciência da Computação, Brazil; email: eduarda.chagas@dcc.ufmg.br},
  document_type           = {Article},
  doi                     = {10.1111/insr.12487},
  groups                  = {Journals},
  language                = {English},
  publisher               = {International Statistical Institute},
  source                  = {Scopus},
  url                     = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85124521918&doi=10.1111%2finsr.12487&partnerID=40&md5=9dee06fb2dc7da06ec6c944c01b05159},
}

@Article{Huang2022a,
  author                  = {Huang, X. and Shang, H.L. and Pitt, D.},
  journal                 = {Journal of Forecasting},
  title = {A model sufficiency test using permutation entropy},
  year                    = {2022},
  issn                    = {02776693},
  note                    = {cited By 2},
  number                  = {5},
  pages = {1017--1036},
  volume                  = {41},
  abbrev_source_title = {J Forecast},
  abstract                = {Using the ordinal-pattern concept in permutation entropy, we propose a model sufficiency test to study a given model's point prediction accuracy. Compared with some classical model sufficiency tests, such as Broock et al.'s (1996) test, our proposal does not require a sufficient model to eliminate all structures exhibited in the estimated residuals. When the innovations in the investigated data's underlying dynamics show a certain structure, such as higher moment serial dependence, Broock et al.'s (1996) test can lead to erroneous conclusions about the sufficiency of point predictors. Due to the structured innovations, inconsistency between the model sufficiency tests and prediction accuracy criteria can occur. Our proposal fills in this incoherence between model and prediction evaluation approaches and remains valid when the underlying process has nonwhite additive innovation. © 2022 John Wiley & Sons, Ltd.},
  affiliation             = {Department of Actuarial Studies and Business Analytics, Macquarie University, Sydney, NSW, Australia},
  author_keywords         = {BDS test; bivariate dependence; model evaluation; ordinal pattern; prediction accuracy},
  coden                   = {JOFOD},
